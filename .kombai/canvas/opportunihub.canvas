ink\"><a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"link label\" href=\"#\">CGU</a></li>\n<li data-kid=\"1-3-1-3-2-2\" data-name=\"confidentialité link\"><a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"link label\" href=\"#\">Confidentialité</a></li>\n<li data-kid=\"1-3-1-3-2-3\" data-name=\"legal mentions link\"><a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-3-1-3-2-3-1\" data-name=\"link label\" href=\"#\">Mentions Légales</a></li>\n</ul>\n</div>\n</div>\n<div class=\"max-w-7xl mx-auto mt-24 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"1-3-2\" data-name=\"footer bottom bar\">\n<p class=\"text-[11px] font-plus font-black uppercase tracking-[0.3em] text-slate-600\" data-kid=\"1-3-2-1\" data-name=\"copyright text\">© 2024 OpportuniHub Togo. Tous droits réservés.</p>\n<p class=\"text-[11px] font-plus font-black uppercase tracking-[0.3em] text-slate-600 flex items-center gap-2\" data-kid=\"1-3-2-2\" data-name=\"credits text\">Fait avec <i class=\"ti ti-heart-filled text-rose-500\" data-kid=\"1-3-2-2-1\" data-name=\"heart icon\"></i> à Lomé</p>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"4\"></script>\n<script type=\"module\" data-kid=\"5\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    document.addEventListener('DOMContentLoaded', () => {\n        // GSAP Reveal Animations\n        gsap.from(\".gsap-reveal\", {\n            opacity: 0,\n            y: 40,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n\n        // SVG Circle Progress Animation\n        gsap.from(\"#progress-circle\", {\n            strokeDashoffset: 282.7,\n            duration: 2.5,\n            ease: \"expo.out\",\n            delay: 0.8\n        });\n\n        // Anime.js Breathing Pulse\n        animate(\"#live-indicator\", {\n            scale: [1, 1.3],\n            opacity: [1, 0.6],\n            duration: 1500,\n            direction: 'alternate',\n            loop: true,\n            easing: 'easeInOutSine'\n        });\n\n        // Hover effect for main cards using GSAP\n        const cards = document.querySelectorAll('.glow-on-hover');\n        cards.forEach(card => {\n            card.addEventListener('mouseenter', () => {\n                gsap.to(card, {\n                    scale: 1.01,\n                    borderColor: '#F59E0B',\n                    boxShadow: '0 0 40px rgba(245, 158, 11, 0.4)',\n                    duration: 0.4,\n                    ease: \"power2.out\"\n                });\n            });\n            card.addEventListener('mouseleave', () => {\n                gsap.to(card, {\n                    scale: 1,\n                    borderColor: 'rgba(255, 255, 255, 0.05)',\n                    boxShadow: '0 25px 50px -12px rgba(0, 0, 0, 0.5)',\n                    duration: 0.4,\n                    ease: \"power2.out\"\n                });\n            });\n        });\n    });\n</script>\n",
