 bg-white hover:bg-gray-50/50 transition-colors\" data-kid=\"143\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"144\">\n                        <div class=\"w-2 h-10 bg-[#27AE60] rounded-full\" data-kid=\"145\"></div>\n                        <div data-kid=\"146\">\n                            <h3 class=\"font-bold text-[#0A3D62] text-sm\" data-kid=\"147\">Artisanal Decor</h3>\n                            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-tight\" data-kid=\"148\">Livraison confirmée</p>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col items-end\" data-kid=\"149\">\n                        <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62] text-lg\" data-kid=\"150\">25,000</span>\n                        <span class=\"text-[8px] text-gray-300 font-bold\" data-kid=\"151\">OCT 08, 2023</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"history-item-minimal p-5 border-b border-gray-100 flex items-center justify-between bg-white hover:bg-gray-50/50 transition-colors\" data-kid=\"152\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"153\">\n                        <div class=\"w-2 h-10 bg-[#F6A623] rounded-full\" data-kid=\"154\"></div>\n                        <div data-kid=\"155\">\n                            <h3 class=\"font-bold text-[#0A3D62] text-sm\" data-kid=\"156\">Sac de Riz Luxe</h3>\n                            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-tight\" data-kid=\"157\">Porte-feuille crédité</p>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col items-end\" data-kid=\"158\">\n                        <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62] text-lg\" data-kid=\"159\">15,500</span>\n                        <span class=\"text-[8px] text-gray-300 font-bold\" data-kid=\"160\">OCT 05, 2023</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"history-item-minimal p-5 flex items-center justify-between bg-white hover:bg-gray-50/50 transition-colors\" data-kid=\"161\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"162\">\n                        <div class=\"w-2 h-10 bg-red-500 rounded-full\" data-kid=\"163\"></div>\n                        <div data-kid=\"164\">\n                            <h3 class=\"font-bold text-[#0A3D62] text-sm\" data-kid=\"165\">Smartphone Android</h3>\n                            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-tight\" data-kid=\"166\">Annulation client</p>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col items-end\" data-kid=\"167\">\n                        <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62] text-lg\" data-kid=\"168\">120,000</span>\n                        <span class=\"text-[8px] text-gray-300 font-bold\" data-kid=\"169\">OCT 01, 2023</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] bg-white border-t border-gray-100 px-6 pt-3 pb-8 flex items-center justify-between z-50 rounded-t-3xl shadow-[0_-12px_40px_rgba(0,0,0,0.06)]\" data-kid=\"170\">\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"171\">\n            <i class=\"ti ti-smart-home text-[22px] text-[#0A3D62]\" data-kid=\"172\"></i>\n            <span class=\"text-[9px] font-bold text-[#0A3D62] tracking-tight\" data-kid=\"173\">Accueil</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"174\">\n            <div class=\"relative\" data-kid=\"175\">\n                <i class=\"ti ti-history text-[22px] text-[#0A3D62]\" data-kid=\"176\"></i>\n                <div class=\"absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"177\"></div>\n            </div>\n            <span class=\"text-[9px] font-black text-[#0A3D62] tracking-tight\" data-kid=\"178\">Historique</span>\n        </button>\n\n        <div class=\"flex flex-col items-center\" data-kid=\"179\">\n            <button class=\"nav-wallet-btn -mt-10 w-16 h-16 bg-[#0A3D62] rounded-full flex items-center justify-center text-white border-[6px] border-[#F5F7FA] active:scale-95 transition-transform z-10\" data-kid=\"180\">\n                <i class=\"ti ti-wallet text-2xl\" data-kid=\"181\"></i>\n            </button>\n            <span class=\"mt-1 text-[9px] font-black text-[#0A3D62] tracking-tight\" data-kid=\"182\">Solde</span>\n        </div>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"183\">\n            <i class=\"ti ti-checklist text-[22px] text-[#0A3D62]\" data-kid=\"184\"></i>\n            <span class=\"text-[9px] font-bold text-[#0A3D62] tracking-tight\" data-kid=\"185\">Sondages</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"186\">\n            <i class=\"ti ti-user-circle text-[22px] text-[#0A3D62]\" data-kid=\"187\"></i>\n            <span class=\"text-[9px] font-bold text-[#0A3D62] tracking-tight\" data-kid=\"188\">Profil</span>\n        </button>\n    </nav>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"189\"></script>\n    <script type=\"module\" data-kid=\"190\">\n        import { animate, press, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Lenis for smooth scroll\n        const lenis = new Lenis({\n            autoRaf: true,\n            lerp: 0.1,\n            smoothWheel: true,\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // Variant Switching Logic\n        const buttons = document.querySelectorAll('.btn-variant');\n        const contents = document.querySelectorAll('.variant-content');\n\n        buttons.forEach(btn => {\n            btn.addEventListener('click', () => {\n                const target = btn.getAttribute('data-variant');\n                \n                // Update buttons\n                buttons.forEach(b => b.classList.remove('active'));\n                btn.classList.add('active');\n\n                // Animate content switch\n                const currentActive = document.querySelector('.variant-content.active');\n                \n                gsap.to(currentActive, {\n                    opacity: 0,\n                    y: 10,\n                    duration: 0.3,\n                    onComplete: () => {\n                        currentActive.classList.remove('active');\n                        const nextContent = document.getElementById(`variant-${target}`);\n                        nextContent.classList.add('active');\n                        \n                        gsap.fromTo(nextContent, \n                            { opacity: 0, y: 10 },\n                            { opacity: 1, y: 0, duration: 0.4, ease: \"power2.out\" }\n                        );\n\n                        // Trigger entrance animations for the specific variant items\n                        if(target === 'classic') animateItems('.history-item-classic');\n                        if(target === 'modern') animateItems('.history-item-modern');\n                        if(target === 'minimal') animateItems('.history-item-minimal');\n                    }\n                });\n            });\n        });\n\n        function animateItems(selector) {\n            gsap.from(selector, {\n                opacity: 0,\n                x: 20,\n                duration: 0.5,\n                stagger: 0.1,\n                ease: \"power3.out\",\n                clearProps: \"all\"\n            });\n        }\n\n        // Initial entrance\n        animateItems('.history-item-classic');\n\n        // Press feedback\n        press('.history-item-classic, .history-item-minimal', (el) => {\n            animate(el, { scale: 0.98 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.2 });\n        });\n    </script>\n</div>\n",
