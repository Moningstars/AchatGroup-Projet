div>\n<p class=\"text-slate-400 text-sm leading-relaxed max-w-sm mb-8\" data-kid=\"1-3-1-1-2\" data-name=\"branding description\">\n                    La première plateforme d'achat groupé d'Afrique de l'Ouest. Transformons notre pouvoir d'achat collectif en économies réelles et durables.\n                </p>\n<div class=\"flex gap-4\" data-kid=\"1-3-1-1-3\" data-name=\"social media links\">\n<a class=\"w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"1-3-1-1-3-1\" data-name=\"facebook link\" href=\"#\"><i class=\"ti ti-brand-facebook\" data-kid=\"1-3-1-1-3-1-1\" data-name=\"facebook icon\"></i></a>\n<a class=\"w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"1-3-1-1-3-2\" data-name=\"instagram link\" href=\"#\"><i class=\"ti ti-brand-instagram\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"instagram icon\"></i></a>\n<a class=\"w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"1-3-1-1-3-3\" data-name=\"twitter link\" href=\"#\"><i class=\"ti ti-brand-x\" data-kid=\"1-3-1-1-3-3-1\" data-name=\"twitter icon\"></i></a>\n</div>\n</div>\n<div data-kid=\"1-3-1-2\" data-name=\"navigation footer links\">\n<h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--primary)] mb-6\" data-kid=\"1-3-1-2-1\" data-name=\"navigation headline\">Navigation</h4>\n<ul class=\"space-y-4 text-sm font-bold text-slate-400\" data-kid=\"1-3-1-2-2\" data-name=\"navigation list\">\n<li data-kid=\"1-3-1-2-2-1\" data-name=\"catalogue footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"catalogue footer anchor\" href=\"#\">Catalogue</a></li>\n<li data-kid=\"1-3-1-2-2-2\" data-name=\"sondages footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"sondages footer anchor\" href=\"#\">Sondages</a></li>\n<li data-kid=\"1-3-1-2-2-3\" data-name=\"wallet footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-2-2-3-1\" data-name=\"wallet footer anchor\" href=\"#\">Mon Wallet</a></li>\n<li data-kid=\"1-3-1-2-2-4\" data-name=\"support footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-2-2-4-1\" data-name=\"support footer anchor\" href=\"#\">Aide &amp; Support</a></li>\n</ul>\n</div>\n<div data-kid=\"1-3-1-3\" data-name=\"legal footer links\">\n<h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--primary)] mb-6\" data-kid=\"1-3-1-3-1\" data-name=\"legal headline\">Légal</h4>\n<ul class=\"space-y-4 text-sm font-bold text-slate-400\" data-kid=\"1-3-1-3-2\" data-name=\"legal list\">\n<li data-kid=\"1-3-1-3-2-1\" data-name=\"cgu footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"cgu footer anchor\" href=\"#\">CGU</a></li>\n<li data-kid=\"1-3-1-3-2-2\" data-name=\"confidentialité footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"confidentialité footer anchor\" href=\"#\">Confidentialité</a></li>\n<li data-kid=\"1-3-1-3-2-3\" data-name=\"mentions footer link\"><a class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"1-3-1-3-2-3-1\" data-name=\"mentions footer anchor\" href=\"#\">Mentions Légales</a></li>\n</ul>\n</div>\n</div>\n<div class=\"max-w-7xl mx-auto mt-16 pt-8 border-t border-slate-50 flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"1-3-2\" data-name=\"footer bottom section\">\n<p class=\"text-[10px] font-black uppercase tracking-widest text-slate-300\" data-kid=\"1-3-2-1\" data-name=\"copyright text\">© 2024 OpportuniHub Togo. Tous droits réservés.</p>\n<p class=\"text-[10px] font-black uppercase tracking-widest text-slate-300 flex items-center gap-1\" data-kid=\"1-3-2-2\" data-name=\"made with love text\">Fait avec <i class=\"ti ti-heart-filled text-rose-500\" data-kid=\"1-3-2-2-1\" data-name=\"heart icon\"></i> à Lomé</p>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"4\"></script>\n<script data-kid=\"5\">\n    // Variant Switcher\n    window.changeVariant = (variant) => {\n        const wrapper = document.getElementById('main-wrapper');\n        wrapper.className = 'min-h-screen transition-colors duration-500 antialiased font-vietnam';\n        wrapper.classList.add(`variant-${variant}`);\n\n        // Update buttons\n        document.querySelectorAll('.variant-btn').forEach(btn => {\n            btn.classList.remove('bg-white', 'shadow-sm', 'text-[var(--primary)]');\n            btn.classList.add('text-slate-500');\n            if(btn.textContent.toLowerCase() === variant) {\n                btn.classList.add('bg-white', 'shadow-sm', 'text-[var(--primary)]');\n                btn.classList.remove('text-slate-500');\n            }\n        });\n\n        // Trigger entrance animation again for visual punch\n        gsap.from(\".reveal-card\", {\n            opacity: 0,\n            y: 20,\n            duration: 0.8,\n            stagger: 0.05,\n            ease: \"power2.out\"\n        });\n    };\n\n    // GSAP Entrance Animations\n    document.addEventListener('DOMContentLoaded', () => {\n        gsap.from(\".reveal-card\", {\n            opacity: 0,\n            y: 40,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: \"expo.out\",\n            delay: 0.2\n        });\n\n        // Circle progress animation\n        gsap.from(\"#progress-circle\", {\n            strokeDashoffset: 251.2,\n            duration: 2,\n            ease: \"power3.inOut\",\n            delay: 1\n        });\n    });\n</script>\n",
