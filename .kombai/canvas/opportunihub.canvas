      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --primary: #0A3D62;\n        --accent: #F6A623;\n        --success: #27AE60;\n        --error: #E74C3C;\n        --bg: #F8FAFC;\n        --text: #1A1A2E;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .otp-field {\n        width: 2.75rem;\n        height: 3.5rem;\n        text-align: center;\n        font-size: 1.25rem;\n        font-weight: 800;\n        border-radius: 0.75rem;\n        border-width: 2px;\n        outline: none;\n    }\n\n    .variant-card {\n        width: 375px;\n        height: 760px;\n        background-color: white;\n        border-radius: 3.5rem;\n        box-shadow: 0 40px 100px -20px rgba(10, 61, 98, 0.15);\n        overflow: hidden;\n        position: relative;\n        display: flex;\n        flex-direction: column;\n        border-width: 12px;\n        border-color: #1a1a1a;\n        flex-shrink: 0;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        height: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: #f1f1f1;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: var(--primary);\n        border-radius: 10px;\n    }\n\n    @keyframes blink {\n        0%, 100% { opacity: 1; }\n        50% { opacity: 0; }\n    }\n    .cursor-blink {\n        animation: blink 1s step-end infinite;\n    }\n</style>\n\n<div class=\"min-h-screen bg-slate-100 font-vietnam text-[var(--text)] py-20 px-4 md:px-20 overflow-x-auto flex flex-col items-center\" data-kid=\"1\">\n    \n    <div class=\"text-center mb-16 max-w-2xl\" data-kid=\"2\">\n        <h2 class=\"text-xs font-black uppercase tracking-[0.3em] text-[var(--primary)] mb-4\" data-kid=\"3\">Design Showcase</h2>\n        <h1 class=\"text-4xl md:text-5xl font-black font-plus text-slate-900 mb-6\" data-kid=\"4\">OTP Verification<br data-kid=\"5\"><span class=\"text-[var(--accent)]\" data-kid=\"6\">Mobile Variants</span></h1>\n        <p class=\"text-slate-500 font-medium\" data-kid=\"7\">Trois approches distinctes pour l'étape de vérification par code de sécurité de la plateforme OpportuniHub.</p>\n    </div>\n\n    \n    <div class=\"flex flex-col xl:flex-row flex-wrap gap-16 items-center justify-center w-full\" data-kid=\"8\">\n        \n        \n        <div class=\"variant-card\" id=\"variant-1\" data-kid=\"9\">\n            <div class=\"p-8 flex flex-col h-full\" data-kid=\"10\">\n                \n                <div class=\"flex items-center justify-between mb-10\" data-kid=\"11\">\n                    <button class=\"w-10 h-10 rounded-full border border-slate-100 flex items-center justify-center text-slate-400 hover:text-[var(--primary)] transition-all\" data-kid=\"12\">\n                        <i class=\"ti ti-arrow-left text-xl\" data-kid=\"13\"></i>\n                    </button>\n                    <div class=\"flex items-center gap-2\" data-kid=\"14\">\n                        <div class=\"w-8 h-8 bg-[var(--primary)] rounded-lg flex items-center justify-center text-white font-bold text-sm\" data-kid=\"15\">O</div>\n                        <span class=\"font-extrabold text-[var(--primary)] text-lg tracking-tight font-plus\" data-kid=\"16\">OpportuniHub</span>\n                    </div>\n                    <div class=\"w-10\" data-kid=\"17\"></div>\n                </div>\n\n                \n                <div class=\"mb-10\" data-kid=\"18\">\n                    <div class=\"flex justify-between items-center mb-2.5\" data-kid=\"19\">\n                        <span class=\"text-[10px] font-bold text-slate-400\" data-kid=\"20\">Progression</span>\n                        <span class=\"text-[10px] font-extrabold text-[var(--primary)] uppercase tracking-wider\" data-kid=\"21\">Étape 2 / 3</span>\n                    </div>\n                    <div class=\"h-1 w-full bg-slate-100 rounded-full overflow-hidden\" data-kid=\"22\">\n                        <div class=\"h-full bg-[var(--accent)] rounded-full w-2/3\" data-kid=\"23\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"flex-1\" data-kid=\"24\">\n                    <h2 class=\"text-4xl font-black text-[var(--primary)] font-plus mb-3 leading-tight tracking-tight\" data-kid=\"25\">Vérification</h2>\n                    <p class=\"text-slate-500 text-sm font-medium leading-relaxed mb-8\" data-kid=\"26\">\n                        Veuillez entrer le code à 6 chiffres envoyé au <span class=\"font-bold text-slate-900\" data-kid=\"27\">+228 91 •• •• 89</span>.\n                    </p>\n\n                    \n                    <div class=\"flex justify-between gap-1.5 mb-8\" id=\"otp-v1\" data-kid=\"28\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-slate-200 bg-slate-50 focus:border-[var(--primary)] focus:bg-white text-[var(--primary)]\" value=\"2\" data-kid=\"29\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-slate-200 bg-slate-50 focus:border-[var(--primary)] focus:bg-white text-[var(--primary)]\" value=\"5\" data-kid=\"30\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-[var(--primary)] bg-white ring-4 ring-[var(--primary)]/10 text-[var(--primary)]\" placeholder=\"·\" data-kid=\"31\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-slate-100 bg-slate-50 focus:border-[var(--primary)] focus:bg-white text-[var(--primary)]\" placeholder=\"·\" data-kid=\"32\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-slate-100 bg-slate-50 focus:border-[var(--primary)] focus:bg-white text-[var(--primary)]\" placeholder=\"·\" data-kid=\"33\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-field border-slate-100 bg-slate-50 focus:border-[var(--primary)] focus:bg-white text-[var(--primary)]\" placeholder=\"·\" data-kid=\"34\">\n                    </div>\n\n                    <div class=\"text-center\" data-kid=\"35\">\n                        <p class=\"text-xs font-bold text-slate-400 mb-2\" data-kid=\"36\">Code non reçu ?</p>\n                        <button class=\"text-[var(--accent)] font-black uppercase text-[10px] tracking-widest flex items-center gap-2 mx-auto hover:gap-3 transition-all\" data-kid=\"37\">\n                            Renvoyer (0:58) <i class=\"ti ti-rotate-clockwise-2\" data-kid=\"38\"></i>\n                        </button>\n                    </div>\n                </div>\n\n                \n                <div class=\"mt-auto space-y-3 pb-2\" data-kid=\"39\">\n                    <button class=\"w-full bg-[var(--primary)] text-white py-4 rounded-2xl font-bold text-base shadow-lg shadow-[var(--primary)]/20 active:scale-95 transition-all hover:bg-[var(--primary)]/95\" data-kid=\"40\">\n                        Valider\n                    </button>\n                    <button class=\"w-full py-2 text-slate-400 font-medium text-[11px] hover:text-[var(--primary)] transition-colors\" data-kid=\"41\">\n                        Changer de numéro de téléphone\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"variant-card\" id=\"variant-2\" data-kid=\"42\">\n            \n            <div class=\"h-44 bg-[var(--primary)] relative p-8 flex flex-col justify-end overflow-hidden\" data-kid=\"43\">\n                <div class=\"absolute -right-16 -top-16 opacity-5 rotate-12\" data-kid=\"44\">\n                    <i class=\"ti ti-shield-lock text-[200px] text-white\" data-kid=\"45\"></i>\n                </div>\n                \n                <div class=\"absolute top-8 left-6 right-6 flex items-center justify-between z-10\" data-kid=\"46\">\n                    <button class=\"text-white/60 hover:text-white transition-colors\" data-kid=\"47\"><i class=\"ti ti-chevron-left text-2xl\" data-kid=\"48\"></i></button>\n                    <div class=\"flex items-center gap-1 bg-white/10 backdrop-blur-sm px-2.5 py-1 rounded-full border border-white/5\" data-kid=\"49\">\n                        <div class=\"w-1 h-1 bg-[var(--accent)] rounded-full animate-pulse\" data-kid=\"50\"></div>\n                        <span class=\"text-[8px] font-bold text-white uppercase tracking-tighter\" data-kid=\"51\">Étape 2 / 3</span>\n                    </div>\n                </div>\n\n                <div class=\"relative z-10 flex items-center gap-4\" data-kid=\"52\">\n                    <div class=\"w-12 h-12 bg-[var(--accent)] rounded-2xl flex items-center justify-center text-[var(--primary)] shadow-xl shadow-black/20 group hover:rotate-6 transition-transform\" data-kid=\"53\">\n                        <i class=\"ti ti-shield-check text-2xl\" data-kid=\"54\"></i>\n                    </div>\n                    <div data-kid=\"55\">\n                        <h2 class=\"text-2xl font-black text-white font-plus leading-none tracking-tight\" data-kid=\"56\">Accès Sécurisé</h2>\n                        <p class=\"text-white/40 text-[9px] mt-1 font-black uppercase tracking-[0.2em]\" data-kid=\"57\">OpportuniHub Verification</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"flex-1 bg-white p-8 -mt-6 rounded-t-[2.5rem] relative z-20 flex flex-col\" data-kid=\"58\">\n                <div class=\"h-1 w-full bg-slate-100 rounded-full mb-10 overflow-hidden\" data-kid=\"59\">\n                    <div class=\"h-full bg-[var(--accent)] rounded-full w-2/3\" data-kid=\"60\"></div>\n                </div>\n\n                <div class=\"text-center mb-10\" data-kid=\"61\">\n                    <p class=\"text-slate-400 text-[10px] font-black uppercase tracking-[0.2em] mb-6\" data-kid=\"62\">Saisissez votre code</p>\n                    \n                    <div class=\"flex justify-between gap-1.5\" id=\"otp-v2\" data-kid=\"63\">\n                        <div class=\"w-11 h-16 rounded-xl bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xl font-black text-[var(--primary)] shadow-sm\" data-kid=\"64\">4</div>\n                        <div class=\"w-11 h-16 rounded-xl bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xl font-black text-[var(--primary)] shadow-sm\" data-kid=\"65\">8</div>\n                        <div class=\"w-11 h-16 rounded-xl bg-white border-2 border-[var(--accent)] flex items-center justify-center text-xl font-black text-[var(--primary)] shadow-md relative\" data-kid=\"66\">\n                            <div class=\"w-0.5 h-6 bg-[var(--accent)] cursor-blink\" data-kid=\"67\"></div>\n                        </div>\n                        <div class=\"w-11 h-16 rounded-xl bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xl font-black text-slate-200\" data-kid=\"68\">·</div>\n                        <div class=\"w-11 h-16 rounded-xl bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xl font-black text-slate-200\" data-kid=\"69\">·</div>\n                        <div class=\"w-11 h-16 rounded-xl bg-slate-50 border-2 border-slate-100 flex items-center justify-center text-xl font-black text-slate-200\" data-kid=\"70\">·</div>\n                    </div>\n                </div>\n\n                <div class=\"mt-auto\" data-kid=\"71\">\n                    <div class=\"flex items-center justify-between text-[11px] font-bold text-slate-400 mb-6\" data-kid=\"72\">\n                        <span data-kid=\"73\">Renvoyer dans 0:42</span>\n                        <button class=\"text-[var(--primary)] font-black uppercase tracking-widest border-b-2 border-[var(--accent)]\" data-kid=\"74\">Support</button>\n                    </div>\n                    \n                    <button class=\"w-full bg-[var(--accent)] text-[var(--primary)] py-4.5 rounded-[1.25rem] font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-[var(--accent)]/30 active:scale-95 transition-all\" data-kid=\"75\">\n                        Continuer\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"variant-card bg-[var(--bg)]\" id=\"variant-3\" data-kid=\"76\">\n            <div class=\"p-8 flex flex-col h-full\" data-kid=\"77\">\n                \n                <div class=\"flex items-center justify-between mb-10\" data-kid=\"78\">\n                    <button class=\"w-10 h-10 bg-white rounded-xl shadow-sm border border-slate-100 flex items-center justify-center text-[var(--primary)] active:scale-90 transition-transform\" data-kid=\"79\">\n                        <i class=\"ti ti-arrow-left text-xl\" data-kid=\"80\"></i>\n                    </button>\n                    <div class=\"flex-1 px-4 text-center\" data-kid=\"81\">\n                         <div class=\"flex justify-between items-center mb-1.5 px-1\" data-kid=\"82\">\n                            <span class=\"text-[8px] font-black text-[var(--primary)] tracking-widest\" data-kid=\"83\">PROGRESSION</span>\n                            <span class=\"text-[9px] font-black text-[var(--primary)]\" data-kid=\"84\">2 / 3</span>\n                         </div>\n                         <div class=\"h-1.5 w-full bg-white rounded-full border border-slate-100 overflow-hidden\" data-kid=\"85\">\n                            <div class=\"h-full bg-[var(--primary)] w-2/3 shadow-inner\" data-kid=\"86\"></div>\n                        </div>\n                    </div>\n                    <span class=\"text-[10px] font-bold text-[var(--primary)] bg-white px-2 py-0.5 rounded-lg border border-slate-100 shadow-sm\" data-kid=\"87\">Étape 2</span>\n                </div>\n\n                \n                <div class=\"flex items-center gap-3 mb-10 px-2\" data-kid=\"88\">\n                    <div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg\" data-kid=\"89\">O</div>\n                    <div class=\"h-8 w-px bg-slate-200\" data-kid=\"90\"></div>\n                    <h2 class=\"text-2xl font-black text-[var(--primary)] font-plus leading-none tracking-tighter\" data-kid=\"91\">Vérification<br data-kid=\"92\">Sécurisée</h2>\n                </div>\n\n                <p class=\"text-slate-500 font-medium text-sm mb-10 px-2 leading-relaxed\" data-kid=\"93\">Nous avons envoyé un code de confirmation unique à votre appareil.</p>\n\n                \n                <div class=\"relative mb-10\" id=\"otp-v3\" data-kid=\"94\">\n                    <div class=\"flex justify-between gap-1\" data-kid=\"95\">\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-white rounded-xl border-2 border-slate-100 shadow-sm flex items-center justify-center text-2xl font-black text-[var(--primary)]\" data-kid=\"96\">7</div>\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-white rounded-xl border-2 border-slate-100 shadow-sm flex items-center justify-center text-2xl font-black text-[var(--primary)]\" data-kid=\"97\">1</div>\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-white rounded-xl border-2 border-slate-100 shadow-sm flex items-center justify-center text-2xl font-black text-[var(--primary)]\" data-kid=\"98\">3</div>\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-white rounded-xl border-2 border-slate-100 shadow-sm flex items-center justify-center text-2xl font-black text-[var(--primary)]\" data-kid=\"99\">9</div>\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-white rounded-xl border-2 border-[var(--primary)] shadow-md flex items-center justify-center text-2xl font-black text-[var(--primary)] relative\" data-kid=\"100\">\n                             0\n                             <div class=\"absolute bottom-1 w-2/3 h-0.5 bg-[var(--primary)]\" data-kid=\"101\"></div>\n                        </div>\n                        <div class=\"otp-v3-digit flex-1 aspect-[3/4] bg-slate-200 rounded-xl border-2 border-slate-300 flex items-center justify-center text-2xl font-black text-slate-400\" data-kid=\"102\">·</div>\n                    </div>\n                    \n                    <div class=\"mt-6 flex items-center justify-center gap-2 bg-white/60 backdrop-blur-sm py-2 rounded-full border border-white mx-6\" data-kid=\"103\">\n                        <i class=\"ti ti-hourglass-empty text-[var(--accent)] animate-pulse\" data-kid=\"104\"></i>\n                        <span class=\"text-[9px] font-black uppercase tracking-[0.1em] text-slate-500\" data-kid=\"105\">Expira dans <span class=\"text-[var(--primary)] font-bold\" data-kid=\"106\">04:59</span></span>\n                    </div>\n                </div>\n\n                <div class=\"mt-auto space-y-3\" data-kid=\"107\">\n                    <button class=\"w-full bg-[var(--primary)] text-white py-5 rounded-3xl font-bold text-base shadow-2xl shadow-[var(--primary)]/20 flex items-center justify-center gap-3 active:scale-95 transition-all\" data-kid=\"108\">\n                        Valider mon compte\n                        <i class=\"ti ti-chevron-right-pipe\" data-kid=\"109\"></i>\n                    </button>\n                    <button class=\"w-full py-3 text-slate-400 font-bold text-xs hover:text-[var(--primary)] transition-colors\" data-kid=\"110\">\n                        Renvoyer le code\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"111\"></script>\n<script data-kid=\"112\">\n    document.addEventListener('DOMContentLoaded', () => {\n        // Entrance animations for the three variants\n        gsap.from(\"#variant-1\", {\n            y: 100,\n            opacity: 0,\n            duration: 1,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n\n        gsap.from(\"#variant-2\", {\n            y: 100,\n            opacity: 0,\n            duration: 1,\n            ease: \"power4.out\",\n            delay: 0.4\n        });\n\n        gsap.from(\"#variant-3\", {\n            y: 100,\n            opacity: 0,\n            duration: 1,\n            ease: \"power4.out\",\n            delay: 0.6\n        });\n\n        // OTP Field entrance animations\n        gsap.from(\"#otp-v1 input\", {\n            scale: 0.5,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.05,\n            ease: \"back.out(1.7)\",\n            delay: 1\n        });\n\n        gsap.from(\"#otp-v2 div\", {\n            y: 20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.05,\n            ease: \"power2.out\",\n            delay: 1.2\n        });\n\n        gsap.from(\".otp-v3-digit\", {\n            x: -20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.05,\n            ease: \"expo.out\",\n            delay: 1.4\n        });\n    });\n</script>\n",
