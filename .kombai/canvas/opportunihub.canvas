      "html": "\n<div class=\"bg-slate-900 min-h-screen flex items-center justify-center p-0 sm:p-4\" data-kid=\"0\">\n<section class=\"w-full max-w-[420px] h-full min-h-screen sm:min-h-[844px] sm:max-h-[900px] bg-[#F5F7FA] font-['Be_Vietnam_Pro'] text-[#0A3D62] flex flex-col overflow-x-clip selection:bg-[#F6A623]/30 sm:rounded-[40px] sm:shadow-2xl sm:border-[8px] sm:border-slate-800 relative\" data-kid=\"1\">\n    <style data-kid=\"2\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .question-card {\n            will-change: transform, opacity;\n        }\n\n        .option-card {\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        input:checked + .option-ui {\n            border-color: #0A3D62;\n            background-color: #FFFFFF;\n            box-shadow: 0 12px 24px -8px rgba(10, 61, 98, 0.15);\n            transform: translateY(-2px);\n        }\n\n        /* Logic for checkboxes (squares) and radios (circles) handled in the script */\n        input:checked + .option-ui .check-box {\n            background-color: #0A3D62;\n            border-color: #0A3D62;\n            transform: scale(1.1);\n        }\n\n        input:checked + .option-ui .check-mark {\n            opacity: 1;\n            transform: scale(1);\n        }\n\n        input:checked + .option-ui .icon-box {\n            background-color: #0A3D62;\n            color: #FFFFFF;\n        }\n\n        /* Custom scrollbar hiding */\n        ::-webkit-scrollbar {\n            width: 0px;\n            background: transparent;\n        }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-50 bg-white\" data-kid=\"3\">\n        <div class=\"bg-[#0A3D62] text-white px-6 py-4 flex justify-between items-center\" data-kid=\"4\">\n            <div class=\"flex items-center gap-3\" data-kid=\"5\">\n                <div class=\"bg-[#27AE60] text-[11px] font-extrabold px-3 py-1.5 rounded-full flex items-center gap-2 uppercase tracking-widest shadow-md\" data-kid=\"6\">\n                    <i class=\"ti ti-gift text-sm\" data-kid=\"7\"></i> RÉCOMPENSE\n                </div>\n                <span class=\"text-sm font-bold font-['Plus_Jakarta_Sans'] tracking-tight\" data-kid=\"8\">Gagnez 2 500 FCFA</span>\n            </div>\n            <button class=\"w-8 h-8 flex items-center justify-center hover:bg-white/10 rounded-full transition-colors active:scale-90\" data-kid=\"9\">\n                <i class=\"ti ti-x text-xl\" data-kid=\"10\"></i>\n            </button>\n        </div>\n\n        \n        <div class=\"px-6 pt-5 pb-6 border-b border-[#E2E8F0] shadow-sm\" data-kid=\"11\">\n            <div class=\"flex justify-between items-center mb-3\" data-kid=\"12\">\n                <div class=\"flex flex-col\" data-kid=\"13\">\n                    <span id=\"current-step-label\" class=\"text-[11px] font-black text-[#0A3D62]/30 uppercase tracking-[0.2em] mb-0.5\" data-kid=\"14\">Étape 1 sur 3</span>\n                    <span id=\"category-label\" class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"15\">Catégories d'achat</span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"16\">\n                    <span id=\"progress-percent\" class=\"text-[11px] font-black text-[#27AE60] bg-[#27AE60]/10 px-3 py-1 rounded-full border border-[#27AE60]/20\" data-kid=\"17\">33%</span>\n                </div>\n            </div>\n            <div class=\"h-2.5 bg-slate-200 rounded-full overflow-hidden relative\" data-kid=\"18\">\n                <div id=\"progress-bar\" class=\"absolute left-0 top-0 h-full bg-[#F6A623] rounded-full transition-all duration-700 ease-out shadow-[0_0_12px_rgba(246,166,35,0.5)]\" style=\"width: 33.33%\" data-kid=\"19\"></div>\n            </div>\n        </div>\n    </header>\n\n    \n    <main class=\"flex-1 relative overflow-y-auto overflow-x-clip flex flex-col\" data-kid=\"20\">\n        <div id=\"question-container\" class=\"flex-1 flex flex-col p-6 pb-44\" data-kid=\"21\">\n            \n            <div id=\"q-loader\" class=\"flex-1 flex items-center justify-center\" data-kid=\"22\">\n                <div class=\"w-8 h-8 border-4 border-[#0A3D62]/20 border-t-[#0A3D62] rounded-full animate-spin\" data-kid=\"23\"></div>\n            </div>\n        </div>\n    </main>\n\n    \n    <div class=\"p-6 pb-8 bg-white/95 backdrop-blur-xl border-t border-[#E2E8F0] sticky bottom-0 z-40 shadow-[0_-10px_40px_-20px_rgba(0,0,0,0.1)] sm:rounded-b-[40px]\" data-kid=\"24\">\n        <div class=\"flex gap-3\" data-kid=\"25\">\n            <button id=\"prev-btn\" class=\"hidden h-16 px-5 border-2 border-[#E2E8F0] text-[#0A3D62] rounded-2xl font-black transition-all active:scale-90 flex items-center justify-center\" data-kid=\"26\">\n                <i class=\"ti ti-arrow-left text-2xl\" data-kid=\"27\"></i>\n            </button>\n            <button id=\"next-btn\" class=\"flex-1 h-16 bg-[#F6A623] hover:bg-[#F6A623] text-[#0A3D62] font-['Plus_Jakarta_Sans'] font-black text-[18px] rounded-2xl shadow-[0_12px_28px_-8px_rgba(246,166,35,0.6)] flex items-center justify-center gap-3 transition-all active:scale-[0.97]\" data-kid=\"28\">\n                <span data-kid=\"29\">Continuer</span>\n                <i class=\"ti ti-chevron-right text-2xl\" data-kid=\"30\"></i>\n            </button>\n        </div>\n        <div class=\"flex items-center justify-center gap-2 mt-5 opacity-40\" data-kid=\"31\">\n            <i class=\"ti ti-lock text-sm\" data-kid=\"32\"></i>\n            <p class=\"text-[11px] font-black uppercase tracking-[0.2em]\" data-kid=\"33\">Données chiffrées & Sécurisées</p>\n        </div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"34\"></script>\n    <script data-kid=\"35\">\n        const questions = [\n            {\n                id: 'q1',\n                tag: 'Catégories d\\'achat',\n                title: 'Quelles catégories vous intéressent le plus ?',\n                sub: 'Sélectionnez vos préférences d\\'achat.',\n                type: 'checkbox',\n                options: [\n                    { id: 'food', label: 'Alimentation', desc: 'Riz, huile, épicerie', icon: 'ti-tools-kitchen-2' },\n                    { id: 'tech', label: 'High-Tech', desc: 'Gadgets & Accessoires', icon: 'ti-device-mobile' },\n                    { id: 'home', label: 'Maison', desc: 'Entretien & Équipement', icon: 'ti-home-check' }\n                ]\n            },\n            {\n                id: 'q2',\n                tag: 'Habitudes',\n                title: 'Combien de fois achetez-vous en groupe ?',\n                sub: 'Choisissez l\\'option la plus proche.',\n                type: 'radio',\n                options: [\n                    { id: 'rare', label: 'Rarement', desc: 'Moins de 2 fois / mois', icon: 'ti-calendar-event' },\n                    { id: 'often', label: 'Régulièrement', desc: '2 à 5 fois / mois', icon: 'ti-calendar-stats' },\n                    { id: 'pro', label: 'Fréquemment', desc: 'Plus de 5 fois / mois', icon: 'ti-calendar-repeat' }\n                ]\n            },\n            {\n                id: 'q3',\n                tag: 'Notifications',\n                title: 'Recevoir les alertes de nouveaux produits ?',\n                sub: 'Ne ratez plus aucune opportunité.',\n                type: 'radio',\n                options: [\n                    { id: 'yes', label: 'Oui, j\\'adore !', desc: 'Alertes Push & WhatsApp', icon: 'ti-bell-ringing' },\n                    { id: 'no', label: 'Non, merci', desc: 'Je verrai sur l\\'app', icon: 'ti-bell-off' }\n                ]\n            }\n        ];\n\n        let currentStep = 0;\n        const container = document.getElementById('question-container');\n        const progressBar = document.getElementById('progress-bar');\n        const progressPercentText = document.getElementById('progress-percent');\n        const currentStepLabel = document.getElementById('current-step-label');\n        const categoryLabel = document.getElementById('category-label');\n        const nextBtn = document.getElementById('next-btn');\n        const prevBtn = document.getElementById('prev-btn');\n\n        function renderQuestion(index) {\n            const q = questions[index];\n            const checkIcon = q.type === 'checkbox' ? 'ti-check' : 'ti-circle-filled';\n            const checkShape = q.type === 'checkbox' ? 'rounded-lg' : 'rounded-full';\n            \n            const html = `\n                <div id=\"${q.id}\" class=\"question-card flex flex-col flex-1\">\n                    <div class=\"mb-8\">\n                        <h1 class=\"text-[28px] font-['Plus_Jakarta_Sans'] font-extrabold leading-[1.15] text-[#0A3D62] tracking-tight\">\n                            ${q.title}\n                        </h1>\n                        <p class=\"text-base text-[#0A3D62]/60 mt-3 font-medium\">${q.sub}</p>\n                    </div>\n\n                    <div class=\"space-y-4\">\n                        ${q.options.map((opt, i) => `\n                            <label class=\"block cursor-pointer option-card\">\n                                <input type=\"${q.type}\" class=\"peer hidden\" name=\"survey_opt\" value=\"${opt.id}\" ${i === 0 ? 'checked' : ''}>\n                                <div class=\"option-ui p-5 bg-white border-2 border-[#E2E8F0] rounded-2xl flex items-center gap-4 transition-all\">\n                                    <div class=\"icon-box w-16 h-16 shrink-0 bg-[#F5F7FA] rounded-2xl flex items-center justify-center text-[#0A3D62] transition-all\">\n                                        <i class=\"ti ${opt.icon} text-[36px]\"></i>\n                                    </div>\n                                    <div class=\"flex-1\">\n                                        <p class=\"font-extrabold text-[19px] text-[#0A3D62] leading-tight\">${opt.label}</p>\n                                        <p class=\"text-[14px] text-[#0A3D62]/50 font-semibold mt-1.5\">${opt.desc}</p>\n                                    </div>\n                                    <div class=\"check-box w-7 h-7 shrink-0 border-2 border-[#E2E8F0] ${checkShape} flex items-center justify-center transition-all\">\n                                        <i class=\"ti ${checkIcon} check-mark text-white text-base opacity-0 transition-all scale-50\"></i>\n                                    </div>\n                                </div>\n                            </label>\n                        `).join('')}\n                    </div>\n                </div>\n            `;\n            return html;\n        }\n\n        function updateUI() {\n            const q = questions[currentStep];\n            const progress = ((currentStep + 1) / questions.length) * 100;\n            progressBar.style.width = `${progress}%`;\n            progressPercentText.textContent = `${Math.round(progress)}%`;\n            currentStepLabel.textContent = `Étape ${currentStep + 1} sur ${questions.length}`;\n            categoryLabel.textContent = q.tag;\n\n            if (currentStep === 0) {\n                prevBtn.classList.add('hidden');\n            } else {\n                prevBtn.classList.remove('hidden');\n            }\n\n            if (currentStep === questions.length - 1) {\n                nextBtn.querySelector('span').textContent = 'Finaliser';\n            } else {\n                nextBtn.querySelector('span').textContent = 'Continuer';\n            }\n        }\n\n        nextBtn.addEventListener('click', () => {\n            if (currentStep < questions.length - 1) {\n                const currentView = container.querySelector('.question-card');\n                gsap.to(currentView, {\n                    x: -50,\n                    opacity: 0,\n                    duration: 0.3,\n                    ease: \"power2.in\",\n                    onComplete: () => {\n                        currentStep++;\n                        container.innerHTML = renderQuestion(currentStep);\n                        const nextView = container.querySelector('.question-card');\n                        gsap.from(nextView, {\n                            x: 50,\n                            opacity: 0,\n                            duration: 0.4,\n                            ease: \"back.out(1.2)\"\n                        });\n                        updateUI();\n                    }\n                });\n            } else {\n                showSuccess();\n            }\n        });\n\n        prevBtn.addEventListener('click', () => {\n            if (currentStep > 0) {\n                const currentView = container.querySelector('.question-card');\n                gsap.to(currentView, {\n                    x: 50,\n                    opacity: 0,\n                    duration: 0.3,\n                    ease: \"power2.in\",\n                    onComplete: () => {\n                        currentStep--;\n                        container.innerHTML = renderQuestion(currentStep);\n                        const prevView = container.querySelector('.question-card');\n                        gsap.from(prevView, {\n                            x: -50,\n                            opacity: 0,\n                            duration: 0.4,\n                            ease: \"back.out(1.2)\"\n                        });\n                        updateUI();\n                    }\n                });\n            }\n        });\n\n        function showSuccess() {\n            gsap.to(container, {\n                opacity: 0,\n                duration: 0.3,\n                onComplete: () => {\n                    container.innerHTML = `\n                        <div class=\"flex-1 flex flex-col items-center justify-center text-center px-4 py-12\">\n                            <div class=\"w-28 h-28 bg-[#27AE60] text-white rounded-full flex items-center justify-center mb-10 shadow-[0_20px_40px_-10px_rgba(39,174,96,0.5)] border-4 border-white\">\n                                <i class=\"ti ti-check text-[60px]\"></i>\n                            </div>\n                            <h2 class=\"text-[34px] font-black font-['Plus_Jakarta_Sans'] text-[#0A3D62] leading-tight mb-4\">Parfait !</h2>\n                            <p class=\"text-[#0A3D62]/60 font-bold text-lg max-w-[280px] mx-auto leading-relaxed\">\n                                <span class=\"text-[#27AE60]\">2 500 FCFA</span> ont été ajoutés à votre portefeuille.\n                            </p>\n                            <div class=\"mt-12 w-full space-y-4\">\n                                <button class=\"w-full h-16 bg-[#0A3D62] text-white font-black rounded-2xl shadow-xl active:scale-[0.97] transition-all flex items-center justify-center gap-3\">\n                                    Voir mon portefeuille\n                                    <i class=\"ti ti-wallet text-xl\"></i>\n                                </button>\n                                <button class=\"w-full h-16 border-2 border-[#E2E8F0] text-[#0A3D62] font-black rounded-2xl active:scale-[0.97] transition-all\">\n                                    Retour à l'accueil\n                                </button>\n                            </div>\n                        </div>\n                    `;\n                    gsap.from(container, { opacity: 0, y: 30, scale: 0.9, duration: 0.6 });\n                    document.querySelector('header').style.display = 'none';\n                    document.querySelector('.sticky.bottom-0').style.display = 'none';\n                }\n            });\n        }\n\n        // Init\n        window.addEventListener('load', () => {\n            container.innerHTML = renderQuestion(0);\n            updateUI();\n            gsap.from('.question-card', { opacity: 0, y: 20, duration: 0.6 });\n        });\n    </script>\n</section>\n</div>\n",
      "comments": [],
      "created": "2026-07-10T23:39:36.024714+00:00",
      "modified": "2026-07-10T23:39:36.024714+00:00",
      "id": "var_a9b09d586be9"
    },
    "var_de2976e411b0": {
      "type": "variant",
      "label": "History (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 18165,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div class=\"min-h-screen bg-[#F5F7FA] pb-32 font-['Be_Vietnam_Pro'] relative overflow-x-clip\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n        :root {\n            --primary: #0A3D62;\n            --accent: #F6A623;\n            --success: #27AE60;\n            --urgency: #E74C3C;\n            --bg-light: #F5F7FA;\n            --border-gray: #E2E8F0;\n        }\n\n        .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n        .no-scrollbar::-webkit-scrollbar { display: none; }\n        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n        /* Animation targeting */\n        .history-card { opacity: 1; } /* We will use animate() which handles visibility */\n    </style>\n    \n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"2\">\n\n    \n    <header class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[#E2E8F0] px-6 pt-10 pb-4\" data-kid=\"3\">\n        <div class=\"flex items-center justify-between mb-6\" data-kid=\"4\">\n            <div class=\"flex items-center gap-3\" data-kid=\"5\">\n                <button class=\"w-10 h-10 rounded-full bg-[#F5F7FA] flex items-center justify-center text-[#0A3D62] border border-[#E2E8F0] active:scale-90 transition-transform\" id=\"btn-back\" data-kid=\"6\">\n                    <i class=\"ti ti-chevron-left text-xl\" data-kid=\"7\"></i>\n                </button>\n                <h1 class=\"font-plus text-xl font-extrabold tracking-tight text-[#0A3D62]\" data-kid=\"8\">Historique</h1>\n            </div>\n            <div class=\"flex flex-col items-end\" data-kid=\"9\">\n                <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"10\">Solde Wallet</span>\n                <span class=\"font-plus text-lg font-extrabold text-[#0A3D62]\" data-kid=\"11\">42,500 <span class=\"text-xs font-bold text-gray-400\" data-kid=\"12\">FCFA</span></span>\n            </div>\n        </div>\n\n        \n        <nav class=\"flex overflow-x-auto no-scrollbar gap-2 pb-1\" data-kid=\"13\">\n            <button class=\"px-5 py-2 rounded-full text-xs font-bold bg-[#0A3D62] text-white whitespace-nowrap shadow-md\" data-kid=\"14\">Tout</button>\n            <button class=\"px-5 py-2 rounded-full text-xs font-bold bg-white text-[#0A3D62] border-2 border-[#E2E8F0] whitespace-nowrap\" data-kid=\"15\">En cours</button>\n            <button class=\"px-5 py-2 rounded-full text-xs font-bold bg-white text-[#0A3D62] border-2 border-[#E2E8F0] whitespace-nowrap\" data-kid=\"16\">Validés</button>\n            <button class=\"px-5 py-2 rounded-full text-xs font-bold bg-white text-[#0A3D62] border-2 border-[#E2E8F0] whitespace-nowrap\" data-kid=\"17\">Remboursés</button>\n        </nav>\n    </header>\n\n    \n    <main class=\"px-6 py-6 space-y-4\" id=\"history-list\" data-kid=\"18\">\n        \n        \n        <div class=\"history-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#0A3D62] p-4 flex items-center relative shadow-sm cursor-pointer group\" data-status=\"EN_COURS\" data-kid=\"19\">\n            <div class=\"w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[#F5F7FA] border border-[#E2E8F0]\" data-kid=\"20\">\n                <img src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=256&q=80&fit=crop\" alt=\"Wax\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"21\">\n            </div>\n            <div class=\"ml-4 flex-1 pr-14\" data-kid=\"22\">\n                <h3 class=\"text-[#0A3D62] font-bold text-sm leading-snug group-hover:text-[#F6A623] transition-colors\" data-kid=\"23\">Pagne Africain Wax Premium</h3>\n                <p class=\"text-[10px] text-gray-400 mt-1 flex items-center gap-1\" data-kid=\"24\">\n                    <i class=\"ti ti-calendar-event text-xs\" data-kid=\"25\"></i> 18 Fév 2024 • 14:20\n                </p>\n                <div class=\"flex items-baseline gap-1 mt-2\" data-kid=\"26\">\n                    <span class=\"font-plus text-base font-extrabold text-[#0A3D62]\" data-kid=\"27\">35,000</span>\n                    <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"28\">FCFA</span>\n                </div>\n            </div>\n            <span class=\"absolute top-4 right-4 bg-[#0A3D62]/10 text-[#0A3D62] text-[9px] font-black px-2 py-0.5 rounded-full border border-[#0A3D62]/20 uppercase\" data-kid=\"29\">En cours</span>\n        </div>\n\n        \n        <div class=\"history-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#27AE60] p-4 flex items-center relative shadow-sm cursor-pointer group\" data-status=\"VALIDE\" data-kid=\"30\">\n            <div class=\"w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[#F5F7FA] border border-[#E2E8F0]\" data-kid=\"31\">\n                <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=256&q=80&fit=crop\" alt=\"Sac\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n            </div>\n            <div class=\"ml-4 flex-1 pr-14\" data-kid=\"33\">\n                <h3 class=\"text-[#0A3D62] font-bold text-sm leading-snug\" data-kid=\"34\">Lot de Sacs en Raphia</h3>\n                <p class=\"text-[10px] text-gray-400 mt-1 flex items-center gap-1\" data-kid=\"35\">\n                    <i class=\"ti ti-calendar-event text-xs\" data-kid=\"36\"></i> 15 Fév 2024 • 09:45\n                </p>\n                <div class=\"flex items-baseline gap-1 mt-2\" data-kid=\"37\">\n                    <span class=\"font-plus text-base font-extrabold text-[#27AE60]\" data-kid=\"38\">12,500</span>\n                    <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"39\">FCFA</span>\n                </div>\n            </div>\n            <span class=\"absolute top-4 right-4 bg-[#27AE60]/10 text-[#27AE60] text-[9px] font-black px-2 py-0.5 rounded-full border border-[#27AE60]/20 uppercase\" data-kid=\"40\">Validé</span>\n        </div>\n\n        \n        <div class=\"history-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#F6A623] p-4 flex items-center relative shadow-sm cursor-pointer group\" data-status=\"REMBOURSE\" data-kid=\"41\">\n            <div class=\"w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[#F5F7FA] border border-[#E2E8F0]\" data-kid=\"42\">\n                <img src=\"https://images.unsplash.com/photo-1730793295617-375689a1df3f?auto=format&w=256&q=80&fit=crop\" alt=\"Bronze\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"43\">\n            </div>\n            <div class=\"ml-4 flex-1 pr-14\" data-kid=\"44\">\n                <h3 class=\"text-[#0A3D62] font-bold text-sm leading-snug\" data-kid=\"45\">Sculpture Girafe Bronze</h3>\n                <p class=\"text-[10px] text-gray-400 mt-1 flex items-center gap-1\" data-kid=\"46\">\n                    <i class=\"ti ti-calendar-event text-xs\" data-kid=\"47\"></i> 10 Fév 2024 • 16:30\n                </p>\n                <div class=\"flex items-center gap-2 mt-2\" data-kid=\"48\">\n                    <span class=\"font-plus text-base font-extrabold text-[#F6A623]\" data-kid=\"49\">Remboursé</span>\n                    <span class=\"text-[10px] font-medium text-gray-400 line-through\" data-kid=\"50\">45k FCFA</span>\n                </div>\n            </div>\n            <span class=\"absolute top-4 right-4 bg-[#F6A623]/10 text-[#F6A623] text-[9px] font-black px-2 py-0.5 rounded-full border border-[#F6A623]/20 uppercase\" data-kid=\"51\">Remboursé</span>\n        </div>\n\n        \n        <div class=\"history-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#E74C3C] p-4 flex items-center relative shadow-sm cursor-pointer group\" data-status=\"ANNULE\" data-kid=\"52\">\n            <div class=\"w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[#F5F7FA] border border-[#E2E8F0] grayscale opacity-50\" data-kid=\"53\">\n                <img src=\"https://images.pexels.com/photos/34143550/pexels-photo-34143550.jpeg?auto=compress&cs=tinysrgb&w=256&q=80\" alt=\"Dried red\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"54\">\n            </div>\n            <div class=\"ml-4 flex-1 pr-14\" data-kid=\"55\">\n                <h3 class=\"text-[#0A3D62] font-bold text-sm leading-snug opacity-60\" data-kid=\"56\">Épices Marché Adawlato</h3>\n                <p class=\"text-[10px] text-gray-400 mt-1 flex items-center gap-1 opacity-60\" data-kid=\"57\">\n                    <i class=\"ti ti-calendar-event text-xs\" data-kid=\"58\"></i> 05 Fév 2024 • 11:15\n                </p>\n                <div class=\"mt-2\" data-kid=\"59\">\n                    <span class=\"font-plus text-base font-extrabold text-[#E74C3C] opacity-80 tracking-tight uppercase\" data-kid=\"60\">Annulé</span>\n                </div>\n            </div>\n            <span class=\"absolute top-4 right-4 bg-[#E74C3C]/10 text-[#E74C3C] text-[9px] font-black px-2 py-0.5 rounded-full border border-[#E74C3C]/20 uppercase\" data-kid=\"61\">Annulé</span>\n        </div>\n\n        \n        <div class=\"history-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#0A3D62] p-4 flex items-center relative shadow-sm cursor-pointer group\" data-status=\"EN_COURS\" data-kid=\"62\">\n            <div class=\"w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-[#F5F7FA] border border-[#E2E8F0]\" data-kid=\"63\">\n                <img src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=256&q=80&fit=crop\" alt=\"Pattern\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"64\">\n            </div>\n            <div class=\"ml-4 flex-1 pr-14\" data-kid=\"65\">\n                <h3 class=\"text-[#0A3D62] font-bold text-sm leading-snug group-hover:text-[#F6A623] transition-colors\" data-kid=\"66\">Tissu Kente Traditionnel</h3>\n                <p class=\"text-[10px] text-gray-400 mt-1 flex items-center gap-1\" data-kid=\"67\">\n                    <i class=\"ti ti-calendar-event text-xs\" data-kid=\"68\"></i> 02 Fév 2024 • 18:05\n                </p>\n                <div class=\"flex items-baseline gap-1 mt-2\" data-kid=\"69\">\n                    <span class=\"font-plus text-base font-extrabold text-[#0A3D62]\" data-kid=\"70\">55,000</span>\n                    <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"71\">FCFA</span>\n                </div>\n            </div>\n            <span class=\"absolute top-4 right-4 bg-[#0A3D62]/10 text-[#0A3D62] text-[9px] font-black px-2 py-0.5 rounded-full border border-[#0A3D62]/20 uppercase\" data-kid=\"72\">En cours</span>\n        </div>\n    </main>\n\n    \n    <div class=\"h-20\" data-kid=\"73\"></div>\n\n    \n    <footer class=\"fixed bottom-0 left-0 w-full bg-white/95 backdrop-blur-md border-t border-[#E2E8F0] z-50\" data-kid=\"74\">\n        <div class=\"flex items-end justify-around h-20 px-2 relative max-w-md mx-auto\" data-kid=\"75\">\n            <div class=\"flex flex-col items-center justify-center gap-1 text-gray-400 flex-1 py-3 cursor-pointer group\" data-kid=\"76\">\n                <i class=\"ti ti-smart-home text-2xl group-hover:text-[#0A3D62] transition-colors\" data-kid=\"77\"></i>\n                <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"78\">Accueil</span>\n            </div>\n            <div class=\"flex flex-col items-center justify-center gap-1 text-gray-400 flex-1 py-3 cursor-pointer group\" data-kid=\"79\">\n                <i class=\"ti ti-clipboard-list text-2xl group-hover:text-[#0A3D62] transition-colors\" data-kid=\"80\"></i>\n                <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"81\">Sondages</span>\n            </div>\n            \n            \n            <div class=\"flex-1 relative flex flex-col items-center justify-end h-full pb-2\" data-kid=\"82\">\n                <div class=\"absolute -top-6 w-14 h-14 bg-[#0A3D62] rounded-full border-4 border-white shadow-xl flex items-center justify-center text-white cursor-pointer active:scale-90 transition-transform\" data-kid=\"83\">\n                    <i class=\"ti ti-shopping-bag text-2xl\" data-kid=\"84\"></i>\n                </div>\n                <span class=\"text-[9px] font-black text-[#0A3D62] uppercase tracking-wider\" data-kid=\"85\">Achats</span>\n                <div class=\"w-1 h-1 bg-[#F6A623] rounded-full mt-0.5\" data-kid=\"86\"></div>\n            </div>\n\n            <div class=\"flex flex-col items-center justify-center gap-1 text-gray-400 flex-1 py-3 cursor-pointer group\" data-kid=\"87\">\n                <i class=\"ti ti-wallet text-2xl group-hover:text-[#0A3D62] transition-colors\" data-kid=\"88\"></i>\n                <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"89\">Wallet</span>\n            </div>\n            <div class=\"flex flex-col items-center justify-center gap-1 text-gray-400 flex-1 py-3 cursor-pointer group\" data-kid=\"90\">\n                <i class=\"ti ti-user text-2xl group-hover:text-[#0A3D62] transition-colors\" data-kid=\"91\"></i>\n                <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"92\">Profil</span>\n            </div>\n        </div>\n    </footer>\n\n    \n    <script type=\"module\" data-kid=\"93\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        import Snap from \"https://esm.sh/lenis@1/snap\"\n        import { animate, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // Initialize Lenis\n        const lenis = new Lenis({\n            autoRaf: true,\n            lerp: 0.1,\n            smoothWheel: true,\n            touchMultiplier: 1.5\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // Stagger Entrance Animation\n        inView(\"#history-list\", () => {\n            animate(\".history-card\", \n                { opacity: [0, 1], y: [30, 0] }, \n                { delay: stagger(0.08), duration: 0.6, easing: [0.22, 1, 0.36, 1] }\n            );\n        });\n\n        // Press Feedback\n        const items = document.querySelectorAll('.history-card, button, footer > div');\n        items.forEach(el => {\n            el.addEventListener('pointerdown', () => {\n                animate(el, { scale: 0.96 }, { duration: 0.1 });\n            });\n            el.addEventListener('pointerup', () => {\n                animate(el, { scale: 1 }, { duration: 0.15 });\n            });\n            el.addEventListener('pointercancel', () => {\n                animate(el, { scale: 1 }, { duration: 0.15 });\n            });\n        });\n\n        // Tab selection visual logic\n        const navPills = document.querySelectorAll('nav button');\n        navPills.forEach(pill => {\n            pill.addEventListener('click', () => {\n                navPills.forEach(p => {\n                    p.classList.remove('bg-[#0A3D62]', 'text-white', 'shadow-md');\n                    p.classList.add('bg-white', 'text-[#0A3D62]', 'border-2', 'border-[#E2E8F0]');\n                });\n                pill.classList.add('bg-[#0A3D62]', 'text-white', 'shadow-md');\n                pill.classList.remove('bg-white', 'text-[#0A3D62]', 'border-2', 'border-[#E2E8F0]');\n            });\n        });\n    </script>\n</div>\n",
