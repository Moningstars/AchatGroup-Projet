      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --color-navy: #0A3D62;\n        --color-orange: #F6A623;\n        --color-bg: #F8FAFC;\n        --color-border: #E2E8F0;\n        --color-green: #10B981;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        font-family: 'Be Vietnam Pro', sans-serif;\n        background-color: #f1f3f6;\n    }\n\n    .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n    .shadow-premium {\n        box-shadow: 0 20px 50px -12px rgba(10, 61, 98, 0.15);\n    }\n\n    .input-active {\n        border-color: var(--color-navy);\n        box-shadow: 0 0 0 4px rgba(10, 61, 98, 0.05);\n    }\n\n    .otp-input:focus {\n        border-color: var(--color-orange);\n        box-shadow: 0 0 0 4px rgba(246, 166, 35, 0.1);\n        transform: translateY(-2px);\n    }\n\n    /* Step animations classes */\n    .step-content {\n        transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);\n    }\n\n    .glass-effect {\n        background: rgba(255, 255, 255, 0.1);\n        backdrop-filter: blur(8px);\n        border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n</style>\n<div class=\"max-w-[375px] mx-auto min-h-screen bg-white relative overflow-x-clip flex flex-col\" data-kid=\"1\" data-name=\"mobile app layout container\" id=\"app-container\">\n\n<header class=\"h-[32vh] bg-[var(--color-navy)] relative overflow-hidden flex flex-col items-center justify-center px-8 text-white\" data-kid=\"1-1\" data-name=\"header branding section\">\n\n<div class=\"absolute -top-12 -left-12 w-64 h-64 bg-white/5 rounded-full blur-3xl animate-pulse\" data-kid=\"1-1-1\" data-name=\"floating pulse background shape\"></div>\n<div class=\"absolute -bottom-16 -right-16 w-72 h-72 bg-[var(--color-orange)]/10 rounded-full blur-3xl\" data-kid=\"1-1-2\" data-name=\"floating background shape\"></div>\n<div class=\"absolute top-8 left-8 flex items-center gap-3\" data-kid=\"1-1-3\" data-name=\"brand logo container\" id=\"brand-logo\">\n<div class=\"w-10 h-10 bg-[var(--color-orange)] rounded-2xl flex items-center justify-center shadow-xl shadow-orange-500/20\" data-kid=\"1-1-3-1\" data-name=\"shield icon container\">\n<i class=\"ti ti-shield-check text-[var(--color-navy)] text-2xl\" data-kid=\"1-1-3-1-1\" data-name=\"shield check icon\"></i>\n</div>\n<span class=\"font-jakarta font-extrabold text-xl tracking-tight\" data-kid=\"1-1-3-2\" data-name=\"brand name text\">OpportuniHub</span>\n</div>\n<div class=\"z-10 text-center mt-8 space-y-3\" data-kid=\"1-1-4\" data-name=\"hero text section\" id=\"hero-text\">\n<h1 class=\"font-jakarta text-4xl font-extrabold leading-tight\" data-kid=\"1-1-4-1\" data-name=\"hero headline text\">\n                Puissance <br data-kid=\"1-1-4-1-1\" data-name=\"headline line break\">\n<span class=\"text-[var(--color-orange)]\" data-kid=\"1-1-4-1-2\" data-name=\"highlighted headline text\">Collective.</span>\n</h1>\n<p class=\"text-white/60 text-sm max-w-[260px] mx-auto leading-relaxed\" data-kid=\"1-1-4-2\" data-name=\"hero description text\">\n                Accédez aux meilleures offres groupées d'Afrique de l'Ouest.\n            </p>\n</div>\n</header>\n\n<main class=\"relative flex-1 -mt-10 bg-white rounded-t-[44px] shadow-premium z-20 overflow-hidden flex flex-col\" data-kid=\"1-2\" data-name=\"main content card\">\n\n<div class=\"flex w-[200%] h-full transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"steps scroller container\" data-reason=\"container transform updated by click navigation\" id=\"steps-scroller\">\n\n<div class=\"w-1/2 p-8 pt-12 flex flex-col\" data-kid=\"1-2-1-1\" data-name=\"login step container\" id=\"step-1\">\n<div class=\"space-y-1 mb-10 stagger-item\" data-kid=\"1-2-1-1-1\" data-name=\"login step title container\">\n<h2 class=\"font-jakarta text-2xl font-extrabold text-[var(--color-navy)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"connexion title text\">Connexion</h2>\n<p class=\"text-slate-500 text-sm\" data-kid=\"1-2-1-1-1-2\" data-name=\"login step subtitle text\">Entrez votre numéro pour continuer</p>\n</div>\n<div class=\"space-y-8 flex-1\" data-kid=\"1-2-1-1-2\" data-name=\"login input container\">\n\n<div class=\"space-y-2 stagger-item\" data-kid=\"1-2-1-1-2-1\" data-name=\"phone number input field container\">\n<label class=\"text-[10px] font-bold text-[var(--color-navy)] uppercase tracking-[0.2em] opacity-60 ml-1\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"phone label text\">Numéro de téléphone</label>\n<div class=\"flex items-center bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden focus-within:border-[var(--color-navy)] focus-within:ring-4 focus-within:ring-navy-900/5 transition-all duration-300\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"phone input wrapper\">\n<div class=\"relative\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"country code picker container\">\n<button class=\"flex items-center gap-2 px-4 py-5 hover:bg-slate-100 transition-colors border-r border-slate-200\" data-kid=\"1-2-1-1-2-1-2-1-1\" data-name=\"country toggle button\" id=\"country-toggle\">\n<span class=\"text-xl\" data-kid=\"1-2-1-1-2-1-2-1-1-1\" data-name=\"country flag emoji\">🇹🇬</span>\n<span class=\"font-bold text-[var(--color-navy)]\" data-kid=\"1-2-1-1-2-1-2-1-1-2\" data-name=\"country code text\">+228</span>\n<i class=\"ti ti-chevron-down text-slate-400 text-xs\" data-kid=\"1-2-1-1-2-1-2-1-1-3\" data-name=\"chevron icon\"></i>\n</button>\n\n<div class=\"absolute top-full left-0 mt-2 w-56 bg-white rounded-2xl shadow-2xl z-50 overflow-hidden opacity-0 pointer-events-none translate-y-2 transition-all duration-200 border border-slate-100\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-1-2\" data-name=\"country dropdown menu\" data-reason=\"visibility and styles modified by click listener\" id=\"country-menu\">\n<button class=\"w-full flex items-center gap-3 p-4 hover:bg-slate-50 transition-colors border-b border-slate-50\" data-kid=\"1-2-1-1-2-1-2-1-2-1\" data-name=\"togo country option\">\n<span class=\"text-xl\" data-kid=\"1-2-1-1-2-1-2-1-2-1-1\" data-name=\"togo flag emoji\">🇹🇬</span>\n<div class=\"text-left\" data-kid=\"1-2-1-1-2-1-2-1-2-1-2\" data-name=\"togo text container\">\n<div class=\"text-sm font-bold text-[var(--color-navy)]\" data-kid=\"1-2-1-1-2-1-2-1-2-1-2-1\" data-name=\"togo label\">Togo</div>\n<div class=\"text-xs text-slate-400\" data-kid=\"1-2-1-1-2-1-2-1-2-1-2-2\" data-name=\"togo code\">+228</div>\n</div>\n</button>\n<button class=\"w-full flex items-center gap-3 p-4 hover:bg-slate-50 transition-colors\" data-kid=\"1-2-1-1-2-1-2-1-2-2\" data-name=\"benin country option\">\n<span class=\"text-xl\" data-kid=\"1-2-1-1-2-1-2-1-2-2-1\" data-name=\"benin flag emoji\">🇧🇯</span>\n<div class=\"text-left\" data-kid=\"1-2-1-1-2-1-2-1-2-2-2\" data-name=\"benin text container\">\n<div class=\"text-sm font-bold text-[var(--color-navy)]\" data-kid=\"1-2-1-1-2-1-2-1-2-2-2-1\" data-name=\"benin label\">Bénin</div>\n<div class=\"text-xs text-slate-400\" data-kid=\"1-2-1-1-2-1-2-1-2-2-2-2\" data-name=\"benin code\">+229</div>\n</div>\n</button>\n</div>\n</div>\n<input class=\"flex-1 bg-transparent px-5 py-5 text-lg font-bold text-[var(--color-navy)] placeholder:text-slate-300 focus:outline-none\" data-kid=\"1-2-1-1-2-1-2-2\" data-name=\"phone input field\" placeholder=\"90 00 00 00\" type=\"tel\">\n</div>\n</div>\n<div class=\"space-y-6 stagger-item\" data-kid=\"1-2-1-1-2-2\" data-name=\"footer actions container\">\n<button class=\"w-full bg-[var(--color-navy)] text-white font-jakarta font-bold py-5 rounded-2xl shadow-xl shadow-navy-900/10 flex items-center justify-center gap-3 hover:bg-navy-800 active:scale-95 transition-all group\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"continue button\" id=\"next-btn\">\n<span data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"continue button text\">Continuer</span>\n<i class=\"ti ti-arrow-right text-lg group-hover:translate-x-1 transition-transform\" data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"arrow right icon\"></i>\n</button>\n<div class=\"text-center space-y-5\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"legal and security container\">\n<p class=\"text-[11px] text-slate-400 leading-relaxed px-4\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"legal text\">\n                                En continuant, vous acceptez nos <a class=\"text-[var(--color-navy)] font-bold hover:underline\" data-kid=\"1-2-1-1-2-2-2-1-1\" data-name=\"terms link\" href=\"#\">Conditions</a> et notre <a class=\"text-[var(--color-navy)] font-bold hover:underline\" data-kid=\"1-2-1-1-2-2-2-1-2\" data-name=\"privacy policy link\" href=\"#\">Politique de Confidentialité</a>.\n                            </p>\n\n<div class=\"inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-100 shadow-sm\" data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"security badge container\">\n<div class=\"w-2 h-2 bg-emerald-500 rounded-full animate-pulse\" data-kid=\"1-2-1-1-2-2-2-2-1\" data-name=\"security pulse indicator\"></div>\n<span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"1-2-1-1-2-2-2-2-2\" data-name=\"security badge text\">Connexion Sécurisée par OTP</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"w-1/2 p-8 pt-12 flex flex-col\" data-kid=\"1-2-1-2\" data-name=\"otp verification step container\" id=\"step-2\">\n<div class=\"flex items-center gap-4 mb-10\" data-kid=\"1-2-1-2-1\" data-name=\"verification header container\">\n<button class=\"w-11 h-11 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-[var(--color-navy)] shadow-sm active:scale-90 transition-transform\" data-kid=\"1-2-1-2-1-1\" data-name=\"back button\" id=\"back-btn\">\n<i class=\"ti ti-arrow-left text-xl\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"arrow left icon\"></i>\n</button>\n<div data-kid=\"1-2-1-2-1-2\" data-name=\"verification title container\">\n<h2 class=\"font-jakarta text-2xl font-extrabold text-[var(--color-navy)]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"verification title text\">Vérification</h2>\n<p class=\"text-slate-500 text-xs font-medium\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"verification subtitle text\">Code envoyé au <span class=\"text-[var(--color-navy)] font-bold\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"phone masked text\">+228 90 •• •• 12</span></p>\n</div>\n</div>\n<div class=\"space-y-10 flex-1\" data-kid=\"1-2-1-2-2\" data-name=\"verification input action container\">\n\n<div class=\"grid grid-cols-6 gap-2\" data-kid=\"1-2-1-2-2-1\" data-name=\"otp input grid\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"otp character input 1\" maxlength=\"1\" type=\"text\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"otp character input 2\" maxlength=\"1\" type=\"text\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"otp character input 3\" maxlength=\"1\" type=\"text\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-4\" data-name=\"otp character input 4\" maxlength=\"1\" type=\"text\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-5\" data-name=\"otp character input 5\" maxlength=\"1\" type=\"text\">\n<input class=\"otp-input w-full aspect-[3/4] bg-slate-50 border border-slate-200 rounded-xl text-center text-xl font-extrabold text-[var(--color-navy)] outline-none transition-all focus:border-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-1-6\" data-name=\"otp character input 6\" maxlength=\"1\" type=\"text\">\n</div>\n<div class=\"space-y-6\" data-kid=\"1-2-1-2-2-2\" data-name=\"verify action container\">\n<button class=\"w-full bg-[var(--color-navy)] text-white font-jakarta font-bold py-5 rounded-2xl shadow-xl shadow-navy-900/10 flex items-center justify-center gap-3 active:scale-95 transition-all\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"verify button\">\n<span data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"verify button text\">Vérifier le code</span>\n<i class=\"ti ti-circle-check text-lg\" data-kid=\"1-2-1-2-2-2-1-2\" data-name=\"check icon\"></i>\n</button>\n<div class=\"text-center\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"resend code container\">\n<button class=\"group inline-flex flex-col items-center gap-1\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"resend button\">\n<span class=\"text-sm font-bold text-[var(--color-orange)]\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"resend text\">Renvoyer le code</span>\n<span class=\"text-[10px] font-medium text-slate-400 uppercase tracking-widest group-hover:text-slate-500 transition-colors\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"resend cooldown timer\">Disponible dans 45s</span>\n</button>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"pb-10 flex justify-center gap-2\" data-kid=\"1-2-2\" data-name=\"pagination indicator container\">\n<div class=\"h-2 w-8 bg-[var(--color-orange)] rounded-full transition-all duration-500\" data-dynamic=\"true\" data-kid=\"1-2-2-1\" data-name=\"pagination dot 1\" data-reason=\"class names updated by navigation logic\" id=\"dot-1\"></div>\n<div class=\"h-2 w-2 bg-slate-200 rounded-full transition-all duration-500\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"pagination dot 2\" data-reason=\"class names updated by navigation logic\" id=\"dot-2\"></div>\n</div>\n</main>\n\n<div class=\"fixed bottom-4 right-4 z-50 flex flex-col gap-2 scale-75 origin-bottom-right\" data-kid=\"1-3\" data-name=\"style switcher container\">\n<button class=\"w-10 h-10 rounded-full bg-white shadow-lg flex items-center justify-center text-slate-400 hover:text-navy-900 transition-colors border border-slate-100\" data-kid=\"1-3-1\" data-name=\"classic style button\" onclick=\"changeVariant('classic')\" title=\"Classic Refined\">\n<i class=\"ti ti-palette\" data-kid=\"1-3-1-1\" data-name=\"palette icon\"></i>\n</button>\n<button class=\"w-10 h-10 rounded-full bg-white shadow-lg flex items-center justify-center text-slate-400 hover:text-navy-900 transition-colors border border-slate-100\" data-kid=\"1-3-2\" data-name=\"soft style button\" onclick=\"changeVariant('soft')\" title=\"Soft Modern\">\n<i class=\"ti ti-leaf\" data-kid=\"1-3-2-1\" data-name=\"leaf icon\"></i>\n</button>\n<button class=\"w-10 h-10 rounded-full bg-white shadow-lg flex items-center justify-center text-slate-400 hover:text-navy-900 transition-colors border border-slate-100\" data-kid=\"1-3-3\" data-name=\"dark style button\" onclick=\"changeVariant('dark')\" title=\"Tech Tech\">\n<i class=\"ti ti-cpu\" data-kid=\"1-3-3-1\" data-name=\"cpu icon\"></i>\n</button>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script data-kid=\"3\">\n    // Navigation Logic\n    const nextBtn = document.getElementById('next-btn');\n    const backBtn = document.getElementById('back-btn');\n    const scroller = document.getElementById('steps-scroller');\n    const dot1 = document.getElementById('dot-1');\n    const dot2 = document.getElementById('dot-2');\n\n    nextBtn.addEventListener('click', () => {\n        gsap.to(scroller, { x: '-50%', duration: 0.8, ease: 'power4.inOut' });\n        dot1.className = 'h-2 w-2 bg-slate-200 rounded-full transition-all duration-500';\n        dot2.className = 'h-2 w-8 bg-[var(--color-orange)] rounded-full transition-all duration-500';\n        \n        // Staggered entry for step 2\n        gsap.from('#step-2 > div', {\n            opacity: 0,\n            y: 20,\n            duration: 0.6,\n            stagger: 0.1,\n            ease: 'power2.out',\n            delay: 0.3\n        });\n    });\n\n    backBtn.addEventListener('click', () => {\n        gsap.to(scroller, { x: '0%', duration: 0.8, ease: 'power4.inOut' });\n        dot1.className = 'h-2 w-8 bg-[var(--color-orange)] rounded-full transition-all duration-500';\n        dot2.className = 'h-2 w-2 bg-slate-200 rounded-full transition-all duration-500';\n    });\n\n    // Country Dropdown\n    const toggle = document.getElementById('country-toggle');\n    const menu = document.getElementById('country-menu');\n    \n    toggle.addEventListener('click', (e) => {\n        e.stopPropagation();\n        const isOpen = !menu.classList.contains('opacity-0');\n        if(isOpen) {\n            gsap.to(menu, { opacity: 0, y: 10, duration: 0.2, pointerEvents: 'none' });\n        } else {\n            menu.classList.remove('pointer-events-none');\n            gsap.to(menu, { opacity: 1, y: 0, duration: 0.3, ease: 'back.out(1.7)' });\n        }\n    });\n\n    document.addEventListener('click', () => {\n        gsap.to(menu, { opacity: 0, y: 10, duration: 0.2, pointerEvents: 'none' });\n    });\n\n    // OTP Auto-focus\n    const otpInputs = document.querySelectorAll('.otp-input');\n    otpInputs.forEach((input, index) => {\n        input.addEventListener('keyup', (e) => {\n            if(e.key >= 0 && e.key <= 9) {\n                if(index < otpInputs.length - 1) otpInputs[index + 1].focus();\n            } else if(e.key === 'Backspace') {\n                if(index > 0) otpInputs[index - 1].focus();\n            }\n        });\n    });\n\n    // Entrance Animations\n    window.addEventListener('load', () => {\n        const tl = gsap.timeline();\n        tl.from('#brand-logo', { opacity: 0, x: -20, duration: 0.8, ease: 'power3.out' })\n          .from('#hero-text > *', { opacity: 0, y: 20, stagger: 0.2, duration: 0.8, ease: 'power3.out' }, \"-=0.4\")\n          .from('main', { y: 100, opacity: 0, duration: 1, ease: 'power4.out' }, \"-=0.6\")\n          .from('.stagger-item', { opacity: 0, y: 20, stagger: 0.1, duration: 0.6, ease: 'power2.out' }, \"-=0.4\");\n    });\n\n    // Variant logic\n    function changeVariant(type) {\n        const main = document.querySelector('main');\n        const header = document.querySelector('header');\n        \n        if(type === 'soft') {\n            main.className = main.className.replace(/rounded-t-\\[.*?\\]/, 'rounded-t-[60px]');\n            gsap.to('main', { backgroundColor: '#ffffff', duration: 0.5 });\n            gsap.to(':root', { '--color-navy': '#1e293b', duration: 0.5 });\n        } else if (type === 'dark') {\n            main.className = main.className.replace(/rounded-t-\\[.*?\\]/, 'rounded-t-none');\n            gsap.to('main', { backgroundColor: '#fdfdfd', duration: 0.5 });\n            gsap.to(':root', { '--color-navy': '#0f172a', duration: 0.5 });\n        } else {\n            main.className = main.className.replace(/rounded-t-\\[.*?\\]/, 'rounded-t-[44px]');\n            gsap.to(':root', { '--color-navy': '#0A3D62', duration: 0.5 });\n        }\n    }\n</script>\n",
      "comments": [],
      "created": "2026-07-12T23:45:31.668439+00:00",
      "modified": "2026-07-12T23:45:31.668439+00:00",
      "id": "var_0ba97da86c99"
    },
    "var_84ca49f72f6d": {
      "type": "variant",
      "label": "Profile (Desktop)",
      "parentId": "var_9a4322468016",
      "themeId": null,
      "rect": {
        "x": 23775,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --primary: #0A3D62;\n        --accent: #F6A623;\n        --bg: #F8FAFC;\n        --card-bg: #FFFFFF;\n        --text: #1A1A2E;\n        --sidebar-bg: #FFFFFF;\n        --sidebar-text: #64748B;\n        --sidebar-active: #0A3D62;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--bg);\n        color: var(--text);\n        font-family: 'Be Vietnam Pro', sans-serif;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    /* Variant: Glass */\n    .variant-glass {\n        --bg: #CBD5E1;\n        --card-bg: rgba(255, 255, 255, 0.25);\n        --sidebar-bg: rgba(255, 255, 255, 0.15);\n    }\n    .variant-glass .glass-card {\n        backdrop-filter: blur(32px);\n        border: 1px solid rgba(255, 255, 255, 0.3);\n        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);\n    }\n\n    /* Variant: Premium */\n    .variant-premium {\n        --bg: #0F172A;\n        --card-bg: #1E293B;\n        --sidebar-bg: #0A3D62;\n        --sidebar-text: rgba(255, 255, 255, 0.5);\n        --sidebar-active: #F6A623;\n        --text: #F8FAFC;\n    }\n    .variant-premium #sidebar-card {\n        border-color: rgba(255, 255, 255, 0.05);\n    }\n    .variant-premium .glass-card {\n        background-color: #1E293B;\n        border-color: rgba(255, 255, 255, 0.05);\n        color: #F8FAFC;\n    }\n    .variant-premium .text-slate-400, .variant-premium .text-slate-500 {\n        color: #94A3B8;\n    }\n    .variant-premium .sidebar-nav-item.active {\n        background-color: rgba(246, 166, 35, 0.15);\n        color: #F6A623;\n    }\n    .variant-premium .sidebar-nav-item {\n        color: rgba(255, 255, 255, 0.7);\n    }\n    .variant-premium .sidebar-nav-item:hover {\n        background-color: rgba(255, 255, 255, 0.05);\n        color: white;\n    }\n\n    .card-wallet {\n        background: linear-gradient(135deg, #0A3D62 0%, #154e7a 50%, #1e5a8a 100%);\n        position: relative;\n        overflow: hidden;\n    }\n\n    .neo-shadow {\n        box-shadow: 0 20px 40px -15px rgba(10, 61, 98, 0.08);\n    }\n\n    .reveal-card { opacity: 1; } /* GSAP will animate from 0 */\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: rgba(10, 61, 98, 0.1);\n        border-radius: 10px;\n    }\n\n    /* Header Styles */\n    .glass-header {\n        background: rgba(255, 255, 255, 0.85);\n        backdrop-filter: blur(16px);\n        border-bottom: 1px solid rgba(10, 61, 98, 0.08);\n    }\n</style>\n<div class=\"min-h-screen bg-[var(--bg)] transition-colors duration-500 antialiased font-vietnam\" data-kid=\"1\" data-name=\"page layout container\" id=\"main-wrapper\">\n\n<nav class=\"sticky top-0 z-50 glass-header px-4 py-3 md:px-8\" data-kid=\"1-1\" data-name=\"navigation header\">\n<div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation content container\">\n<div class=\"flex items-center gap-12\" data-kid=\"1-1-1-1\" data-name=\"branding and site links container\">\n<a class=\"flex items-center gap-2 group\" data-kid=\"1-1-1-1-1\" data-name=\"logo anchor link\" href=\"/\">\n<div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center text-white font-bold text-xl transition-all group-hover:rotate-6 group-hover:scale-110\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo icon container\">O</div>\n<span class=\"font-black text-[var(--primary)] text-2xl tracking-tighter hidden sm:block font-plus\" data-kid=\"1-1-1-1-1-2\" data-name=\"site name text\">OpportuniHub</span>\n</a>\n<div class=\"hidden lg:flex items-center gap-8\" data-kid=\"1-1-1-1-2\" data-name=\"navigation menu links\">\n<a class=\"font-bold text-slate-400 hover:text-[var(--primary)] transition-colors\" data-kid=\"1-1-1-1-2-1\" data-name=\"catalogue navigation link\" href=\"#\">Catalogue</a>\n<a class=\"font-bold text-slate-400 hover:text-[var(--primary)] transition-colors\" data-kid=\"1-1-1-1-2-2\" data-name=\"sondages navigation link\" href=\"#\">Sondages</a>\n<a class=\"font-bold text-[var(--primary)] relative after:content-[''] after:absolute after:-bottom-5 after:left-0 after:w-full after:h-1 after:bg-[var(--primary)] after:rounded-full\" data-kid=\"1-1-1-1-2-3\" data-name=\"active profile navigation link\" href=\"#\">Profil</a>\n<a class=\"font-bold text-slate-400 hover:text-[var(--primary)] transition-colors\" data-kid=\"1-1-1-1-2-4\" data-name=\"aide navigation link\" href=\"#\">Aide</a>\n</div>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-1-2\" data-name=\"header action items container\">\n<div class=\"hidden md:flex bg-slate-100 p-1 rounded-xl border border-slate-200 mr-4\" data-kid=\"1-1-1-2-1\" data-name=\"theme variant selector container\">\n<button class=\"variant-btn px-4 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg bg-white shadow-sm text-[var(--primary)] transition-all cursor-pointer\" data-kid=\"1-1-1-2-1-1\" data-name=\"modern theme button\" onclick=\"changeVariant('modern')\">Modern</button>\n<button class=\"variant-btn px-4 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg text-slate-500 hover:text-[var(--primary)] transition-all cursor-pointer\" data-kid=\"1-1-1-2-1-2\" data-name=\"glass theme button\" onclick=\"changeVariant('glass')\">Glass</button>\n<button class=\"variant-btn px-4 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg text-slate-500 hover:text-[var(--primary)] transition-all cursor-pointer\" data-kid=\"1-1-1-2-1-3\" data-name=\"premium theme button\" onclick=\"changeVariant('premium')\">Premium</button>\n</div>\n<div class=\"bg-white px-4 py-2 rounded-2xl border border-slate-200 flex items-center gap-3 shadow-sm\" data-kid=\"1-1-1-2-2\" data-name=\"wallet balance container\">\n<i class=\"ti ti-wallet text-[var(--primary)] text-xl\" data-kid=\"1-1-1-2-2-1\" data-name=\"wallet icon\"></i>\n<div class=\"flex flex-col leading-none\" data-kid=\"1-1-1-2-2-2\" data-name=\"wallet balance text group\">\n<span class=\"text-[9px] opacity-40 font-black uppercase tracking-widest\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"wallet label\">Solde</span>\n<span class=\"font-extrabold text-sm text-[var(--primary)]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"wallet amount value\">125.750 <span class=\"text-[10px]\" data-kid=\"1-1-1-2-2-2-2-1\" data-name=\"currency code\">FCFA</span></span>\n</div>\n</div>\n</div>\n</div>\n</nav>\n<main class=\"max-w-7xl mx-auto px-4 py-10 md:px-8\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"grid grid-cols-1 lg:grid-cols-10 gap-10\" data-kid=\"1-2-1\" data-name=\"grid layout container\">\n\n<div class=\"lg:col-span-3\" data-kid=\"1-2-1-1\" data-name=\"sidebar container\">\n<div class=\"bg-[var(--sidebar-bg)] rounded-[2.5rem] p-8 border border-slate-100 neo-shadow reveal-card sticky top-28\" data-kid=\"1-2-1-1-1\" data-name=\"user profile card\" id=\"sidebar-card\">\n<div class=\"flex flex-col items-center text-center mb-10\" data-kid=\"1-2-1-1-1-1\" data-name=\"avatar and status container\">\n<div class=\"relative mb-6\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"avatar image container\">\n<div class=\"w-36 h-36 rounded-full ring-4 ring-offset-4 ring-[var(--accent)] p-1 overflow-hidden hover:scale-105 transition-transform duration-300\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"user profile image\">\n<img alt=\"Avatar\" class=\"w-full h-full object-cover rounded-full\" data-kid=\"1-2-1-1-1-1-1-1-1\" data-name=\"user profile image source\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/300?u=opportuni\">\n</div>\n<div class=\"absolute bottom-1 right-2 w-10 h-10 bg-emerald-500 border-4 border-white rounded-full flex items-center justify-center text-white shadow-lg\" data-kid=\"1-2-1-1-1-1-1-2\" data-name=\"online status indicator\">\n<i class=\"ti ti-check text-xl font-bold\" data-kid=\"1-2-1-1-1-1-1-2-1\" data-name=\"checkmark icon\"></i>\n</div>\n</div>\n<h2 class=\"text-2xl font-black text-[var(--primary)] font-plus tracking-tight\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"online status badge\" id=\"sidebar-name\">Jean Dupont</h2>\n<div class=\"flex items-center gap-2 mt-2 text-slate-400 font-bold text-[10px] uppercase tracking-widest\" data-kid=\"1-2-1-1-1-1-3\" data-name=\"phone contact container\">\n<i class=\"ti ti-phone text-[var(--accent)]\" data-kid=\"1-2-1-1-1-1-3-1\" data-name=\"phone icon\"></i>\n<span data-kid=\"1-2-1-1-1-1-3-2\" data-name=\"phone number text\">+228 90 12 34 56</span>\n</div>\n</div>\n<nav class=\"space-y-2\" data-kid=\"1-2-1-1-1-2\" data-name=\"user profile name\">\n<a class=\"sidebar-nav-item active flex items-center gap-4 px-6 py-4 rounded-2xl bg-[var(--sidebar-active)] text-white shadow-xl shadow-[var(--sidebar-active)]/10 transition-all font-bold\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"profile navigation link\" href=\"#\">\n<i class=\"ti ti-user-circle text-2xl\" data-kid=\"1-2-1-1-1-2-1-1\" data-name=\"profile icon\"></i>\n<span data-kid=\"1-2-1-1-1-2-1-2\" data-name=\"profile text\">Profil</span>\n</a>\n<a class=\"sidebar-nav-item flex items-center gap-4 px-6 py-4 rounded-2xl text-[var(--sidebar-text)] hover:bg-slate-50 transition-all font-bold group\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"wallet navigation link\" href=\"#\">\n<i class=\"ti ti-wallet text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-2-2-1\" data-name=\"wallet icon\"></i>\n<span data-kid=\"1-2-1-1-1-2-2-2\" data-name=\"wallet text\">Portefeuille</span>\n</a>\n<a class=\"sidebar-nav-item flex items-center gap-4 px-6 py-4 rounded-2xl text-[var(--sidebar-text)] hover:bg-slate-50 transition-all font-bold group\" data-kid=\"1-2-1-1-1-2-3\" data-name=\"history navigation link\" href=\"#\">\n<i class=\"ti ti-history text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-2-3-1\" data-name=\"history icon\"></i>\n<span data-kid=\"1-2-1-1-1-2-3-2\" data-name=\"history text\">Historique</span>\n</a>\n<a class=\"sidebar-nav-item flex items-center gap-4 px-6 py-4 rounded-2xl text-[var(--sidebar-text)] hover:bg-slate-50 transition-all font-bold group\" data-kid=\"1-2-1-1-1-2-4\" data-name=\"settings navigation link\" href=\"#\">\n<i class=\"ti ti-settings text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-2-4-1\" data-name=\"settings icon\"></i>\n<span data-kid=\"1-2-1-1-1-2-4-2\" data-name=\"settings text\">Paramètres</span>\n</a>\n<div class=\"pt-8 mt-8 border-t border-slate-100 opacity-50\" data-kid=\"1-2-1-1-1-2-5\" data-name=\"navigation divider\"></div>\n<a class=\"sidebar-nav-item flex items-center gap-4 px-6 py-4 rounded-2xl text-rose-500 hover:bg-rose-50 transition-all font-bold\" data-kid=\"1-2-1-1-1-2-6\" data-name=\"logout navigation link\" href=\"#\">\n<i class=\"ti ti-logout text-2xl\" data-kid=\"1-2-1-1-1-2-6-1\" data-name=\"logout icon\"></i>\n<span data-kid=\"1-2-1-1-1-2-6-2\" data-name=\"logout text\">Déconnexion</span>\n</a>\n</nav>\n</div>\n</div>\n\n<div class=\"lg:col-span-7 space-y-8\" data-kid=\"1-2-1-2\" data-name=\"main content column\">\n\n<div class=\"reveal-card\" data-kid=\"1-2-1-2-1\" data-name=\"welcome header container\">\n<h1 class=\"text-4xl font-black text-[var(--primary)] font-plus tracking-tight mb-2\" data-kid=\"1-2-1-2-1-1\" data-name=\"welcome headline\">Tableau de Bord</h1>\n<p class=\"text-slate-400 font-medium\" data-kid=\"1-2-1-2-1-2\" data-name=\"welcome sub-headline\">Bon retour, Jean. Voici un aperçu de votre compte aujourd'hui.</p>\n</div>\n\n<div class=\"bg-[var(--card-bg)] glass-card rounded-[2.5rem] p-8 border border-slate-100 neo-shadow reveal-card flex flex-col md:flex-row items-center gap-8\" data-kid=\"1-2-1-2-2\" data-name=\"profile completion card\">\n<div class=\"relative w-32 h-32 flex-shrink-0\" data-kid=\"1-2-1-2-2-1\" data-name=\"progress ring container\">\n<svg class=\"w-full h-full -rotate-90\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"progress ring svg\" viewbox=\"0 0 100 100\">\n<circle class=\"text-slate-100\" cx=\"50\" cy=\"50\" fill=\"transparent\" r=\"40\" stroke=\"currentColor\" stroke-width=\"8\" data-kid=\"2\"></circle>\n<circle class=\"text-[var(--accent)]\" cx=\"50\" cy=\"50\" fill=\"transparent\" id=\"progress-circle\" r=\"40\" stroke=\"currentColor\" stroke-dasharray=\"251.2\" stroke-dashoffset=\"62.8\" stroke-linecap=\"round\" stroke-width=\"8\" data-kid=\"3\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"progress percentage container\">\n<span class=\"text-2xl font-black font-plus text-[var(--primary)]\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"percentage text\">75%</span>\n</div>\n</div>\n<div class=\"flex-1\" data-kid=\"1-2-1-2-2-2\" data-name=\"profile completion info\">\n<h3 class=\"text-xl font-black text-[var(--primary)] font-plus mb-2\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"completion headline\">Optimisez votre visibilité</h3>\n<p class=\"text-slate-500 text-sm mb-6 leading-relaxed\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"completion description\">Un profil complété vous donne accès à des offres exclusives et augmente votre confiance auprès de la communauté.</p>\n<div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"completion status tags\">\n<span class=\"px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-black uppercase rounded-full border border-emerald-100 flex items-center gap-1\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"verified status tag\"><i class=\"ti ti-check\" data-kid=\"1-2-1-2-2-2-3-1-1\" data-name=\"checkmark icon\"></i> Email vérifié</span>\n<span class=\"px-3 py-1 bg-slate-50 text-slate-400 text-[10px] font-black uppercase rounded-full border border-slate-200 flex items-center gap-1\" data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"photo tag\">Photo de profil</span>\n<span class=\"px-3 py-1 bg-slate-50 text-slate-400 text-[10px] font-black uppercase rounded-full border border-slate-200 flex items-center gap-1\" data-kid=\"1-2-1-2-2-2-3-3\" data-name=\"banking tag\">Infos Bancaires</span>\n</div>\n</div>\n<button class=\"bg-[var(--primary)] text-white px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest hover:scale-105 transition-transform shadow-lg shadow-[var(--primary)]/20 whitespace-nowrap\" data-kid=\"1-2-1-2-2-3\" data-name=\"complete profile action button\">Compléter</button>\n</div>\n\n<div class=\"card-wallet rounded-[3rem] p-10 text-white reveal-card shadow-2xl shadow-[var(--primary)]/30 group\" data-kid=\"1-2-1-2-3\" data-name=\"wallet summary card\">\n<div class=\"absolute -right-32 -bottom-32 w-96 h-96 bg-[var(--accent)]/10 blur-[100px] rounded-full transition-all group-hover:scale-110\" data-kid=\"1-2-1-2-3-1\" data-name=\"background decorative orb\"></div>\n<div class=\"absolute top-10 right-10 w-20 h-20 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-center backdrop-blur-md\" data-kid=\"1-2-1-2-3-2\" data-name=\"wallet icon container\">\n<i class=\"ti ti-wallet text-4xl opacity-40\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"wallet icon\"></i>\n</div>\n<div class=\"relative z-10\" data-kid=\"1-2-1-2-3-3\" data-name=\"wallet details container\">\n<div class=\"inline-flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-full border border-white/20 mb-6\" data-kid=\"1-2-1-2-3-3-1\" data-name=\"status badge container\">\n<div class=\"w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse\" data-kid=\"1-2-1-2-3-3-1-1\" data-name=\"live status pulse\"></div>\n<span class=\"text-[9px] font-black uppercase tracking-widest\" data-kid=\"1-2-1-2-3-3-1-2\" data-name=\"status label\">Actif - Portefeuille Principal</span>\n</div>\n<p class=\"text-[10px] font-black uppercase tracking-[0.3em] opacity-60 mb-2\" data-kid=\"1-2-1-2-3-3-2\" data-name=\"wallet balance label\">Solde Total Disponible</p>\n<div class=\"flex items-baseline gap-4 mb-10\" data-kid=\"1-2-1-2-3-3-3\" data-name=\"wallet amount container\">\n<span class=\"text-6xl md:text-7xl font-black font-plus tracking-tighter\" data-kid=\"1-2-1-2-3-3-3-1\" data-name=\"wallet numeric balance\">125.750</span>\n<span class=\"text-2xl font-black opacity-60 font-plus\" data-kid=\"1-2-1-2-3-3-3-2\" data-name=\"wallet currency\">FCFA</span>\n</div>\n<div class=\"grid grid-cols-2 md:grid-cols-3 gap-8 pt-10 border-t border-white/10\" data-kid=\"1-2-1-2-3-3-4\" data-name=\"wallet statistics grid\">\n<div data-kid=\"1-2-1-2-3-3-4-1\" data-name=\"monthly expenses container\">\n<p class=\"text-[10px] font-black uppercase tracking-widest opacity-50 mb-1\" data-kid=\"1-2-1-2-3-3-4-1-1\" data-name=\"expenses label\">Dépenses (Mois)</p>\n<p class=\"text-xl font-bold font-plus\" data-kid=\"1-2-1-2-3-3-4-1-2\" data-name=\"expenses amount\">83.450 <span class=\"text-xs opacity-60\" data-kid=\"1-2-1-2-3-3-4-1-2-1\" data-name=\"expenses currency\">FCFA</span></p>\n</div>\n<div data-kid=\"1-2-1-2-3-3-4-2\" data-name=\"monthly gains container\">\n<p class=\"text-[10px] font-black uppercase tracking-widest opacity-50 mb-1\" data-kid=\"1-2-1-2-3-3-4-2-1\" data-name=\"gains label\">Gains (Mois)</p>\n<p class=\"text-xl font-bold font-plus text-[var(--accent)]\" data-kid=\"1-2-1-2-3-3-4-2-2\" data-name=\"gains amount\">+42.300 <span class=\"text-xs opacity-60\" data-kid=\"1-2-1-2-3-3-4-2-2-1\" data-name=\"gains currency\">FCFA</span></p>\n</div>\n<div class=\"md:text-right flex items-end justify-end\" data-kid=\"1-2-1-2-3-3-4-3\" data-name=\"wallet details action container\">\n<button class=\"bg-white text-[var(--primary)] px-8 py-3 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-[var(--accent)] hover:text-white transition-all transform active:scale-95\" data-kid=\"1-2-1-2-3-3-4-3-1\" data-name=\"view details button\">Voir Détails</button>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"1-2-1-2-4\" data-name=\"activity and badges grid\">\n\n<div class=\"bg-[var(--card-bg)] glass-card rounded-[2.5rem] p-8 border border-slate-100 neo-shadow reveal-card\" data-kid=\"1-2-1-2-4-1\" data-name=\"recent activity card\">\n<div class=\"flex items-center justify-between mb-8\" data-kid=\"1-2-1-2-4-1-1\" data-name=\"activity header container\">\n<h4 class=\"text-xl font-black text-[var(--primary)] font-plus tracking-tight\" data-kid=\"1-2-1-2-4-1-1-1\" data-name=\"activity headline\">Activité Récente</h4>\n<a class=\"text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-[var(--primary)] transition-colors\" data-kid=\"1-2-1-2-4-1-1-2\" data-name=\"all activity link\" href=\"#\">Tout voir</a>\n</div>\n<div class=\"space-y-6\" data-kid=\"1-2-1-2-4-1-2\" data-name=\"activity list\">\n<div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-2-1-2-4-1-2-1\" data-name=\"activity item\">\n<div class=\"w-12 h-12 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center transition-transform group-hover:scale-110\" data-kid=\"1-2-1-2-4-1-2-1-1\" data-name=\"activity icon container\">\n<i class=\"ti ti-arrow-down-left text-xl\" data-kid=\"1-2-1-2-4-1-2-1-1-1\" data-name=\"activity icon\"></i>\n</div>\n<div class=\"flex-1\" data-kid=\"1-2-1-2-4-1-2-1-2\" data-name=\"activity details\">\n<p class=\"text-sm font-bold text-[var(--primary)]\" data-kid=\"1-2-1-2-4-1-2-1-2-1\" data-name=\"activity name\">Recharge Flooz</p>\n<p class=\"text-[10px] text-slate-400 font-bold uppercase\" data-kid=\"1-2-1-2-4-1-2-1-2-2\" data-name=\"activity date\">Aujourd'hui, 14:20<