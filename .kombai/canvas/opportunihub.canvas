      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --primary: #0A3D62;\n        --accent: #F6A623;\n        --success: #27AE60;\n        --error: #E74C3C;\n        --bg: #F8FAFC;\n        --text: #1A1A2E;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--bg);\n        color: var(--text);\n        font-family: 'Be Vietnam Pro', sans-serif;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .glass-header {\n        background: rgba(255, 255, 255, 0.85);\n        backdrop-filter: blur(16px);\n        border-bottom: 1px solid rgba(10, 61, 98, 0.08);\n    }\n\n    .card-gradient {\n        background: linear-gradient(135deg, #0A3D62 0%, #154e7a 50%, #1e5a8a 100%);\n        position: relative;\n        overflow: hidden;\n    }\n\n    .card-gradient::before {\n        content: '';\n        position: absolute;\n        top: -50%;\n        right: -50%;\n        width: 100%;\n        height: 100%;\n        background: radial-gradient(circle, rgba(246, 166, 35, 0.15) 0%, transparent 70%);\n        pointer-events: none;\n    }\n\n    .neo-shadow {\n        box-shadow: 0 20px 40px -15px rgba(10, 61, 98, 0.08);\n    }\n\n    .status-badge {\n        padding: 4px 10px;\n        border-radius: 8px;\n        font-size: 9px;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        display: inline-flex;\n        align-items: center;\n        gap: 6px;\n    }\n\n    .scrollbar-hide::-webkit-scrollbar { display: none; }\n    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n    .btn-hover-effect {\n        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    \n    .btn-hover-effect:hover {\n        transform: translateY(-2px);\n    }\n\n    .btn-hover-effect:active {\n        transform: translateY(0) scale(0.98);\n    }\n\n    /* Theme Variants */\n    .variant-modern { --bg: #F8FAFC; }\n    .variant-glass { --bg: #ffffff; }\n    .variant-dark { --bg: #0a0f1d; --text: #f8fafc; }\n    .variant-dark .bg-white { background-color: #111827; border-color: #1f2937; }\n    .variant-dark .text-slate-700 { color: #cbd5e1; }\n    .variant-dark .text-slate-400 { color: #94a3b8; }\n    .variant-dark .bg-slate-50 { background-color: #334155; }\n    .variant-dark .border-slate-100 { border-color: #334155; }\n    .variant-dark nav.glass-header { background: rgba(30, 41, 59, 0.85); border-bottom-color: rgba(255, 255, 255, 0.05); }\n\n    /* Animation utility classes */\n    .reveal-card { opacity: 0; transform: translateY(30px); }\n\n    /* Custom SVG Logos */\n    .logo-flooz { color: #f97316; }\n    .logo-tmoney { color: #2563eb; }\n    .logo-wave { color: #38bdf8; }\n</style>\n\n<div class=\"min-h-screen bg-[var(--bg)] font-vietnam antialiased\" data-kid=\"1\">\n    \n    \n    <nav class=\"sticky top-0 z-50 glass-header px-4 py-3 md:px-8\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-12\" data-kid=\"4\">\n                <a href=\"/\" class=\"flex items-center gap-2 group\" data-kid=\"5\">\n                    <div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center text-white font-bold text-xl transition-all group-hover:rotate-6 group-hover:scale-110\" data-kid=\"6\">O</div>\n                    <span class=\"font-black text-[var(--primary)] text-2xl tracking-tighter hidden sm:block font-plus\" data-kid=\"7\">OpportuniHub</span>\n                </a>\n                \n                <div class=\"hidden lg:flex items-center gap-8\" data-kid=\"8\">\n                    <a href=\"#\" class=\"font-bold text-[var(--text)]/40 hover:text-[var(--primary)] transition-colors\" data-kid=\"9\">Catalogue</a>\n                    <a href=\"#\" class=\"font-bold text-[var(--text)]/40 hover:text-[var(--primary)] transition-colors\" data-kid=\"10\">Sondages</a>\n                    <a href=\"#\" class=\"font-bold text-[var(--primary)] relative after:content-[''] after:absolute after:-bottom-5 after:left-0 after:w-full after:h-1 after:bg-[var(--primary)] after:rounded-full\" data-kid=\"11\">Mon Wallet</a>\n                    <a href=\"#\" class=\"font-bold text-[var(--text)]/40 hover:text-[var(--primary)] transition-colors\" data-kid=\"12\">Aide</a>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-4\" data-kid=\"13\">\n                \n                <div class=\"hidden md:flex bg-slate-100 p-1 rounded-xl border border-slate-200 mr-4\" data-kid=\"14\">\n                    <button onclick=\"changeVariant('modern')\" class=\"variant-btn px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg bg-white shadow-sm text-[var(--primary)] transition-all\" data-kid=\"15\">Modern</button>\n                    <button onclick=\"changeVariant('glass')\" class=\"variant-btn px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg text-slate-500 hover:text-[var(--primary)] transition-all\" data-kid=\"16\">Glass</button>\n                    <button onclick=\"changeVariant('dark')\" class=\"variant-btn px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded-lg text-slate-500 hover:text-[var(--primary)] transition-all\" data-kid=\"17\">Dark</button>\n                </div>\n                \n                <div class=\"bg-white px-4 py-2 rounded-2xl border border-slate-200 flex items-center gap-3 shadow-sm\" data-kid=\"18\">\n                    <i class=\"ti ti-wallet text-[var(--primary)] text-xl\" data-kid=\"19\"></i>\n                    <div class=\"flex flex-col leading-none\" data-kid=\"20\">\n                        <span class=\"text-[9px] opacity-40 font-black uppercase tracking-widest\" data-kid=\"21\">Solde</span>\n                        <span class=\"font-extrabold text-sm text-[var(--primary)]\" data-kid=\"22\">125.750 <span class=\"text-[10px]\" data-kid=\"23\">FCFA</span></span>\n                    </div>\n                </div>\n                <button class=\"w-10 h-10 rounded-full border-2 border-white overflow-hidden shadow-md hover:scale-105 transition-transform cursor-pointer\" data-kid=\"24\">\n                    <img src=\"https://i.pravatar.cc/100?u=opportunihub_user\" alt=\"User\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"25\">\n                </button>\n            </div>\n        </div>\n    </nav>\n\n    <main class=\"max-w-7xl mx-auto px-4 py-8 md:px-8\" data-kid=\"26\">\n        \n        \n        <header class=\"mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6\" data-kid=\"27\">\n            <div class=\"reveal-card\" data-kid=\"28\">\n                <nav class=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2\" data-kid=\"29\">\n                    <a href=\"#\" class=\"hover:text-[var(--primary)]\" data-kid=\"30\">Accueil</a>\n                    <i class=\"ti ti-chevron-right text-[8px]\" data-kid=\"31\"></i>\n                    <span class=\"text-[var(--primary)]\" data-kid=\"32\">Mon Wallet</span>\n                </nav>\n                <h1 class=\"text-4xl font-black text-[var(--primary)] font-plus tracking-tight\" data-kid=\"33\">Espace Portefeuille</h1>\n                <p class=\"text-slate-400 font-medium text-sm mt-1\" data-kid=\"34\">Gérez vos fonds, suivez vos gains et retirez vos économies.</p>\n            </div>\n            \n            <div class=\"flex items-center gap-3 reveal-card\" data-kid=\"35\">\n                <div class=\"flex -space-x-3\" data-kid=\"36\">\n                    <div class=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-500\" data-kid=\"37\">\n                        <i class=\"ti ti-history\" data-kid=\"38\"></i>\n                    </div>\n                    <div class=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-500\" data-kid=\"39\">\n                        <i class=\"ti ti-bell\" data-kid=\"40\"></i>\n                    </div>\n                </div>\n                <span class=\"text-[10px] font-black uppercase tracking-widest text-slate-400\" data-kid=\"41\">Dernière activité: Aujourd'hui, 14:35</span>\n            </div>\n        </header>\n\n        \n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12\" data-kid=\"42\">\n            \n            \n            <div class=\"lg:col-span-2 reveal-card\" data-kid=\"43\">\n                <div class=\"card-gradient w-full aspect-[2/1] md:aspect-[2.2/1] rounded-[2.5rem] p-8 md:p-12 text-white flex flex-col justify-between shadow-2xl shadow-[var(--primary)]/20 overflow-hidden group\" data-kid=\"44\">\n                    \n                    <div class=\"absolute -right-20 -bottom-20 w-80 h-80 bg-white/5 blur-[80px] rounded-full group-hover:bg-white/10\" data-kid=\"45\"></div>\n                    \n                    <div class=\"relative z-10 flex justify-between items-start\" data-kid=\"46\">\n                        <div data-kid=\"47\">\n                            <div class=\"inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1 rounded-full border border-white/20 mb-4\" data-kid=\"48\">\n                                <div class=\"w-2 h-2 rounded-full bg-[#F6A623] animate-pulse\" data-kid=\"49\"></div>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest\" data-kid=\"50\">Compte Actif</span>\n                            </div>\n                            <h3 class=\"text-2xl font-black font-plus\" data-kid=\"51\">Compte Principal</h3>\n                        </div>\n                        <div class=\"w-16 h-12 bg-white/10 backdrop-blur-md rounded-xl flex items-center justify-center border border-white/20\" data-kid=\"52\">\n                            <i class=\"ti ti-microchip text-3xl opacity-60\" data-kid=\"53\"></i>\n                        </div>\n                    </div>\n\n                    <div class=\"relative z-10 my-6\" data-kid=\"54\">\n                        <p class=\"text-[10px] font-black uppercase tracking-[0.3em] opacity-60 mb-2\" data-kid=\"55\">Solde Total</p>\n                        <div class=\"flex items-baseline gap-4\" data-kid=\"56\">\n                            <span class=\"text-6xl md:text-7xl font-black font-plus tracking-tighter\" data-kid=\"57\">125.750</span>\n                            <span class=\"text-2xl font-black opacity-60 font-plus\" data-kid=\"58\">FCFA</span>\n                        </div>\n                    </div>\n\n                    <div class=\"relative z-10 flex gap-12 pt-8 border-t border-white/10\" data-kid=\"59\">\n                        <div data-kid=\"60\">\n                            <p class=\"text-[10px] font-black uppercase tracking-[0.2em] opacity-50 mb-1\" data-kid=\"61\">Disponible</p>\n                            <p class=\"text-xl font-bold font-plus\" data-kid=\"62\">98.250 <span class=\"text-xs opacity-60\" data-kid=\"63\">FCFA</span></p>\n                        </div>\n                        <div data-kid=\"64\">\n                            <p class=\"text-[10px] font-black uppercase tracking-[0.2em] opacity-50 mb-1\" data-kid=\"65\">Gelé (GEL)</p>\n                            <p class=\"text-xl font-bold font-plus text-[#F6A623]\" data-kid=\"66\">27.500 <span class=\"text-xs opacity-60\" dat