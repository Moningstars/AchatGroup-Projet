    "var_d055fca881a1": {
      "type": "variant",
      "label": "Survey Detail (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13030,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div class=\"bg-[#F5F7FA] min-h-screen font-['Be_Vietnam_Pro'] text-[#0A3D62] overflow-x-hidden flex flex-col selection:bg-[#F6A623]/30\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n        \n        /* Neobrutalist tactile styles */\n        .tactile-card {\n            box-shadow: 4px 4px 0px 0px #E2E8F0;\n            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n        }\n        .tactile-card:active {\n            box-shadow: 0px 0px 0px 0px #E2E8F0;\n            transform: translate(2px, 2px);\n        }\n        .tactile-card-active {\n            border-color: #0A3D62;\n            box-shadow: 4px 4px 0px 0px #0A3D62;\n        }\n\n        .shadow-neobrutal {\n            box-shadow: 6px 6px 0px 0px #0A3D62;\n        }\n        .shadow-neobrutal:active {\n            box-shadow: 0px 0px 0px 0px #0A3D62;\n            transform: translate(4px, 4px);\n        }\n\n        /* Slide Animation Container */\n        #survey-container {\n            position: relative;\n            overflow-x: clip;\n        }\n        \n        .question-step {\n            position: absolute;\n            width: 100%;\n            top: 0;\n            left: 0;\n        }\n        \n        .question-step:not(.active) {\n            opacity: 0;\n            pointer-events: none;\n        }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-50 bg-[#F5F7FA]/90 backdrop-blur-xl border-b border-[#E2E8F0]\" data-kid=\"2\">\n        \n        <div class=\"px-4 py-3 bg-[#27AE60] text-white flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-2\" data-kid=\"4\">\n                <div class=\"w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center\" data-kid=\"5\">\n                    <i class=\"ti ti-coin text-lg\" data-kid=\"6\"></i>\n                </div>\n                <div data-kid=\"7\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-wider leading-none opacity-80\" data-kid=\"8\">Récompense</p>\n                    <p class=\"font-plus text-sm font-extrabold leading-tight\" data-kid=\"9\">Gagnez 2 500 FCFA</p>\n                </div>\n            </div>\n            <div class=\"bg-black/10 px-2 py-1 rounded text-[10px] font-black flex items-center gap-1 border border-white/10 uppercase\" data-kid=\"10\">\n                <i class=\"ti ti-clock-filled\" data-kid=\"11\"></i> 08:00\n            </div>\n        </div>\n        \n        \n        <div class=\"px-6 py-4\" data-kid=\"12\">\n            <div class=\"flex items-center justify-between mb-2\" data-kid=\"13\">\n                <span class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#0A3D62]/40\" data-kid=\"14\">Progression</span>\n                <span class=\"text-xs font-plus font-extrabold text-[#0A3D62]\" data-kid=\"15\"><span id=\"current-step-display\" data-kid=\"16\">1</span> / 3</span>\n            </div>\n            <div class=\"h-2 w-full bg-[#E2E8F0] rounded-full overflow-hidden border border-[#E2E8F0]\" data-kid=\"17\">\n                <div id=\"progress-bar\" class=\"h-full bg-[#F6A623] rounded-full transition-all duration-700 ease-in-out\" style=\"width: 33.33%\" data-kid=\"18\"></div>\n            </div>\n        </div>\n    </header>\n\n    \n    <main class=\"flex-1 relative px-6 py-8\" id=\"survey-container\" data-kid=\"19\">\n        \n        <div class=\"question-step active\" id=\"step-1\" data-kid=\"20\">\n            <div class=\"mb-8\" data-kid=\"21\">\n                <span class=\"inline-block px-3 py-1 bg-[#0A3D62]/10 rounded-full text-[#0A3D62] text-[10px] font-black uppercase tracking-widest mb-4\" data-kid=\"22\">Question Unique</span>\n                <h1 class=\"text-3xl font-plus font-extrabold leading-[1.1] text-[#0A3D62]\" data-kid=\"23\">\n                    Quelle est votre source principale de revenus ?\n                </h1>\n            </div>\n\n            <div class=\"space-y-4\" data-kid=\"24\">\n                <label class=\"block group\" data-kid=\"25\">\n                    <input type=\"radio\" name=\"q1\" value=\"salarie\" class=\"peer sr-only\" data-kid=\"26\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-center justify-between\" data-kid=\"27\">\n                        <span class=\"text-lg font-bold\" data-kid=\"28\">Salarié(e) du privé</span>\n                        <div class=\"w-6 h-6 rounded-full border-2 border-[#E2E8F0] peer-checked:border-[#0A3D62] flex items-center justify-center\" data-kid=\"29\">\n                            <div class=\"w-3 h-3 bg-[#0A3D62] rounded-full scale-0 peer-checked:scale-100 transition-transform\" data-kid=\"30\"></div>\n                        </div>\n                    </div>\n                </label>\n\n                <label class=\"block group\" data-kid=\"31\">\n                    <input type=\"radio\" name=\"q1\" value=\"independant\" class=\"peer sr-only\" data-kid=\"32\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-center justify-between\" data-kid=\"33\">\n                        <span class=\"text-lg font-bold\" data-kid=\"34\">Indépendant / Commerçant</span>\n                        <div class=\"w-6 h-6 rounded-full border-2 border-[#E2E8F0] peer-checked:border-[#0A3D62] flex items-center justify-center\" data-kid=\"35\">\n                            <div class=\"w-3 h-3 bg-[#0A3D62] rounded-full scale-0 peer-checked:scale-100 transition-transform\" data-kid=\"36\"></div>\n                        </div>\n                    </div>\n                </label>\n\n                <label class=\"block group\" data-kid=\"37\">\n                    <input type=\"radio\" name=\"q1\" value=\"etudiant\" class=\"peer sr-only\" data-kid=\"38\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-center justify-between\" data-kid=\"39\">\n                        <span class=\"text-lg font-bold\" data-kid=\"40\">Étudiant</span>\n                        <div class=\"w-6 h-6 rounded-full border-2 border-[#E2E8F0] peer-checked:border-[#0A3D62] flex items-center justify-center\" data-kid=\"41\">\n                            <div class=\"w-3 h-3 bg-[#0A3D62] rounded-full scale-0 peer-checked:scale-100 transition-transform\" data-kid=\"42\"></div>\n                        </div>\n                    </div>\n                </label>\n            </div>\n        </div>\n\n        \n        <div class=\"question-step\" id=\"step-2\" data-kid=\"43\">\n            <div class=\"mb-8\" data-kid=\"44\">\n                <span class=\"inline-block px-3 py-1 bg-[#0A3D62]/10 rounded-full text-[#0A3D62] text-[10px] font-black uppercase tracking-widest mb-4\" data-kid=\"45\">Plusieurs Choix</span>\n                <h1 class=\"text-3xl font-plus font-extrabold leading-[1.1] text-[#0A3D62]\" data-kid=\"46\">\n                    Quels services utilisez-vous régulièrement ?\n                </h1>\n                <p class=\"mt-2 text-[#0A3D62]/50 font-medium\" data-kid=\"47\">Sélectionnez au moins deux options</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 gap-4\" data-kid=\"48\">\n                <label class=\"block\" data-kid=\"49\">\n                    <input type=\"checkbox\" name=\"q2\" value=\"mobile-money\" class=\"peer sr-only\" data-kid=\"50\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-start gap-4\" data-kid=\"51\">\n                        <div class=\"w-6 h-6 rounded-lg border-2 border-[#E2E8F0] peer-checked:bg-[#0A3D62] peer-checked:border-[#0A3D62] flex items-center justify-center text-white shrink-0 mt-1\" data-kid=\"52\">\n                            <i class=\"ti ti-check text-sm font-bold opacity-0 peer-checked:opacity-100\" data-kid=\"53\"></i>\n                        </div>\n                        <div data-kid=\"54\">\n                            <span class=\"text-lg font-bold block leading-tight\" data-kid=\"55\">Mobile Money</span>\n                            <span class=\"text-sm text-[#0A3D62]/50 mt-1 block\" data-kid=\"56\">Orange Money, Wave, MTN...</span>\n                        </div>\n                    </div>\n                </label>\n\n                <label class=\"block\" data-kid=\"57\">\n                    <input type=\"checkbox\" name=\"q2\" value=\"group-buying\" class=\"peer sr-only\" data-kid=\"58\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-start gap-4\" data-kid=\"59\">\n                        <div class=\"w-6 h-6 rounded-lg border-2 border-[#E2E8F0] peer-checked:bg-[#0A3D62] peer-checked:border-[#0A3D62] flex items-center justify-center text-white shrink-0 mt-1\" data-kid=\"60\">\n                            <i class=\"ti ti-check text-sm font-bold opacity-0 peer-checked:opacity-100\" data-kid=\"61\"></i>\n                        </div>\n                        <div data-kid=\"62\">\n                            <span class=\"text-lg font-bold block leading-tight\" data-kid=\"63\">Achats Groupés</span>\n                            <span class=\"text-sm text-[#0A3D62]/50 mt-1 block\" data-kid=\"64\">OpportuniHub, Marché Local...</span>\n                        </div>\n                    </div>\n                </label>\n\n                <label class=\"block\" data-kid=\"65\">\n                    <input type=\"checkbox\" name=\"q2\" value=\"delivery\" class=\"peer sr-only\" data-kid=\"66\">\n                    <div class=\"p-5 bg-white border-2 border-[#E2E8F0] rounded-xl tactile-card peer-checked:tactile-card-active flex items-start gap-4\" data-kid=\"67\">\n                        <div class=\"w-6 h-6 rounded-lg border-2 border-[#E2E8F0] peer-checked:bg-[#0A3D62] peer-checked:border-[#0A3D62] flex items-center justify-center text-white shrink-0 mt-1\" data-kid=\"68\">\n                            <i class=\"ti ti-check text-sm font-bold opacity-0 peer-checked:opacity-100\" data-kid=\"69\"></i>\n                        </div>\n                        <div data-kid=\"70\">\n                            <span class=\"text-lg font-bold block leading-tight\" data-kid=\"71\">Livraison à Domicile</span>\n                            <span class=\"text-sm text-[#0A3D62]/50 mt-1 block\" data-kid=\"72\">Yango Deli, Glovo, Jumia...</span>\n                        </div>\n                    </div>\n                </label>\n            </div>\n        </div>\n\n        \n        <div class=\"question-step\" id=\"step-3\" data-kid=\"73\">\n            <div class=\"text-center py-12\" data-kid=\"74\">\n                <div class=\"w-24 h-24 bg-[#27AE60]/10 rounded-full flex items-center justify-center mx-auto mb-8 border-4 border-dashed border-[#27AE60]\" data-kid=\"75\">\n                    <i class=\"ti ti-check text-5xl text-[#27AE60]\" data-kid=\"76\"></i>\n                </div>\n                <h1 class=\"text-3xl font-plus font-extrabold leading-[1.1] text-[#0A3D62] mb-4\" data-kid=\"77\">\n                    Presque terminé !\n                </h1>\n                <p class=\"text-lg text-[#0A3D62]/70 max-w-[280px] mx-auto\" data-kid=\"78\">\n                    Confirmez votre participation pour recevoir vos <span class=\"font-bold text-[#27AE60]\" data-kid=\"79\">2 500 FCFA</span> dans votre portefeuille.\n                </p>\n\n                <div class=\"mt-12 bg-[#0A3D62] p-6 rounded-2xl text-white text-left relative overflow-hidden\" data-kid=\"80\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/checkered-diamond.svg\" class=\"absolute -right-8 -bottom-8 w-40 opacity-10\" data-kid=\"81\">\n                    <p class=\"text-xs font-bold uppercase tracking-widest opacity-60 mb-2\" data-kid=\"82\">Total à créditer</p>\n                    <div class=\"flex items-baseline gap-2\" data-kid=\"83\">\n                        <span class=\"text-4xl font-plus font-black\" data-kid=\"84\">2 500</span>\n                        <span class=\"text-xl font-bold opacity-80\" data-kid=\"85\">FCFA</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <footer class=\"p-6 bg-white border-t border-[#E2E8F0]\" data-kid=\"86\">\n        <div class=\"flex items-center gap-4\" data-kid=\"87\">\n            <button id=\"prev-btn\" class=\"hidden w-16 h-16 rounded-xl border-2 border-[#E2E8F0] flex items-center justify-center text-[#0A3D62] tactile-card bg-white\" data-kid=\"88\">\n                <i class=\"ti ti-arrow-left text-2xl\" data-kid=\"89\"></i>\n            </button>\n            <button id=\"next-btn\" class=\"flex-1 bg-[#F6A623] text-[#0A3D62] font-plus font-black text-xl py-5 rounded-xl border-2 border-[#0A3D62] shadow-neobrutal flex items-center justify-center gap-3\" data-kid=\"90\">\n                <span id=\"next-btn-text\" data-kid=\"91\">Continuer</span>\n                <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"92\"></i>\n            </button>\n        </div>\n        <p class=\"text-center text-[10px] text-[#0A3D62]/40 font-bold uppercase tracking-widest mt-6\" data-kid=\"93\">\n            Paiement sécurisé via Portefeuille OpportuniHub\n        </p>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"94\"></script>\n    <script type=\"module\" data-kid=\"95\">\n        import { animate, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        let currentStep = 1;\n        const totalSteps = 3;\n\n        const nextBtn = document.getElementById('next-btn');\n        const prevBtn = document.getElementById('prev-btn');\n        const progressBar = document.getElementById('progress-bar');\n        const stepDisplay = document.getElementById('current-step-display');\n        const nextBtnText = document.getElementById('next-btn-text');\n\n        // Initial setup\n        updateUI();\n\n        // Button Click Handler\n        nextBtn.addEventListener('click', () => {\n            if (currentStep < totalSteps) {\n                transitionStep(currentStep, currentStep + 1);\n                currentStep++;\n            } else {\n                // Final submission animation\n                gsap.to(nextBtn, { scale: 0.9, opacity: 0.5, pointerEvents: 'none' });\n                nextBtnText.innerText = \"Traitement...\";\n                setTimeout(() => {\n                    alert(\"Sondage terminé ! 2 500 FCFA ajoutés à votre compte.\");\n                }, 1500);\n            }\n            updateUI();\n        });\n\n        prevBtn.addEventListener('click', () => {\n            if (currentStep > 1) {\n                transitionStep(currentStep, currentStep - 1);\n                currentStep--;\n            }\n            updateUI();\n        });\n\n        function transitionStep(from, to) {\n            const fromEl = document.getElementById(`step-${from}`);\n            const toEl = document.getElementById(`step-${to}`);\n            const direction = to > from ? 1 : -1;\n\n            // GSAP Slide Push Transition (#motion-route-slide-push style)\n            const tl = gsap.timeline();\n\n            tl.to(fromEl, { \n                x: -100 * direction + '%', \n                opacity: 0, \n                duration: 0.4, \n                ease: \"power2.inOut\",\n                onComplete: () => {\n                    fromEl.classList.remove('active');\n                    gsap.set(fromEl, { x: 0 }); // reset\n                }\n            });\n\n            tl.fromTo(toEl, \n                { x: 100 * direction + '%', opacity: 0 },\n                { \n                    x: '0%', \n                    opacity: 1, \n                    duration: 0.4, \n                    ease: \"power2.out\",\n                    onStart: () => {\n                        toEl.classList.add('active');\n                    }\n                },\n                \"-=0.3\"\n            );\n        }\n\n        function updateUI() {\n            // Progress Bar & Step Text\n            progressBar.style.width = `${(currentStep / totalSteps) * 100}%`;\n            stepDisplay.innerText = currentStep;\n\n            // Prev Button visibility\n            if (currentStep === 1) {\n                prevBtn.classList.add('hidden');\n            } else {\n                prevBtn.classList.remove('hidden');\n            }\n\n            // Next Button text\n            if (currentStep === totalSteps) {\n                nextBtnText.innerText = \"Terminer le sondage\";\n            } else {\n                nextBtnText.innerText = \"Continuer\";\n            }\n        }\n\n        // Motion Press Effects\n        document.querySelectorAll('.tactile-card, #next-btn, #prev-btn').forEach(el => {\n            press(el, (element) => {\n                animate(element, { scale: 0.96 }, { duration: 0.1 });\n                return () => animate(element, { scale: 1 }, { duration: 0.2 });\n            });\n        });\n\n    </script>\n</div>\n",
