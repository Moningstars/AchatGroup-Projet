      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --primary: #0A3D62;\n        --accent: #F6A623;\n        --success: #27AE60;\n        --error: #E74C3C;\n        --bg: #F5F7FA;\n        --text: #1A1A2E;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .scrollbar-hide::-webkit-scrollbar { display: none; }\n    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n    .glass-header {\n        background: rgba(255, 255, 255, 0.95);\n        backdrop-filter: blur(12px);\n        border-bottom: 1px solid rgba(10, 61, 98, 0.08);\n    }\n\n    .neo-shadow {\n        box-shadow: 0 10px 30px -10px rgba(10, 61, 98, 0.12);\n    }\n\n    /* Remove generic lift/transition from classes targeted by GSAP */\n    .bento-card-base {\n        border-width: 2px;\n        border-color: #E2E8F0;\n    }\n    \n    .product-card-base {\n        border-width: 2px;\n        border-color: #E2E8F0;\n        /* No global transition to avoid GSAP conflict */\n    }\n\n    /* Apply transitions only on hover to specific properties */\n    .product-card-base:hover {\n        border-color: var(--primary);\n    }\n\n    @keyframes pulse-light {\n        0%, 100% { opacity: 0.3; }\n        50% { opacity: 0.6; }\n    }\n    .animate-pulse-light {\n        animation: pulse-light 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n</style>\n\n<div class=\"bg-[var(--bg)] text-[var(--text)] font-vietnam antialiased\" data-kid=\"1\">\n    \n    <nav class=\"sticky top-0 z-50 glass-header px-4 py-3 md:px-8\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-8\" data-kid=\"4\">\n                <a href=\"/\" class=\"flex items-center gap-2 group\" data-kid=\"5\">\n                    <div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center text-white font-bold text-xl group-hover:rotate-6 transition-transform\" data-kid=\"6\">O</div>\n                    <span class=\"font-extrabold text-[var(--primary)] text-2xl tracking-tight hidden sm:block font-plus\" data-kid=\"7\">OpportuniHub</span>\n                </a>\n                \n                <div class=\"hidden lg:flex items-center gap-8\" data-kid=\"8\">\n                    <a href=\"#\" class=\"font-bold text-[var(--primary)] relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-full after:h-0.5 after:bg-[var(--primary)]\" data-kid=\"9\">Catalogue</a>\n                    <a href=\"#\" class=\"font-semibold text-[var(--text)]/50 hover:text-[var(--primary)] transition-colors\" data-kid=\"10\">Sondages</a>\n                    <a href=\"#\" class=\"font-semibold text-[var(--text)]/50 hover:text-[var(--primary)] transition-colors\" data-kid=\"11\">Mon Wallet</a>\n                    <a href=\"#\" class=\"font-semibold text-[var(--text)]/50 hover:text-[var(--primary)] transition-colors\" data-kid=\"12\">Aide</a>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-3 md:gap-6\" data-kid=\"13\">\n                <div class=\"bg-[var(--primary)] text-white px-4 py-2 rounded-full flex items-center gap-3 border-2 border-[var(--primary)] shadow-lg shadow-[var(--primary)]/10\" data-kid=\"14\">\n                    <i class=\"ti ti-wallet text-xl\" data-kid=\"15\"></i>\n                    <div class=\"flex flex-col leading-none\" data-kid=\"16\">\n                        <span class=\"text-[10px] opacity-60 font-bold uppercase tracking-widest hidden xs:block\" data-kid=\"17\">Solde</sp