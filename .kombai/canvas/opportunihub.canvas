      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: #0A3D62;\n    --accent: #F6A623;\n    --success: #27AE60;\n    --bg: #F5F7FA;\n    --border: #E2E8F0;\n  }\n\n  body {\n    font-family: 'Be Vietnam Pro', sans-serif;\n    background-color: var(--bg);\n    color: var(--primary);\n  }\n\n  h1, h2, h3, h4, .font-jakarta {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  .shadow-soft {\n    box-shadow: 0 4px 20px -2px rgba(10, 61, 98, 0.05);\n  }\n\n  .ladder-line::before {\n    content: '';\n    position: absolute;\n    left: 11px;\n    top: 0;\n    bottom: 0;\n    width: 2px;\n    background-color: var(--border);\n    z-index: 0;\n  }\n\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n</style>\n\n<div class=\"min-h-screen flex flex-col\" data-kid=\"1\">\n  \n  <header class=\"sticky top-0 z-50 bg-white border-b border-[var(--border)] px-6 lg:px-12 py-4 flex items-center justify-between shadow-sm\" data-kid=\"2\">\n    <div class=\"flex items-center gap-8\" data-kid=\"3\">\n      <a href=\"/\" class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[var(--primary)] rounded-lg flex items-center justify-center text-white\" data-kid=\"5\">\n          <i class=\"ti ti-building-store text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-extrabold tracking-tight text-[var(--primary)] font-jakarta\" data-kid=\"7\">Opportuni<span class=\"text-[var(--accent)]\" data-kid=\"8\">Hub</span></span>\n      </a>\n      <nav class=\"hidden md:flex items-center gap-6\" data-kid=\"9\">\n        <a href=\"#\" class=\"text-sm font-semibold hover:text-[var(--accent)] transition-colors\" data-kid=\"10\">Catalog</a>\n        <a href=\"#\" class=\"text-sm font-semibold hover:text-[var(--accent)] transition-colors\" data-kid=\"11\">Surveys</a>\n        <a href=\"#\" class=\"text-sm font-semibold hover:text-[var(--accent)] transition-colors\" data-kid=\"12\">Community</a>\n      </nav>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"13\">\n      <div class=\"hidden sm:flex items-center gap-2 bg-[var(--primary)] text-white px-4 py-2 rounded-full shadow-md\" data-kid=\"14\">\n        <i class=\"ti ti-wallet text-lg\" data-kid=\"15\"></i>\n        <span class=\"text-sm font-bold\" data-kid=\"16\">12,500 FCFA</span>\n      </div>\n      <button class=\"w-10 h-10 rounded-full border-2 border-[var(--border)] overflow-hidden hover:border-[var(--primary)] transition-all\" data-kid=\"17\">\n        <img src=\"https://i.pravatar.cc/100?u=user123\" alt=\"Profile\" class=\"w-full h-full object-cover\" data-kid=\"18\">\n      </button>\n    </div>\n  </header>\n\n  \n    \n    <nav class=\"flex items-center gap-2 text-xs font-medium text-gray-500 mb-8 uppercase tracking-widest\" data-kid=\"19\">\n      <a href=\"#\" class=\"hover:text-[var(--primary)]\" data-kid=\"20\">OpportuniHub</a>\n      <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"21\"></i>\n      <a href=\"#\" class=\"hover:text-[var(--primary)]\" data-kid=\"22\">Textiles</a>\n      <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"23\"></i>\n      <span class=\"text-[var(--primary)]\" data-kid=\"24\">Tissu Wax Traditionnel</span>\n    </nav>\n\n    \n    \n      \n      \n      <section class=\"space-y-6\" id=\"gallery-container\" data-kid=\"25\">\n        <div class=\"relative aspect-[4/5] sm:aspect-square rounded-2xl overflow-hidden border-2 border-[var(--border)] bg-white shadow-soft group\" data-kid=\"26\">\n          <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=1200&q=80&fit=crop\" alt=\"Tissu Wax Traditionnel\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"27\">\n          <div class=\"absolute top-6 left-6\" data-kid=\"28\">\n            <span class=\"bg-[var(--success)] text-white px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-lg\" data-kid=\"29\">\n              Stock Vérifié\n            </span>\n          </div>\n          <button class=\"absolute top-6 right-6 w-12 h-12 bg-white/90 rounded-full flex items-center justify-center text-[var(--primary)] shadow-xl hover:bg-white transition-all hover:scale-110 active:scale-95\" data-kid=\"30\">\n            <i class=\"ti ti-heart-filled text-xl text-red-500\" data-kid=\"31\"></i>\n          </button>\n        </div>\n        \n        <div class=\"grid grid-cols-4 gap-4\" data-kid=\"32\">\n          <button class=\"aspect-square rounded-xl overflow-hidden border-2 border-[var(--primary)] ring-4 ring-[var(--primary)]/10 cursor-pointer transition-all hover:scale-105 active:scale-95\" data-kid=\"33\">\n            <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"34\">\n          </button>\n          <button class=\"aspect-square rounded-xl overflow-hidden border-2 border-[var(--border)] cursor-pointer transition-all hover:scale-105 active:scale-95 group\" data-kid=\"35\">\n            <img src=\"https://images.unsplash.com/photo-1692689383138-c2df3476072c?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"36\">\n          </button>\n          <button class=\"aspect-square rounded-xl overflow-hidden border-2 border-[var(--border)] cursor-pointer transition-all hover:scale-105 active:scale-95 group\" data-kid=\"37\">\n            <img src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"38\">\n          </button>\n          <button class=\"aspect-square rounded-xl overflow-hidden border-2 border-[var(--border)] cursor-pointer transition-all hover:scale-105 active:scale-95 group\" data-kid=\"39\">\n            <img src=\"https://images.unsplash.com/photo-1730793295617-375689a1df3f?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"40\">\n          </button>\n        </div>\n      </section>\n\n      \n      \n        <div class=\"flex-grow\" data-kid=\"41\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"42\">\n            <span class=\"px-2.5 py-1 bg-[var(--success)]/10 text-[var(--success)] text-[10px] font-bold rounded-full uppercase tracking-widest border border-[var(--success)]/20\" data-kid=\"43\">\n              Économie de Groupe\n            </span>\n            <div class=\"flex items-center gap-1 text-[var(--accent)] font-bold text-xs uppercase tracking-wider\" data-kid=\"44\">\n              <i class=\"ti ti-clock\" data-kid=\"45\"></i> 2j 14h restants\n            </div>\n          </div>\n\n          <h1 class=\"text-4xl lg:text-6xl font-extrabold leading-[1.1] mb-6 font-jakarta tracking-tighter\" data-kid=\"46\">Tissu Wax Premium Heritage - 6 Yards</h1>\n          \n          <div class=\"flex flex-wrap items-baseline gap-4 mb-8\" data-kid=\"47\">\n            <span class=\"text-5xl lg:text-6xl font-extrabold text-[var(--accent)] font-jakarta tracking-tighter whitespace-nowrap\" data-kid=\"48\">275,000 <span class=\"text-xl\" data-kid=\"49\">FCFA</span></span>\n            <span class=\"text-xl text-gray-400 line-through decoration-gray-300 whitespace-nowrap\" data-kid=\"50\">450,000 FCFA</span>\n            <div class=\"bg-[var(--success)] text-white px-3 py-1 rounded-md text-sm font-bold shadow-sm\" data-kid=\"51\">\n              -38%\n            </div>\n          </div>\n\n          <p class=\"text-lg text-gray-600 leading-relaxed mb-10 font-light\" data-kid=\"52\">\n            Une qualité exceptionnelle héritée des marchés traditionnels, parfait pour les grandes occasions et le port quotidien. Réunissez-vous pour débloquer le meilleur tarif du marché ouest-africain.\n          </p>\n\n          \n          <div class=\"mb-10 bg-white p-5 rounded-2xl border-2 border-[var(--border)] inline-flex items-center gap-5 shadow-soft transition-all hover:border-[var(--primary)]/30 group\" id=\"social-proof-bar\" data-kid=\"53\">\n            <div class=\"flex -space-x-4\" data-kid=\"54\">\n              <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=a\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"55\">\n              <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=b\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"56\">\n              <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=c\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"57\">\n              <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=d\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n              <div class=\"w-10 h-10 rounded-full border-2 border-white bg-[var(--primary)] flex items-center justify-center text-[10px] text-white font-bold\" data-kid=\"59\">+3</div>\n            </div>\n            <div class=\"space-y-1\" data-kid=\"60\">\n              <p class=\"text-base font-bold text-[var(--primary)]\" data-kid=\"61\">7 personnes participent déjà</p>\n              <p class=\"text-[10px] text-[var(--success)] uppercase tracking-[0.15em] font-extrabold flex items-center gap-1.5 pt-1\" data-kid=\"62\">\n                <span class=\"w-1.5 h-1.5 bg-[var(--success)] rounded-full animate-pulse\" data-kid=\"63\"></span>\n                Objectif: 30 participants atteints !\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"bg-white p-8 rounded-2xl border-2 border-[var(--border)] shadow-soft mb-8 relative overflow-hidden\" data-kid=\"64\">\n            <div class=\"absolute top-0 right-0 p-4 opacity-5\" data-kid=\"65\">\n              <i class=\"ti ti-chart-bar text-9xl\" data-kid=\"66\"></i>\n            </div>\n            \n            <h3 class=\"text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-8 font-jakarta\" data-kid=\"67\">Progression des Prix</h3>\n            \n            <div class=\"relative space-y-8 ladder-line\" data-kid=\"68\">\n              \n              <div class=\"relative flex items-center opacity-40 grayscale\" data-kid=\"69\">\n                <div class=\"z-10 w-6 h-6 rounded-full border-2 border-[var(--border)] bg-white flex items-center justify-center\" data-kid=\"70\">\n                  <div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\" data-kid=\"71\"></div>\n                </div>\n                <div class=\"ml-6\" data-kid=\"72\">\n                  <p class=\"text-xs font-bold text-gray-400\" data-kid=\"73\">10 PERSONNES</p>\n                  <p class=\"text-xl font-bold text-gray-300\" data-kid=\"74\">355,000 FCFA</p>\n                </div>\n              </div>\n\n              \n              <div class=\"relative flex items-center bg-[var(--success)]/5 -mx-4 px-4 py-3 rounded-xl border border-[var(--success)]/10 shadow-sm\" data-kid=\"75\">\n                <div class=\"absolute left-[-5px] w-9 h-9 rounded-full bg-[var(--success)]/10 animate-ping\" data-kid=\"76\"></div>\n                <div class=\"z-10 w-6 h-6 rounded-full border-2 border-[var(--success)] bg-white flex items-center justify-center\" data-kid=\"77\">\n                  <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--success)]\" data-kid=\"78\"></div>\n                </div>\n                <div class=\"ml-6\" data-kid=\"79\">\n                  <div class=\"flex items-center gap-2 mb-0.5\" data-kid=\"80\">\n                    <p class=\"text-xs font-extrabold text-[var(--primary)] uppercase tracking-widest\" data-kid=\"81\">30 PERSONNES</p>\n                    <span class=\"px-2 py-0.5 bg-[var(--success)] text-white text-[9px] font-bold rounded-full shadow-sm\" data-kid=\"82\">ACTUEL</span>\n                  </div>\n                  <p class=\"text-3xl font-extrabold text-[var(--success)] font-jakarta tracking-tighter\" data-kid=\"83\">275,000 FCFA</p>\n                </div>\n              </div>\n\n              \n              <div class=\"relative flex items-center\" data-kid=\"84\">\n                <div class=\"z-10 w-6 h-6 rounded-full border-2 border-[var(--primary)] bg-white flex items-center justify-center\" data-kid=\"85\">\n                  <div class=\"w-1.5 h-1.5 rounded-full bg-transparent group-hover:bg-[var(--primary)] transition-colors\" data-kid=\"86\"></div>\n                </div>\n                <div class=\"ml-6 flex-grow\" data-kid=\"87\">\n                  <div class=\"flex items-center justify-between mb-2\" data-kid=\"88\">\n                    <p class=\"text-xs font-bold text-[var(--primary)] opacity-60\" data-kid=\"89\">50 PERSONNES</p>\n                    <span class=\"text-[10px] font-bold text-[var(--accent)]\" data-kid=\"90\">-25,000 FCFA DE PLUS</span>\n                  </div>\n                  <p class=\"text-xl font-bold text-[var(--primary)] opacity-60 mb-4\" data-kid=\"91\">250,000 FCFA</p>\n                  \n                  <div class=\"w-full bg-gray-100 h-2 rounded-full overflow-hidden border border-[var(--border)] mt-2\" data-kid=\"92\">\n                    <div class=\"bg-gradient-to-r from-[var(--accent)] to-[#ffd700] h-full w-[35%] rounded-full shadow-[0_0_12px_rgba(246,166,35,0.3)]\" id=\"tier-progress-bar\" data-kid=\"93\"></div>\n                  </div>\n                  <p class=\"text-[10px] text-gray-500 mt-2 font-medium flex items-center gap-1.5\" data-kid=\"94\">\n                    <i class=\"ti ti-users\" data-kid=\"95\"></i> Encore 23 participants pour débloquer ce tarif spécial\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"mt-auto pt-10 border-t border-[var(--border)] space-y-8\" data-kid=\"96\">\n          <div class=\"grid grid-cols-3 gap-4\" data-kid=\"97\">\n            <div class=\"flex flex-col items-center text-center p-3 rounded-xl bg-gray-50 border border-gray-100\" data-kid=\"98\">\n              <i class=\"ti ti-truck text-[var(--primary)] text-xl mb-1\" data-kid=\"99\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-500\" data-kid=\"100\">Livraison 48h</span>\n            </div>\n            <div class=\"flex flex-col items-center text-center p-3 rounded-xl bg-gray-50 border border-gray-100\" data-kid=\"101\">\n              <i class=\"ti ti-rotate-clockwise text-[var(--primary)] text-xl mb-1\" data-kid=\"102\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-500\" data-kid=\"103\">Retours Faciles</span>\n            </div>\n            <div class=\"flex flex-col items-center text-center p-3 rounded-xl bg-gray-50 border border-gray-100\" data-kid=\"104\">\n              <i class=\"ti ti-award text-[var(--primary)] text-xl mb-1\" data-kid=\"105\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-500\" data-kid=\"106\">Qualité Pro</span>\n            </div>\n          </div>\n\n          <div class=\"flex flex-col sm:flex-row items-center gap-6\" data-kid=\"107\">\n          <div class=\"flex-grow\" data-kid=\"108\">\n            <div class=\"flex items-center gap-2 text-sm font-bold text-[var(--primary)] mb-1\" data-kid=\"109\">\n              <i class=\"ti ti-shield-check text-[var(--success)] text-lg\" data-kid=\"110\"></i> Paiement Sécurisé\n            </div>\n            <p class=\"text-xs text-gray-500\" data-kid=\"111\">Les fonds sont bloqués jusqu'à la fin de la vente</p>\n          </div>\n          <button class=\"w-full sm:w-auto px-8 py-6 bg-[var(--accent)] text-white rounded-2xl font-black text-xl shadow-lg flex items-center justify-center gap-4 whitespace-nowrap group\" id=\"cta-button\" data-kid=\"112\">\n            Rejoindre le groupe\n            <i class=\"ti ti-arrow-right transition-transform group-hover:translate-x-2\" data-kid=\"113\"></i>\n          </button>\n        </div>\n      \n    </div>\n\n    \n    <section class=\"mt-24\" data-kid=\"114\">\n      <div class=\"flex items-end justify-between mb-10\" data-kid=\"115\">\n        <div data-kid=\"116\">\n          <h2 class=\"text-3xl font-extrabold text-[var(--primary)] mb-2 font-jakarta\" data-kid=\"117\">Plus d'opportunités</h2>\n          <p class=\"text-gray-500\" data-kid=\"118\">Découvrez d'autres ventes groupées actives dans votre région.</p>\n        </div>\n        <a href=\"#\" class=\"text-[var(--primary)] font-bold flex items-center gap-2 group/all\" data-kid=\"119\">\n          Voir tout <i class=\"ti ti-arrow-narrow-right transition-transform group-hover/all:translate-x-2\" data-kid=\"120\"></i>\n        </a>\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 auto-rows-min\" data-kid=\"121\">\n        \n        <div class=\"lg:col-span-6 bg-white rounded-3xl border-2 border-[var(--border)] overflow-hidden group hover:border-[var(--primary)] shadow-sm flex flex-col md:flex-row h-full\" data-kid=\"122\">\n          <div class=\"w-full md:w-1/2 relative overflow-hidden h-full min-h-[300px]\" data-kid=\"123\">\n            <img src=\"https://images.unsplash.com/photo-1734255026082-82fdc81991f0?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"124\">\n            <div class=\"absolute top-4 left-4 bg-[var(--primary)] text-white px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest shadow-md\" data-kid=\"125\">\n              Plus Populaire\n            </div>\n          </div>\n          <div class=\"p-8 flex flex-col justify-center w-full md:w-1/2\" data-kid=\"126\">\n            <span class=\"text-[var(--success)] text-[10px] font-bold uppercase tracking-[0.2em] mb-2\" data-kid=\"127\">Alimentaire</span>\n            <h4 class=\"text-2xl font-extrabold text-[var(--primary)] mb-4 font-jakarta leading-tight\" data-kid=\"128\">Lot de Tomates Fraîches de Saison</h4>\n            <p class=\"text-sm text-gray-500 mb-6 line-clamp-2\" data-kid=\"129\">Tomates sélectionnées à la main, livrées directement des champs locaux au meilleur prix groupé.</p>\n            <div class=\"flex items-center justify-between mt-auto\" data-kid=\"130\">\n              <span class=\"text-2xl font-extrabold text-[var(--accent)] font-jakarta\" data-kid=\"131\">5,500 <span class=\"text-sm\" data-kid=\"132\">FCFA</span></span>\n              <div class=\"flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100\" data-kid=\"133\">\n                <i class=\"ti ti-users text-[var(--primary)]\" data-kid=\"134\"></i>\n                <span class=\"text-xs font-bold text-gray-600\" data-kid=\"135\">12 / 20</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        \n        <div class=\"lg:col-span-6 grid grid-cols-1 sm:grid-cols-3 gap-8\" data-kid=\"136\">\n          <div class=\"bg-white rounded-2xl border-2 border-[var(--border)] overflow-hidden group hover:border-[var(--primary)] shadow-sm flex flex-col\" data-kid=\"137\">\n            <div class=\"aspect-square relative overflow-hidden\" data-kid=\"138\">\n              <img src=\"https://images.unsplash.com/photo-1761416182901-b4fae3717e70?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"139\">\n              <div class=\"absolute bottom-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] font-bold text-[var(--primary)] shadow-sm\" data-kid=\"140\">\n                -45%\n              </div>\n            </div>\n            <div class=\"p-5 flex-grow flex flex-col\" data-kid=\"141\">\n              <h4 class=\"font-bold text-[var(--primary)] mb-3 text-sm line-clamp-2\" data-kid=\"142\">Paniers Tressés Artisanaux</h4>\n              <div class=\"mt-auto flex items-center justify-between\" data-kid=\"143\">\n                <span class=\"text-base font-bold text-[var(--accent)]\" data-kid=\"144\">12,000 <span class=\"text-[10px]\" data-kid=\"145\">FCFA</span></span>\n                <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"146\">45/50</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border-2 border-[var(--border)] overflow-hidden group hover:border-[var(--primary)] shadow-sm flex flex-col\" data-kid=\"147\">\n            <div class=\"aspect-square relative overflow-hidden\" data-kid=\"148\">\n              <img src=\"https://images.unsplash.com/photo-1734255074937-4b446b8dcf18?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"149\">\n              <div class=\"absolute bottom-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] font-bold text-[var(--primary)] shadow-sm\" data-kid=\"150\">\n                -15%\n              </div>\n            </div>\n            <div class=\"p-5 flex-grow flex flex-col\" data-kid=\"151\">\n              <h4 class=\"font-bold text-[var(--primary)] mb-3 text-sm line-clamp-2\" data-kid=\"152\">Sac de Riz Premium (50kg)</h4>\n              <div class=\"mt-auto flex items-center justify-between\" data-kid=\"153\">\n                <span class=\"text-base font-bold text-[var(--accent)]\" data-kid=\"154\">18,500 <span class=\"text-[10px]\" data-kid=\"155\">FCFA</span></span>\n                <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"156\">8/15</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white rounded-2xl border-2 border-[var(--border)] overflow-hidden group hover:border-[var(--primary)] shadow-sm flex flex-col\" data-kid=\"157\">\n            <div class=\"aspect-square relative overflow-hidden\" data-kid=\"158\">\n              <img src=\"https://images.unsplash.com/photo-1760727467662-5f0943d196a8?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"159\">\n              <div class=\"absolute bottom-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] font-bold text-[var(--primary)] shadow-sm\" data-kid=\"160\">\n                -30%\n              </div>\n            </div>\n            <div class=\"p-5 flex-grow flex flex-col\" data-kid=\"161\">\n              <h4 class=\"font-bold text-[var(--primary)] mb-3 text-sm line-clamp-2\" data-kid=\"162\">Potteries Traditionnelles</h4>\n              <div class=\"mt-auto flex items-center justify-between\" data-kid=\"163\">\n                <span class=\"text-base font-bold text-[var(--accent)]\" data-kid=\"164\">7,200 <span class=\"text-[10px]\" data-kid=\"165\">FCFA</span></span>\n                <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"166\">3/10</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  \n\n  <footer class=\"bg-[var(--primary)] text-white/60 py-16 px-6 lg:px-12 mt-24\" data-kid=\"167\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"168\">\n      <div class=\"md:col-span-2\" data-kid=\"169\">\n        <a href=\"/\" class=\"flex items-center gap-2 mb-6\" data-kid=\"170\">\n          <div class=\"w-10 h-10 bg-white rounded-lg flex items-center justify-center text-[var(--primary)]\" data-kid=\"171\">\n            <i class=\"ti ti-building-store text-xl\" data-kid=\"172\"></i>\n          </div>\n          <span class=\"text-xl font-extrabold tracking-tight text-white font-jakarta\" data-kid=\"173\">Opportuni<span class=\"text-[var(--accent)]\" data-kid=\"174\">Hub</span></span>\n        </a>\n        <p class=\"max-w-sm mb-8 leading-relaxed\" data-kid=\"175\">\n          OpportuniHub démocratise le pouvoir d'achat en Afrique de l'Ouest. Rejoignez des milliers de personnes pour acheter au meilleur prix directement auprès des producteurs.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"176\">\n          <a href=\"#\" class=\"w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-[var(--primary)] transition-all\" data-kid=\"177\"><i class=\"ti ti-brand-facebook\" data-kid=\"178\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-[var(--primary)] transition-all\" data-kid=\"179\"><i class=\"ti ti-brand-twitter\" data-kid=\"180\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-[var(--primary)] transition-all\" data-kid=\"181\"><i class=\"ti ti-brand-instagram\" data-kid=\"182\"></i></a>\n        </div>\n      </div>\n      <div data-kid=\"183\">\n        <h4 class=\"text-white font-bold mb-6 font-jakarta\" data-kid=\"184\">OpportuniHub</h4>\n        <ul class=\"space-y-4 text-sm\" data-kid=\"185\">\n          <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"187\">À propos de nous</a></li>\n          <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"189\">Fonctionnement</a></li>\n          <li data-kid=\"190\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"191\">Sécurité & Confiance</a></li>\n          <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"193\">Devenir Partenaire</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"194\">\n        <h4 class=\"text-white font-bold mb-6 font-jakarta\" data-kid=\"195\">Support</h4>\n        <ul class=\"space-y-4 text-sm\" data-kid=\"196\">\n          <li data-kid=\"197\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"198\">Centre d'aide</a></li>\n          <li data-kid=\"199\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"200\">Contactez-nous</a></li>\n          <li data-kid=\"201\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"202\">Conditions d'utilisation</a></li>\n          <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"204\">Confidentialité</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto border-t border-white/10 mt-16 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs\" data-kid=\"205\">\n      <p data-kid=\"206\">&copy; 2024 OpportuniHub. Tous droits réservés.</p>\n      <div class=\"flex gap-8\" data-kid=\"207\">\n        <div class=\"flex items-center gap-2\" data-kid=\"208\">\n          <i class=\"ti ti-world\" data-kid=\"209\"></i>\n          <span data-kid=\"210\">Français (Afrique de l'Ouest)</span>\n        </div>\n        <span data-kid=\"211\">FCFA (XOF)</span>\n      </div>\n    </div>\n  </footer>\n\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"212\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"213\"></script>\n<script type=\"module\" data-kid=\"214\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import { animate, scroll, inView, stagger, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Init Lenis\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  // Entrance Animations\n  inView(\"main\", () => {\n    animate(\"#gallery-container\", { opacity: [0, 1], x: [-50, 0] }, { duration: 0.8, ease: \"easeOut\" });\n    animate(\"section:nth-of-type(2)\", { opacity: [0, 1], x: [50, 0] }, { duration: 0.8, ease: \"easeOut\", delay: 0.2 });\n  });\n\n  // Stagger Related Products\n  inView(\".grid-cols-4\", (el) => {\n    animate(el.querySelectorAll(\".group\"), { opacity: [0, 1], y: [20, 0] }, { \n      delay: stagger(0.1),\n      duration: 0.5,\n      ease: \"easeOut\"\n    });\n  });\n\n  // Hover scale on buttons using motion.dev\n  const cta = document.querySelector(\"#cta-button\");\n  press(cta, (el) => {\n    animate(el, { scale: 0.95 });\n    return () => animate(el, { scale: 1 });\n  });\n\n  // Active ladder item animation\n  gsap.to(\".ladder-line div:nth-child(2) .animate-ping\", {\n    scale: 1.5,\n    opacity: 0,\n    duration: 2,\n    repeat: -1,\n    ease: \"power2.out\"\n  });\n\n</script>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"215\">\n</div>",
