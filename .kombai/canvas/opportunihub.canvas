r:text-white transition-all\" data-kid=\"260\"><i class=\"ti ti-brand-instagram\" data-kid=\"261\"></i></a>\n                    <a href=\"#\" class=\"w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"262\"><i class=\"ti ti-brand-x\" data-kid=\"263\"></i></a>\n                </div>\n            </div>\n            <div data-kid=\"264\">\n                <h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--primary)] mb-6\" data-kid=\"265\">Navigation</h4>\n                <ul class=\"space-y-4 text-sm font-bold text-slate-400\" data-kid=\"266\">\n                    <li data-kid=\"267\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"268\">Catalogue</a></li>\n                    <li data-kid=\"269\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"270\">Sondages</a></li>\n                    <li data-kid=\"271\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"272\">Mon Wallet</a></li>\n                    <li data-kid=\"273\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"274\">Aide & Support</a></li>\n                </ul>\n            </div>\n            <div data-kid=\"275\">\n                <h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--primary)] mb-6\" data-kid=\"276\">Légal</h4>\n                <ul class=\"space-y-4 text-sm font-bold text-slate-400\" data-kid=\"277\">\n                    <li data-kid=\"278\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"279\">CGU</a></li>\n                    <li data-kid=\"280\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"281\">Confidentialité</a></li>\n                    <li data-kid=\"282\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"283\">Mentions Légales</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-slate-50 flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"284\">\n            <p class=\"text-[10px] font-black uppercase tracking-widest text-slate-300\" data-kid=\"285\">© 2024 OpportuniHub Togo. Tous droits réservés.</p>\n            <p class=\"text-[10px] font-black uppercase tracking-widest text-slate-300 flex items-center gap-1\" data-kid=\"286\">Fait avec <i class=\"ti ti-heart-filled text-rose-500\" data-kid=\"287\"></i> à Lomé</p>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"288\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"289\"></script>\n<script type=\"module\" data-kid=\"290\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    const lenis = new Lenis({ autoRaf: true });\n    \n    gsap.registerPlugin(ScrollTrigger);\n\n    // Variant Switcher Logic\n    window.changeVariant = (variant) => {\n        const body = document.querySelector('body > div');\n        body.classList.remove('variant-modern', 'variant-glass', 'variant-dark');\n        body.classList.add(`variant-${variant}`);\n        \n        // Update button styles\n        document.querySelectorAll('.variant-btn').forEach(btn => {\n            btn.classList.remove('bg-white', 'shadow-sm', 'text-[var(--primary)]');\n            btn.classList.add('text-slate-500');\n            if(btn.textContent.toLowerCase() === variant) {\n                btn.classList.add('bg-white', 'shadow-sm', 'text-[var(--primary)]');\n                btn.classList.remove('text-slate-500');\n            }\n        });\n    }\n\n    // Entrance Animation - No CSS transitions on these elements\n    window.addEventListener('DOMContentLoaded', () => {\n        gsap.to(\".reveal-card\", {\n            opacity: 1,\n            y: 0,\n            duration: 1,\n            stagger: 0.1,\n            ease: \"expo.out\",\n            delay: 0.2\n        });\n    });\n\n    // Smooth hover effect for the balance card\n    const card = document.querySelector('.card-gradient');\n    if (card) {\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            gsap.to(card, {\n                \"--mouse-x\": `${x}px`,\n                \"--mouse-y\": `${y}px`,\n                duration: 0.4\n            });\n        });\n\n        card.addEventListener('mouseenter', () => {\n            gsap.to(card, { scale: 1.01, duration: 0.3, ease: \"power2.out\" });\n        });\n        \n        card.addEventListener('mouseleave', () => {\n            gsap.to(card, { scale: 1, duration: 0.3, ease: \"power2.out\" });\n        });\n    }\n</script>\n",
