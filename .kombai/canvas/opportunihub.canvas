ass=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"150\">\n                        <div class=\"absolute bottom-4 right-4 bg-[var(--success)] text-white px-4 py-1.5 rounded-xl font-black text-sm shadow-xl\" data-kid=\"151\">-15%</div>\n                    </div>\n                    <div class=\"px-1 flex-grow flex flex-col\" data-kid=\"152\">\n                        <h3 class=\"text-lg font-extrabold text-[var(--text)] leading-tight mb-3 font-plus\" data-kid=\"153\">Pack Épices & Condiments Familial</h3>\n                        <div class=\"flex items-baseline gap-3 mb-6\" data-kid=\"154\">\n                            <span class=\"text-2xl font-black text-[var(--primary)] font-plus\" data-kid=\"155\">5.500 <span class=\"text-xs opacity-40\" data-kid=\"156\">FCFA</span></span>\n                            <span class=\"text-xs text-[var(--text)]/30 line-through font-bold uppercase\" data-kid=\"157\">6.500 FCFA</span>\n                        </div>\n                        <div class=\"space-y-3 mb-8\" data-kid=\"158\">\n                            <div class=\"flex justify-between items-end\" data-kid=\"159\">\n                                <span class=\"text-[10px] font-black uppercase text-[var(--text)]/30 tracking-[0.2em]\" data-kid=\"160\">Participation</span>\n                                <span class=\"text-sm font-black text-[var(--primary)] font-plus\" data-kid=\"161\">22/30</span>\n                            </div>\n                            <div class=\"h-3 bg-[#F0F2F5] rounded-full overflow-hidden p-0.5\" data-kid=\"162\">\n                                <div class=\"h-full bg-[var(--accent)] rounded-full\" style=\"width: 73%;\" data-kid=\"163\"></div>\n                            </div>\n                             <div class=\"flex items-center gap-1.5 text-[9px] font-black text-[var(--accent)] uppercase tracking-widest\" data-kid=\"164\">\n                                <i class=\"ti ti-clock\" data-kid=\"165\"></i>\n                                <span data-kid=\"166\">Fermeture: 18h</span>\n                            </div>\n                        </div>\n                        <button class=\"mt-auto w-full bg-[var(--primary)] text-white font-black uppercase text-[10px] tracking-widest py-4 rounded-2xl shadow-xl shadow-[var(--primary)]/10 flex items-center justify-center gap-2 hover:bg-[var(--primary)]/95 active:scale-95 transition-all\" data-kid=\"167\">\n                            <span data-kid=\"168\">Rejoindre</span>\n                            <i class=\"ti ti-plus\" data-kid=\"169\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"space-y-10 pb-20\" data-kid=\"170\">\n            <div class=\"flex items-center justify-between\" data-kid=\"171\">\n                <div data-kid=\"172\">\n                    <h2 class=\"text-4xl font-black text-[var(--text)] font-plus tracking-tight\" data-kid=\"173\">Répondez & Gagnez</h2>\n                    <p class=\"text-[var(--text)]/50 font-bold text-sm uppercase tracking-widest mt-2\" data-kid=\"174\">Gagnez du cash instantané dans votre wallet</p>\n                </div>\n                <button class=\"bg-white border-2 border-[#E2E8F0] text-[var(--primary)] font-black uppercase text-[10px] tracking-widest px-6 py-3.5 rounded-2xl hover:border-[var(--primary)] transition-all active:scale-95\" data-kid=\"175\">\n                    Voir Tout\n                </button>\n            </div>\n\n            <div class=\"flex gap-8 overflow-x-auto pb-8 scrollbar-hide snap-x\" id=\"survey-carousel\" data-kid=\"176\">\n                \n                <div class=\"survey-card-item min-w-[340px] md:min-w-[450px] bg-[var(--primary)] rounded-[2.5rem] p-10 border-2 border-[var(--primary)] shadow-2xl shadow-[var(--primary)]/20 snap-start group relative overflow-hidden\" data-kid=\"177\">\n                    <div class=\"absolute -right-10 -bottom-10 opacity-5 group-hover:scale-125 transition-transform duration-1000\" data-kid=\"178\">\n                        <i class=\"ti ti-gift text-[220px] text-white\" data-kid=\"179\"></i>\n                    </div>\n                    <div class=\"relative z-10 flex flex-col h-full justify-between\" data-kid=\"180\">\n                        <div data-kid=\"181\">\n                            <div class=\"flex items-center gap-3 mb-8\" data-kid=\"182\">\n                                <span class=\"bg-[var(--accent)] text-[var(--primary)] px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest\" data-kid=\"183\">Premium</span>\n                                <span class=\"text-white/40 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"184\">~ 5 mins</span>\n                            </div>\n                            <h3 class=\"text-2xl font-black text-white mb-4 leading-tight font-plus\" data-kid=\"185\">Habitudes : Produits locaux VS Importés</h3>\n                            <p class=\"text-white/40 text-sm font-medium mb-12\" data-kid=\"186\">Donnez votre avis sur le marché local et gagnez des crédits instantanés.</p>\n                        </div>\n                        <div class=\"flex items-end justify-between pt-4 border-t border-white/10\" data-kid=\"187\">\n                            <div data-kid=\"188\">\n                                <span class=\"text-[var(--success)] text-[10px] font-black uppercase tracking-widest block mb-2\" data-kid=\"189\">Récompense</span>\n                                <span class=\"text-4xl font-black text-white tracking-tight font-plus\" data-kid=\"190\">2.500 <span class=\"text-sm font-bold opacity-40\" data-kid=\"191\">FCFA</span></span>\n                            </div>\n                            <button class=\"bg-white text-[var(--primary)] w-14 h-14 rounded-2xl flex items-center justify-center hover:scale-110 active:scale-90 shadow-lg hover:bg-[var(--accent)] transition-all\" data-kid=\"192\">\n                                <i class=\"ti ti-player-play-filled text-2xl ml-1\" data-kid=\"193\"></i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                \n                \n                <div class=\"survey-card-item min-w-[340px] md:min-w-[450px] bg-white rounded-[2.5rem] p-10 border-2 border-[#E2E8F0] snap-start group hover:border-[var(--primary)] transition-colors\" data-kid=\"194\">\n                    <div class=\"relative z-10 flex flex-col h-full justify-between\" data-kid=\"195\">\n                        <div data-kid=\"196\">\n                            <div class=\"flex items-center gap-3 mb-8\" data-kid=\"197\">\n                                <span class=\"bg-[var(--success)] text-white px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest\" data-kid=\"198\">Haut Gain</span>\n                                <span class=\"text-[var(--text)]/40 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"199\">~ 12 mins</span>\n                            </div>\n                            <h3 class=\"text-2xl font-black text-[var(--text)] mb-4 leading-tight font-plus\" data-kid=\"200\">Test Utilisateur : Nouvelle interface v2</h3>\n                            <p class=\"text-[var(--text)]/30 text-sm font-medium mb-12\" data-kid=\"201\">Donnez votre avis sur l'expérience OpportuniHub et gagnez un bonus exclusif.</p>\n                        </div>\n                        <div class=\"flex items-end justify-between pt-4 border-t border-[#F0F2F5]\" data-kid=\"202\">\n                            <div data-kid=\"203\">\n                                <span class=\"text-[var(--success)] text-[10px] font-black uppercase tracking-widest block mb-2 font-bold\" data-kid=\"204\">Récompense</span>\n                                <span class=\"text-4xl font-black text-[var(--primary)] tracking-tight font-plus\" data-kid=\"205\">5.000 <span class=\"text-sm font-bold opacity-30\" data-kid=\"206\">FCFA</span></span>\n                            </div>\n                            <button class=\"bg-[var(--accent)] text-white w-14 h-14 rounded-2xl flex items-center justify-center hover:scale-110 active:scale-90 shadow-lg transition-all\" data-kid=\"207\">\n                                <i class=\"ti ti-player-play-filled text-2xl ml-1\" data-kid=\"208\"></i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer class=\"bg-white border-t-2 border-[#F0F2F5] py-16 px-8\" data-kid=\"209\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"210\">\n            <div class=\"col-span-1 md:col-span-2\" data-kid=\"211\">\n                <div class=\"flex items-center gap-2 mb-6\" data-kid=\"212\">\n                    <div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center text-white font-black\" data-kid=\"213\">O</div>\n                    <span class=\"font-black text-[var(--primary)] text-2xl font-plus\" data-kid=\"214\">OpportuniHub</span>\n                </div>\n                <p class=\"text-[var(--text)]/40 text-sm leading-relaxed max-w-sm mb-8\" data-kid=\"215\">\n                    La première plateforme d'achat groupé d'Afrique de l'Ouest. Transformons notre pouvoir d'achat collectif en économies réelles.\n                </p>\n                <div class=\"flex gap-4\" data-kid=\"216\">\n                    <a href=\"#\" class=\"w-10 h-10 bg-[#F0F2F5] rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"217\"><i class=\"ti ti-brand-facebook\" data-kid=\"218\"></i></a>\n                    <a href=\"#\" class=\"w-10 h-10 bg-[#F0F2F5] rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"219\"><i class=\"ti ti-brand-instagram\" data-kid=\"220\"></i></a>\n                    <a href=\"#\" class=\"w-10 h-10 bg-[#F0F2F5] rounded-xl flex items-center justify-center text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white transition-all\" data-kid=\"221\"><i class=\"ti ti-brand-whatsapp\" data-kid=\"222\"></i></a>\n                </div>\n            </div>\n            <div data-kid=\"223\">\n                <h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--text)] mb-6\" data-kid=\"224\">Navigation</h4>\n                <ul class=\"space-y-4 text-sm font-bold text-[var(--text)]/40\" data-kid=\"225\">\n                    <li data-kid=\"226\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"227\">Catalogue</a></li>\n                    <li data-kid=\"228\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"229\">Sondages</a></li>\n                    <li data-kid=\"230\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"231\">Aide & Support</a></li>\n                </ul>\n            </div>\n            <div data-kid=\"232\">\n                <h4 class=\"font-black text-xs uppercase tracking-widest text-[var(--text)] mb-6\" data-kid=\"233\">Légal</h4>\n                <ul class=\"space-y-4 text-sm font-bold text-[var(--text)]/40\" data-kid=\"234\">\n                    <li data-kid=\"235\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"236\">CGU</a></li>\n                    <li data-kid=\"237\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"238\">Confidentialité</a></li>\n                    <li data-kid=\"239\"><a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"240\">Mentions Légales</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto mt-16 pt-8 border-t border-[#F0F2F5] flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"241\">\n            <p class=\"text-[10px] font-black uppercase tracking-widest text-[var(--text)]/30\" data-kid=\"242\">© 2024 OpportuniHub Togo. Tous droits réservés.</p>\n            <p class=\"text-[10px] font-black uppercase tracking-widest text-[var(--text)]/30\" data-kid=\"243\">Fait avec <i class=\"ti ti-heart-filled text-[var(--error)]\" data-kid=\"244\"></i> à Lomé</p>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"245\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"246\"></script>\n<script type=\"module\" data-kid=\"247\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    const lenis = new Lenis({ autoRaf: true });\n    gsap.registerPlugin(ScrollTrigger);\n\n    function animateValue(id, start, end, duration) {\n        const obj = document.getElementById(id);\n        if (!obj) return;\n        gsap.to({ val: start }, {\n            val: end, duration: duration, ease: \"power2.out\",\n            scrollTrigger: { trigger: obj, start: \"top 95%\" },\n            onUpdate: function() { \n                const num = Math.floor(this.targets()[0].val);\n                obj.textContent = num.toLocaleString('fr-FR').replace(/,/g, ' '); \n            }\n        });\n    }\n\n    animateValue('stat-savings', 0, 12540000, 2.5);\n    animateValue('stat-active', 0, 142, 1.5);\n    animateValue('stat-members', 0, 8420, 2);\n\n    // GSAP animations for cards - no transitions on these elements in CSS\n    gsap.from(\".product-card-item\", {\n        y: 60, opacity: 0, duration: 1, stagger: 0.1, ease: \"power4.out\",\n        scrollTrigger: { trigger: \"#product-grid\", start: \"top 85%\" }\n    });\n\n    gsap.from(\".survey-card-item\", {\n        x: 100, opacity: 0, duration: 1.2, stagger: 0.2, ease: \"expo.out\",\n        scrollTrigger: { trigger: \"#survey-carousel\", start: \"top 90%\" }\n    });\n</script>",
      "comments": [],
      "created": "2026-07-10T23:27:48.747031+00:00",
