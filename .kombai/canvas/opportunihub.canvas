      "themeId": null,
      "rect": {
        "x": 9750,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --color-navy: #0A3D62;\n        --color-orange: #F6A623;\n        --color-bg: #F5F7FA;\n        --color-border: #E2E8F0;\n        --color-green: #27AE60;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        font-family: 'Be+Vietnam+Pro', sans-serif;\n        background-color: var(--color-bg);\n    }\n\n    .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    /* Hide scrollbars but keep functionality */\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n    \n    .otp-input:focus {\n        border-color: var(--color-orange);\n        box-shadow: 0 0 0 4px rgba(246, 166, 35, 0.1);\n    }\n</style>\n\n<div class=\"max-w-[375px] mx-auto min-h-screen bg-[var(--color-bg)] flex flex-col relative overflow-x-clip shadow-2xl\" data-kid=\"1\">\n    \n    \n    <div class=\"h-[30vh] bg-[var(--color-navy)] relative overflow-hidden flex flex-col items-center justify-center p-8 text-white\" data-kid=\"2\">\n        \n        <img id=\"shape-1\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" class=\"absolute -top-10 -left-10 w-64 h-64 opacity-[0.03] rotate-12\" style=\"filter: invert(1);\" data-kid=\"3\">\n        <img id=\"shape-2\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bordered-shield.svg\" class=\"absolute -bottom-20 -right-20 w-80 h-80 opacity-[0.03] -rotate-12\" style=\"filter: invert(1);\" data-kid=\"4\">\n\n        \n        <div class=\"absolute top-6 left-6 flex items-center gap-2.5\" data-kid=\"5\">\n            <div class=\"w-9 h-9 bg-[var(--color-orange)] rounded-xl flex items-center justify-center shadow-lg shadow-[var(--color-orange)]/20\" data-kid=\"6\">\n                <i class=\"ti ti-shield-check text-[var(--color-navy)] text-xl\" data-kid=\"7\"></i>\n            </div>\n            <span class=\"font-jakarta font-extrabold text-xl tracking-tight\" data-kid=\"8\">OpportuniHub</span>\n        </div>\n\n        \n        <div class=\"z-10 text-center mt-6\" data-kid=\"9\">\n            <h1 class=\"font-jakarta text-3xl font-extrabold leading-tight mb-2\" data-kid=\"10\">\n                Puissance <span class=\"text-[var(--color-orange)]\" data-kid=\"11\">Collective.</span>\n            </h1>\n            <p class=\"font-vietnam text-white/70 text-sm max-w-[280px] mx-auto\" data-kid=\"12\">\n                Accédez aux meilleures offres groupées d'Afrique de l'Ouest.\n            </p>\n        </div>\n    </div>\n\n    \n    <div class=\"relative flex-1 -mt-10 bg-white rounded-t-[40px] shadow-[0_-10px_60px_rgba(10,61,98,0.1)] z-20 overflow-hidden\" data-kid=\"13\">\n        \n        <div id=\"steps-scroller\" class=\"flex transition-transform duration-500 ease-[cubic-bezier(0.45,0,0.55,1)]\" data-kid=\"14\">\n            \n            \n            <div id=\"step-1\" class=\"w-full flex-shrink-0 p-8 pt-10 pb-4 flex flex-col\" data-kid=\"15\">\n                <div class=\"space-y-2 mb-10\" data-kid=\"16\">\n                    <h2 class=\"font-jakarta text-2xl font-bold text-[var(--color-navy)]\" data-kid=\"17\">Connexion</h2>\n                    <p class=\"text-gray-500 text-sm\" data-kid=\"18\">Entrez votre numéro pour continuer</p>\n                </div>\n\n                \n                <div class=\"space-y-8\" data-kid=\"19\">\n                    <div class=\"space-y-2\" data-kid=\"20\">\n                        <label class=\"text-xs font-bold text-[var(--color-navy)] uppercase tracking-widest ml-1\" data-kid=\"21\">Numéro de téléphone</label>\n                        <div class=\"flex items-center bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-2xl overflow-hidden focus-within:border-[var(--color-navy)] transition-all\" data-kid=\"22\">\n                            \n                            <div class=\"relative\" data-kid=\"23\">\n                                <button id=\"country-btn\" class=\"flex items-center gap-2 px-4 py-5 hover:bg-black/5 transition-colors border-r-2 border-[var(--color-border)]\" data-kid=\"24\">\n                                    <span class=\"text-xl\" id=\"selected-flag\" data-kid=\"25\">🇹🇬</span>\n                                    <span class=\"font-bold text-[var(--color-navy)]\" id=\"selected-code\" data-kid=\"26\">+228</span>\n                                    <i class=\"ti ti-chevron-down text-gray-400 text-[10px]\" data-kid=\"27\"></i>\n                                </button>\n                                \n                                <div id=\"country-dropdown\" class=\"absolute top-full left-0 mt-2 w-48 bg-white rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.1)] z-50 overflow-hidden opacity-0 pointer-events-none scale-95 transition-all duration-200\" data-kid=\"28\">\n                                    <button onclick=\"selectCountry('🇹🇬', '+228')\" class=\"w-full flex items-center gap-3 p-4 hover:bg-[var(--color-bg)] transition-colors border-b border-[var(--color-border)]\" data-kid=\"29\">\n                                        <span class=\"text-xl\" data-kid=\"30\">🇹🇬</span>\n                                        <span class=\"text-sm font-semibold text-[var(--color-navy)]\" data-kid=\"31\">Togo (+228)</span>\n                                    </button>\n                                    <button onclick=\"selectCountry('🇧🇯', '+229')\" class=\"w-full flex items-center gap-3 p-4 hover:bg-[var(--color-bg)] transition-colors\" data-kid=\"32\">\n                                        <span class=\"text-xl\" data-kid=\"33\">🇧🇯</span>\n                                        <span class=\"text-sm font-semibold text-[var(--color-navy)]\" data-kid=\"34\">Bénin (+229)</span>\n                                    </button>\n                                </div>\n                            </div>\n                            \n                            <input type=\"tel\" placeholder=\"00 00 00 00\" class=\"flex-1 bg-transparent px-5 py-5 text-lg font-bold text-[var(--color-navy)] placeholder:text-gray-300 focus:outline-none\" data-kid=\"35\">\n                        </div>\n                    </div>\n\n                    <button id=\"btn-continue\" class=\"w-full bg-[var(--color-navy)] text-white font-jakarta font-bold py-5 rounded-2xl shadow-xl shadow-[var(--color-navy)]/10 flex items-center justify-center gap-3 group active:scale-[0.98] transition-all\" data-kid=\"36\">\n                        <span data-kid=\"37\">Continuer</span>\n                        <i class=\"ti ti-arrow-right text-lg group-hover:translate-x-1 transition-transform\" data-kid=\"38\"></i>\n                    </button>\n\n                    <div class=\"text-center pt-2 space-y-4\" data-kid=\"39\">\n                        <p class=\"text-xs text-gray-400 leading-relaxed max-w-[280px] mx-auto\" data-kid=\"40\">\n                            En continuant, vous acceptez nos <a href=\"#\" class=\"text-[var(--color-navy)] font-semibold hover:underline underline-offset-2\" data-kid=\"41\">Conditions</a> et notre <a href=\"#\" class=\"text-[var(--color-navy)] font-semibold hover:underline underline-offset-2\" data-kid=\"42\">Politique de Confidentialité</a>.\n                        </p>\n                        <div class=\"flex items-center justify-center gap-1.5 text-[10px] text-gray-400 font-medium uppercase tracking-widest\" data-kid=\"43\">\n                            <i class=\"ti ti-lock text-[var(--color-green)] text-xs\" data-kid=\"44\"></i>\n                            Connexion sécurisée par OTP\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div id=\"step-2\" class=\"w-full flex-shrink-0 p-8 pt-10 pb-4 flex flex-col\" data-kid=\"45\">\n                <div class=\"space-y-2 mb-10\" data-kid=\"46\">\n                    <div class=\"flex items-center gap-4 mb-4\" data-kid=\"47\">\n                        <button onclick=\"goToStep(1)\" class=\"w-10 h-10 rounded-full bg-[var(--color-bg)] flex items-center justify-center text-[var(--color-navy)] hover:bg-[var(--color-border)] transition-colors\" data-kid=\"48\">\n                            <i class=\"ti ti-arrow-left text-xl\" data-kid=\"49\"></i>\n                        </button>\n                        <h2 class=\"font-jakarta text-2xl font-bold text-[var(--color-navy)]\" data-kid=\"50\">Vérification</h2>\n                    </div>\n                    <p class=\"text-gray-500 text-sm\" data-kid=\"51\">\n                        Code envoyé au <span class=\"text-[var(--color-navy)] font-bold\" id=\"display-number\" data-kid=\"52\">+228 90 •• •• 12</span>\n                    </p>\n                </div>\n\n                <div class=\"space-y-10\" data-kid=\"53\">\n                    <div class=\"flex justify-between gap-2\" data-kid=\"54\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"55\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"56\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"57\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"58\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"59\">\n                        <input type=\"text\" maxlength=\"1\" class=\"otp-input w-12 h-16 bg-[var(--color-bg)] border-2 border-[var(--color-border)] rounded-xl text-center text-2xl font-extrabold text-[var(--color-navy)] focus:outline-none transition-all\" data-kid=\"60\">\n                    </div>\n\n                    <div class=\"text-center space-y-4\" data-kid=\"61\">\n                        <button class=\"text-sm font-bold text-[var(--color-orange)] hover:underline active:scale-95 transition-transform\" data-kid=\"62\">Renvoyer le code (45s)</button>\n                        \n                        <button id=\"btn-verify\" class=\"w-full bg-[var(--color-navy)] text-white font-jakarta font-bold py-5 rounded-2xl shadow-lg shadow-[var(--color-navy)]/10 flex items-center justify-center gap-3 active:scale-[0.98] transition-all\" data-kid=\"63\">\n                            <span data-kid=\"64\">Vérifier le code</span>\n                            <i class=\"ti ti-circle-check text-lg\" data-kid=\"65\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"flex justify-center gap-2.5 pb-10\" data-kid=\"66\">\n            <div id=\"dot-1\" class=\"w-8 h-1.5 rounded-full bg-[var(--color-orange)] transition-all duration-500 ease-in-out\" data-kid=\"67\"></div>\n            <div id=\"dot-2\" class=\"w-2 h-1.5 rounded-full bg-gray-200 transition-all duration-500 ease-in-out\" data-kid=\"68\"></div>\n        </div>\n    </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"69\"></script>\n<script data-kid=\"70\">\n    // Country Dropdown Logic\n    const countryBtn = document.getElementById('country-btn');\n    const countryDropdown = document.getElementById('country-dropdown');\n    \n    countryBtn.addEventListener('click', (e) => {\n        e.stopPropagation();\n        const isOpen = countryDropdown.classList.contains('opacity-100');\n        if (isOpen) {\n            closeDropdown();\n        } else {\n            openDropdown();\n        }\n    });\n\n    document.addEventListener('click', closeDropdown);\n\n    function openDropdown() {\n        countryDropdown.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');\n        countryDropdown.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');\n    }\n\n    function closeDropdown() {\n        countryDropdown.classList.add('opacity-0', 'pointer-events-none', 'scale-95');\n        countryDropdown.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');\n    }\n\n    function selectCountry(flag, code) {\n        document.getElementById('selected-flag').innerText = flag;\n        document.getElementById('selected-code').innerText = code;\n        closeDropdown();\n    }\n\n    // Hero Shape Animations\n    gsap.to('#shape-1', { y: 20, rotate: 20, duration: 4, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n    gsap.to('#shape-2', { x: -30, rotate: -20, duration: 5, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n    gsap.to('#shape-3', { scale: 1.2, duration: 3, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n\n    // Step Transition Logic\n    const btnContinue = document.getElementById('btn-continue');\n    const step1 = document.getElementById('step-1');\n    const step2 = document.getElementById('step-2');\n    const dot1 = document.getElementById('dot-1');\n    const dot2 = document.getElementById('dot-2');\n\n    const scroller = document.getElementById('steps-scroller');\n    btnContinue.addEventListener('click', () => goToStep(2));\n\n    function goToStep(num) {\n        if (num === 2) {\n            gsap.to(scroller, { x: '-100%', duration: 0.6, ease: 'power3.inOut' });\n            \n            // Update dots\n            dot1.classList.remove('w-8', 'bg-[var(--color-orange)]');\n            dot1.classList.add('w-2', 'bg-gray-200');\n            dot2.classList.remove('w-2', 'bg-gray-200');\n            dot2.classList.add('w-8', 'bg-[var(--color-orange)]');\n        } else {\n            gsap.to(scroller, { x: '0%', duration: 0.6, ease: 'power3.inOut' });\n            \n            // Update dots\n            dot2.classList.remove('w-8', 'bg-[var(--color-orange)]');\n            dot2.classList.add('w-2', 'bg-gray-200');\n            dot1.classList.remove('w-2', 'bg-gray-200');\n            dot1.classList.add('w-8', 'bg-[var(--color-orange)]');\n        }\n    }\n\n    // Auto-focus OTP inputs\n    const otpInputs = document.querySelectorAll('.otp-input');\n    otpInputs.forEach((input, index) => {\n        input.addEventListener('input', (e) => {\n            if (e.target.value.length === 1 && index < otpInputs.length - 1) {\n                otpInputs[index + 1].focus();\n            }\n        });\n        input.addEventListener('keydown', (e) => {\n            if (e.key === 'Backspace' && e.target.value.length === 0 && index > 0) {\n                otpInputs[index - 1].focus();\n            }\n        });\n    });\n</script>\n",
