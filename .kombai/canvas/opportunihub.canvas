      "html": "\n<div class=\"bg-[#F5F7FA] min-h-screen font-['Be_Vietnam_Pro'] text-[#0A3D62] pb-36 relative overflow-x-clip\" id=\"main-container\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-plus-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-be-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n        .gradient-card-overlay {\n            background: linear-gradient(135deg, #0A3D62 0%, #062841 100%);\n        }\n\n        .balance-glow {\n            box-shadow: 0 15px 45px -12px rgba(10, 61, 98, 0.45);\n        }\n\n        .action-button-recharge {\n            box-shadow: 0 10px 25px -8px rgba(39, 174, 96, 0.4);\n        }\n\n        .action-button-withdraw {\n            box-shadow: 0 10px 25px -8px rgba(246, 166, 35, 0.4);\n        }\n\n        .active-tab-glow {\n            box-shadow: 0 12px 30px -10px rgba(10, 61, 98, 0.5);\n        }\n    </style>\n\n    \n    <header class=\"flex justify-between items-center px-6 py-5 bg-[#F5F7FA] sticky top-0 z-40 backdrop-blur-md bg-[#F5F7FA]/80 border-b border-[#E2E8F0]/50\" data-kid=\"2\">\n        <h1 class=\"text-2xl font-extrabold font-plus-jakarta tracking-tight text-[#0A3D62]\" data-kid=\"3\">Portefeuille</h1>\n        <div class=\"flex gap-3\" data-kid=\"4\">\n            <button class=\"w-10 h-10 rounded-xl bg-white border border-[#E2E8F0] flex items-center justify-center text-[#0A3D62] shadow-sm hover:shadow-md transition-shadow active:scale-90\" id=\"btn-search\" data-kid=\"5\">\n                <i class=\"ti ti-search text-xl\" data-kid=\"6\"></i>\n            </button>\n            <button class=\"w-10 h-10 rounded-xl bg-white border border-[#E2E8F0] flex items-center justify-center text-[#0A3D62] shadow-sm hover:shadow-md transition-shadow active:scale-90 relative\" id=\"btn-notif\" data-kid=\"7\">\n                <i class=\"ti ti-bell text-xl\" data-kid=\"8\"></i>\n                <span class=\"absolute top-2.5 right-2.5 w-2 h-2 bg-[#E74C3C] rounded-full border-2 border-white\" data-kid=\"9\"></span>\n            </button>\n        </div>\n    </header>\n\n    <main class=\"px-6 mt-8 space-y-9 max-w-md mx-auto\" data-kid=\"10\">\n        \n        <section class=\"relative w-full aspect-[1.6/1] rounded-[2.2rem] gradient-card-overlay p-8 overflow-hidden text-white balance-glow ring-1 ring-white/10\" id=\"balance-card\" data-kid=\"11\">\n            \n            <div class=\"absolute -top-12 -right-12 w-48 h-48 opacity-10 rotate-12 pointer-events-none\" data-kid=\"12\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/checkered-diamond.svg\" class=\"w-full h-full\" style=\"filter: invert(1);\" alt=\"Pattern\" data-kid=\"13\">\n            </div>\n            <div class=\"absolute -bottom-10 -left-10 w-32 h-32 bg-white/5 rounded-full blur-2xl pointer-events-none\" data-kid=\"14\"></div>\n            \n            <div class=\"relative z-10 flex flex-col justify-between h-full\" data-kid=\"15\">\n                <div data-kid=\"16\">\n                    <div class=\"flex items-center gap-2 text-white/70\" data-kid=\"17\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.15em] font-plus-jakarta\" data-kid=\"18\">Solde Total Disponible</p>\n                        <i class=\"ti ti-eye-off text-sm\" data-kid=\"19\"></i>\n                    </div>\n                    <div class=\"flex items-baseline gap-2 mt-1\" data-kid=\"20\">\n                        <h2 class=\"text-5xl font-extrabold font-plus-jakarta tracking-tighter\" id=\"total-balance\" data-kid=\"21\">125.450</h2>\n                        <span class=\"text-xl font-bold text-white/50\" data-kid=\"22\">FCFA</span>\n                    </div>\n                </div>\n                \n                <div class=\"grid grid-cols-2 gap-4 border-t border-white/10 pt-6\" data-kid=\"23\">\n                    <div data-kid=\"24\">\n                        <p class=\"text-white/50 text-[9px] font-bold uppercase tracking-wider mb-1\" data-kid=\"25\">Disponible</p>\n                        <div class=\"flex items-center gap-1.5\" data-kid=\"26\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#27AE60]\" data-kid=\"27\"></span>\n                            <p class=\"text-base font-bold font-plus-jakarta\" data-kid=\"28\">85.450 <span class=\"text-[10px] opacity-60 uppercase font-medium\" data-kid=\"29\">FCFA</span></p>\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"30\">\n                        <p class=\"text-white/50 text-[9px] font-bold uppercase tracking-wider mb-1\" data-kid=\"31\">Gelé (Achats)</p>\n                        <div class=\"flex items-center justify-end gap-1.5\" data-kid=\"32\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#F6A623]\" data-kid=\"33\"></span>\n                            <p class=\"text-base font-bold font-plus-jakarta text-[#F6A623]\" data-kid=\"34\">40.000 <span class=\"text-[10px] opacity-60 uppercase font-medium\" data-kid=\"35\">FCFA</span></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"absolute bottom-0 left-0 w-full h-1/2 bg-[linear-gradient(to_top,#00000044,transparent)] pointer-events-none\" data-kid=\"36\"></div>\n        </section>\n\n        \n        <section class=\"grid grid-cols-2 gap-4\" id=\"action-buttons\" data-kid=\"37\">\n            <button class=\"flex flex-col items-center justify-center gap-4 bg-[#27AE60] text-white py-6 px-4 rounded-[1.8rem] action-button-recharge hover:brightness-105\" id=\"btn-recharge\" data-kid=\"38\">\n                <div class=\"w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center shadow-inner\" data-kid=\"39\">\n                    <i class=\"ti ti-plus text-2xl\" data-kid=\"40\"></i>\n                </div>\n                <span class=\"font-bold text-lg font-plus-jakarta\" data-kid=\"41\">Recharger</span>\n            </button>\n            <button class=\"flex flex-col items-center justify-center gap-4 bg-[#F6A623] text-white py-6 px-4 rounded-[1.8rem] action-button-withdraw hover:brightness-105\" id=\"btn-withdraw\" data-kid=\"42\">\n                <div class=\"w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center shadow-inner\" data-kid=\"43\">\n                    <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"44\"></i>\n                </div>\n                <span class=\"font-bold text-lg font-plus-jakarta\" data-kid=\"45\">Retirer</span>\n            </button>\n        </section>\n\n        \n        <section class=\"space-y-4\" data-kid=\"46\">\n            <div class=\"flex justify-between items-end\" data-kid=\"47\">\n                <div data-kid=\"48\">\n                    <h3 class=\"text-xl font-extrabold font-plus-jakarta text-[#0A3D62]\" data-kid=\"49\">Activité Récente</h3>\n                    <p class=\"text-[10px] text-[#0A3D62]/40 font-bold uppercase tracking-widest mt-0.5\" data-kid=\"50\">Mises à jour en direct</p>\n                </div>\n                <button class=\"text-[#0A3D62]/60 text-[10px] font-bold uppercase tracking-widest flex items-center gap-1 hover:text-[#0A3D62] transition-colors px-3 py-1.5 rounded-full bg-white border border-[#E2E8F0] shadow-xs\" data-kid=\"51\">\n                    Voir Tout <i class=\"ti ti-chevron-right text-sm\" data-kid=\"52\"></i>\n                </button>\n            </div>\n\n            <div class=\"space-y-2.5\" id=\"activity-list\" data-kid=\"53\">\n                \n                <div class=\"bg-white p-4 rounded-2xl border border-[#E2E8F0] flex items-center gap-4 shadow-xs cursor-pointer transaction-card\" data-kid=\"54\">\n                    <div class=\"w-11 h-11 rounded-xl bg-[#27AE60]/10 flex items-center justify-center text-[#27AE60] shrink-0\" data-kid=\"55\">\n                        <i class=\"ti ti-brand-orange text-xl\" data-kid=\"56\"></i>\n                    </div>\n                    <div class=\"flex-grow\" data-kid=\"57\">\n                        <p class=\"font-bold text-sm font-plus-jakarta text-[#0A3D62] leading-tight\" data-kid=\"58\">Recharge Orange</p>\n                        <p class=\"text-[10px] text-[#0A3D62]/40 font-semibold mt-0.5\" data-kid=\"59\">Aujourd'hui, 14:30</p>\n                    </div>\n                    <div class=\"text-right shrink-0\" data-kid=\"60\">\n                        <p class=\"font-bold text-[#27AE60] text-sm font-plus-jakarta\" data-kid=\"61\">+50.000</p>\n                        <div class=\"flex items-center justify-end gap-1.5 mt-1.5\" data-kid=\"62\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#27AE60] shadow-[0_0_8px_rgba(39,174,96,0.4)]\" data-kid=\"63\"></span>\n                            <span class=\"text-[8px] text-[#27AE60]/90 uppercase font-black tracking-widest\" data-kid=\"64\">Réussi</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"bg-white p-4 rounded-2xl border border-[#E2E8F0] flex items-center gap-4 shadow-xs cursor-pointer transaction-card\" data-kid=\"65\">\n                    <div class=\"w-11 h-11 rounded-xl bg-[#F6A623]/10 flex items-center justify-center text-[#F6A623] shrink-0\" data-kid=\"66\">\n                        <i class=\"ti ti-shopping-cart text-xl\" data-kid=\"67\"></i>\n                    </div>\n                    <div class=\"flex-grow\" data-kid=\"68\">\n                        <p class=\"font-bold text-sm font-plus-jakarta text-[#0A3D62] leading-tight\" data-kid=\"69\">Achat Groupé: Frigo</p>\n                        <p class=\"text-[10px] text-[#0A3D62]/40 font-semibold mt-0.5\" data-kid=\"70\">Hier, 09:15</p>\n                    </div>\n                    <div class=\"text-right shrink-0\" data-kid=\"71\">\n                        <p class=\"font-bold text-[#0A3D62] text-sm font-plus-jakarta\" data-kid=\"72\">-40.000</p>\n                        <div class=\"flex items-center justify-end gap-1.5 mt-1.5\" data-kid=\"73\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#F6A623] shadow-[0_0_8px_rgba(246,166,35,0.4)]\" data-kid=\"74\"></span>\n                            <span class=\"text-[8px] text-[#F6A623]/90 uppercase font-black tracking-widest\" data-kid=\"75\">Gelé</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"bg-white p-4 rounded-2xl border border-[#E2E8F0] flex items-center gap-4 shadow-xs cursor-pointer transaction-card\" data-kid=\"76\">\n                    <div class=\"w-11 h-11 rounded-xl bg-[#27AE60]/10 flex items-center justify-center text-[#27AE60] shrink-0\" data-kid=\"77\">\n                        <i class=\"ti ti-award text-xl\" data-kid=\"78\"></i>\n                    </div>\n                    <div class=\"flex-grow\" data-kid=\"79\">\n                        <p class=\"font-bold text-sm font-plus-jakarta text-[#0A3D62] leading-tight\" data-kid=\"80\">Sondage Terminé</p>\n                        <p class=\"text-[10px] text-[#0A3D62]/40 font-semibold mt-0.5\" data-kid=\"81\">10 Oct, 18:00</p>\n                    </div>\n                    <div class=\"text-right shrink-0\" data-kid=\"82\">\n                        <p class=\"font-bold text-[#27AE60] text-sm font-plus-jakarta\" data-kid=\"83\">+2.500</p>\n                        <div class=\"flex items-center justify-end gap-1 mt-1\" data-kid=\"84\">\n                            <span class=\"w-1 h-1 rounded-full bg-[#27AE60]\" data-kid=\"85\"></span>\n                            <span class=\"text-[8px] text-[#27AE60]/80 uppercase font-black tracking-widest\" data-kid=\"86\">Réussi</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"bg-white p-4 rounded-2xl border border-[#E2E8F0] flex items-center gap-4 shadow-xs cursor-pointer transaction-card\" data-kid=\"87\">\n                    <div class=\"w-11 h-11 rounded-xl bg-[#E74C3C]/10 flex items-center justify-center text-[#E74C3C] shrink-0\" data-kid=\"88\">\n                        <i class=\"ti ti-logout text-xl\" data-kid=\"89\"></i>\n                    </div>\n                    <div class=\"flex-grow\" data-kid=\"90\">\n                        <p class=\"font-bold text-sm font-plus-jakarta text-[#0A3D62] leading-tight\" data-kid=\"91\">Retrait Bancaire</p>\n                        <p class=\"text-[10px] text-[#0A3D62]/40 font-semibold mt-0.5\" data-kid=\"92\">08 Oct, 11:20</p>\n                    </div>\n                    <div class=\"text-right shrink-0\" data-kid=\"93\">\n                        <p class=\"font-bold text-[#E74C3C] text-sm font-plus-jakarta\" data-kid=\"94\">-15.000</p>\n                        <div class=\"flex items-center justify-end gap-1 mt-1\" data-kid=\"95\">\n                            <span class=\"w-1 h-1 rounded-full bg-[#E74C3C]\" data-kid=\"96\"></span>\n                            <span class=\"text-[8px] text-[#E74C3C]/80 uppercase font-black tracking-widest\" data-kid=\"97\">Sortie</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-0 w-full bg-white/95 backdrop-blur-md border-t border-[#E2E8F0] px-6 pb-8 pt-4 flex justify-between items-center z-50 rounded-t-[2.5rem] shadow-[0_-10px_40px_rgba(0,0,0,0.06)]\" data-kid=\"98\">\n        <a href=\"#\" class=\"flex flex-col items-center gap-1.5 transition-all group\" data-kid=\"99\">\n            <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]/30 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"100\"></i>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62]/40 uppercase tracking-wider group-hover:text-[#0A3D62]\" data-kid=\"101\">Accueil</span>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1.5 transition-all group\" data-kid=\"102\">\n            <i class=\"ti ti-clipboard-text text-2xl text-[#0A3D62]/30 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"103\"></i>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62]/40 uppercase tracking-wider group-hover:text-[#0A3D62]\" data-kid=\"104\">Sondages</span>\n        </a>\n        \n        \n        <div class=\"relative -top-12 scale-110\" data-kid=\"105\">\n            <div class=\"absolute -top-1 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-[#F6A623] rounded-full border-[3.5px] border-white z-10 shadow-lg shadow-[#F6A623]/40\" data-kid=\"106\"></div>\n            <a href=\"#\" class=\"w-16 h-16 rounded-[1.8rem] bg-[#0A3D62] text-white flex items-center justify-center shadow-2xl shadow-[#0A3D62]/50 active:scale-90 transition-transform ring-6 ring-white/50 backdrop-blur-xl\" data-kid=\"107\">\n                <i class=\"ti ti-wallet text-3xl\" data-kid=\"108\"></i>\n            </a>\n            <span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-[9px] font-black text-[#0A3D62] uppercase tracking-tight whitespace-nowrap\" data-kid=\"109\">Wallet</span>\n        </div>\n\n        <a href=\"#\" class=\"flex flex-col items-center gap-1.5 transition-all group\" data-kid=\"110\">\n            <i class=\"ti ti-chart-bar text-2xl text-[#0A3D62]/30 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"111\"></i>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62]/40 uppercase tracking-wider group-hover:text-[#0A3D62]\" data-kid=\"112\">Stats</span>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1.5 transition-all group\" data-kid=\"113\">\n            <i class=\"ti ti-user-circle text-2xl text-[#0A3D62]/30 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"114\"></i>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62]/40 uppercase tracking-wider group-hover:text-[#0A3D62]\" data-kid=\"115\">Profil</span>\n        </a>\n    </nav>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"116\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"117\"></script>\n    <script type=\"module\" data-kid=\"118\">\n        import { animate, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // GSAP Stagger Entrance (#motion-stagger-list-on-enter)\n        window.addEventListener('load', () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            const tl = gsap.timeline();\n\n            tl.from(\"#balance-card\", {\n                y: 30,\n                opacity: 0,\n                duration: 0.8,\n                ease: \"power3.out\"\n            })\n            .from(\"#action-buttons > button\", {\n                scale: 0.9,\n                opacity: 0,\n                duration: 0.5,\n                stagger: 0.1,\n                ease: \"back.out(1.7)\"\n            }, \"-=0.4\")\n            .from(\".transaction-card\", {\n                x: -20,\n                opacity: 0,\n                duration: 0.6,\n                stagger: 0.08,\n                ease: \"power2.out\"\n            }, \"-=0.3\");\n\n            // Count Up Balance (#motion-count-up-text)\n            const balanceEl = document.getElementById('total-balance');\n            animate(0, 125450, {\n                duration: 2,\n                ease: \"circOut\",\n                onUpdate: latest => {\n                    balanceEl.textContent = Math.round(latest).toLocaleString('fr-FR').replace(/\\s/g, '.');\n                }\n            });\n        });\n\n        // Motion Press Scale (#motion-press-scale)\n        press(\"button, .transaction-card, a\", (el) => {\n            animate(el, { scale: 0.96 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.1 });\n        });\n\n    </script>\n</div>\n",
