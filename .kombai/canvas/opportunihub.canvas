        <div class=\"flex justify-between items-end\" data-kid=\"81\">\n                        <div class=\"flex flex-col\" data-kid=\"82\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"83\">Payé</span>\n                            <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62]\" data-kid=\"84\">120,000 <span class=\"text-[10px] font-bold\" data-kid=\"85\">FCFA</span></span>\n                        </div>\n                        <button class=\"w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center text-[#0A3D62]\" data-kid=\"86\">\n                            <i class=\"ti ti-chevron-right text-lg\" data-kid=\"87\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div id=\"variant-modern\" class=\"variant-content space-y-4\" data-kid=\"88\">\n            <div class=\"bg-[#0A3D62] rounded-[2rem] p-6 text-white overflow-hidden relative shadow-xl mb-4\" data-kid=\"89\">\n                <div class=\"absolute -right-20 -bottom-20 w-64 h-64 bg-[#F6A623]/20 rounded-full blur-3xl\" data-kid=\"90\"></div>\n                <div class=\"flex justify-between items-start mb-6 relative z-10\" data-kid=\"91\">\n                    <div data-kid=\"92\">\n                        <p class=\"text-white/50 text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"93\">Dépenses Totales</p>\n                        <h2 class=\"text-3xl font-['Plus_Jakarta_Sans'] font-extrabold\" data-kid=\"94\">173,000 <span class=\"text-sm font-bold opacity-60\" data-kid=\"95\">FCFA</span></h2>\n                    </div>\n                    <div class=\"bg-white/10 p-2 rounded-xl backdrop-blur-md\" data-kid=\"96\">\n                        <i class=\"ti ti-chart-bar text-[#F6A623]\" data-kid=\"97\"></i>\n                    </div>\n                </div>\n                <div class=\"fl