      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: #0A3D62;\n    --accent: #F6A623;\n    --success: #27AE60;\n    --bg: #F5F7FA;\n    --white: #FFFFFF;\n    --border: #E2E8F0;\n    --text-muted: #64748b;\n  }\n\n  body {\n    font-family: 'Be Vietnam Pro', sans-serif;\n    background-color: var(--bg);\n    color: var(--primary);\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: clip; /* Fix for sticky positioning as per guidelines */\n  }\n\n  .font-heading {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  /* Patterns */\n  .medium-border {\n    border: 2px solid var(--border);\n  }\n\n  .reward-badge {\n    background-color: var(--success);\n    color: white;\n    padding: 3px 10px;\n    border-radius: 9999px;\n    font-size: 0.6rem;\n    font-weight: 700;\n    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  }\n\n  .tab-bar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: rgba(255, 255, 255, 0.95);\n    backdrop-filter: blur(8px);\n    border-top: 1px solid var(--border);\n    display: flex;\n    justify-content: space-around;\n    padding: 0.75rem 0.5rem 1.75rem;\n    z-index: 100;\n  }\n\n  .tab-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0.25rem;\n    color: var(--text-muted);\n    font-size: 0.65rem;\n    font-weight: 600;\n    transition: color 0.2s;\n    position: relative;\n  }\n\n  .tab-item.active {\n    color: var(--primary);\n  }\n\n  .tab-item i {\n    font-size: 1.5rem;\n  }\n\n  .pinterest-grid {\n    columns: 2;\n    column-gap: 0.65rem;\n    padding: 0.65rem;\n  }\n\n  .survey-card {\n    break-inside: avoid;\n    margin-bottom: 0.65rem;\n    background: var(--white);\n    border-radius: 1.25rem;\n    overflow: hidden;\n    position: relative;\n    border: 2px solid var(--border);\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* Custom Scrollbar hide */\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .tab-item.active::after {\n    content: '';\n    position: absolute;\n    bottom: -6px;\n    width: 4px;\n    height: 4px;\n    background-color: var(--accent);\n    border-radius: 50%;\n  }\n\n  /* Image Hover Effect */\n  .survey-card img {\n    transition: transform 0.3s ease;\n  }\n  .survey-card:hover img {\n    transform: scale(1.05);\n  }\n</style>\n\n<div class=\"min-h-screen pb-28\" data-kid=\"1\">\n  \n  <header class=\"bg-white sticky top-0 z-50 px-4 py-3 border-b border-[#E2E8F0] flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-9 h-9 bg-[var(--primary)] rounded-xl flex items-center justify-center shadow-lg shadow-[#0A3D6233]\" data-kid=\"4\">\n        <i class=\"ti ti-hexagon-filled text-white text-xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-heading font-extrabold text-xl tracking-tight text-[var(--primary)]\" data-kid=\"6\">OpportuniHub</span>\n    </div>\n    <div class=\"flex items-center gap-3\" data-kid=\"7\">\n      <div class=\"bg-[var(--primary)] text-white px-3.5 py-1.5 rounded-full flex items-center gap-2 shadow-sm\" data-kid=\"8\">\n        <i class=\"ti ti-wallet text-sm\" data-kid=\"9\"></i>\n        <span class=\"text-xs font-bold font-heading\" data-kid=\"10\">12,480 FCFA</span>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"px-5 pt-8 pb-3\" data-kid=\"11\">\n    <div class=\"flex items-end justify-between mb-5\" data-kid=\"12\">\n      <div data-kid=\"13\">\n        <h1 class=\"font-heading text-3xl font-extrabold tracking-tight\" data-kid=\"14\">Sondages</h1>\n        <p class=\"text-slate-500 text-sm font-medium mt-1\" data-kid=\"15\">Gagnez des récompenses en partageant votre avis.</p>\n      </div>\n      <div class=\"bg-[var(--accent)]/10 text-[var(--accent)] px-3 py-1 rounded-lg text-xs font-bold\" data-kid=\"16\">\n        12 Disponibles\n      </div>\n    </div>\n    \n    <div class=\"flex gap-2\" data-kid=\"17\">\n      <div class=\"relative flex-grow\" data-kid=\"18\">\n        <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg\" data-kid=\"19\"></i>\n        <input type=\"text\" placeholder=\"Thème, récompense...\" class=\"w-full bg-white border-2 border-slate-200 rounded-2xl py-3 pl-11 pr-4 text-sm font-medium focus:outline-hidden focus:border-[var(--primary)] transition-all shadow-sm\" data-kid=\"20\">\n      </div>\n      <button class=\"w-12 h-12 border-2 border-slate-200 rounded-2xl flex items-center justify-center text-slate-600 bg-white shadow-sm\" data-kid=\"21\">\n        <i class=\"ti ti-adjustments-horizontal text-xl\" data-kid=\"22\"></i>\n      </button>\n    </div>\n  </section>\n\n  \n  <nav class=\"flex overflow-x-auto px-5 py-4 gap-2 no-scrollbar\" data-kid=\"23\">\n    <button class=\"whitespace-nowrap px-6 py-2.5 rounded-full bg-[var(--primary)] text-white text-sm font-bold shadow-lg shadow-[#0A3D6222]\" data-kid=\"24\">Tous</button>\n    <button class=\"whitespace-nowrap px-6 py-2.5 rounded-full bg-white border-2 border-slate-200 text-slate-500 text-sm font-semibold\" data-kid=\"25\">Consommation</button>\n    <button class=\"whitespace-nowrap px-6 py-2.5 rounded-full bg-white border-2 border-slate-200 text-slate-500 text-sm font-semibold\" data-kid=\"26\">Lifestyle</button>\n    <button class=\"whitespace-nowrap px-6 py-2.5 rounded-full bg-white border-2 border-slate-200 text-slate-500 text-sm font-semibold\" data-kid=\"27\">Tech</button>\n    <button class=\"whitespace-nowrap px-6 py-2.5 rounded-full bg-white border-2 border-slate-200 text-slate-500 text-sm font-semibold\" data-kid=\"28\">Santé</button>\n  </nav>\n\n  \n  <main class=\"pinterest-grid\" id=\"survey-list\" data-kid=\"29\">\n    \n    <article class=\"survey-card group\" data-kid=\"30\">\n      <div class=\"relative overflow-hidden\" data-kid=\"31\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"32\">Gagnez 2 500 FCFA</div>\n        <img src=\"https://images.unsplash.com/photo-1734255026082-82fdc81991f0?auto=format&w=400&q=80&fit=crop\" alt=\"Market\" class=\"w-full object-cover aspect-[3/4]\" decoding=\"async\" loading=\"lazy\" data-kid=\"33\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"34\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"35\">Alimentation Locale</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"36\">\n          <span class=\"flex items-center gap-1\" data-kid=\"37\"><i class=\"ti ti-clock\" data-kid=\"38\"></i> 8m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"39\"><i class=\"ti ti-users\" data-kid=\"40\"></i> 142</span>\n        </div>\n      </div>\n    </article>\n\n    \n    <article class=\"survey-card group\" data-kid=\"41\">\n      <div class=\"relative overflow-hidden\" data-kid=\"42\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"43\">Gagnez 5 000 FCFA</div>\n        <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=400&q=80&fit=crop\" alt=\"Textiles\" class=\"w-full object-cover aspect-[4/5]\" decoding=\"async\" loading=\"lazy\" data-kid=\"44\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"45\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"46\">Mode & Textiles</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"47\">\n          <span class=\"flex items-center gap-1\" data-kid=\"48\"><i class=\"ti ti-clock\" data-kid=\"49\"></i> 12m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"50\"><i class=\"ti ti-users\" data-kid=\"51\"></i> 89</span>\n        </div>\n      </div>\n    </article>\n\n    \n    <article class=\"survey-card group\" data-kid=\"52\">\n      <div class=\"relative overflow-hidden\" data-kid=\"53\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"54\">Gagnez 1 000 FCFA</div>\n        <img src=\"https://images.pexels.com/photos/5239890/pexels-photo-5239890.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" alt=\"Agri\" class=\"w-full object-cover aspect-square\" decoding=\"async\" loading=\"lazy\" data-kid=\"55\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"56\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"57\">Agriculture 2.0</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"58\">\n          <span class=\"flex items-center gap-1\" data-kid=\"59\"><i class=\"ti ti-clock\" data-kid=\"60\"></i> 5m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"61\"><i class=\"ti ti-users\" data-kid=\"62\"></i> 312</span>\n        </div>\n      </div>\n    </article>\n\n    \n    <article class=\"survey-card group\" data-kid=\"63\">\n      <div class=\"relative overflow-hidden\" data-kid=\"64\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"65\">Gagnez 1 500 FCFA</div>\n        <img src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=400&q=80&fit=crop\" alt=\"Artisanat\" class=\"w-full object-cover aspect-[2/3]\" decoding=\"async\" loading=\"lazy\" data-kid=\"66\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"67\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"68\">Artisanat Local</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"69\">\n          <span class=\"flex items-center gap-1\" data-kid=\"70\"><i class=\"ti ti-clock\" data-kid=\"71\"></i> 10m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"72\"><i class=\"ti ti-users\" data-kid=\"73\"></i> 64</span>\n        </div>\n      </div>\n    </article>\n\n    \n    <article class=\"survey-card group\" data-kid=\"74\">\n      <div class=\"relative overflow-hidden\" data-kid=\"75\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"76\">Gagnez 750 FCFA</div>\n        <img src=\"https://images.pexels.com/photos/28468188/pexels-photo-28468188.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" alt=\"Transport\" class=\"w-full object-cover aspect-[4/3]\" decoding=\"async\" loading=\"lazy\" data-kid=\"77\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"78\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"79\">Mobilité Urbaine</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"80\">\n          <span class=\"flex items-center gap-1\" data-kid=\"81\"><i class=\"ti ti-clock\" data-kid=\"82\"></i> 4m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"83\"><i class=\"ti ti-users\" data-kid=\"84\"></i> 256</span>\n        </div>\n      </div>\n    </article>\n\n    \n    <article class=\"survey-card group\" data-kid=\"85\">\n      <div class=\"relative overflow-hidden\" data-kid=\"86\">\n        <div class=\"reward-badge absolute top-2 right-2 z-10\" data-kid=\"87\">Gagnez 3 000 FCFA</div>\n        <img src=\"https://images.unsplash.com/photo-1760727467662-5f0943d196a8?auto=format&w=400&q=80&fit=crop\" alt=\"Digital\" class=\"w-full object-cover aspect-[3/4]\" decoding=\"async\" loading=\"lazy\" data-kid=\"88\">\n      </div>\n      <div class=\"p-4 bg-white grow\" data-kid=\"89\">\n        <h3 class=\"font-heading text-sm font-bold leading-tight mb-2 text-slate-800\" data-kid=\"90\">Paiement Mobile</h3>\n        <div class=\"flex items-center gap-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider\" data-kid=\"91\">\n          <span class=\"flex items-center gap-1\" data-kid=\"92\"><i class=\"ti ti-clock\" data-kid=\"93\"></i> 15m</span>\n          <span class=\"flex items-center gap-1\" data-kid=\"94\"><i class=\"ti ti-users\" data-kid=\"95\"></i> 110</span>\n        </div>\n      </div>\n    </article>\n  </main>\n</div>\n\n\n<nav class=\"tab-bar\" data-kid=\"96\">\n  <a href=\"#\" class=\"tab-item\" data-kid=\"97\">\n    <i class=\"ti ti-home\" data-kid=\"98\"></i>\n    <span data-kid=\"99\">Accueil</span>\n  </a>\n  <a href=\"#\" class=\"tab-item active\" data-kid=\"100\">\n    <i class=\"ti ti-forms\" data-kid=\"101\"></i>\n    <span data-kid=\"102\">Sondages</span>\n  </a>\n  <a href=\"#\" class=\"tab-item\" data-kid=\"103\">\n    <i class=\"ti ti-wallet\" data-kid=\"104\"></i>\n    <span data-kid=\"105\">Portefeuille</span>\n  </a>\n  <a href=\"#\" class=\"tab-item\" data-kid=\"106\">\n    <i class=\"ti ti-user\" data-kid=\"107\"></i>\n    <span data-kid=\"108\">Profil</span>\n  </a>\n</nav>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"109\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"110\"></script>\n<script data-kid=\"111\">gsap.registerPlugin(ScrollTrigger);</script>\n\n<script type=\"module\" data-kid=\"112\">\n  import { animate, stagger, inView, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Press feedback for cards and buttons\n  press(\".survey-card\", (el) => {\n    animate(el, { scale: 0.96 }, { duration: 0.1 });\n    return () => animate(el, { scale: 1 }, { duration: 0.1 });\n  });\n\n  press(\"button\", (el) => {\n    animate(el, { scale: 0.94 }, { duration: 0.1 });\n    return () => animate(el, { scale: 1 }, { duration: 0.1 });\n  });\n\n  press(\".tab-item\", (el) => {\n    animate(el, { scale: 0.9 }, { duration: 0.1 });\n    return () => animate(el, { scale: 1 }, { duration: 0.1 });\n  });\n\n  // Stagger entrance for survey cards\n  inView(\"#survey-list\", (info) => {\n    animate(info.target.querySelectorAll(\".survey-card\"), \n      { opacity: [0, 1], y: [30, 0] }, \n      { delay: stagger(0.1), duration: 0.6, ease: [0.22, 1, 0.36, 1] }\n    );\n  });\n</script>\n\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"113\">\n<script type=\"module\" data-kid=\"114\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ \n    autoRaf: true, \n    autoToggle: true, \n    anchors: true, \n    allowNestedScroll: true, \n    naiveDimensions: true, \n    stopInertiaOnNavigate: true \n  });\n</script>\n",
