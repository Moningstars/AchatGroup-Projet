    "var_42f610662c0c": {
      "type": "variant",
      "label": "Surveys List (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 22825,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div class=\"bg-[#F5F7FA] text-[#0A3D62] font-['Be_Vietnam_Pro'] min-h-screen pb-56 selection:bg-[#F6A623]/30 overflow-x-clip\" data-kid=\"0\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n    <style data-kid=\"2\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .scrollbar-hide::-webkit-scrollbar { display: none; }\n        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n        .glass-header {\n            background: rgba(245, 247, 250, 0.8);\n            backdrop-filter: blur(20px);\n        }\n\n        .tab-active {\n            color: #0A3D62;\n            background: white;\n            box-shadow: 0 4px 12px rgba(10, 61, 98, 0.08);\n        }\n\n        .variant-container {\n            display: none;\n        }\n        .variant-container.active {\n            display: block;\n        }\n\n        /* Custom shadow for buttons */\n        .btn-shadow {\n            box-shadow: 0 4px 12px -2px rgba(10, 61, 98, 0.15);\n        }\n        .card-shadow {\n            box-shadow: 0 10px 25px -10px rgba(10, 61, 98, 0.08);\n        }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-50 glass-header border-b border-gray-100/50 px-4 pt-6 pb-4 max-w-[375px] mx-auto\" data-kid=\"3\">\n        <div class=\"flex items-center justify-between mb-2\" data-kid=\"4\">\n            <button class=\"w-11 h-11 rounded-2xl bg-white flex items-center justify-center text-[#0A3D62] shadow-sm active:scale-90 transition-transform border border-gray-100\" data-kid=\"5\">\n                <i class=\"ti ti-chevron-left text-xl\" data-kid=\"6\"></i>\n            </button>\n            <h1 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl tracking-tight\" data-kid=\"7\">Available Surveys</h1>\n            <button class=\"w-11 h-11 rounded-2xl bg-white flex items-center justify-center text-[#0A3D62] shadow-sm relative border border-gray-100\" data-kid=\"8\">\n                <i class=\"ti ti-adjustments-horizontal text-xl\" data-kid=\"9\"></i>\n                <span class=\"absolute top-2.5 right-2.5 w-2 h-2 bg-[#F6A623] rounded-full border-2 border-white\" data-kid=\"10\"></span>\n            </button>\n        </div>\n\n        \n        <div class=\"mt-6 bg-gray-200/50 p-1 rounded-2xl flex items-center gap-1\" data-kid=\"11\">\n            <button onclick=\"switchVariant(1)\" id=\"tab-1\" class=\"tab-btn flex-1 py-2.5 text-xs font-bold rounded-xl transition-all tab-active\" data-kid=\"12\">Variant 1</button>\n            <button onclick=\"switchVariant(2)\" id=\"tab-2\" class=\"tab-btn flex-1 py-2.5 text-xs font-bold rounded-xl transition-all text-gray-500\" data-kid=\"13\">Variant 2</button>\n            <button onclick=\"switchVariant(3)\" id=\"tab-3\" class=\"tab-btn flex-1 py-2.5 text-xs font-bold rounded-xl transition-all text-gray-500\" data-kid=\"14\">Variant 3</button>\n        </div>\n    </header>\n\n    <main class=\"max-w-[375px] mx-auto px-4 pt-6\" data-kid=\"15\">\n        \n        <div id=\"variant-1\" class=\"variant-container active space-y-4\" data-kid=\"16\">\n            \n            <div class=\"survey-card-v1 bg-[#0A3D62] rounded-2xl p-6 text-white relative overflow-hidden card-shadow\" data-kid=\"17\">\n                <div class=\"relative z-10\" data-kid=\"18\">\n                    <div class=\"flex justify-between items-center mb-6\" data-kid=\"19\">\n                        <div class=\"bg-[#27AE60]/20 text-[#27AE60] text-[10px] font-black px-2.5 py-1 rounded-md uppercase tracking-wider border border-[#27AE60]/30\" data-kid=\"20\">Trending</div>\n                        <div class=\"flex items-center gap-1.5 text-white/60\" data-kid=\"21\">\n                            <i class=\"ti ti-users-group text-sm\" data-kid=\"22\"></i>\n                            <span class=\"text-[10px] font-bold\" data-kid=\"23\">2.4k joined</span>\n                        </div>\n                    </div>\n                    <h3 class=\"text-xl font-['Plus_Jakarta_Sans'] font-extrabold mb-3 leading-tight tracking-tight\" data-kid=\"24\">Digital Connectivity & Rural Communities</h3>\n                    <p class=\"text-white/50 text-[13px] mb-8 font-medium leading-relaxed\" data-kid=\"25\">Help us map internet accessibility across remote regions to improve local services and infrastructure.</p>\n                    <div class=\"flex items-center justify-between\" data-kid=\"26\">\n                        <div class=\"flex flex-col\" data-kid=\"27\">\n                            <span class=\"text-[9px] text-white/30 font-bold uppercase tracking-widest mb-0.5\" data-kid=\"28\">Reward</span>\n                            <div class=\"flex items-center gap-1.5\" data-kid=\"29\">\n                                <span class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#F6A623]\" data-kid=\"30\">4,500</span>\n                                <span class=\"text-xs font-bold text-white/50\" data-kid=\"31\">FCFA</span>\n                            </div>\n                        </div>\n                        <button class=\"bg-[#F6A623] text-[#0A3D62] px-6 py-3 rounded-xl text-[11px] font-black uppercase tracking-widest active:scale-95 transition-transform shadow-lg shadow-[#F6A623]/10\" data-kid=\"32\">Start</button>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"survey-card-v1 bg-white rounded-2xl p-6 border border-gray-100 relative overflow-hidden card-shadow\" data-kid=\"33\">\n                <div class=\"relative z-10\" data-kid=\"34\">\n                    <div class=\"flex justify-between items-center mb-6\" data-kid=\"35\">\n                        <div class=\"bg-[#F6A623]/10 text-[#F6A623] text-[10px] font-black px-2.5 py-1 rounded-md uppercase tracking-wider border border-[#F6A623]/20\" data-kid=\"36\">High Yield</div>\n                        <div class=\"flex items-center gap-1.5 text-gray-400\" data-kid=\"37\">\n                            <i class=\"ti ti-clock text-sm\" data-kid=\"38\"></i>\n                            <span class=\"text-[10px] font-bold uppercase\" data-kid=\"39\">Ending Soon</span>\n                        </div>\n                    </div>\n                    <h3 class=\"text-xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62] mb-3 leading-tight tracking-tight\" data-kid=\"40\">Post-Harvest Waste Management</h3>\n                    <p class=\"text-gray-400 text-[13px] mb-8 font-medium leading-relaxed\" data-kid=\"41\">Share insights on local storage solutions to help farmers reduce seasonal food waste and improve yield.</p>\n                    <div class=\"flex items-center justify-between mt-auto\" data-kid=\"42\">\n                        <div class=\"flex flex-col\" data-kid=\"43\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest mb-0.5\" data-kid=\"44\">Reward</span>\n                            <div class=\"flex items-center gap-1.5\" data-kid=\"45\">\n                                <span class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#27AE60]\" data-kid=\"46\">7,000</span>\n                                <span class=\"text-xs font-bold text-gray-400\" data-kid=\"47\">FCFA</span>\n                            </div>\n                        </div>\n                        <button class=\"bg-[#0A3D62] text-white px-6 py-3 rounded-xl text-[11px] font-black uppercase tracking-widest active:scale-95 transition-transform btn-shadow\" data-kid=\"48\">Start</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div id=\"variant-2\" class=\"variant-container space-y-3\" data-kid=\"49\">\n            <div class=\"flex items-center justify-between mb-2 px-1\" data-kid=\"50\">\n                <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-400\" data-kid=\"51\">Active Surveys (12)</span>\n                <button class=\"text-[10px] font-bold text-[#F6A623] uppercase tracking-widest\" data-kid=\"52\">Sort by: Reward</button>\n            </div>\n            \n            \n            <div class=\"survey-card-v2 bg-white p-4 rounded-3xl border border-gray-100 shadow-sm flex gap-4 items-center\" data-kid=\"53\">\n                <div class=\"w-16 h-16 bg-[#F5F7FA] rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"54\">\n                    <i class=\"ti ti-basket text-2xl text-[#0A3D62]\" data-kid=\"55\"></i>\n                </div>\n                <div class=\"grow min-w-0\" data-kid=\"56\">\n                    <div class=\"flex items-center justify-between mb-1\" data-kid=\"57\">\n                        <span class=\"text-[9px] font-black text-[#27AE60] bg-[#27AE60]/10 px-2 py-0.5 rounded-md uppercase tracking-tighter\" data-kid=\"58\">Verified</span>\n                        <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"59\">2 days left</span>\n                    </div>\n                    <h4 class=\"font-bold text-[#0A3D62] text-sm truncate\" data-kid=\"60\">Daily Consumption Habits</h4>\n                    <div class=\"flex items-center justify-between mt-2\" data-kid=\"61\">\n                        <div class=\"flex items-center gap-1\" data-kid=\"62\">\n                            <i class=\"ti ti-coin text-[#F6A623]\" data-kid=\"63\"></i>\n                            <span class=\"text-sm font-extrabold\" data-kid=\"64\">1,500 <span class=\"text-[10px] font-medium text-gray-400\" data-kid=\"65\">FCFA</span></span>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-gray-500\" data-kid=\"66\">840 joined</span>\n                    </div>\n                </div>\n                <div class=\"shrink-0\" data-kid=\"67\">\n                    <button class=\"w-8 h-8 rounded-full bg-[#0A3D62] text-white flex items-center justify-center\" data-kid=\"68\">\n                        <i class=\"ti ti-chevron-right\" data-kid=\"69\"></i>\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"survey-card-v2 bg-white p-4 rounded-3xl border border-gray-100 shadow-sm flex gap-4 items-center\" data-kid=\"70\">\n                <div class=\"w-16 h-16 bg-[#F5F7FA] rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"71\">\n                    <i class=\"ti ti-device-tv text-2xl text-[#0A3D62]\" data-kid=\"72\"></i>\n                </div>\n                <div class=\"grow min-w-0\" data-kid=\"73\">\n                    <div class=\"flex items-center justify-between mb-1\" data-kid=\"74\">\n                        <span class=\"text-[9px] font-black text-[#F6A623] bg-[#F6A623]/10 px-2 py-0.5 rounded-md uppercase tracking-tighter\" data-kid=\"75\">Urgent</span>\n                        <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"76\">6 hours left</span>\n                    </div>\n                    <h4 class=\"font-bold text-[#0A3D62] text-sm truncate\" data-kid=\"77\">Media & Entertainment Survey</h4>\n                    <div class=\"flex items-center justify-between mt-2\" data-kid=\"78\">\n                        <div class=\"flex items-center gap-1\" data-kid=\"79\">\n                            <i class=\"ti ti-coin text-[#F6A623]\" data-kid=\"80\"></i>\n                            <span class=\"text-sm font-extrabold\" data-kid=\"81\">2,200 <span class=\"text-[10px] font-medium text-gray-400\" data-kid=\"82\">FCFA</span></span>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-gray-500\" data-kid=\"83\">1.2k joined</span>\n                    </div>\n                </div>\n                <div class=\"shrink-0\" data-kid=\"84\">\n                    <button class=\"w-8 h-8 rounded-full bg-[#0A3D62] text-white flex items-center justify-center\" data-kid=\"85\">\n                        <i class=\"ti ti-chevron-right\" data-kid=\"86\"></i>\n                    </button>\n                </div>\n            </div>\n\n             \n             <div class=\"survey-card-v2 bg-white p-4 rounded-3xl border border-gray-100 shadow-sm flex gap-4 items-center opacity-60\" data-kid=\"87\">\n                <div class=\"w-16 h-16 bg-[#F5F7FA] rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"88\">\n                    <i class=\"ti ti-car text-2xl text-[#0A3D62]\" data-kid=\"89\"></i>\n                </div>\n                <div class=\"grow min-w-0\" data-kid=\"90\">\n                    <div class=\"flex items-center justify-between mb-1\" data-kid=\"91\">\n                        <span class=\"text-[9px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-md uppercase tracking-tighter\" data-kid=\"92\">Full</span>\n                        <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"93\">Ended</span>\n                    </div>\n                    <h4 class=\"font-bold text-[#0A3D62] text-sm truncate\" data-kid=\"94\">Transport Infrastructure Feed</h4>\n                    <div class=\"flex items-center justify-between mt-2\" data-kid=\"95\">\n                        <div class=\"flex items-center gap-1 text-gray-400\" data-kid=\"96\">\n                            <i class=\"ti ti-coin\" data-kid=\"97\"></i>\n                            <span class=\"text-sm font-extrabold\" data-kid=\"98\">3,000 <span class=\"text-[10px] font-medium text-gray-400\" data-kid=\"99\">FCFA</span></span>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"100\">5k/5k users</span>\n                    </div>\n                </div>\n                <div class=\"shrink-0\" data-kid=\"101\">\n                    <button class=\"w-8 h-8 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center cursor-not-allowed\" data-kid=\"102\">\n                        <i class=\"ti ti-lock\" data-kid=\"103\"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        \n        <div id=\"variant-3\" class=\"variant-container\" data-kid=\"104\">\n            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"105\">\n                \n                <div class=\"survey-card-v3 bg-white rounded-2xl p-4 flex flex-col card-shadow border border-gray-100\" data-kid=\"106\">\n                    <div class=\"bg-[#F5F7FA] rounded-xl h-28 mb-3 flex items-center justify-center relative overflow-hidden group\" data-kid=\"107\">\n                        <i class=\"ti ti-building-hospital text-4xl text-[#0A3D62]/10 transition-transform group-hover:scale-110 duration-500\" data-kid=\"108\"></i>\n                        <div class=\"absolute top-2 right-2 bg-[#27AE60] text-white text-[7px] font-black px-1.5 py-0.5 rounded uppercase\" data-kid=\"109\">New</div>\n                    </div>\n                    <h3 class=\"text-xs font-extrabold text-[#0A3D62] mb-1 line-clamp-2 leading-tight\" data-kid=\"110\">Healthcare Access</h3>\n                    <div class=\"flex items-center gap-1.5 mb-4\" data-kid=\"111\">\n                        <i class=\"ti ti-users text-[11px] text-gray-400\" data-kid=\"112\"></i>\n                        <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"113\">1.5k participants</span>\n                    </div>\n                    <div class=\"mt-auto pt-4 border-t border-gray-50\" data-kid=\"114\">\n                        <div class=\"flex flex-col mb-3\" data-kid=\"115\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"116\">Reward</span>\n                            <span class=\"text-lg font-black text-[#F6A623]\" data-kid=\"117\">2,500 <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"118\">FCFA</span></span>\n                        </div>\n                        <button class=\"w-full bg-[#0A3D62] text-white py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest btn-shadow active:scale-95 transition-transform\" data-kid=\"119\">Take Part</button>\n                    </div>\n                </div>\n\n                \n                <div class=\"survey-card-v3 bg-white rounded-2xl p-4 flex flex-col card-shadow border border-gray-100\" data-kid=\"120\">\n                    <div class=\"bg-[#F5F7FA] rounded-xl h-28 mb-3 flex items-center justify-center relative overflow-hidden group\" data-kid=\"121\">\n                        <i class=\"ti ti-droplet text-4xl text-[#0A3D62]/10 transition-transform group-hover:scale-110 duration-500\" data-kid=\"122\"></i>\n                        <div class=\"absolute top-2 right-2 bg-red-500 text-white text-[7px] font-black px-1.5 py-0.5 rounded uppercase\" data-kid=\"123\">Ending</div>\n                    </div>\n                    <h3 class=\"text-sm font-extrabold text-[#0A3D62] mb-1 line-clamp-2 leading-tight\" data-kid=\"124\">Water Quality Survey</h3>\n                    <div class=\"flex items-center gap-1.5 mb-4\" data-kid=\"125\">\n                        <i class=\"ti ti-users text-[11px] text-gray-400\" data-kid=\"126\"></i>\n                        <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"127\">3.2k participants</span>\n                    </div>\n                    <div class=\"mt-auto pt-4 border-t border-gray-50\" data-kid=\"128\">\n                        <div class=\"flex flex-col mb-3\" data-kid=\"129\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"130\">Reward</span>\n                            <span class=\"text-lg font-black text-[#F6A623]\" data-kid=\"131\">1,800 <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"132\">FCFA</span></span>\n                        </div>\n                        <button class=\"w-full bg-[#0A3D62] text-white py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest btn-shadow active:scale-95 transition-transform\" data-kid=\"133\">Take Part</button>\n                    </div>\n                </div>\n\n                \n                <div class=\"survey-card-v3 bg-white rounded-2xl p-4 flex flex-col card-shadow border border-gray-100\" data-kid=\"134\">\n                    <div class=\"bg-[#F5F7FA] rounded-xl h-28 mb-3 flex items-center justify-center relative overflow-hidden group\" data-kid=\"135\">\n                        <i class=\"ti ti-bulb text-4xl text-[#0A3D62]/10 transition-transform group-hover:scale-110 duration-500\" data-kid=\"136\"></i>\n                    </div>\n                    <h3 class=\"text-xs font-extrabold text-[#0A3D62] mb-1 line-clamp-2 leading-tight\" data-kid=\"137\">Energy Consumption</h3>\n                    <div class=\"flex items-center gap-1.5 mb-4\" data-kid=\"138\">\n                        <i class=\"ti ti-users text-[11px] text-gray-400\" data-kid=\"139\"></i>\n                        <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"140\">900 participants</span>\n                    </div>\n                    <div class=\"mt-auto pt-4 border-t border-gray-50\" data-kid=\"141\">\n                        <div class=\"flex flex-col mb-3\" data-kid=\"142\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"143\">Reward</span>\n                            <span class=\"text-lg font-black text-[#F6A623]\" data-kid=\"144\">4,000 <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"145\">FCFA</span></span>\n                        </div>\n                        <button class=\"w-full bg-[#0A3D62] text-white py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest btn-shadow active:scale-95 transition-transform\" data-kid=\"146\">Take Part</button>\n                    </div>\n                </div>\n\n                \n                <div class=\"survey-card-v3 bg-white rounded-2xl p-4 flex flex-col card-shadow border border-gray-100\" data-kid=\"147\">\n                    <div class=\"bg-[#F5F7FA] rounded-xl h-28 mb-3 flex items-center justify-center relative overflow-hidden group\" data-kid=\"148\">\n                        <i class=\"ti ti-books text-4xl text-[#0A3D62]/10 transition-transform group-hover:scale-110 duration-500\" data-kid=\"149\"></i>\n                    </div>\n                    <h3 class=\"text-xs font-extrabold text-[#0A3D62] mb-1 line-clamp-2 leading-tight\" data-kid=\"150\">Education Resources</h3>\n                    <div class=\"flex items-center gap-1.5 mb-4\" data-kid=\"151\">\n                        <i class=\"ti ti-users text-[11px] text-gray-400\" data-kid=\"152\"></i>\n                        <span class=\"text-[10px] text-gray-400 font-bold\" data-kid=\"153\">120 participants</span>\n                    </div>\n                    <div class=\"mt-auto pt-4 border-t border-gray-50\" data-kid=\"154\">\n                        <div class=\"flex flex-col mb-3\" data-kid=\"155\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"156\">Reward</span>\n                            <span class=\"text-lg font-black text-[#F6A623]\" data-kid=\"157\">5,500 <span class=\"text-[10px] font-bold text-gray-400\" data-kid=\"158\">FCFA</span></span>\n                        </div>\n                        <button class=\"w-full bg-[#0A3D62] text-white py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest btn-shadow active:scale-95 transition-transform\" data-kid=\"159\">Take Part</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] bg-white border-t border-gray-100 px-6 pt-3 pb-8 flex items-center justify-between z-50 rounded-t-3xl shadow-[0_-4px_16px_rgba(0,0,0,0.04)]\" data-kid=\"160\">\n        <button class=\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"161\">\n            <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]\" data-kid=\"162\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"163\">Home</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 relative\" data-kid=\"164\">\n            <i class=\"ti ti-checklist text-2xl text-[#0A3D62]\" data-kid=\"165\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"166\">Surveys</span>\n            <div class=\"absolute -bottom-1 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"167\"></div>\n        </button>\n\n        \n        <div class=\"relative -top-8 flex flex-col items-center\" data-kid=\"168\">\n            <button class=\"w-14 h-14 bg-[#0A3D62] rounded-full flex items-center justify-center text-white shadow-xl shadow-[#0A3D62]/20 border-[3px] border-white active:scale-90 transition-transform group\" data-kid=\"169\">\n                <i class=\"ti ti-plus text-2xl group-hover:rotate-90 transition-transform duration-300\" data-kid=\"170\"></i>\n            </button>\n        </div>\n\n        <button class=\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"171\">\n            <i class=\"ti ti-wallet text-2xl text-[#0A3D62]\" data-kid=\"172\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"173\">Wallet</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"174\">\n            <i class=\"ti ti-user-circle text-2xl text-[#0A3D62]\" data-kid=\"175\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"176\">Account</span>\n        </button>\n    </nav>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"177\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"178\"></script>\n    <script type=\"module\" data-kid=\"179\">\n        import { animate, scroll, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Initialize Lenis\n        const lenis = new Lenis({\n            autoRaf: true,\n            lerp: 0.1,\n            smoothWheel: true,\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // Global functions for tab switching\n        window.switchVariant = (id) => {\n            // Update Tabs\n            document.querySelectorAll('.tab-btn').forEach(btn => {\n                btn.classList.remove('tab-active');\n                btn.classList.add('text-gray-500');\n            });\n            document.getElementById(`tab-${id}`).classList.add('tab-active');\n            document.getElementById(`tab-${id}`).classList.remove('text-gray-500');\n\n            // Hide/Show Containers\n            document.querySelectorAll('.variant-container').forEach(cont => {\n                cont.classList.remove('active');\n            });\n            const activeCont = document.getElementById(`variant-${id}`);\n            activeCont.classList.add('active');\n\n            // Trigger Animation for new content\n            const targetClass = `.survey-card-v${id}`;\n            gsap.from(targetClass, {\n                y: 30,\n                opacity: 0,\n                duration: 0.6,\n                stagger: 0.1,\n                ease: \"power3.out\"\n            });\n        };\n\n        // Initial entrance animations\n        gsap.from(\"header\", {\n            y: -50,\n            opacity: 0,\n            duration: 1,\n            ease: \"expo.out\"\n        });\n\n        gsap.from(\".survey-card-v1\", {\n            y: 40,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.15,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n\n        // Motion hover/press effects\n        inView(\".survey-card-v1, .survey-card-v2, .survey-card-v3\", ({ target }) => {\n            // Just a check to ensure they are visible\n        });\n        \n    </script>\n</div>\n",
