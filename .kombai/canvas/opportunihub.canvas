FA</span></span>\n                        </div>\n                        <button class=\"w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center text-[#0A3D62]\" data-kid=\"38\">\n                            <i class=\"ti ti-chevron-right text-lg\" data-kid=\"39\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"history-item-classic bg-white rounded-3xl p-4 shadow-sm border border-gray-100 flex gap-4\" data-kid=\"40\">\n                <div class=\"w-20 h-20 rounded-2xl overflow-hidden shrink-0 border border-gray-50\" data-kid=\"41\">\n                    <img src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=200&q=80&fit=crop\" alt=\"Decor\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"42\">\n                </div>\n                <div class=\"flex-1 flex flex-col justify-between py-0.5\" data-kid=\"43\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"44\">\n                        <div class=\"flex flex-col\" data-kid=\"45\">\n                            <h3 class=\"font-['Plus_Jakarta_Sans'] font-bold text-sm text-[#0A3D62] leading-tight mb-1\" data-kid=\"46\">Artisanal Decor</h3>\n                            <span class=\"text-[10px] text-gray-400 font-medium\" data-kid=\"47\">08 Oct 2023 • 09:15</span>\n                        </div>\n                        <span class=\"text-[10px] font-black px-2.5 py-1 rounded-lg status-green uppercase tracking-tighter shadow-sm\" data-kid=\"48\">Validé</span>\n                    </div>\n                    <div class=\"flex justify-between items-end\" data-kid=\"49\">\n                        <div class=\"flex flex-col\" data-kid=\"50\">\n                            <span class=\"text-[9px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"51\">Payé</span>\n                            <span cla