    "var_b35fa2998b38": {
      "type": "variant",
      "label": "Survey Responder (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 29935,
        "y": 9.936904774200912,
        "w": 375,
        "h": 812
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --primary: #0A3D62;\n        --accent: #F6A623;\n        --success: #27AE60;\n        --error: #E74C3C;\n        --bg: #F5F7FA;\n        --text: #1A1A2E;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .scrollbar-hide::-webkit-scrollbar { display: none; }\n    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* Custom styles for survey components */\n    .survey-screen {\n        width: 375px;\n        height: 760px;\n        background-color: white;\n        flex-shrink: 0;\n        display: flex;\n        flex-direction: column;\n        overflow: hidden;\n        position: relative;\n        box-shadow: 0 40px 100px -20px rgba(10, 61, 98, 0.2), 0 0 0 1px rgba(10, 61, 98, 0.05);\n        border-radius: 40px;\n        border: 10px solid #1A1A2E; /* Slightly thicker frame */\n    }\n\n    .radio-card input:checked + .card-content {\n        border-color: var(--primary);\n        background-color: white;\n        box-shadow: 0 16px 32px -12px rgba(10, 61, 98, 0.15);\n        transform: translateY(-2px);\n    }\n    \n    .radio-card input:checked + .card-content .check-icon {\n        display: flex;\n        opacity: 1;\n    }\n\n    .checkbox-card input:checked + .card-content {\n        border-color: var(--accent);\n        background-color: white;\n        box-shadow: 0 16px 32px -12px rgba(246, 166, 35, 0.25);\n        transform: translateY(-4px);\n    }\n\n    .checkbox-card input:checked + .card-content .check-box {\n        background-color: var(--accent);\n        border-color: var(--accent);\n    }\n\n    .step-indicator-bar {\n        transition: width 0.8s cubic-bezier(0.65, 0, 0.35, 1);\n    }\n\n    .neo-shadow {\n        box-shadow: 0 10px 30px -10px rgba(10, 61, 98, 0.12);\n    }\n\n    /* Floating reward badge animation */\n    @keyframes float {\n        0%, 100% { transform: translateY(0); }\n        50% { transform: translateY(-5px); }\n    }\n    .animate-float {\n        animation: float 3s ease-in-out infinite;\n    }\n\n    /* Glass effect */\n    .glass-btn {\n        background: rgba(255, 255, 255, 0.15);\n        backdrop-filter: blur(8px);\n        border: 1px solid rgba(255, 255, 255, 0.2);\n    }\n</style>\n\n<div class=\"bg-[#F8FAFC] min-h-screen py-24 px-4 font-vietnam antialiased overflow-x-clip\" data-kid=\"1\">\n    \n    <div class=\"max-w-7xl mx-auto mb-20 text-center\" data-kid=\"2\">\n        <div class=\"inline-flex items-center gap-2 bg-[var(--primary)]/5 text-[var(--primary)] px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-[0.2em] mb-6\" data-kid=\"3\">\n            <i class=\"ti ti-device-mobile\" data-kid=\"4\"></i>\n            <span data-kid=\"5\">Mobile SDK Components</span>\n        </div>\n        <h1 class=\"text-5xl md:text-6xl font-black text-[var(--primary)] font-plus mb-6 tracking-tighter\" data-kid=\"6\">Survey Responder</h1>\n        <p class=\"text-[var(--text)]/60 font-bold uppercase tracking-[0.3em] text-[10px] max-w-md mx-auto\" data-kid=\"7\">Modern interfaces for high-conversion user feedback collection.</p>\n    </div>\n\n    \n    <div class=\"flex flex-col xl:flex-row gap-20 items-start justify-center overflow-x-auto pb-24 scrollbar-hide px-8 snap-x\" data-kid=\"8\">\n        \n        \n        <div class=\"flex flex-col gap-6 snap-center\" data-kid=\"9\">\n            <div class=\"px-6 border-l-4 border-[var(--primary)]\" data-kid=\"10\">\n                <h3 class=\"font-black text-[var(--primary)] text-xl font-plus\" data-kid=\"11\">01. Choix Unique</h3>\n                <p class=\"text-xs font-bold text-[var(--text)]/60 uppercase tracking-widest mt-1\" data-kid=\"12\">Single Selection Module</p>\n            </div>\n            <section class=\"survey-screen\" id=\"variant-1\" data-kid=\"13\">\n            \n            <header class=\"bg-[var(--primary)] text-white p-6 pb-12 relative overflow-hidden shrink-0\" data-kid=\"14\">\n                <div class=\"absolute -right-8 -top-8 p-8 opacity-10\" data-kid=\"15\">\n                    <i class=\"ti ti-gift text-[120px] rotate-12\" data-kid=\"16\"></i>\n                </div>\n                \n                <div class=\"flex items-center justify-between relative z-10 mb-8\" data-kid=\"17\">\n                    <button class=\"w-12 h-12 rounded-2xl glass-btn flex items-center justify-center\" data-kid=\"18\">\n                        <i class=\"ti ti-chevron-left text-xl\" data-kid=\"19\"></i>\n                    </button>\n                    <div class=\"text-center animate-float\" data-kid=\"20\">\n                        <p class=\"text-[10px] uppercase tracking-[0.2em] font-black opacity-60 mb-0.5\" data-kid=\"21\">Gagnez</p>\n                        <p class=\"text-xl font-black font-plus\" data-kid=\"22\">2 500 <span class=\"text-xs opacity-70\" data-kid=\"23\">FCFA</span></p>\n                    </div>\n                    <button class=\"w-12 h-12 rounded-2xl glass-btn flex items-center justify-center\" data-kid=\"24\">\n                        <i class=\"ti ti-dots-vertical text-xl\" data-kid=\"25\"></i>\n                    </button>\n                </div>\n                \n                <div class=\"relative z-10\" data-kid=\"26\">\n                    <div class=\"flex justify-between items-end mb-3\" data-kid=\"27\">\n                        <div class=\"flex flex-col\" data-kid=\"28\">\n                            <span class=\"text-[10px] font-black uppercase tracking-widest opacity-50\" data-kid=\"29\">Sondage Express</span>\n                            <span class=\"text-sm font-bold\" data-kid=\"30\">Question 3 <span class=\"opacity-40 font-medium\" data-kid=\"31\">/ 8</span></span>\n                        </div>\n                        <span class=\"text-xs font-black text-[var(--accent)] bg-[var(--accent)]/10 px-2 py-0.5 rounded-md\" data-kid=\"32\">35%</span>\n                    </div>\n                    <div class=\"h-2 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"33\">\n                        <div class=\"h-full bg-[var(--accent)] rounded-full step-indicator-bar\" style=\"width: 35%;\" data-kid=\"34\"></div>\n                    </div>\n                </div>\n            </header>\n\n            \n            <main class=\"flex-grow p-6 -mt-6 bg-[var(--bg)] rounded-t-[2.5rem] relative z-20 overflow-y-auto scrollbar-hide\" data-kid=\"35\">\n                <div class=\"space-y-8 py-4\" data-kid=\"36\">\n                    <h2 class=\"text-2xl font-black text-[var(--primary)] font-plus leading-tight stagger-item\" data-kid=\"37\">\n                        À quelle fréquence achetez-vous des produits locaux ?\n                    </h2>\n                    \n                    <div class=\"space-y-4\" data-kid=\"38\">\n                        <label class=\"radio-card block cursor-pointer stagger-item\" data-kid=\"39\">\n                            <input type=\"radio\" name=\"v1-freq\" class=\"hidden\" checked data-kid=\"40\">\n                            <div class=\"card-content flex items-center justify-between p-6 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300\" data-kid=\"41\">\n                                <div class=\"flex items-center gap-5\" data-kid=\"42\">\n                                    <i class=\"ti ti-calendar-event text-2xl text-[var(--accent)]\" data-kid=\"43\"></i>\n                                    <span class=\"font-bold text-[var(--primary)]\" data-kid=\"44\">Tous les jours</span>\n                                </div>\n                                <div class=\"check-icon w-6 h-6 rounded-full bg-[var(--primary)] text-white flex items-center justify-center opacity-0 transition-opacity\" data-kid=\"45\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"46\"></i>\n                                </div>\n                            </div>\n                        </label>\n                        \n                        <label class=\"radio-card block cursor-pointer stagger-item\" data-kid=\"47\">\n                            <input type=\"radio\" name=\"v1-freq\" class=\"hidden\" data-kid=\"48\">\n                            <div class=\"card-content flex items-center justify-between p-6 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300\" data-kid=\"49\">\n                                <div class=\"flex items-center gap-5\" data-kid=\"50\">\n                                    <i class=\"ti ti-calendar-week text-2xl text-[var(--primary)]\" data-kid=\"51\"></i>\n                                    <span class=\"font-bold text-[var(--text)]/60\" data-kid=\"52\">Une fois par semaine</span>\n                                </div>\n                                <div class=\"check-icon w-6 h-6 rounded-full bg-[var(--primary)] text-white flex items-center justify-center opacity-0 transition-opacity\" data-kid=\"53\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"54\"></i>\n                                </div>\n                            </div>\n                        </label>\n\n                        <label class=\"radio-card block cursor-pointer stagger-item\" data-kid=\"55\">\n                            <input type=\"radio\" name=\"v1-freq\" class=\"hidden\" data-kid=\"56\">\n                            <div class=\"card-content flex items-center justify-between p-6 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300\" data-kid=\"57\">\n                                <div class=\"flex items-center gap-5\" data-kid=\"58\">\n                                    <i class=\"ti ti-clock text-2xl text-[var(--text)]/20\" data-kid=\"59\"></i>\n                                    <span class=\"font-bold text-[var(--text)]/60\" data-kid=\"60\">Rarement</span>\n                                </div>\n                                <div class=\"check-icon w-6 h-6 rounded-full bg-[var(--primary)] text-white flex items-center justify-center opacity-0 transition-opacity\" data-kid=\"61\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"62\"></i>\n                                </div>\n                            </div>\n                        </label>\n                    </div>\n                </div>\n            </main>\n\n            \n            <footer class=\"p-6 bg-white shrink-0 border-t border-gray-100 flex items-center gap-4\" data-kid=\"63\">\n                <button class=\"flex-grow h-16 bg-[var(--primary)] text-white rounded-3xl font-black uppercase tracking-[0.2em] text-xs flex items-center justify-center gap-3 shadow-xl shadow-[var(--primary)]/20 active:scale-95 transition-transform\" data-kid=\"64\">\n                    <span data-kid=\"65\">Suivant</span>\n                    <i class=\"ti ti-arrow-right text-lg\" data-kid=\"66\"></i>\n                </button>\n            </footer>\n        </section>\n\n        \n        <div class=\"flex flex-col gap-6 snap-center\" data-kid=\"67\">\n            <div class=\"px-6 border-l-4 border-[var(--accent)]\" data-kid=\"68\">\n                <h3 class=\"font-black text-[var(--primary)] text-xl font-plus\" data-kid=\"69\">02. Choix Multiples</h3>\n                <p class=\"text-xs font-bold text-[var(--text)]/60 uppercase tracking-widest mt-1\" data-kid=\"70\">Multi-Selection Grid</p>\n            </div>\n            <section class=\"survey-screen\" id=\"variant-2\" data-kid=\"71\">\n            \n            <header class=\"bg-[var(--primary)] text-white p-6 pb-12 relative overflow-hidden shrink-0\" data-kid=\"72\">\n                <div class=\"absolute -left-8 -top-8 p-8 opacity-10\" data-kid=\"73\">\n                    <i class=\"ti ti-clipboard-check text-[140px] -rotate-12\" data-kid=\"74\"></i>\n                </div>\n                \n                <div class=\"flex items-center justify-between relative z-10 mb-8\" data-kid=\"75\">\n                    <button class=\"w-12 h-12 rounded-2xl glass-btn flex items-center justify-center\" data-kid=\"76\">\n                        <i class=\"ti ti-x text-xl\" data-kid=\"77\"></i>\n                    </button>\n                    <div class=\"bg-[var(--accent)] text-[var(--primary)] px-5 py-2 rounded-2xl font-black text-sm shadow-lg animate-pulse\" data-kid=\"78\">\n                        +2 500 FCFA\n                    </div>\n                    <button class=\"w-12 h-12 rounded-2xl glass-btn flex items-center justify-center\" data-kid=\"79\">\n                        <i class=\"ti ti-info-circle text-xl\" data-kid=\"80\"></i>\n                    </button>\n                </div>\n                \n                <div class=\"relative z-10\" data-kid=\"81\">\n                    <div class=\"flex justify-between items-center mb-3\" data-kid=\"82\">\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.2em] opacity-50\" data-kid=\"83\">Étape 5 / 8</span>\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"84\">62% Terminé</span>\n                    </div>\n                    <div class=\"h-2 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"85\">\n                        <div class=\"h-full bg-[var(--accent)] rounded-full step-indicator-bar\" style=\"width: 62%;\" data-kid=\"86\"></div>\n                    </div>\n                </div>\n            </header>\n\n            \n            <main class=\"flex-grow p-6 -mt-6 bg-[var(--bg)] rounded-t-[2.5rem] relative z-20 overflow-y-auto scrollbar-hide\" data-kid=\"87\">\n                <div class=\"space-y-8 py-4\" data-kid=\"88\">\n                    <div class=\"space-y-2 stagger-item\" data-kid=\"89\">\n                        <h2 class=\"text-2xl font-black text-[var(--primary)] font-plus leading-tight\" data-kid=\"90\">\n                            Quels produits achetez-vous le plus souvent ?\n                        </h2>\n                        <p class=\"text-xs text-[var(--text)]/50 font-bold uppercase tracking-widest\" data-kid=\"91\">Plusieurs choix possibles</p>\n                    </div>\n                    \n                    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"92\">\n                        <label class=\"checkbox-card cursor-pointer stagger-item\" data-kid=\"93\">\n                            <input type=\"checkbox\" class=\"hidden\" checked data-kid=\"94\">\n                            <div class=\"card-content p-5 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300 h-full flex flex-col gap-2 relative\" data-kid=\"95\">\n                                <div class=\"check-box w-6 h-6 rounded-lg border-2 border-gray-200 flex items-center justify-center text-white transition-colors absolute top-4 right-4\" data-kid=\"96\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"97\"></i>\n                                </div>\n                                <i class=\"ti ti-tools-kitchen-2 text-3xl text-[var(--accent)] mb-2\" data-kid=\"98\"></i>\n                                <span class=\"font-black text-[13px] text-[var(--primary)] leading-tight\" data-kid=\"99\">Produits Alimentaires</span>\n                            </div>\n                        </label>\n\n                        <label class=\"checkbox-card cursor-pointer stagger-item\" data-kid=\"100\">\n                            <input type=\"checkbox\" class=\"hidden\" checked data-kid=\"101\">\n                            <div class=\"card-content p-5 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300 h-full flex flex-col gap-2 relative\" data-kid=\"102\">\n                                <div class=\"check-box w-6 h-6 rounded-lg border-2 border-gray-200 flex items-center justify-center text-white transition-colors absolute top-4 right-4\" data-kid=\"103\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"104\"></i>\n                                </div>\n                                <i class=\"ti ti-device-mobile text-3xl text-[var(--primary)] mb-2\" data-kid=\"105\"></i>\n                                <span class=\"font-black text-[13px] text-[var(--primary)] leading-tight\" data-kid=\"106\">High-Tech & Mobile</span>\n                            </div>\n                        </label>\n\n                        <label class=\"checkbox-card cursor-pointer stagger-item\" data-kid=\"107\">\n                            <input type=\"checkbox\" class=\"hidden\" data-kid=\"108\">\n                            <div class=\"card-content p-5 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300 h-full flex flex-col gap-2 relative\" data-kid=\"109\">\n                                <div class=\"check-box w-6 h-6 rounded-lg border-2 border-gray-200 flex items-center justify-center text-white transition-colors absolute top-4 right-4\" data-kid=\"110\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"111\"></i>\n                                </div>\n                                <i class=\"ti ti-shirt text-3xl text-[var(--text)]/20 mb-2\" data-kid=\"112\"></i>\n                                <span class=\"font-black text-[13px] text-[var(--text)]/40 leading-tight\" data-kid=\"113\">Mode & Vêtements</span>\n                            </div>\n                        </label>\n\n                        <label class=\"checkbox-card cursor-pointer stagger-item\" data-kid=\"114\">\n                            <input type=\"checkbox\" class=\"hidden\" data-kid=\"115\">\n                            <div class=\"card-content p-5 bg-white border-2 border-gray-100 rounded-2xl shadow-sm transition-all duration-300 h-full flex flex-col gap-2 relative\" data-kid=\"116\">\n                                <div class=\"check-box w-6 h-6 rounded-lg border-2 border-gray-200 flex items-center justify-center text-white transition-colors absolute top-4 right-4\" data-kid=\"117\">\n                                    <i class=\"ti ti-check text-xs\" data-kid=\"118\"></i>\n                                </div>\n                                <i class=\"ti ti-armchair text-3xl text-[var(--text)]/20 mb-2\" data-kid=\"119\"></i>\n                                <span class=\"font-black text-[13px] text-[var(--text)]/40 leading-tight\" data-kid=\"120\">Maison & Déco</span>\n                            </div>\n                        </label>\n                    </div>\n                </div>\n            </main>\n\n            \n            <footer class=\"p-6 bg-white shrink-0 border-t border-gray-100\" data-kid=\"121\">\n                <button class=\"w-full h-16 bg-[var(--primary)] text-white rounded-3xl font-black uppercase tracking-[0.2em] text-xs flex items-center justify-center gap-3 shadow-xl shadow-[var(--primary)]/20 active:scale-95 transition-transform\" data-kid=\"122\">\n                    <span data-kid=\"123\">Continuer</span>\n                    <i class=\"ti ti-chevron-right text-lg\" data-kid=\"124\"></i>\n                </button>\n            </footer>\n        </section>\n\n        \n        <div class=\"flex flex-col gap-6 snap-center\" data-kid=\"125\">\n            <div class=\"px-6 border-l-4 border-gray-300\" data-kid=\"126\">\n                <h3 class=\"font-black text-[var(--primary)] text-xl font-plus\" data-kid=\"127\">03. Champ Texte</h3>\n                <p class=\"text-xs font-bold text-[var(--text)]/60 uppercase tracking-widest mt-1\" data-kid=\"128\">Open Feedback Form</p>\n            </div>\n            <section class=\"survey-screen\" id=\"variant-3\" data-kid=\"129\">\n            \n            <header class=\"bg-[var(--bg)] p-6 pb-12 shrink-0\" data-kid=\"130\">\n                <div class=\"flex items-center justify-between mb-8\" data-kid=\"131\">\n                     <button class=\"w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-sm border border-gray-100\" data-kid=\"132\">\n                        <i class=\"ti ti-arrow-left text-[var(--primary)] text-xl\" data-kid=\"133\"></i>\n                    </button>\n                    <div class=\"flex flex-col items-center\" data-kid=\"134\">\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--text)]/30\" data-kid=\"135\">Question Finale</span>\n                        <div class=\"flex items-center gap-1.5 mt-0.5\" data-kid=\"136\">\n                            <div class=\"flex gap-1\" data-kid=\"137\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--primary)]\" data-kid=\"138\"></div>\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--primary)]\" data-kid=\"139\"></div>\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--primary)]\" data-kid=\"140\"></div>\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--accent)]\" data-kid=\"141\"></div>\n                            </div>\n                            <span class=\"text-xs font-black text-[var(--primary)]\" data-kid=\"142\">8/8</span>\n                        </div>\n                    </div>\n                     <button class=\"w-12 h-12 rounded-2xl bg-[var(--accent)]/10 flex items-center justify-center text-[var(--accent)]\" data-kid=\"143\">\n                        <i class=\"ti ti-help text-xl\" data-kid=\"144\"></i>\n                    </button>\n                </div>\n\n                <div class=\"bg-[var(--primary)] rounded-[2rem] p-8 text-white relative overflow-hidden stagger-item\" data-kid=\"145\">\n                    <div class=\"absolute right-0 bottom-0 p-4 opacity-10\" data-kid=\"146\">\n                        <i class=\"ti ti-message-dots text-8xl\" data-kid=\"147\"></i>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"148\">\n                        <div class=\"inline-flex items-center gap-2 bg-white/10 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest mb-6\" data-kid=\"149\">\n                            <i class=\"ti ti-bulb-filled text-[var(--accent)]\" data-kid=\"150\"></i>\n                            Votre Avis Compte\n                        </div>\n                        <h2 class=\"text-2xl font-black font-plus leading-tight\" data-kid=\"151\">\n                            Comment pouvons-nous améliorer votre expérience ?\n                        </h2>\n                    </div>\n                </div>\n            </header>\n\n            \n            <main class=\"flex-grow p-6 bg-white rounded-t-[3rem] shadow-[0_-20px_50px_-12px_rgba(0,0,0,0.05)] relative z-20 overflow-y-auto scrollbar-hide\" data-kid=\"152\">\n                <div class=\"space-y-6 py-4 stagger-item\" data-kid=\"153\">\n                    <div class=\"relative\" data-kid=\"154\">\n                        <textarea placeholder=\"Partagez vos impressions ici...\" class=\"w-full min-h-[220px] p-8 bg-[var(--bg)] border-2 border-gray-100 focus:border-[var(--primary)] rounded-3xl focus:outline-none font-bold text-[var(--text)] placeholder:text-[var(--text)]/50 resize-none transition-all text-lg leading-relaxed shadow-inner\" data-kid=\"155\"></textarea>\n                        <div class=\"absolute bottom-6 right-8\" data-kid=\"156\">\n                            <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm text-[var(--text)]/20\" data-kid=\"157\">\n                                <i class=\"ti ti-pencil text-xl\" data-kid=\"158\"></i>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"flex justify-between items-center px-4\" data-kid=\"159\">\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--text)]/30\" data-kid=\"160\">Max. 500 caractères</span>\n                        <div class=\"flex items-center gap-2 text-[var(--success)] opacity-60\" data-kid=\"161\">\n                            <i class=\"ti ti-cloud-check text-lg\" data-kid=\"162\"></i>\n                            <span class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"163\">Sauvegardé</span>\n                        </div>\n                    </div>\n                </div>\n            </main>\n\n            \n            <footer class=\"p-6 bg-white shrink-0\" data-kid=\"164\">\n                <button class=\"w-full h-18 bg-[var(--accent)] text-[var(--primary)] rounded-3xl font-black uppercase tracking-[0.2em] text-xs flex items-center justify-center gap-3 shadow-xl shadow-[var(--accent)]/30 active:scale-95 transition-all\" data-kid=\"165\">\n                    <span data-kid=\"166\">Terminer & Encaisser</span>\n                    <i class=\"ti ti-wallet text-xl\" data-kid=\"167\"></i>\n                </button>\n                <div class=\"flex items-center justify-center gap-2 mt-6 py-2 px-4 bg-gray-50 rounded-2xl w-max mx-auto\" data-kid=\"168\">\n                    <i class=\"ti ti-shield-check text-[var(--success)] text-lg\" data-kid=\"169\"></i>\n                    <p class=\"text-[9px] font-bold text-[var(--text)]/40 uppercase tracking-widest leading-none\" data-kid=\"170\">Paiement sécurisé via Wallet</p>\n                </div>\n            </footer>\n        </section>\n\n    </div>\n\n    \n        </div>\n    </div>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"171\"></script>\n<script data-kid=\"172\">\n    // Entrance animations\n    document.addEventListener('DOMContentLoaded', () => {\n        gsap.from(\".survey-screen\", {\n            y: 50,\n            opacity: 0,\n            duration: 1.2,\n            stagger: 0.3,\n            ease: \"expo.out\"\n        });\n\n        // Stagger children inside each screen\n        document.querySelectorAll('.survey-screen').forEach(screen => {\n            const items = screen.querySelectorAll('.stagger-item');\n            gsap.from(items, {\n                y: 20,\n                opacity: 0,\n                duration: 0.8,\n                stagger: 0.1,\n                ease: \"power2.out\",\n                delay: 0.5\n            });\n        });\n    });\n\n    // Custom interaction for visual feedback\n    document.querySelectorAll('.radio-card, .checkbox-card').forEach(card => {\n        card.addEventListener('click', () => {\n            gsap.fromTo(card, { scale: 1 }, { scale: 0.97, duration: 0.1, yoyo: true, repeat: 1 });\n        });\n    });\n</script>\n</div>",
