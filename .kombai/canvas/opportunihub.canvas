      "html": "\n<div class=\"bg-[#F5F7FA] text-[#0A3D62] font-['Be_Vietnam_Pro'] min-h-screen pb-36 selection:bg-[#F6A623]/30\" data-kid=\"0\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n    <style data-kid=\"2\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .scrollbar-hide::-webkit-scrollbar { display: none; }\n        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n        .proportion-bar-container {\n            height: 10px;\n            background: #E2E8F0;\n            border-radius: 9999px;\n            overflow: hidden;\n            display: flex;\n        }\n        .proportion-bar-fill {\n            height: 100%;\n            background: #27AE60;\n            border-radius: 9999px;\n        }\n\n        /* Custom shadow for the orange button */\n        .btn-orange-shadow {\n            box-shadow: 0 4px 0 0 #D98517;\n        }\n        .btn-orange-shadow:active {\n            box-shadow: 0 0px 0 0 #D98517;\n            transform: translateY(4px);\n        }\n\n        .glass-header {\n            background: rgba(255, 255, 255, 0.9);\n            backdrop-filter: blur(12px);\n        }\n        .featured-glow {\n            box-shadow: 0 0 40px -10px rgba(246, 166, 35, 0.3);\n        }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-40 glass-header border-b border-gray-100 px-4 py-4 flex items-center justify-between max-w-[375px] mx-auto shadow-sm\" data-kid=\"3\">\n        <div class=\"flex items-center gap-2\" data-kid=\"4\">\n            <div class=\"w-9 h-9 bg-[#0A3D62] rounded-xl flex items-center justify-center text-white shadow-lg\" data-kid=\"5\">\n                <i class=\"ti ti-building-community text-xl\" data-kid=\"6\"></i>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"7\">\n                <h1 class=\"text-[#0A3D62] font-['Plus_Jakarta_Sans'] font-extrabold text-lg leading-none\" data-kid=\"8\">OpportuniHub</h1>\n                <span class=\"text-[10px] text-[#27AE60] font-bold uppercase tracking-widest\" data-kid=\"9\">Community Power</span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2.5\" data-kid=\"10\">\n            <div class=\"bg-[#0A3D62] text-white pl-2 pr-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-md\" data-kid=\"11\">\n                <i class=\"ti ti-wallet text-sm text-[#F6A623]\" data-kid=\"12\"></i>\n                <span data-kid=\"13\">12,480 <span class=\"text-[10px] opacity-70\" data-kid=\"14\">FCFA</span></span>\n            </div>\n            <div class=\"w-10 h-10 rounded-full border-2 border-[#0A3D62]/10 overflow-hidden ring-2 ring-white\" data-kid=\"15\">\n                <img src=\"https://i.pravatar.cc/100?u=opportunihub_user\" alt=\"Profile\" class=\"w-full h-full object-cover\" data-kid=\"16\">\n            </div>\n        </div>\n    </header>\n\n    <main class=\"max-w-[375px] mx-auto overflow-x-clip\" data-kid=\"17\">\n        \n        <section class=\"p-4 pt-6\" data-kid=\"18\">\n            <div class=\"grid grid-cols-2 gap-3\" id=\"stats-container\" data-kid=\"19\">\n                <div class=\"stat-card col-span-2 bg-[#0A3D62] p-6 rounded-2xl text-white relative overflow-hidden shadow-xl shadow-[#0A3D62]/10\" data-kid=\"20\">\n                    <div class=\"relative z-10\" data-kid=\"21\">\n                        <div class=\"flex items-center gap-2 mb-1 opacity-70\" data-kid=\"22\">\n                            <i class=\"ti ti-lock-open-2 text-sm\" data-kid=\"23\"></i>\n                            <p class=\"text-xs font-semibold uppercase tracking-wider\" data-kid=\"24\">Community Savings Unlocked</p>\n                        </div>\n                        <h2 class=\"text-4xl font-['Plus_Jakarta_Sans'] font-extrabold mb-1\" data-kid=\"25\">\n                            <span id=\"savings-count\" data-kid=\"26\">0</span>\n                            <span class=\"text-lg font-bold\" data-kid=\"27\">FCFA</span>\n                        </h2>\n                        <div class=\"flex items-center gap-1.5 mt-2 bg-white/10 w-fit px-2 py-1 rounded-lg\" data-kid=\"28\">\n                            <i class=\"ti ti-trending-up text-[#27AE60]\" data-kid=\"29\"></i>\n                            <p class=\"text-[10px] font-bold text-white/90\" data-kid=\"30\">+12.5% vs last month</p>\n                        </div>\n                    </div>\n                    <div class=\"absolute -right-6 -bottom-6 opacity-10\" data-kid=\"31\">\n                        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/gem-chain.svg\" class=\"w-40 h-40 filter invert\" data-kid=\"32\">\n                    </div>\n                </div>\n\n                <div class=\"stat-card bg-white p-5 rounded-2xl border-2 border-[#E2E8F0] shadow-sm\" data-kid=\"33\">\n                    <div class=\"w-8 h-8 bg-[#0A3D62]/5 text-[#0A3D62] rounded-lg flex items-center justify-center mb-3\" data-kid=\"34\">\n                        <i class=\"ti ti-shopping-cart text-lg\" data-kid=\"35\"></i>\n                    </div>\n                    <h3 class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62]\" data-kid=\"36\">24</h3>\n                    <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-wide\" data-kid=\"37\">Active Opportunities</p>\n                </div>\n\n                <div class=\"stat-card bg-white p-5 rounded-2xl border-2 border-[#E2E8F0] shadow-sm\" data-kid=\"38\">\n                    <div class=\"w-8 h-8 bg-[#0A3D62]/5 text-[#0A3D62] rounded-lg flex items-center justify-center mb-3\" data-kid=\"39\">\n                        <i class=\"ti ti-users-group text-lg\" data-kid=\"40\"></i>\n                    </div>\n                    <h3 class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62]\" data-kid=\"41\">1,284</h3>\n                    <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-wide\" data-kid=\"42\">Members Buying</p>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"px-4 mb-10\" data-kid=\"43\">\n            <div class=\"relative mb-8\" data-kid=\"44\">\n                <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xl\" data-kid=\"45\"></i>\n                <input type=\"text\" placeholder=\"Search products, groceries...\" class=\"w-full bg-white border-2 border-[#E2E8F0] rounded-2xl py-4 pl-12 pr-4 focus:border-[#0A3D62] focus:ring-4 focus:ring-[#0A3D62]/5 outline-none text-sm font-semibold transition-all\" data-kid=\"46\">\n            </div>\n\n            <div class=\"flex gap-2.5 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-hide\" id=\"category-pills\" data-kid=\"47\">\n                <button class=\"pill bg-[#0A3D62] text-white px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap shadow-lg shadow-[#0A3D62]/20\" data-kid=\"48\">All Deals</button>\n                <button class=\"pill bg-white text-gray-500 border-2 border-[#E2E8F0] px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap\" data-kid=\"49\">Textiles</button>\n                <button class=\"pill bg-white text-gray-500 border-2 border-[#E2E8F0] px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap\" data-kid=\"50\">Groceries</button>\n                <button class=\"pill bg-white text-gray-500 border-2 border-[#E2E8F0] px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap\" data-kid=\"51\">Home Goods</button>\n                <button class=\"pill bg-white text-gray-500 border-2 border-[#E2E8F0] px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap\" data-kid=\"52\">Electronics</button>\n            </div>\n        </section>\n\n        \n        <section class=\"px-4 mb-10 space-y-8\" id=\"product-grid\" data-kid=\"53\">\n            \n            \n            <div class=\"product-card bg-[#0A3D62] rounded-[2rem] overflow-hidden shadow-2xl shadow-[#0A3D62]/30 group border-b-8 border-[#F6A623] featured-glow\" data-kid=\"54\">\n                <div class=\"relative h-64 overflow-hidden\" data-kid=\"55\">\n                    <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=800&q=80&fit=crop\" alt=\"Premium African Wax Fabric\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90\" decoding=\"async\" loading=\"lazy\" data-kid=\"56\">\n                    <div class=\"absolute inset-0 bg-linear-to-t from-[#0A3D62] to-transparent opacity-80\" data-kid=\"57\"></div>\n                    <div class=\"absolute top-5 left-5 flex flex-col gap-2\" data-kid=\"58\">\n                        <div class=\"bg-[#F6A623] text-[#0A3D62] px-4 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-widest shadow-xl\" data-kid=\"59\">HOT DEAL</div>\n                        <div class=\"bg-white/20 backdrop-blur-md text-white px-3 py-1.5 rounded-xl text-[10px] font-bold uppercase tracking-wider\" data-kid=\"60\">Save 40%</div>\n                    </div>\n                    <div class=\"absolute bottom-6 left-5 text-white\" data-kid=\"61\">\n                        <h3 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-2xl leading-tight mb-1\" data-kid=\"62\">Premium Kente Wax</h3>\n                        <div class=\"flex items-center gap-2\" data-kid=\"63\">\n                            <span class=\"text-3xl font-extrabold text-[#F6A623]\" data-kid=\"64\">12,500 <span class=\"text-sm\" data-kid=\"65\">FCFA</span></span>\n                            <span class=\"text-xs text-white/50 line-through font-bold\" data-kid=\"66\">18,000 FCFA</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"p-6\" data-kid=\"67\">\n                    <div class=\"bg-white/5 p-4 rounded-2xl mb-6 border border-white/10\" data-kid=\"68\">\n                        <div class=\"flex justify-between items-end mb-2.5\" data-kid=\"69\">\n                            <span class=\"text-xs font-bold text-white/80\" data-kid=\"70\">Participation Power</span>\n                            <span class=\"text-xs font-extrabold text-[#F6A623]\" data-kid=\"71\">85% Fulfilled</span>\n                        </div>\n                        <div class=\"proportion-bar-container bg-white/10\" data-kid=\"72\">\n                            <div class=\"proportion-bar-fill bg-[#F6A623] w-[85%]\" data-kid=\"73\"></div>\n                        </div>\n                        <div class=\"flex items-center justify-between mt-3\" data-kid=\"74\">\n                            <div class=\"flex -space-x-2\" data-kid=\"75\">\n                                <img class=\"w-7 h-7 rounded-full border-2 border-[#0A3D62]\" src=\"https://i.pravatar.cc/100?u=1\" alt data-kid=\"76\">\n                                <img class=\"w-7 h-7 rounded-full border-2 border-[#0A3D62]\" src=\"https://i.pravatar.cc/100?u=2\" alt data-kid=\"77\">\n                                <img class=\"w-7 h-7 rounded-full border-2 border-[#0A3D62]\" src=\"https://i.pravatar.cc/100?u=3\" alt data-kid=\"78\">\n                                <div class=\"w-7 h-7 rounded-full bg-[#F6A623] border-2 border-[#0A3D62] flex items-center justify-center text-[10px] font-bold text-[#0A3D62]\" data-kid=\"79\">+12</div>\n                            </div>\n                            <div class=\"flex items-center gap-2 bg-[#F6A623] text-[#0A3D62] px-3 py-1 rounded-lg\" data-kid=\"80\">\n                                <i class=\"ti ti-clock-filled text-sm\" data-kid=\"81\"></i>\n                                <span class=\"text-xs font-black\" data-kid=\"82\">02:45:12</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <button class=\"btn-orange w-full bg-[#F6A623] text-[#0A3D62] py-5 rounded-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-sm uppercase tracking-widest btn-orange-shadow\" data-kid=\"83\">\n                        Join Group Buy\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"product-card bg-white rounded-3xl border-2 border-[#E2E8F0] overflow-hidden shadow-sm group\" data-kid=\"84\">\n                <div class=\"relative h-56 overflow-hidden\" data-kid=\"85\">\n                    <img src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=800&q=80&fit=crop\" alt=\"African Market Spices\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"86\">\n                    <div class=\"absolute top-4 left-4\" data-kid=\"87\">\n                        <div class=\"bg-[#27AE60] text-white px-3 py-1.5 rounded-xl text-[10px] font-bold uppercase tracking-wider shadow-lg\" data-kid=\"88\">Limited Stock</div>\n                    </div>\n                    <div class=\"absolute bottom-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-2xl flex items-center gap-2 text-[#F6A623] border border-[#F6A623]/20 shadow-xl\" data-kid=\"89\">\n                        <i class=\"ti ti-clock-filled text-lg\" data-kid=\"90\"></i>\n                        <span class=\"text-sm font-extrabold tracking-tight\" data-kid=\"91\">00:12:45</span>\n                    </div>\n                </div>\n\n                <div class=\"p-5\" data-kid=\"92\">\n                    <div class=\"flex justify-between items-start mb-2\" data-kid=\"93\">\n                        <h3 class=\"text-[#0A3D62] font-['Plus_Jakarta_Sans'] font-extrabold text-xl leading-tight\" data-kid=\"94\">Artisanal Home Decor</h3>\n                        <div class=\"bg-gray-100 p-2 rounded-xl text-gray-400\" data-kid=\"95\">\n                            <i class=\"ti ti-heart\" data-kid=\"96\"></i>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-500 text-xs mb-5 font-medium leading-relaxed\" data-kid=\"97\">Hand-crafted statues and decorative items from local master carvers.</p>\n\n                    <div class=\"flex items-baseline gap-3 mb-6\" data-kid=\"98\">\n                        <div class=\"flex flex-col\" data-kid=\"99\">\n                            <span class=\"text-[10px] text-gray-400 font-bold uppercase tracking-widest mb-1\" data-kid=\"100\">Group Price</span>\n                            <div class=\"flex items-center gap-2\" data-kid=\"101\">\n                                <span class=\"text-3xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62]\" data-kid=\"102\">25,000</span>\n                                <span class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"103\">FCFA</span>\n                            </div>\n                        </div>\n                        <span class=\"text-sm text-gray-400 line-through font-semibold mb-1\" data-kid=\"104\">32,000 FCFA</span>\n                    </div>\n\n                    <div class=\"bg-[#F5F7FA] p-4 rounded-2xl mb-6\" data-kid=\"105\">\n                        <div class=\"flex justify-between items-end mb-2.5\" data-kid=\"106\">\n                            <span class=\"text-xs font-bold text-[#0A3D62]\" data-kid=\"107\">Participation Target</span>\n                            <span class=\"text-xs font-extrabold text-[#27AE60]\" data-kid=\"108\">12 / 20 Members</span>\n                        </div>\n                        <div class=\"proportion-bar-container\" data-kid=\"109\">\n                            <div class=\"proportion-bar-fill w-[60%]\" data-kid=\"110\"></div>\n                        </div>\n                        <div class=\"flex items-center gap-2 mt-3\" data-kid=\"111\">\n                            <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-tight\" data-kid=\"112\">8 more to reach the next tier!</p>\n                        </div>\n                    </div>\n\n                    <button class=\"btn-orange w-full bg-[#F6A623] text-[#0A3D62] py-4.5 rounded-2xl font-['Plus_Jakarta_Sans'] font-extrabold text-sm uppercase tracking-widest btn-orange-shadow\" data-kid=\"113\">\n                        Join Group Buy\n                    </button>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"mb-12\" data-kid=\"114\">\n            <div class=\"px-4 flex items-center justify-between mb-5\" data-kid=\"115\">\n                <div class=\"flex flex-col\" data-kid=\"116\">\n                    <h2 class=\"text-xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62]\" data-kid=\"117\">Earn Rewards</h2>\n                    <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-wider\" data-kid=\"118\">Help us grow, get paid</p>\n                </div>\n                <button class=\"text-xs font-bold text-[#F6A623] flex items-center gap-1 bg-[#F6A623]/5 px-3 py-1.5 rounded-full\" data-kid=\"119\">\n                    Explore All <i class=\"ti ti-chevron-right\" data-kid=\"120\"></i>\n                </button>\n            </div>\n\n            <div class=\"flex gap-4 overflow-x-auto pb-6 px-4 scrollbar-hide\" id=\"survey-carousel\" data-kid=\"121\">\n                \n                <div class=\"survey-card min-w-[300px] bg-[#0A3D62] p-6 rounded-3xl relative overflow-hidden text-white border-2 border-[#0A3D62] shadow-xl shadow-[#0A3D62]/20\" data-kid=\"122\">\n                    <div class=\"relative z-10\" data-kid=\"123\">\n                        <div class=\"bg-[#27AE60] text-white px-2.5 py-1 rounded-lg text-[10px] font-extrabold inline-block mb-4 uppercase tracking-widest shadow-lg shadow-[#27AE60]/20\" data-kid=\"124\">New Arrival</div>\n                        <h3 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl mb-2 leading-tight\" data-kid=\"125\">Lome Consumer Survey</h3>\n                        <p class=\"text-white/60 text-xs mb-6 font-medium leading-relaxed\" data-kid=\"126\">Share your tech habits and help us curate the next group buy deals.</p>\n                        <div class=\"flex items-center justify-between\" data-kid=\"127\">\n                            <div class=\"flex flex-col\" data-kid=\"128\">\n                                <span class=\"text-[10px] text-white/50 font-bold uppercase tracking-widest\" data-kid=\"129\">Reward</span>\n                                <span class=\"text-2xl font-extrabold text-[#F6A623]\" data-kid=\"130\">2,500 <span class=\"text-xs\" data-kid=\"131\">FCFA</span></span>\n                            </div>\n                            <button class=\"bg-white text-[#0A3D62] px-6 py-3 rounded-2xl text-xs font-extrabold shadow-lg active:scale-95 transition-transform\" data-kid=\"132\">Take Now</button>\n                        </div>\n                    </div>\n                    <div class=\"absolute -right-8 -bottom-8 opacity-10\" data-kid=\"133\">\n                         <i class=\"ti ti-device-mobile text-[140px]\" data-kid=\"134\"></i>\n                    </div>\n                </div>\n\n                \n                <div class=\"survey-card min-w-[300px] bg-white p-6 rounded-3xl relative overflow-hidden text-[#0A3D62] border-2 border-[#E2E8F0] shadow-sm\" data-kid=\"135\">\n                    <div class=\"relative z-10\" data-kid=\"136\">\n                        <div class=\"bg-gray-100 text-gray-500 px-2.5 py-1 rounded-lg text-[10px] font-extrabold inline-block mb-4 uppercase tracking-widest\" data-kid=\"137\">2 Min Task</div>\n                        <h3 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl mb-2 leading-tight\" data-kid=\"138\">Daily Shopping Quiz</h3>\n                        <p class=\"text-gray-400 text-xs mb-6 font-medium leading-relaxed\" data-kid=\"139\">A quick check-in on what you're buying this week. Instant reward.</p>\n                        <div class=\"flex items-center justify-between\" data-kid=\"140\">\n                            <div class=\"flex flex-col\" data-kid=\"141\">\n                                <span class=\"text-[10px] text-gray-400 font-bold uppercase tracking-widest\" data-kid=\"142\">Reward</span>\n                                <span class=\"text-2xl font-extrabold text-[#27AE60]\" data-kid=\"143\">500 <span class=\"text-xs\" data-kid=\"144\">FCFA</span></span>\n                            </div>\n                            <button class=\"bg-[#0A3D62] text-white px-6 py-3 rounded-2xl text-xs font-extrabold shadow-lg active:scale-95 transition-transform\" data-kid=\"145\">Start</button>\n                        </div>\n                    </div>\n                    <div class=\"absolute -right-8 -bottom-8 opacity-5\" data-kid=\"146\">\n                         <i class=\"ti ti-basket text-[140px]\" data-kid=\"147\"></i>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] bg-white border-t border-gray-200 px-6 pt-3 pb-8 flex items-center justify-between z-50 rounded-t-3xl shadow-[0_-8px_30px_rgba(0,0,0,0.1)]\" data-kid=\"148\">\n        <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"149\">\n            <div class=\"relative mb-0.5\" data-kid=\"150\">\n                <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]\" data-kid=\"151\"></i>\n                <div class=\"absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#F6A623] rounded-full\" data-kid=\"152\"></div>\n            </div>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"153\">Accueil</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-50\" data-kid=\"154\">\n            <i class=\"ti ti-checklist text-2xl text-[#0A3D62] mb-0.5\" data-kid=\"155\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"156\">Sondages</span>\n        </button>\n\n        \n        <div class=\"relative -top-11 flex flex-col items-center\" data-kid=\"157\">\n            <button class=\"w-16 h-16 bg-[#0A3D62] rounded-full flex items-center justify-center text-white shadow-2xl shadow-[#0A3D62]/40 border-[6px] border-[#F5F7FA] active:scale-90 transition-transform\" data-kid=\"158\">\n                <i class=\"ti ti-wallet text-3xl\" data-kid=\"159\"></i>\n            </button>\n            <span class=\"mt-2 text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"160\">Solde</span>\n        </div>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-50\" data-kid=\"161\">\n            <i class=\"ti ti-user-circle text-2xl text-[#0A3D62] mb-0.5\" data-kid=\"162\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"163\">Profil</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-50\" data-kid=\"164\">\n            <i class=\"ti ti-settings text-2xl text-[#0A3D62] mb-0.5\" data-kid=\"165\"></i>\n            <span class=\"text-[10px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"166\">Réglages</span>\n        </button>\n    </nav>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"167\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"168\"></script>\n    <script type=\"module\" data-kid=\"169\">\n        import { animate, press, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Initialize Lenis\n        const lenis = new Lenis({\n            autoRaf: true,\n            lerp: 0.1,\n            smoothWheel: true,\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // GSAP Count-up animation\n        gsap.registerPlugin(ScrollTrigger);\n        \n        const countUp = { val: 0 };\n        gsap.to(countUp, {\n            val: 45670000,\n            duration: 3,\n            ease: \"expo.out\",\n            onUpdate: () => {\n                document.getElementById('savings-count').textContent = Math.round(countUp.val).toLocaleString();\n            },\n            scrollTrigger: {\n                trigger: \"#savings-count\",\n                start: \"top 95%\",\n            }\n        });\n\n        // Entrance animations\n        gsap.from(\".stat-card\", {\n            y: 30,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.15,\n            ease: \"power3.out\",\n            delay: 0.2\n        });\n\n        gsap.from(\".pill\", {\n            x: 20,\n            opacity: 0,\n            duration: 0.6,\n            stagger: 0.1,\n            ease: \"power2.out\",\n            delay: 0.5\n        });\n\n        // Motion.dev Interactions\n        inView(\".product-card\", ({ target }) => {\n            animate(target, { opacity: [0, 1], y: [60, 0] }, { duration: 0.8, easing: [0.22, 1, 0.36, 1] });\n        });\n\n        inView(\".survey-card\", ({ target }) => {\n            animate(target, { opacity: [0, 1], x: [30, 0] }, { duration: 0.5, easing: \"ease-out\" });\n        });\n\n        // Press feedback\n        press(\".product-card\", (el) => {\n            animate(el, { scale: 0.98 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.2 });\n        });\n\n        press(\".btn-orange\", (el) => {\n            animate(el, { scale: 0.96 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.2 });\n        });\n\n        press(\".survey-card\", (el) => {\n            animate(el, { scale: 0.97 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.2 });\n        });\n\n        // Pill active state toggle (simple demo logic)\n        document.querySelectorAll('.pill').forEach(pill => {\n            pill.addEventListener('click', () => {\n                document.querySelectorAll('.pill').forEach(p => {\n                    p.classList.remove('bg-[#0A3D62]', 'text-white', 'shadow-lg', 'shadow-[#0A3D62]/20');\n                    p.classList.add('bg-white', 'text-gray-500');\n                });\n                pill.classList.remove('bg-white', 'text-gray-500');\n                pill.classList.add('bg-[#0A3D62]', 'text-white', 'shadow-lg', 'shadow-[#0A3D62]/20');\n            });\n        });\n\n    </script>\n</div>\n",
