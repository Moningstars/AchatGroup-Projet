    "var_fcf1b409aab1": {
      "type": "variant",
      "label": "Profile (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13505,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div id=\"app-root\" class=\"min-h-screen bg-[#F5F7FA] font-['Be_Vietnam_Pro'] text-[#0A3D62] pb-24 overflow-x-clip\" data-kid=\"0\">\n  \n  <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n  <script type=\"module\" data-kid=\"2\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    const lenis = new Lenis({ autoRaf: true, autoToggle: true, anchors: true, allowNestedScroll: true, naiveDimensions: true, stopInertiaOnNavigate: true });\n  </script>\n\n  \n  <style data-kid=\"3\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .ios-item-shadow {\n      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);\n    }\n    \n    @keyframes shimmer {\n      0% { transform: translateX(-100%) skewX(-15deg); }\n      100% { transform: translateX(200%) skewX(-15deg); }\n    }\n    \n    .shimmer-effect::after {\n      content: '';\n      position: absolute;\n      top: 0; left: 0; width: 50%; height: 100%;\n      background: linear-gradient(to right, transparent, rgba(255,255,255,0.05), transparent);\n      animation: shimmer 3s infinite;\n    }\n  </style>\n\n  \n  <main class=\"max-w-[375px] mx-auto min-h-screen flex flex-col pt-12 px-6 pb-32\" data-kid=\"4\">\n    \n    \n    <section class=\"flex flex-col items-center mb-10 text-center animate-profile-entry\" data-kid=\"5\">\n      <div class=\"relative mb-6\" data-kid=\"6\">\n        \n        <div class=\"w-28 h-28 rounded-full bg-[#0A3D62] flex items-center justify-center text-white text-4xl font-extrabold shadow-[0_10px_30px_rgba(10,61,98,0.2)] border-4 border-white ring-2 ring-[#0A3D62]/20\" data-kid=\"7\">\n          KM\n        </div>\n        \n        <div class=\"absolute bottom-1 right-1 w-6 h-6 bg-[#27AE60] border-4 border-white rounded-full shadow-sm\" data-kid=\"8\"></div>\n      </div>\n      \n      <h1 class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold tracking-tight mb-1\" data-kid=\"9\">Koffi Mensah</h1>\n      <p class=\"text-[#0A3D62]/60 font-medium text-sm\" data-kid=\"10\">+228 90 12 34 56</p>\n    </section>\n\n    \n    <section class=\"mb-10 animate-wallet-entry\" data-kid=\"11\">\n      <div class=\"bg-[#0A3D62] rounded-3xl p-6 text-white shadow-[0_20px_40px_rgba(10,61,98,0.15)] relative overflow-hidden shimmer-effect\" data-kid=\"12\">\n        \n        <div class=\"absolute top-0 right-0 p-4 opacity-5 pointer-events-none\" data-kid=\"13\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/checkered-diamond.svg\" class=\"w-32 h-32\" style=\"filter: invert(1);\" alt=\"Pattern\" data-kid=\"14\">\n        </div>\n        \n        <div class=\"flex justify-between items-start mb-6\" data-kid=\"15\">\n          <div data-kid=\"16\">\n            <span class=\"text-white/70 text-xs font-bold uppercase tracking-[0.12em]\" data-kid=\"17\">Current Balance</span>\n            <div class=\"flex items-baseline gap-1.5 mt-2\" data-kid=\"18\">\n              <h2 class=\"text-4xl font-['Plus_Jakarta_Sans'] font-extrabold tracking-tight\" id=\"balance-counter\" data-kid=\"19\">0</h2>\n              <span class=\"text-lg font-bold text-white/60\" data-kid=\"20\">FCFA</span>\n            </div>\n          </div>\n          <div class=\"bg-white/10 p-3 rounded-2xl backdrop-blur-md\" data-kid=\"21\">\n            <i class=\"ti ti-wallet text-2xl\" data-kid=\"22\"></i>\n          </div>\n        </div>\n        \n        <div class=\"flex items-center justify-between pt-5 border-t border-white/10\" data-kid=\"23\">\n          <div class=\"flex items-center gap-2\" data-kid=\"24\">\n            <div class=\"w-2 h-2 rounded-full bg-[#27AE60] shadow-[0_0_10px_#27AE60]\" data-kid=\"25\"></div>\n            <span class=\"text-xs font-bold text-white/90\" data-kid=\"26\">Active Buying Power</span>\n          </div>\n          <button class=\"text-sm font-bold text-[#F6A623] bg-[#F6A623]/20 px-4 py-2 rounded-xl press-scale border border-[#F6A623]/30\" data-kid=\"27\">\n            Top Up\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"space-y-8 animate-list-entry\" data-kid=\"28\">\n      \n      <div class=\"space-y-3\" data-kid=\"29\">\n        <h3 class=\"px-4 text-[10px] font-bold uppercase tracking-[0.15em] text-[#0A3D62]/40\" data-kid=\"30\">Account & Finance</h3>\n        <div class=\"bg-white rounded-3xl border-2 border-[#E2E8F0] overflow-hidden ios-item-shadow\" data-kid=\"31\">\n          <div class=\"divide-y-2 divide-[#E2E8F0]/50\" data-kid=\"32\">\n            \n            <button class=\"w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50/50 press-scale transition-colors\" data-kid=\"33\">\n              <div class=\"flex items-center gap-4\" data-kid=\"34\">\n                <div class=\"w-12 h-12 rounded-2xl bg-[#0A3D62] flex items-center justify-center text-white shadow-lg shadow-[#0A3D62]/20\" data-kid=\"35\">\n                  <i class=\"ti ti-wallet text-xl\" data-kid=\"36\"></i>\n                </div>\n                <div class=\"text-left\" data-kid=\"37\">\n                  <p class=\"font-bold text-base\" data-kid=\"38\">Detailed Wallet</p>\n                  <p class=\"text-xs text-[#0A3D62]/50 font-medium\" data-kid=\"39\">Manage your funds</p>\n                </div>\n              </div>\n              <i class=\"ti ti-chevron-right text-gray-300 text-lg\" data-kid=\"40\"></i>\n            </button>\n            \n            \n            <button class=\"w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50/50 press-scale transition-colors\" data-kid=\"41\">\n              <div class=\"flex items-center gap-4\" data-kid=\"42\">\n                <div class=\"w-12 h-12 rounded-2xl bg-[#F5F7FA] flex items-center justify-center text-[#0A3D62]\" data-kid=\"43\">\n                  <i class=\"ti ti-history text-xl\" data-kid=\"44\"></i>\n                </div>\n                <div class=\"text-left\" data-kid=\"45\">\n                  <p class=\"font-bold text-base\" data-kid=\"46\">Purchase History</p>\n                  <p class=\"text-xs text-[#0A3D62]/50 font-medium\" data-kid=\"47\">Transactions & buys</p>\n                </div>\n              </div>\n              <i class=\"ti ti-chevron-right text-gray-300 text-lg\" data-kid=\"48\"></i>\n            </button>\n\n            \n            <button class=\"w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50/50 press-scale transition-colors\" data-kid=\"49\">\n              <div class=\"flex items-center gap-4\" data-kid=\"50\">\n                <div class=\"w-12 h-12 rounded-2xl bg-[#F6A623]/10 flex items-center justify-center text-[#F6A623]\" data-kid=\"51\">\n                  <i class=\"ti ti-gift text-xl\" data-kid=\"52\"></i>\n                </div>\n                <div class=\"text-left\" data-kid=\"53\">\n                  <p class=\"font-bold text-base\" data-kid=\"54\">Rewards Program</p>\n                  <p class=\"text-xs text-[#0A3D62]/50 font-medium text-ellipsis overflow-hidden\" data-kid=\"55\">Claim your bonuses</p>\n                </div>\n              </div>\n              <i class=\"ti ti-chevron-right text-gray-300 text-lg\" data-kid=\"56\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"space-y-3\" data-kid=\"57\">\n        <h3 class=\"px-4 text-[10px] font-bold uppercase tracking-[0.15em] text-[#0A3D62]/40\" data-kid=\"58\">Help & Security</h3>\n        <div class=\"bg-white rounded-3xl border-2 border-[#E2E8F0] overflow-hidden ios-item-shadow\" data-kid=\"59\">\n          <div class=\"divide-y-2 divide-[#E2E8F0]/50\" data-kid=\"60\">\n            \n            <button class=\"w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50/50 press-scale transition-colors\" data-kid=\"61\">\n              <div class=\"flex items-center gap-4\" data-kid=\"62\">\n                <div class=\"w-12 h-12 rounded-2xl bg-[#F5F7FA] flex items-center justify-center text-[#0A3D62]\" data-kid=\"63\">\n                  <i class=\"ti ti-headphones text-xl\" data-kid=\"64\"></i>\n                </div>\n                <div class=\"text-left\" data-kid=\"65\">\n                  <p class=\"font-bold text-base\" data-kid=\"66\">Contact Support</p>\n                  <p class=\"text-xs text-[#0A3D62]/50 font-medium\" data-kid=\"67\">24/7 availability</p>\n                </div>\n              </div>\n              <i class=\"ti ti-chevron-right text-gray-300 text-lg\" data-kid=\"68\"></i>\n            </button>\n            \n            \n            <button class=\"w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50/50 press-scale transition-colors\" data-kid=\"69\">\n              <div class=\"flex items-center gap-4\" data-kid=\"70\">\n                <div class=\"w-12 h-12 rounded-2xl bg-[#F5F7FA] flex items-center justify-center text-[#0A3D62]\" data-kid=\"71\">\n                  <i class=\"ti ti-shield-lock text-xl\" data-kid=\"72\"></i>\n                </div>\n                <div class=\"text-left\" data-kid=\"73\">\n                  <p class=\"font-bold text-base\" data-kid=\"74\">Security & Privacy</p>\n                  <p class=\"text-xs text-[#0A3D62]/50 font-medium\" data-kid=\"75\">PIN & Privacy settings</p>\n                </div>\n              </div>\n              <i class=\"ti ti-chevron-right text-gray-300 text-lg\" data-kid=\"76\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      \n      <button class=\"w-full flex items-center justify-between p-5 bg-white border-2 border-[#E74C3C]/20 rounded-3xl text-[#E74C3C] press-scale ios-item-shadow\" data-kid=\"77\">\n        <div class=\"flex items-center gap-4\" data-kid=\"78\">\n          <div class=\"w-12 h-12 rounded-2xl bg-[#E74C3C]/10 flex items-center justify-center\" data-kid=\"79\">\n            <i class=\"ti ti-logout-2 text-xl\" data-kid=\"80\"></i>\n          </div>\n          <span class=\"font-bold text-base\" data-kid=\"81\">Logout Session</span>\n        </div>\n      </button>\n    </section>\n  </main>\n\n  \n  <nav class=\"fixed bottom-0 left-0 right-0 h-20 bg-white/95 backdrop-blur-xl border-t-2 border-[#E2E8F0] flex items-center justify-around px-4 z-50 shadow-[0_-5px_20px_rgba(0,0,0,0.02)]\" data-kid=\"82\">\n    <button class=\"flex flex-col items-center gap-1.5 text-[#0A3D62]/30 press-scale\" data-kid=\"83\">\n      <i class=\"ti ti-smart-home text-2xl\" data-kid=\"84\"></i>\n      <span class=\"text-[10px] font-extrabold uppercase tracking-wide\" data-kid=\"85\">Home</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 text-[#0A3D62]/30 press-scale\" data-kid=\"86\">\n      <i class=\"ti ti-search text-2xl\" data-kid=\"87\"></i>\n      <span class=\"text-[10px] font-extrabold uppercase tracking-wide\" data-kid=\"88\">Explore</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 text-[#0A3D62]/30 press-scale\" data-kid=\"89\">\n      <i class=\"ti ti-wallet text-2xl\" data-kid=\"90\"></i>\n      <span class=\"text-[10px] font-extrabold uppercase tracking-wide\" data-kid=\"91\">Wallet</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 text-[#0A3D62] relative press-scale group\" data-kid=\"92\">\n      <div class=\"absolute -top-0.5 right-3 w-2.5 h-2.5 bg-[#F6A623] rounded-full ring-2 ring-white group-active:scale-75 transition-transform shadow-sm\" data-kid=\"93\"></div>\n      <i class=\"ti ti-user-filled text-2xl\" data-kid=\"94\"></i>\n      <span class=\"text-[10px] font-extrabold uppercase tracking-wide\" data-kid=\"95\">Profile</span>\n    </button>\n  </nav>\n\n  \n  <script type=\"module\" data-kid=\"96\">\n    import { animate, stagger, scroll, inView, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // Press scale effect for all elements with .press-scale class\n    press(\".press-scale\", (el) => {\n      animate(el, { scale: 0.96 }, { duration: 0.1 });\n      return () => animate(el, { scale: 1 }, { duration: 0.1 });\n    });\n\n    // Entrance animations\n    animate(\".animate-profile-entry\", { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, ease: \"easeOut\" });\n    animate(\".animate-wallet-entry\", { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: 0.1, ease: \"easeOut\" });\n    animate(\".animate-list-entry\", { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: 0.2, ease: \"easeOut\" });\n\n    // Counter animation for balance (#motion-count-up-text)\n    const balanceEl = document.getElementById('balance-counter');\n    animate(0, 25450, {\n      duration: 2,\n      delay: 0.5,\n      ease: \"circOut\",\n      onUpdate: (v) => {\n        balanceEl.textContent = Math.round(v).toLocaleString();\n      }\n    });\n\n    // Hover-like tilt effect on wallet card could be added, but we stick to press-scale for mobile consistency.\n  </script>\n</div>\n",
