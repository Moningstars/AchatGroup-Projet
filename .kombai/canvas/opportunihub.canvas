    "var_82dac9dba3ee": {
      "type": "variant",
      "label": "Wallet (Mobile)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 20495,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div class=\"bg-[#F5F7FA] text-[#0A3D62] font-['Be_Vietnam_Pro'] min-h-screen pb-44 selection:bg-[#F6A623]/30 overflow-x-clip relative\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n        @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n        .scrollbar-hide::-webkit-scrollbar { display: none; }\n        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n        .balance-card-glow {\n            box-shadow: 0 25px 50px -12px rgba(10, 61, 98, 0.25);\n        }\n        .transaction-card:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 25px -5px rgba(10, 61, 98, 0.05);\n        }\n\n        .glass-nav {\n            background: rgba(255, 255, 255, 0.85);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n        }\n\n        .variant-tag {\n            background: rgba(10, 61, 98, 0.05);\n            border: 1px solid rgba(10, 61, 98, 0.1);\n        }\n\n        /* Animation utilities - Removed opacity:0 to fix GSAP from() issue */\n        .reveal-y { }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-[60] bg-[#F5F7FA]/80 backdrop-blur-md px-6 py-5 flex items-center justify-between max-w-[375px] mx-auto border-b border-gray-100/50\" data-kid=\"2\">\n        <div class=\"flex items-center gap-3\" data-kid=\"3\">\n            <div class=\"w-11 h-11 bg-[#0A3D62] rounded-2xl flex items-center justify-center text-white shadow-lg relative\" data-kid=\"4\">\n                <i class=\"ti ti-wallet text-2xl\" data-kid=\"5\"></i>\n                <div class=\"absolute -top-1 -right-1 w-3 h-3 bg-[#F6A623] border-2 border-[#F5F7FA] rounded-full\" data-kid=\"6\"></div>\n            </div>\n            <div data-kid=\"7\">\n                <h1 class=\"text-lg font-['Plus_Jakarta_Sans'] font-extrabold leading-none text-[#0A3D62]\" data-kid=\"8\">Portfolio</h1>\n                <p class=\"text-[9px] text-[#27AE60] font-bold uppercase tracking-[0.1em] mt-1\" data-kid=\"9\">Community Balance</p>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"10\">\n            <button class=\"w-10 h-10 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-[#0A3D62] shadow-xs active:scale-90 transition-transform\" data-kid=\"11\">\n                <i class=\"ti ti-layout-grid text-lg\" data-kid=\"12\"></i>\n            </button>\n            <div class=\"w-10 h-10 rounded-full border-2 border-white shadow-md overflow-hidden ring-2 ring-[#0A3D62]/5\" data-kid=\"13\">\n                <img src=\"https://i.pravatar.cc/100?u=opportunihub_user\" alt=\"Profile\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"14\">\n            </div>\n        </div>\n    </header>\n\n    \n    <main class=\"max-w-[375px] mx-auto px-6 pt-2\" data-kid=\"15\">\n        \n        \n        <section id=\"variant-1\" class=\"mb-12\" data-kid=\"16\">\n            <div class=\"flex items-center gap-2 mb-4\" data-kid=\"17\">\n                <span class=\"variant-tag px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest text-[#0A3D62]/50\" data-kid=\"18\">Variant 01 • Classic</span>\n            </div>\n\n            \n            <div class=\"balance-card bg-[#0A3D62] rounded-[2.5rem] p-8 text-white relative overflow-hidden balance-card-glow mb-8 border border-white/5\" data-kid=\"19\">\n                <div class=\"relative z-10\" data-kid=\"20\">\n                    <div class=\"flex items-center justify-between mb-2\" data-kid=\"21\">\n                        <p class=\"text-white/60 text-xs font-bold uppercase tracking-widest\" data-kid=\"22\">Total Balance</p>\n                        <i class=\"ti ti-info-circle text-white/40\" data-kid=\"23\"></i>\n                    </div>\n                    <div class=\"flex items-baseline gap-2 mb-6\" data-kid=\"24\">\n                        <h2 id=\"balance-amount\" class=\"text-4xl font-['Plus_Jakarta_Sans'] font-extrabold\" data-kid=\"25\">45.670</h2>\n                        <span class=\"text-xl font-bold opacity-70\" data-kid=\"26\">FCFA</span>\n                    </div>\n                    \n                    <div class=\"flex gap-3\" data-kid=\"27\">\n                        <button class=\"flex-1 bg-white/10 hover:bg-white/20 px-4 py-3 rounded-2xl flex items-center justify-center gap-2 transition-colors active:scale-95\" data-kid=\"28\">\n                            <i class=\"ti ti-square-rounded-plus text-[#F6A623]\" data-kid=\"29\"></i>\n                            <span class=\"text-xs font-bold\" data-kid=\"30\">Add</span>\n                        </button>\n                        <button class=\"flex-1 bg-white/10 hover:bg-white/20 px-4 py-3 rounded-2xl flex items-center justify-center gap-2 transition-colors active:scale-95\" data-kid=\"31\">\n                            <i class=\"ti ti-arrow-up-right text-[#27AE60]\" data-kid=\"32\"></i>\n                            <span class=\"text-xs font-bold\" data-kid=\"33\">Send</span>\n                        </button>\n                    </div>\n                </div>\n                \n                <div class=\"absolute -right-12 -bottom-12 w-48 h-48 bg-white/5 rounded-full blur-xl animate-pulse\" data-kid=\"34\"></div>\n                <div class=\"absolute -left-10 -top-10 w-32 h-32 bg-[#F6A623]/10 rounded-full blur-2xl animate-pulse\" data-kid=\"35\"></div>\n                <div class=\"absolute top-0 right-0 p-4 opacity-10\" data-kid=\"36\">\n                    <i class=\"ti ti-activity-heartbeat text-[100px]\" data-kid=\"37\"></i>\n                </div>\n            </div>\n\n            \n            <div class=\"mb-10 reveal-y\" data-kid=\"38\">\n                <div class=\"flex items-center justify-between mb-5\" data-kid=\"39\">\n                    <h3 class=\"text-[11px] font-extrabold text-[#0A3D62]/40 uppercase tracking-[0.2em]\" data-kid=\"40\">Quick Recharge</h3>\n                    <div class=\"h-px flex-1 bg-gray-100 ml-4 opacity-50\" data-kid=\"41\"></div>\n                </div>\n                <div class=\"grid grid-cols-3 gap-4\" data-kid=\"42\">\n                    \n                    <button class=\"group flex flex-col items-center gap-3\" data-kid=\"43\">\n                        <div class=\"w-full aspect-square bg-white rounded-3xl border border-gray-100 shadow-sm flex items-center justify-center overflow-hidden relative\" data-kid=\"44\">\n                            <div class=\"w-14 h-14 bg-[#004A99] rounded-2xl flex items-center justify-center shadow-lg transform relative z-10\" data-kid=\"45\">\n                                <i class=\"ti ti-brand-shopee text-white text-2xl\" data-kid=\"46\"></i>\n                            </div>\n                            <span class=\"absolute bottom-1 text-[7px] font-black text-[#004A99]/40 tracking-widest z-20\" data-kid=\"47\">FLOOZ</span>\n                            <div class=\"absolute inset-0 bg-blue-600/5 opacity-0 group-hover:opacity-100\" data-kid=\"48\"></div>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-[#0A3D62]/70\" data-kid=\"49\">Flooz</span>\n                    </button>\n                    \n                    <button class=\"group flex flex-col items-center gap-3\" data-kid=\"50\">\n                        <div class=\"w-full aspect-square bg-white rounded-3xl border border-gray-100 shadow-sm flex items-center justify-center overflow-hidden relative\" data-kid=\"51\">\n                            <div class=\"w-14 h-14 bg-[#FFD700] rounded-2xl flex items-center justify-center shadow-lg transform relative z-10\" data-kid=\"52\">\n                                <i class=\"ti ti-topology-star-ring text-[#0A3D62] text-2xl\" data-kid=\"53\"></i>\n                            </div>\n                            <span class=\"absolute bottom-1 text-[7px] font-black text-[#0A3D62]/20 tracking-widest z-20\" data-kid=\"54\">TMONEY</span>\n                            <div class=\"absolute inset-0 bg-yellow-400/5 opacity-0 group-hover:opacity-100\" data-kid=\"55\"></div>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-[#0A3D62]/70\" data-kid=\"56\">T-Money</span>\n                    </button>\n                    \n                    <button class=\"group flex flex-col items-center gap-3\" data-kid=\"57\">\n                        <div class=\"w-full aspect-square bg-white rounded-3xl border border-gray-100 shadow-sm flex items-center justify-center overflow-hidden relative\" data-kid=\"58\">\n                            <div class=\"w-14 h-14 bg-[#1CB0F6] rounded-2xl flex items-center justify-center shadow-lg transform relative z-10\" data-kid=\"59\">\n                                <i class=\"ti ti-ripple text-white text-2xl\" data-kid=\"60\"></i>\n                            </div>\n                            <span class=\"absolute bottom-1 text-[7px] font-black text-white/40 tracking-widest z-20\" data-kid=\"61\">WAVE</span>\n                            <div class=\"absolute inset-0 bg-teal-400/5 opacity-0 group-hover:opacity-100\" data-kid=\"62\"></div>\n                        </div>\n                        <span class=\"text-[10px] font-bold text-[#0A3D62]/70\" data-kid=\"63\">Wave</span>\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"reveal-y\" data-kid=\"64\">\n                <div class=\"flex items-center justify-between mb-6\" data-kid=\"65\">\n                    <h3 class=\"text-sm font-['Plus_Jakarta_Sans'] font-extrabold\" data-kid=\"66\">Recent Activity</h3>\n                    <button class=\"text-[10px] font-bold text-[#F6A623] hover:underline\" data-kid=\"67\">See All</button>\n                </div>\n                \n                <div class=\"space-y-4\" data-kid=\"68\">\n                    \n                    <div class=\"transaction-card bg-white p-5 rounded-[2rem] border border-gray-100 shadow-xs flex items-center justify-between group cursor-pointer transition-shadow\" data-kid=\"69\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"70\">\n                            <div class=\"w-12 h-12 bg-[#F5F7FA] rounded-2xl flex items-center justify-center text-[#0A3D62] group-hover:bg-[#0A3D62]/5\" data-kid=\"71\">\n                                <i class=\"ti ti-basket text-xl\" data-kid=\"72\"></i>\n                            </div>\n                            <div data-kid=\"73\">\n                                <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"74\">Grocery Market</h4>\n                                <p class=\"text-[10px] text-gray-400 font-medium\" data-kid=\"75\">Today • 14:30</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"76\">\n                            <p class=\"text-sm font-black text-[#0A3D62]\" data-kid=\"77\">-4.500 <span class=\"text-[8px]\" data-kid=\"78\">F</span></p>\n                            <span class=\"text-[8px] px-2 py-0.5 bg-[#27AE60]/10 text-[#27AE60] rounded-full font-bold\" data-kid=\"79\">Success</span>\n                        </div>\n                    </div>\n                    \n                    <div class=\"transaction-card bg-white p-5 rounded-[2rem] border border-gray-100 shadow-xs flex items-center justify-between group cursor-pointer transition-shadow\" data-kid=\"80\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"81\">\n                            <div class=\"w-12 h-12 bg-[#F5F7FA] rounded-2xl flex items-center justify-center text-[#0A3D62]\" data-kid=\"82\">\n                                <i class=\"ti ti-award text-xl text-[#F6A623]\" data-kid=\"83\"></i>\n                            </div>\n                            <div data-kid=\"84\">\n                                <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"85\">Survey Bonus</h4>\n                                <p class=\"text-[10px] text-gray-400 font-medium\" data-kid=\"86\">Yesterday • 09:15</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"87\">\n                            <p class=\"text-sm font-black text-[#27AE60]\" data-kid=\"88\">+2.500 <span class=\"text-[8px]\" data-kid=\"89\">F</span></p>\n                            <span class=\"text-[8px] px-2 py-0.5 bg-[#F6A623]/10 text-[#F6A623] rounded-full font-bold\" data-kid=\"90\">Pending</span>\n                        </div>\n                    </div>\n                    \n                    <div class=\"transaction-card bg-white p-5 rounded-[2rem] border border-gray-100 shadow-xs flex items-center justify-between group cursor-pointer transition-shadow\" data-kid=\"91\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"92\">\n                            <div class=\"w-12 h-12 bg-[#F5F7FA] rounded-2xl flex items-center justify-center text-[#0A3D62]\" data-kid=\"93\">\n                                <i class=\"ti ti-device-mobile text-xl\" data-kid=\"94\"></i>\n                            </div>\n                            <div data-kid=\"95\">\n                                <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"96\">Wave Deposit</h4>\n                                <p class=\"text-[10px] text-gray-400 font-medium\" data-kid=\"97\">10 Jul • 18:45</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"98\">\n                            <p class=\"text-sm font-black text-[#27AE60]\" data-kid=\"99\">+10.000 <span class=\"text-[8px]\" data-kid=\"100\">F</span></p>\n                            <span class=\"text-[8px] px-2 py-0.5 bg-[#27AE60]/10 text-[#27AE60] rounded-full font-bold\" data-kid=\"101\">Success</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <div class=\"h-px w-full bg-gray-200/50 mb-12\" data-kid=\"102\"></div>\n\n        \n        <section id=\"variant-2\" class=\"mb-12 opacity-80 scale-95 origin-top transition-all hover:opacity-100 hover:scale-100\" data-kid=\"103\">\n            <div class=\"flex items-center gap-2 mb-6\" data-kid=\"104\">\n                <span class=\"variant-tag px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest text-[#0A3D62]/50\" data-kid=\"105\">Variant 02 • Minimalist</span>\n            </div>\n\n            <div class=\"bg-white rounded-[2rem] border-2 border-[#E2E8F0] p-7 mb-6\" data-kid=\"106\">\n                <div class=\"flex justify-between items-start mb-6\" data-kid=\"107\">\n                    <div data-kid=\"108\">\n                        <p class=\"text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"109\">Available Balance</p>\n                        <h2 class=\"text-3xl font-['Plus_Jakarta_Sans'] font-extrabold\" data-kid=\"110\">45.670 FCFA</h2>\n                    </div>\n                    <div class=\"w-10 h-10 bg-[#0A3D62]/5 rounded-xl flex items-center justify-center text-[#0A3D62]\" data-kid=\"111\">\n                        <i class=\"ti ti-shield-check\" data-kid=\"112\"></i>\n                    </div>\n                </div>\n                <div class=\"flex gap-2\" data-kid=\"113\">\n                    <div class=\"px-3 py-1 bg-green-50 text-[#27AE60] text-[9px] font-bold rounded-lg flex items-center gap-1\" data-kid=\"114\">\n                        <i class=\"ti ti-trending-up\" data-kid=\"115\"></i> +12%\n                    </div>\n                    <div class=\"px-3 py-1 bg-blue-50 text-[#0A3D62] text-[9px] font-bold rounded-lg\" data-kid=\"116\">Last 30 days</div>\n                </div>\n            </div>\n\n            <div class=\"flex gap-4 overflow-x-auto pb-4 scrollbar-hide\" data-kid=\"117\">\n                <button class=\"shrink-0 bg-[#0A3D62] text-white px-6 py-4 rounded-3xl flex items-center gap-3 shadow-lg shadow-[#0A3D62]/20\" data-kid=\"118\">\n                    <i class=\"ti ti-plus text-lg\" data-kid=\"119\"></i>\n                    <span class=\"text-xs font-bold\" data-kid=\"120\">Recharger</span>\n                </button>\n                <button class=\"shrink-0 bg-white text-[#0A3D62] px-6 py-4 rounded-3xl flex items-center gap-3 border border-gray-200\" data-kid=\"121\">\n                    <i class=\"ti ti-send text-lg\" data-kid=\"122\"></i>\n                    <span class=\"text-xs font-bold\" data-kid=\"123\">Transfer</span>\n                </button>\n            </div>\n        </section>\n\n        <div class=\"h-px w-full bg-gray-200/50 mb-12\" data-kid=\"124\"></div>\n\n        \n        <section id=\"variant-3\" class=\"mb-20 opacity-80 scale-95 origin-top transition-all hover:opacity-100 hover:scale-100\" data-kid=\"125\">\n            <div class=\"flex items-center gap-2 mb-6\" data-kid=\"126\">\n                <span class=\"variant-tag px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest text-[#0A3D62]/50\" data-kid=\"127\">Variant 03 • Dark Mode</span>\n            </div>\n\n            <div class=\"bg-[#0A3D62] rounded-[3rem] p-8 text-white relative overflow-hidden\" data-kid=\"128\">\n                <div class=\"relative z-10 flex flex-col items-center\" data-kid=\"129\">\n                    <div class=\"w-12 h-12 bg-white/10 rounded-full flex items-center justify-center mb-4\" data-kid=\"130\">\n                        <i class=\"ti ti-eye text-xl text-white/70\" data-kid=\"131\"></i>\n                    </div>\n                    <p class=\"text-white/70 text-[11px] font-bold uppercase tracking-[0.2em] mb-2\" data-kid=\"132\">My Savings</p>\n                    <h2 class=\"text-5xl font-['Plus_Jakarta_Sans'] font-extrabold mb-8\" data-kid=\"133\">45.670 <span class=\"text-xl opacity-70\" data-kid=\"134\">F</span></h2>\n                    \n                    <div class=\"w-full grid grid-cols-3 gap-6 text-center border-t border-white/10 pt-8\" data-kid=\"135\">\n                        <div class=\"flex flex-col items-center gap-2\" data-kid=\"136\">\n                            <div class=\"w-10 h-10 bg-white/10 rounded-2xl flex items-center justify-center text-[#F6A623]\" data-kid=\"137\"><i class=\"ti ti-plus\" data-kid=\"138\"></i></div>\n                            <span class=\"text-[10px] font-bold text-white/90\" data-kid=\"139\">Add</span>\n                        </div>\n                        <div class=\"flex flex-col items-center gap-2\" data-kid=\"140\">\n                            <div class=\"w-10 h-10 bg-white/10 rounded-2xl flex items-center justify-center text-[#27AE60]\" data-kid=\"141\"><i class=\"ti ti-send\" data-kid=\"142\"></i></div>\n                            <span class=\"text-[10px] font-bold text-white/90\" data-kid=\"143\">Send</span>\n                        </div>\n                        <div class=\"flex flex-col items-center gap-2\" data-kid=\"144\">\n                            <div class=\"w-10 h-10 bg-white/10 rounded-2xl flex items-center justify-center text-white\" data-kid=\"145\"><i class=\"ti ti-history\" data-kid=\"146\"></i></div>\n                            <span class=\"text-[10px] font-bold text-white/90\" data-kid=\"147\">Log</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"absolute inset-0 bg-linear-to-br from-white/10 to-transparent\" data-kid=\"148\"></div>\n            </div>\n        </section>\n\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] glass-nav border-t border-gray-100 px-6 pt-3 pb-8 flex items-center justify-between z-[100] rounded-t-[2.5rem] shadow-[0_-10px_40px_rgba(0,0,0,0.08)]\" data-kid=\"149\">\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"150\">\n            <div class=\"p-1\" data-kid=\"151\">\n                <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]\" data-kid=\"152\"></i>\n            </div>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"153\">Accueil</span>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"154\">\n            <div class=\"p-1\" data-kid=\"155\">\n                <i class=\"ti ti-checklist text-2xl text-[#0A3D62]\" data-kid=\"156\"></i>\n            </div>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"157\">Sondages</span>\n        </button>\n\n        \n        <button class=\"flex flex-col items-center gap-1 relative -top-3\" data-kid=\"158\">\n            <div class=\"w-14 h-14 bg-[#0A3D62] rounded-2xl flex items-center justify-center text-white shadow-xl shadow-[#0A3D62]/30 relative z-10 border-4 border-[#F5F7FA]\" data-kid=\"159\">\n                <i class=\"ti ti-wallet text-2xl\" data-kid=\"160\"></i>\n            </div>\n            <span class=\"text-[9px] font-black text-[#0A3D62] tracking-tight mt-1 uppercase\" data-kid=\"161\">Wallet</span>\n            <div class=\"absolute bottom-2 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"162\"></div>\n        </button>\n\n        <button class=\"flex flex-col items-center gap-1 group opacity-40\" data-kid=\"163\">\n            <div class=\"p-1\" data-kid=\"164\">\n                <i class=\"ti ti-user-circle text-2xl text-[#0A3D62]\" data-kid=\"165\"></i>\n            </div>\n            <span class=\"text-[9px] font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"166\">Profil</span>\n        </button>\n    </nav>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"167\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"168\"></script>\n    <script type=\"module\" data-kid=\"169\">\n        import { animate, press, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Initialize smooth scroll\n        const lenis = new Lenis({\n            autoRaf: true,\n            lerp: 0.1,\n            smoothWheel: true,\n        });\n\n        // GSAP Animations\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Balance count-up\n        const countObj = { val: 0 };\n        gsap.to(countObj, {\n            val: 45670,\n            duration: 2.5,\n            ease: \"expo.out\",\n            onUpdate: () => {\n                const formatted = Math.floor(countObj.val).toLocaleString('fr-FR');\n                document.getElementById('balance-amount').textContent = formatted;\n            }\n        });\n\n        // Reveal animations for sections - Using gsap.from but without CSS opacity:0\n        gsap.from(\".reveal-y\", {\n            scrollTrigger: {\n                trigger: \".reveal-y\",\n                start: \"top 95%\",\n            },\n            y: 40,\n            opacity: 0,\n            duration: 1.2,\n            stagger: 0.2,\n            ease: \"power4.out\"\n        });\n\n        // Floating card intro\n        gsap.from(\".balance-card\", {\n            scale: 0.9,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"elastic.out(1, 0.75)\",\n            delay: 0.2\n        });\n\n        gsap.to(\".animate-pulse\", {\n            scale: 1.1,\n            duration: 3,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\"\n        });\n\n        // Motion interactions\n        press(\"button\", (el) => {\n            animate(el, { scale: 0.95 }, { duration: 0.1 });\n            return () => animate(el, { scale: 1 }, { duration: 0.2 });\n        });\n\n        inView(\".bg-white.p-5\", ({ target }) => {\n            animate(target, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.5, delay: stagger(0.1) });\n        });\n\n    </script>\n</div>\n",
