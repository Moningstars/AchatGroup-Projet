      },
      "html": "\n<div class=\"w-full max-w-[375px] mx-auto bg-[#F5F7FA] min-h-screen font-['Be_Vietnam_Pro'] relative pb-24 overflow-x-clip\" id=\"main-container\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600&display=swap');\n        \n        .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n        /* Custom scrollbar for clean look */\n        ::-webkit-scrollbar { width: 0; background: transparent; }\n\n        .navy-card-gradient {\n            background: linear-gradient(135deg, #0A3D62 0%, #05233a 100%);\n        }\n\n        .tab-bar-shadow {\n            box-shadow: 0 -4px 20px rgba(0,0,0,0.05);\n        }\n\n        .btn-press-effect {\n            transition: transform 0.1s ease;\n        }\n        .btn-press-effect:active {\n            transform: scale(0.96);\n        }\n    </style>\n\n    \n    <header class=\"pt-8 px-6 pb-4 flex items-center justify-between sticky top-0 bg-[#F5F7FA]/90 backdrop-blur-md z-30\" data-kid=\"2\">\n        <div data-kid=\"3\">\n            <h1 class=\"font-jakarta text-2xl font-extrabold text-[#0A3D62]\" data-kid=\"4\">Portefeuille</h1>\n            <p class=\"text-xs text-[#0A3D62]/60 font-medium\" data-kid=\"5\">Gérez votre argent OpportuniHub</p>\n        </div>\n        <div class=\"relative\" data-kid=\"6\">\n            <div class=\"w-11 h-11 rounded-full border-2 border-white shadow-sm overflow-hidden bg-white\" data-kid=\"7\">\n                <img src=\"https://i.pravatar.cc/150?u=opportuni\" alt=\"Avatar\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"8\">\n            </div>\n            <div class=\"absolute -top-1 -right-1 w-4 h-4 bg-[#F6A623] border-2 border-white rounded-full\" data-kid=\"9\"></div>\n        </div>\n    </header>\n\n    \n    <main class=\"px-6 space-y-8 mt-4\" data-kid=\"10\">\n        \n        \n        <section class=\"relative navy-card-gradient w-full aspect-[1.58/1] rounded-[2rem] p-7 text-white shadow-2xl shadow-[#0A3D62]/20 overflow-hidden group\" data-kid=\"11\">\n            \n            <div class=\"absolute -top-12 -right-12 w-48 h-48 opacity-10 rotate-12 group-hover:rotate-45 transition-transform duration-1000\" data-kid=\"12\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/gear-stick-pattern.svg\" class=\"w-full h-full filter invert\" alt=\"Pattern\" decoding=\"async\" loading=\"lazy\" data-kid=\"13\">\n            </div>\n            <div class=\"absolute -bottom-8 -left-8 w-32 h-32 opacity-10 -rotate-12\" data-kid=\"14\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/checkered-diamond.svg\" class=\"w-full h-full filter invert\" alt=\"Pattern\" decoding=\"async\" loading=\"lazy\" data-kid=\"15\">\n            </div>\n            \n            <div class=\"relative z-10 h-full flex flex-col justify-between\" data-kid=\"16\">\n                <div data-kid=\"17\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"18\">\n                        <span class=\"text-white/70 text-sm font-medium\" data-kid=\"19\">Solde Total</span>\n                        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bordered-shield.svg\" class=\"w-6 h-6 filter invert opacity-80\" alt=\"Secure\" decoding=\"async\" loading=\"lazy\" data-kid=\"20\">\n                    </div>\n                    <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"21\">\n                        <span id=\"balance-amount\" class=\"font-jakarta text-4xl font-extrabold tracking-tight\" data-kid=\"22\">124.500</span>\n                        <span class=\"text-xl font-bold text-white/80\" data-kid=\"23\">FCFA</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"grid grid-cols-2 gap-6 pt-6 border-t border-white/10 relative overflow-hidden\" data-kid=\"24\">\n                    <div data-kid=\"25\">\n                        <div class=\"flex items-center gap-1.5 mb-1\" data-kid=\"26\">\n                            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27AE60]\" data-kid=\"27\"></div>\n                            <span class=\"text-white/60 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"28\">Disponible</span>\n                        </div>\n                        <p class=\"text-lg font-bold\" data-kid=\"29\">98.200 <span class=\"text-xs font-medium text-white/70 uppercase\" data-kid=\"30\">FCFA</span></p>\n                    </div>\n                    <div data-kid=\"31\">\n                        <div class=\"flex items-center gap-1.5 mb-1\" data-kid=\"32\">\n                            <div class=\"w-1.5 h-1.5 rounded-full bg-[#F6A623]\" data-kid=\"33\"></div>\n                            <span class=\"text-white/60 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"34\">Bloqué</span>\n                        </div>\n                        <p class=\"text-lg font-bold text-[#F6A623]\" data-kid=\"35\">26.300 <span class=\"text-xs font-medium text-[#F6A623]/70 uppercase\" data-kid=\"36\">FCFA</span></p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"absolute inset-0 bg-[linear-gradient(to_bottom,transparent_40%,rgba(5,35,58,0.6)_100%)] pointer-events-none\" data-kid=\"37\"></div>\n        </section>\n\n        \n        <section class=\"flex gap-4\" data-kid=\"38\">\n            <button id=\"btn-recharge\" class=\"btn-press-effect flex-1 bg-[#27AE60] text-white py-4 px-2 rounded-2xl flex flex-col items-center justify-center gap-1.5 shadow-xl shadow-[#27AE60]/20 font-bold border-b-4 border-[#1e8a4b]\" data-kid=\"39\">\n                <div class=\"w-10 h-10 rounded-full bg-white/20 flex items-center justify-center mb-1\" data-kid=\"40\">\n                    <i class=\"ti ti-plus text-2xl\" data-kid=\"41\"></i>\n                </div>\n                <span class=\"text-sm\" data-kid=\"42\">Recharger</span>\n            </button>\n            <button id=\"btn-retire\" class=\"btn-press-effect flex-1 bg-[#F6A623] text-white py-4 px-2 rounded-2xl flex flex-col items-center justify-center gap-1.5 shadow-xl shadow-[#F6A623]/20 font-bold border-b-4 border-[#d58d1b]\" data-kid=\"43\">\n                <div class=\"w-10 h-10 rounded-full bg-white/20 flex items-center justify-center mb-1\" data-kid=\"44\">\n                    <i class=\"ti ti-arrow-up-right text-2xl\" data-kid=\"45\"></i>\n                </div>\n                <span class=\"text-sm\" data-kid=\"46\">Retirer</span>\n            </button>\n        </section>\n\n        \n        <section data-kid=\"47\">\n            <div class=\"flex items-center justify-between mb-5\" data-kid=\"48\">\n                <h3 class=\"font-jakarta text-lg font-bold text-[#0A3D62]\" data-kid=\"49\">Transactions</h3>\n                <a href=\"#\" class=\"text-xs font-bold text-[#F6A623] flex items-center gap-1 hover:underline\" data-kid=\"50\">\n                    Tout voir <i class=\"ti ti-chevron-right\" data-kid=\"51\"></i>\n                </a>\n            </div>\n\n            <div class=\"space-y-4\" id=\"transaction-list\" data-kid=\"52\">\n                \n                <div class=\"transaction-item bg-white p-4 rounded-2xl flex items-center border border-[#E2E8F0] shadow-sm hover:border-[#0A3D62]/20 transition-colors\" data-kid=\"53\">\n                    <div class=\"w-12 h-12 rounded-xl bg-[#27AE60]/10 flex items-center justify-center mr-4 shrink-0\" data-kid=\"54\">\n                        <i class=\"ti ti-wallet text-[#27AE60] text-xl\" data-kid=\"55\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"56\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"57\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#27AE60]\" data-kid=\"58\"></span>\n                            <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"59\">Dépôt Mobile Money</h4>\n                        </div>\n                        <p class=\"text-[11px] text-[#0A3D62]/50 font-medium\" data-kid=\"60\">14 Oct 2023 • 10:45</p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"61\">\n                        <p class=\"text-sm font-extrabold text-[#27AE60]\" data-kid=\"62\">+50.000 FCFA</p>\n                        <p class=\"text-[9px] font-bold text-[#0A3D62]/40 uppercase tracking-tighter\" data-kid=\"63\">Complété</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"transaction-item bg-white p-4 rounded-2xl flex items-center border border-[#E2E8F0] shadow-sm hover:border-[#0A3D62]/20 transition-colors\" data-kid=\"64\">\n                    <div class=\"w-12 h-12 rounded-xl bg-[#F6A623]/10 flex items-center justify-center mr-4 shrink-0\" data-kid=\"65\">\n                        <i class=\"ti ti-shopping-cart text-[#F6A623] text-xl\" data-kid=\"66\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"67\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"68\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#F6A623]\" data-kid=\"69\"></span>\n                            <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"70\">Achat Riz Parfumé (50kg)</h4>\n                        </div>\n                        <p class=\"text-[11px] text-[#0A3D62]/50 font-medium\" data-kid=\"71\">13 Oct 2023 • 15:20</p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"72\">\n                        <p class=\"text-sm font-extrabold text-[#0A3D62]\" data-kid=\"73\">-22.500 FCFA</p>\n                        <p class=\"text-[9px] font-bold text-[#F6A623] uppercase tracking-tighter\" data-kid=\"74\">En cours</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"transaction-item bg-white p-4 rounded-2xl flex items-center border border-[#E2E8F0] shadow-sm hover:border-[#0A3D62]/20 transition-colors\" data-kid=\"75\">\n                    <div class=\"w-12 h-12 rounded-xl bg-[#E74C3C]/10 flex items-center justify-center mr-4 shrink-0\" data-kid=\"76\">\n                        <i class=\"ti ti-arrow-up-right text-[#E74C3C] text-xl\" data-kid=\"77\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"78\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"79\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#E74C3C]\" data-kid=\"80\"></span>\n                            <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"81\">Retrait Orange Money</h4>\n                        </div>\n                        <p class=\"text-[11px] text-[#0A3D62]/50 font-medium\" data-kid=\"82\">12 Oct 2023 • 09:30</p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"83\">\n                        <p class=\"text-sm font-extrabold text-[#E74C3C]\" data-kid=\"84\">-15.000 FCFA</p>\n                        <p class=\"text-[9px] font-bold text-[#0A3D62]/40 uppercase tracking-tighter\" data-kid=\"85\">Débité</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"transaction-item bg-white p-4 rounded-2xl flex items-center border border-[#E2E8F0] shadow-sm hover:border-[#0A3D62]/20 transition-colors\" data-kid=\"86\">\n                    <div class=\"w-12 h-12 rounded-xl bg-[#27AE60]/10 flex items-center justify-center mr-4 shrink-0\" data-kid=\"87\">\n                        <i class=\"ti ti-award text-[#27AE60] text-xl\" data-kid=\"88\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"89\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"90\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#27AE60]\" data-kid=\"91\"></span>\n                            <h4 class=\"text-sm font-bold text-[#0A3D62]\" data-kid=\"92\">Récompense Sondage</h4>\n                        </div>\n                        <p class=\"text-[11px] text-[#0A3D62]/50 font-medium\" data-kid=\"93\">11 Oct 2023 • 18:15</p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"94\">\n                        <p class=\"text-sm font-extrabold text-[#27AE60]\" data-kid=\"95\">+2.500 FCFA</p>\n                        <p class=\"text-[9px] font-bold text-[#0A3D62]/40 uppercase tracking-tighter\" data-kid=\"96\">Cadeau</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] bg-white tab-bar-shadow border-t border-[#E2E8F0] z-40 px-6 py-4 flex justify-between items-center rounded-t-3xl\" data-kid=\"97\">\n        <a href=\"#\" class=\"flex flex-col items-center gap-1 group\" data-kid=\"98\">\n            <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]/40 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"99\"></i>\n            <span class=\"text-[10px] font-bold text-[#0A3D62]/40 group-hover:text-[#0A3D62]\" data-kid=\"100\">Accueil</span>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1 group\" data-kid=\"101\">\n            <i class=\"ti ti-clipboard-list text-2xl text-[#0A3D62]/40 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"102\"></i>\n            <span class=\"text-[10px] font-bold text-[#0A3D62]/40 group-hover:text-[#0A3D62]\" data-kid=\"103\">Sondages</span>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1 relative\" data-kid=\"104\">\n            <div class=\"w-12 h-12 rounded-full bg-[#0A3D62] flex items-center justify-center -mt-8 shadow-lg shadow-[#0A3D62]/30 border-4 border-[#F5F7FA]\" data-kid=\"105\">\n                <i class=\"ti ti-wallet text-white text-xl\" data-kid=\"106\"></i>\n            </div>\n            <span class=\"text-[10px] font-bold text-[#0A3D62]\" data-kid=\"107\">Portefeuille</span>\n            \n            <div class=\"absolute -bottom-1 w-1 h-1 rounded-full bg-[#F6A623]\" data-kid=\"108\"></div>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1 group\" data-kid=\"109\">\n            <i class=\"ti ti-shopping-bag text-2xl text-[#0A3D62]/40 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"110\"></i>\n            <span class=\"text-[10px] font-bold text-[#0A3D62]/40 group-hover:text-[#0A3D62]\" data-kid=\"111\">Achats</span>\n        </a>\n        <a href=\"#\" class=\"flex flex-col items-center gap-1 group\" data-kid=\"112\">\n            <i class=\"ti ti-user text-2xl text-[#0A3D62]/40 group-hover:text-[#0A3D62] transition-colors\" data-kid=\"113\"></i>\n            <span class=\"text-[10px] font-bold text-[#0A3D62]/40 group-hover:text-[#0A3D62]\" data-kid=\"114\">Profil</span>\n        </a>\n    </nav>\n\n    \n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"115\">\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"116\"></script>\n    <script type=\"module\" data-kid=\"117\">\n        import { animate, scroll, stagger, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // Count-up animation for balance\n        animate(0, 124500, {\n            duration: 1.5,\n            ease: \"easeOut\",\n            onUpdate: latest => {\n                document.getElementById('balance-amount').textContent = Math.round(latest).toLocaleString('fr-FR');\n            }\n        });\n\n        // Stagger list items on enter: #motion-stagger-list-on-enter\n        inView(\"#transaction-list\", (list) => {\n            const items = list.querySelectorAll('.transaction-item');\n            animate(items, \n                { opacity: [0, 1], y: [20, 0] }, \n                { delay: stagger(0.1), duration: 0.5, ease: \"easeOut\" }\n            );\n        });\n\n        // Press feedback for buttons: #motion-press-scale (Applied via CSS :active for simplicity but can use Motion if needed)\n        // Using Motion for more robust gesture feedback\n        const buttons = document.querySelectorAll('.btn-press-effect');\n        buttons.forEach(btn => {\n            btn.addEventListener('pointerdown', () => {\n                animate(btn, { scale: 0.95 }, { duration: 0.1 });\n            });\n            btn.addEventListener('pointerup', () => {\n                animate(btn, { scale: 1 }, { duration: 0.1 });\n            });\n            btn.addEventListener('pointerleave', () => {\n                animate(btn, { scale: 1 }, { duration: 0.1 });\n            });\n        });\n\n    </script>\n</div>\n",
