    "var_654e9a935430": {
      "type": "variant",
      "label": "Auth Step 3 - Name (Mobile)",
      "parentId": "var_e5c79df9dede",
      "themeId": null,
      "rect": {
        "x": 5565,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-vietnam { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .variant-card {\n        width: 100%;\n        max-width: 375px;\n        height: 812px;\n        overflow: hidden;\n        flex-shrink: 0;\n        position: relative;\n        display: flex;\n        flex-direction: column;\n        box-shadow: 0 40px 80px -20px rgba(10, 61, 98, 0.2);\n        border: 1px solid rgba(10, 61, 98, 0.08);\n        border-radius: 2.5rem;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n\n    @keyframes pulse-gentle {\n        0%, 100% { opacity: 0.4; transform: scale(1); }\n        50% { opacity: 0.6; transform: scale(1.08); }\n    }\n    .animate-pulse-gentle {\n        animation: pulse-gentle 6s infinite ease-in-out;\n    }\n</style>\n\n<div class=\"flex flex-col lg:flex-row gap-12 p-6 lg:p-12 justify-center items-center lg:items-start min-h-screen bg-slate-100 font-vietnam text-[#1A1A2E]\" data-kid=\"1\">\n\n    \n    <div class=\"variant-card bg-white\" id=\"variant-1\" data-kid=\"2\">\n        <div class=\"p-8 pt-12 flex flex-col h-full\" data-kid=\"3\">\n            \n            <div class=\"mb-10 v1-el\" data-kid=\"4\">\n                <div class=\"flex justify-between items-center mb-3\" data-kid=\"5\">\n                    <span class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[#0A3D62]\" data-kid=\"6\">Étape 3 sur 3</span>\n                    <span class=\"text-[10px] font-black text-[#0A3D62]\" data-kid=\"7\">100%</span>\n                </div>\n                <div class=\"h-1.5 w-full bg-slate-100 rounded-full overflow-hidden\" data-kid=\"8\">\n                    <div class=\"h-full bg-[#0A3D62] w-full rounded-full origin-left v1-progress\" data-kid=\"9\"></div>\n                </div>\n            </div>\n\n            <div class=\"flex-grow v1-el\" data-kid=\"10\">\n                <div class=\"w-16 h-16 bg-[#0A3D62]/5 rounded-3xl flex items-center justify-center mb-8\" data-kid=\"11\">\n                    <i class=\"ti ti-confetti text-2xl text-[#F6A623]\" data-kid=\"12\"></i>\n                </div>\n                \n                <h1 class=\"text-3xl font-extrabold font-plus leading-tight mb-4 text-[#0A3D62]\" data-kid=\"13\">C'est presque fini !</h1>\n                <p class=\"text-[#1A1A2E]/60 font-medium text-sm leading-relaxed mb-12\" data-kid=\"14\">Bienvenue sur OpportuniHub. Comment devrions-nous vous appeler ?</p>\n\n                <div class=\"space-y-6\" data-kid=\"15\">\n                    <div class=\"group\" data-kid=\"16\">\n                        <label class=\"block text-[10px] font-black uppercase tracking-widest text-[#0A3D62]/50 mb-3 ml-1\" data-kid=\"17\">Nom complet</label>\n                        <div class=\"relative\" data-kid=\"18\">\n                            <input type=\"text\" placeholder=\"Ex: Jean Dupont\" class=\"w-full bg-slate-50 border-2 border-slate-50 focus:border-[#0A3D62] focus:bg-white rounded-2xl p-5 pr-14 font-bold text-sm outline-none transition-all shadow-xs\" data-kid=\"19\">\n                            <i class=\"ti ti-user-circle absolute right-5 top-1/2 -translate-y-1/2 text-[#0A3D62]/40 group-focus-within:text-[#0A3D62] transition-colors text-2xl\" data-kid=\"20\"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"mt-auto pb-4 v1-el\" data-kid=\"21\">\n                <button class=\"w-full bg-[#0A3D62] text-white font-black uppercase text-xs tracking-[0.2em] py-5 rounded-2xl shadow-xl shadow-[#0A3D62]/20 active:scale-95 transition-transform flex items-center justify-center gap-2 group\" data-kid=\"22\">\n                    <span data-kid=\"23\">Terminer</span>\n                    <i class=\"ti ti-check text-lg\" data-kid=\"24\"></i>\n                </button>\n                <p class=\"text-center text-[10px] text-slate-300 font-bold mt-6 uppercase tracking-widest\" data-kid=\"25\">Compte vérifié & sécurisé</p>\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"variant-card bg-[#F5F7FA] border border-[#0A3D62]/5\" id=\"variant-2\" data-kid=\"26\">\n        <div class=\"p-5 flex flex-col h-full\" data-kid=\"27\">\n            \n            <div class=\"bg-white rounded-[2rem] p-4.5 mb-4 border border-slate-200/40 flex items-center justify-between shadow-xs v2-el\" data-kid=\"28\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"29\">\n                    <div class=\"w-9 h-9 bg-[#0A3D62] rounded-xl flex items-center justify-center text-white font-black text-sm\" data-kid=\"30\">O</div>\n                    <span class=\"font-bold font-plus text-[#0A3D62] text-sm tracking-tight\" data-kid=\"31\">OpportuniHub</span>\n                </div>\n                <div class=\"bg-[#27AE60]/10 text-[#27AE60] px-3.5 py-2 rounded-full text-[9px] font-black uppercase tracking-wider flex items-center gap-2\" data-kid=\"32\">\n                    <span class=\"w-1.5 h-1.5 bg-[#27AE60] rounded-full animate-pulse\" data-kid=\"33\"></span>\n                    Étape 3/3\n                </div>\n            </div>\n\n            \n            <div class=\"bg-[#0A3D62] rounded-[2.5rem] p-8 mb-4 relative overflow-hidden flex flex-col justify-end min-h-[240px] v2-el group\" data-kid=\"34\">\n                <div class=\"absolute -right-10 -top-10 opacity-5 group-hover:scale-110 transition-transform duration-1000\" data-kid=\"35\">\n                    <i class=\"ti ti-brand-hipchat text-[220px] text-white\" data-kid=\"36\"></i>\n                </div>\n                <div class=\"relative z-10\" data-kid=\"37\">\n                    <div class=\"inline-flex items-center gap-2 bg-[#F6A623] text-[#0A3D62] px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest mb-4\" data-kid=\"38\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"39\"></i>\n                        Bienvenue\n                    </div>\n                    <h2 class=\"text-3xl font-black font-plus text-white leading-tight\" data-kid=\"40\">Enchanté de vous<br data-kid=\"41\"><span class=\"text-[#F6A623]\" data-kid=\"42\">voir ici !</span></h2>\n                    <p class=\"text-white/40 text-[10px] font-bold uppercase tracking-widest mt-3\" data-kid=\"43\">Prêt pour les économies ?</p>\n                </div>\n            </div>\n\n            \n            <div class=\"bg-white rounded-[2.5rem] p-8 flex-grow border border-slate-200/40 flex flex-col justify-center v2-el\" data-kid=\"44\">\n                <div class=\"text-center mb-8\" data-kid=\"45\">\n                    <div class=\"w-14 h-14 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-100/50\" data-kid=\"46\">\n                        <i class=\"ti ti-id text-2xl text-[#0A3D62]/40\" data-kid=\"47\"></i>\n                    </div>\n                    <h3 class=\"font-bold text-base font-plus text-[#0A3D62]\" data-kid=\"48\">Votre nom complet</h3>\n                </div>\n                \n                <input type=\"text\" placeholder=\"Koffi Mensah\" class=\"w-full bg-[#F8FAFC] border-2 border-[#F1F5F9] focus:border-[#0A3D62] focus:bg-white rounded-2xl p-[18px] font-bold text-sm outline-none transition-all text-center placeholder-[#0A3D62]/30\" data-kid=\"49\">\n            </div>\n\n            \n            <div class=\"mt-4 v2-el\" data-kid=\"50\">\n                <button class=\"w-full bg-[#0A3D62] text-white font-black uppercase text-xs tracking-[0.2em] py-[22px] rounded-[2rem] shadow-xl shadow-[#0A3D62]/10 flex items-center justify-center gap-3 active:scale-95 transition-transform\" data-kid=\"51\">\n                    <span data-kid=\"52\">Finaliser & Ouvrir</span>\n                    <i class=\"ti ti-sparkles text-lg\" data-kid=\"53\"></i>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"variant-card bg-[#0A3D62]\" id=\"variant-3\" data-kid=\"54\">\n        \n        <div class=\"absolute inset-0 overflow-hidden pointer-events-none\" data-kid=\"55\">\n            <div class=\"absolute -right-20 top-20 w-80 h-80 bg-[#F6A623] opacity-10 rounded-full blur-[100px] animate-pulse-gentle\" data-kid=\"56\"></div>\n            <div class=\"absolute -left-20 -bottom-20 w-80 h-80 bg-white opacity-5 rounded-full blur-[100px]\" data-kid=\"57\"></div>\n        </div>\n\n        <div class=\"p-8 flex flex-col h-full relative z-10\" data-kid=\"58\">\n            \n            <div class=\"flex items-center justify-between mb-16 v3-el\" data-kid=\"59\">\n                <button class=\"w-11 h-11 bg-white/5 rounded-2xl flex items-center justify-center text-white border border-white/10 hover:bg-white/10 transition-colors\" data-kid=\"60\">\n                    <i class=\"ti ti-arrow-narrow-left text-2xl\" data-kid=\"61\"></i>\n                </button>\n                <div class=\"flex items-center gap-3\" data-kid=\"62\">\n                    <div class=\"flex gap-1.5\" data-kid=\"63\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"64\"></div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white/20\" data-kid=\"65\"></div>\n                        <div class=\"w-5 h-1.5 rounded-full bg-[#F6A623]\" data-kid=\"66\"></div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"flex-grow flex flex-col justify-center v3-el\" data-kid=\"67\">\n                <div class=\"mb-4\" data-kid=\"68\">\n                    <span class=\"text-[#F6A623] font-black text-[10px] uppercase tracking-[0.4em]\" data-kid=\"69\">Dernier pas</span>\n                </div>\n                <h1 class=\"text-3xl font-black font-plus text-white leading-tight mb-6 tracking-tight\" data-kid=\"70\">L'union fait<br data-kid=\"71\">le prix.</h1>\n                <p class=\"text-white/50 font-medium text-sm leading-relaxed mb-10 max-w-[280px]\" data-kid=\"72\">Rejoignez la plus grande communauté d'achat groupé d'Afrique de l'Ouest.</p>\n\n                <div class=\"space-y-6\" data-kid=\"73\">\n                    <div class=\"group relative\" data-kid=\"74\">\n                        <input type=\"text\" placeholder=\"Entrez votre nom complet\" class=\"w-full bg-white/10 border-2 border-white/5 focus:border-[#F6A623] focus:bg-white/[0.12] rounded-[1.5rem] p-6 pr-14 font-bold text-lg outline-none transition-all text-white placeholder-white/20\" data-kid=\"75\">\n                        <i class=\"ti ti-pencil-code absolute right-6 top-1/2 -translate-y-1/2 text-white/20 group-focus-within:text-[#F6A623] transition-colors text-2xl\" data-kid=\"76\"></i>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"mt-auto pt-8 v3-el\" data-kid=\"77\">\n                <button class=\"w-full bg-[#F6A623] text-[#0A3D62] font-black uppercase text-sm tracking-[0.2em] py-6 rounded-[1.5rem] shadow-2xl shadow-[#F6A623]/20 active:scale-95 transition-transform\" data-kid=\"78\">\n                    C'est parti !\n                </button>\n                <p class=\"text-center text-[9px] text-white/20 font-bold mt-10 uppercase tracking-widest tracking-[0.2em]\" data-kid=\"79\">OpportuniHub v2.0</p>\n            </div>\n        </div>\n    </div>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"80\"></script>\n<script data-kid=\"81\">\n    document.addEventListener('DOMContentLoaded', () => {\n        // Variant 1 Entrance\n        gsap.from(\".v1-el\", {\n            y: 30, opacity: 0, duration: 1, stagger: 0.15, ease: \"power4.out\"\n        });\n        gsap.from(\".v1-progress\", {\n            scaleX: 0, duration: 1.5, ease: \"expo.inOut\", delay: 0.8\n        });\n\n        // Variant 2 Entrance\n        gsap.from(\".v2-el\", {\n            scale: 0.9, opacity: 0, duration: 1.2, stagger: 0.2, ease: \"back.out(1.4)\", delay: 0.3\n        });\n\n        // Variant 3 Entrance\n        gsap.from(\".v3-el\", {\n            x: -50, opacity: 0, duration: 1.5, stagger: 0.25, ease: \"expo.out\", delay: 0.6\n        });\n    });\n</script>\n",
