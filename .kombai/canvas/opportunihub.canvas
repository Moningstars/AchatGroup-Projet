      "html": "\n<div class=\"bg-[#F5F7FA] text-[#0A3D62] font-['Be_Vietnam_Pro'] min-h-screen selection:bg-[#F6A623]/30 overflow-x-clip pb-24\" data-kid=\"0\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n    <style data-kid=\"2\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .scrollbar-hide::-webkit-scrollbar { display: none; }\n        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n\n        .glass-header {\n            background: rgba(255, 255, 255, 0.9);\n            backdrop-filter: blur(12px);\n        }\n\n        .variant-content {\n            display: none;\n        }\n        .variant-content.active {\n            display: block;\n        }\n\n        /* Status Colors */\n        .status-blue { color: #3B82F6; background: rgba(59, 130, 246, 0.1); }\n        .status-green { color: #27AE60; background: rgba(39, 174, 96, 0.1); }\n        .status-orange { color: #F6A623; background: rgba(246, 166, 35, 0.1); }\n        .status-red { color: #EF4444; background: rgba(239, 68, 68, 0.1); }\n\n        .btn-variant.active {\n            background: #0A3D62;\n            color: white;\n            box-shadow: 0 8px 16px rgba(10, 61, 98, 0.2);\n        }\n\n        /* Nav floating button refinement */\n        .nav-wallet-btn {\n            box-shadow: 0 12px 24px -8px rgba(10, 61, 98, 0.4);\n        }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-40 glass-header border-b border-gray-100 px-4 py-4 flex items-center justify-between max-w-[375px] mx-auto shadow-sm shadow-gray-200/50\" data-kid=\"3\">\n        <div class=\"flex items-center gap-2\" data-kid=\"4\">\n            <div class=\"w-9 h-9 bg-[#0A3D62] rounded-xl flex items-center justify-center text-white shadow-lg\" data-kid=\"5\">\n                <i class=\"ti ti-history text-xl\" data-kid=\"6\"></i>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"7\">\n                <h1 class=\"text-[#0A3D62] font-['Plus_Jakarta_Sans'] font-extrabold text-lg leading-none\" data-kid=\"8\">Historique</h1>\n                <span class=\"text-[11px] text-[#065F46] font-bold uppercase tracking-widest mt-0.5\" data-kid=\"9\">Participations</span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2.5\" data-kid=\"10\">\n            <div class=\"bg-[#0A3D62] text-white pl-2 pr-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-md\" data-kid=\"11\">\n                <i class=\"ti ti-wallet text-sm text-[#F6A623]\" data-kid=\"12\"></i>\n                <span data-kid=\"13\">12,480 <span class=\"text-[10px] opacity-70\" data-kid=\"14\">FCFA</span></span>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"max-w-[375px] mx-auto px-4 pt-6 pb-12\" data-kid=\"15\">\n        \n        <div class=\"relative mb-6\" data-kid=\"16\">\n            <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg\" data-kid=\"17\"></i>\n            <input type=\"text\" placeholder=\"Rechercher une transaction...\" class=\"w-full bg-white border border-gray-100 rounded-2xl py-3.5 pl-11 pr-4 focus:border-[#0A3D62] outline-hidden text-xs font-semibold shadow-sm transition-all\" data-kid=\"18\">\n        </div>\n\n        \n        <div class=\"bg-white p-1 rounded-2xl mb-8 flex gap-1 border border-gray-100 shadow-sm\" data-kid=\"19\">\n            <button class=\"btn-variant flex-1 py-2.5 rounded-xl text-xs font-bold transition-all active\" data-variant=\"classic\" data-kid=\"20\">Classic</button>\n            <button class=\"btn-variant flex-1 py-2.5 rounded-xl text-xs font-bold transition-all\" data-variant=\"modern\" data-kid=\"21\">Modern</button>\n            <button class=\"btn-variant f