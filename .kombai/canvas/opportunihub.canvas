      },
      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Be Vietnam Pro', sans-serif;\n    background-color: #F5F7FA;\n    color: #0A3D62;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-heading {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  /* Custom shadow for cards */\n  .card-shadow {\n    box-shadow: 0 4px 20px -2px rgba(10, 61, 98, 0.08);\n  }\n\n  /* Animation helpers */\n  .stagger-item {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n</style>\n\n<div class=\"min-h-screen flex flex-col pb-24 max-w-[375px] mx-auto overflow-x-clip bg-[#F5F7FA]\" data-kid=\"1\">\n  \n  <header class=\"p-6 flex items-center justify-between bg-white border-b-2 border-[#E2E8F0]\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[#0A3D62] rounded-xl flex items-center justify-center text-white rotate-3\" data-kid=\"4\">\n        <i class=\"ti ti-wallet text-xl\" data-kid=\"5\"></i>\n      </div>\n      <div data-kid=\"6\">\n        <h1 class=\"text-xl font-bold font-heading\" data-kid=\"7\">Portefeuille</h1>\n        <p class=\"text-[10px] font-bold text-[#0A3D62]/40 uppercase tracking-widest\" data-kid=\"8\">OpportuniHub Pay</p>\n      </div>\n    </div>\n    <button class=\"w-10 h-10 rounded-full border-2 border-[#E2E8F0] flex items-center justify-center bg-white hover:bg-gray-50 active:scale-95 transition-all\" data-kid=\"9\">\n      <i class=\"ti ti-bell text-xl text-[#0A3D62]\" data-kid=\"10\"></i>\n    </button>\n  </header>\n\n  <main class=\"flex-1 p-5 space-y-6\" data-kid=\"11\">\n    \n    <section id=\"balance-hero\" class=\"relative\" data-kid=\"12\">\n      <div class=\"relative overflow-hidden bg-[#0A3D62] rounded-[32px] p-8 card-shadow text-white min-h-[220px] flex flex-col justify-between\" data-kid=\"13\">\n        \n        <div class=\"absolute inset-0 pointer-events-none overflow-hidden\" data-kid=\"14\">\n          <div class=\"absolute -top-10 -right-10 w-48 h-48 bg-white/10 rounded-full blur-3xl\" data-kid=\"15\"></div>\n          <div class=\"absolute -bottom-10 -left-10 w-40 h-40 bg-[#F6A623]/20 rounded-full blur-3xl\" data-kid=\"16\"></div>\n          <div class=\"absolute inset-0 bg-[linear-gradient(to_top,#00000066,transparent)] bottom-0 h-1/2\" data-kid=\"17\"></div>\n        </div>\n\n        <div class=\"relative z-10 space-y-2\" data-kid=\"18\">\n          <p class=\"text-white/60 text-xs font-bold uppercase tracking-widest flex items-center gap-2\" data-kid=\"19\">\n            <span class=\"w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"20\"></span>\n            Solde Total\n          </p>\n          <div class=\"flex items-baseline gap-2\" data-kid=\"21\">\n            <h2 class=\"text-4xl font-bold font-heading tracking-tight\" id=\"main-balance\" data-kid=\"22\">125,500</h2>\n            <span class=\"text-lg font-bold opacity-60\" data-kid=\"23\">FCFA</span>\n          </div>\n        </div>\n\n        <div class=\"relative z-10 grid grid-cols-2 gap-4 mt-8 pt-6 border-t border-white/10\" data-kid=\"24\">\n          <div class=\"space-y-1\" data-kid=\"25\">\n            <p class=\"text-white/50 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"26\">Disponible</p>\n            <p class=\"text-lg font-bold text-[#27AE60]\" data-kid=\"27\">95,000 <span class=\"text-xs font-medium\" data-kid=\"28\">FCFA</span></p>\n          </div>\n          <div class=\"space-y-1 text-right border-l border-white/10 pl-4\" data-kid=\"29\">\n            <p class=\"text-white/50 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"30\">Gelé</p>\n            <p class=\"text-lg font-bold text-[#F6A623]\" data-kid=\"31\">30,500 <span class=\"text-xs font-medium\" data-kid=\"32\">FCFA</span></p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"wallet-actions\" class=\"flex gap-4\" data-kid=\"33\">\n      <button class=\"flex-1 bg-[#27AE60] hover:bg-[#219150] text-white p-5 rounded-3xl card-shadow flex flex-col items-center gap-3 transition-all transform active:scale-95 group\" id=\"btn-recharger\" data-kid=\"34\">\n        <div class=\"w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center group-hover:bg-white/30 transition-colors\" data-kid=\"35\">\n          <i class=\"ti ti-plus text-2xl\" data-kid=\"36\"></i>\n        </div>\n        <span class=\"font-bold text-sm\" data-kid=\"37\">Recharger</span>\n      </button>\n      <button class=\"flex-1 bg-[#F6A623] hover:bg-[#e0951a] text-white p-5 rounded-3xl card-shadow flex flex-col items-center gap-3 transition-all transform active:scale-95 group\" id=\"btn-retirer\" data-kid=\"38\">\n        <div class=\"w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center group-hover:bg-white/30 transition-colors\" data-kid=\"39\">\n          <i class=\"ti ti-arrow-up text-2xl\" data-kid=\"40\"></i>\n        </div>\n        <span class=\"font-bold text-sm\" data-kid=\"41\">Retirer</span>\n      </button>\n    </section>\n\n    \n    <section id=\"history\" class=\"space-y-4\" data-kid=\"42\">\n      <div class=\"flex items-center justify-between px-1\" data-kid=\"43\">\n        <h3 class=\"font-bold text-[#0A3D62] font-heading flex items-center gap-2\" data-kid=\"44\">\n          Activités récentes\n          <span class=\"bg-[#0A3D62]/5 text-[#0A3D62] text-[10px] px-2 py-0.5 rounded-full\" data-kid=\"45\">12</span>\n        </h3>\n        <button class=\"text-[#0A3D62]/50 text-xs font-bold hover:text-[#0A3D62] transition-colors\" data-kid=\"46\">Voir tout</button>\n      </div>\n\n      <div class=\"bg-white rounded-3xl border-2 border-[#E2E8F0] overflow-hidden p-2\" id=\"transaction-list\" data-kid=\"47\">\n        \n        <div class=\"stagger-item flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer rounded-2xl\" data-kid=\"48\">\n          <div class=\"flex items-center gap-4\" data-kid=\"49\">\n            <div class=\"w-10 h-10 rounded-xl bg-[#27AE60]/10 flex items-center justify-center\" data-kid=\"50\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#27AE60]\" data-kid=\"51\"></div>\n            </div>\n            <div data-kid=\"52\">\n              <p class=\"font-bold text-sm text-[#0A3D62]\" data-kid=\"53\">Récompense Sondage</p>\n              <p class=\"text-[10px] font-bold text-[#0A3D62]/40 uppercase\" data-kid=\"54\">Aujourd'hui • 14:20</p>\n            </div>\n          </div>\n          <p class=\"font-bold text-sm text-[#27AE60]\" data-kid=\"55\">+2,500 FCFA</p>\n        </div>\n\n        \n        <div class=\"stagger-item flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer rounded-2xl\" data-kid=\"56\">\n          <div class=\"flex items-center gap-4\" data-kid=\"57\">\n            <div class=\"w-10 h-10 rounded-xl bg-[#F6A623]/10 flex items-center justify-center\" data-kid=\"58\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#F6A623]\" data-kid=\"59\"></div>\n            </div>\n            <div data-kid=\"60\">\n              <p class=\"font-bold text-sm text-[#0A3D62]\" data-kid=\"61\">Achat Groupé (Gelé)</p>\n              <p class=\"text-[10px] font-bold text-[#0A3D62]/40 uppercase\" data-kid=\"62\">Hier • 09:45</p>\n            </div>\n          </div>\n          <p class=\"font-bold text-sm text-[#F6A623]\" data-kid=\"63\">-15,000 FCFA</p>\n        </div>\n\n        \n        <div class=\"stagger-item flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer rounded-2xl\" data-kid=\"64\">\n          <div class=\"flex items-center gap-4\" data-kid=\"65\">\n            <div class=\"w-10 h-10 rounded-xl bg-[#E74C3C]/10 flex items-center justify-center\" data-kid=\"66\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#E74C3C]\" data-kid=\"67\"></div>\n            </div>\n            <div data-kid=\"68\">\n              <p class=\"font-bold text-sm text-[#0A3D62]\" data-kid=\"69\">Retrait Orange Money</p>\n              <p class=\"text-[10px] font-bold text-[#0A3D62]/40 uppercase\" data-kid=\"70\">22 Mai • 18:30</p>\n            </div>\n          </div>\n          <p class=\"font-bold text-sm text-[#E74C3C]\" data-kid=\"71\">-25,000 FCFA</p>\n        </div>\n\n        \n        <div class=\"stagger-item flex items-center justify-between p-4 hover:bg-gray-50 transition-colors cursor-pointer rounded-2xl\" data-kid=\"72\">\n          <div class=\"flex items-center gap-4\" data-kid=\"73\">\n            <div class=\"w-10 h-10 rounded-xl bg-[#27AE60]/10 flex items-center justify-center\" data-kid=\"74\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#27AE60]\" data-kid=\"75\"></div>\n            </div>\n            <div data-kid=\"76\">\n              <p class=\"font-bold text-sm text-[#0A3D62]\" data-kid=\"77\">Bonus Parrainage</p>\n              <p class=\"text-[10px] font-bold text-[#0A3D62]/40 uppercase\" data-kid=\"78\">20 Mai • 11:05</p>\n            </div>\n          </div>\n          <p class=\"font-bold text-sm text-[#27AE60]\" data-kid=\"79\">+500 FCFA</p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"bg-[#0A3D62]/5 border-2 border-[#E2E8F0] rounded-3xl p-5 flex gap-4\" data-kid=\"80\">\n      <div class=\"w-12 h-12 shrink-0 bg-[#F6A623] rounded-2xl flex items-center justify-center text-white\" data-kid=\"81\">\n        <i class=\"ti ti-bulb text-2xl\" data-kid=\"82\"></i>\n      </div>\n      <div class=\"space-y-1\" data-kid=\"83\">\n        <p class=\"font-bold text-sm\" data-kid=\"84\">Gagnez plus de FCFA</p>\n        <p class=\"text-xs text-[#0A3D62]/60 leading-relaxed\" data-kid=\"85\">Participez à 3 nouveaux sondages aujourd'hui pour débloquer un bonus de 1,000 FCFA.</p>\n      </div>\n    </section>\n  </main>\n\n  \n  <nav class=\"fixed bottom-0 left-0 right-0 max-w-[375px] mx-auto bg-white border-t-2 border-[#E2E8F0] px-6 py-4 flex items-center justify-between z-50\" data-kid=\"86\">\n    <a href=\"#\" class=\"flex flex-col items-center gap-1 text-[#0A3D62]/40\" data-kid=\"87\">\n      <i class=\"ti ti-smart-home text-2xl\" data-kid=\"88\"></i>\n      <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"89\">Accueil</span>\n    </a>\n    <a href=\"#\" class=\"flex flex-col items-center gap-1 text-[#0A3D62]/40\" data-kid=\"90\">\n      <i class=\"ti ti-clipboard-check text-2xl\" data-kid=\"91\"></i>\n      <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"92\">Sondages</span>\n    </a>\n    <a href=\"#\" class=\"flex flex-col items-center gap-1 text-[#0A3D62] relative\" data-kid=\"93\">\n      <div class=\"absolute -top-1 -right-1 w-2 h-2 bg-[#F6A623] rounded-full ring-4 ring-white\" data-kid=\"94\"></div>\n      <i class=\"ti ti-wallet text-2xl\" data-kid=\"95\"></i>\n      <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"96\">Wallet</span>\n    </a>\n    <a href=\"#\" class=\"flex flex-col items-center gap-1 text-[#0A3D62]/40\" data-kid=\"97\">\n      <div class=\"w-6 h-6 rounded-full bg-[#E2E8F0] flex items-center justify-center overflow-hidden\" data-kid=\"98\">\n        <img src=\"https://i.pravatar.cc/100?u=opportuni\" alt=\"Avatar\" class=\"w-full h-full object-cover\" data-kid=\"99\">\n      </div>\n      <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"100\">Profil</span>\n    </a>\n  </nav>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"101\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"102\"></script>\n<script type=\"module\" data-kid=\"103\">\n  import { animate, scroll, inView, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import Lenis from \"https://esm.sh/lenis@1\"\n\n  // Initialize smooth scroll\n  const lenis = new Lenis({\n    autoRaf: true,\n  });\n\n  // GSAP for stagger entry\n  gsap.registerPlugin(ScrollTrigger);\n  \n  gsap.to(\".stagger-item\", {\n    opacity: 1,\n    y: 0,\n    duration: 0.6,\n    stagger: 0.1,\n    ease: \"power2.out\",\n    scrollTrigger: {\n      trigger: \"#transaction-list\",\n      start: \"top 90%\",\n    }\n  });\n\n  // Motion gestures for buttons\n  press(\"#btn-recharger\", (el) => {\n    animate(el, { scale: 0.95 });\n    return () => animate(el, { scale: 1 });\n  });\n\n  press(\"#btn-retirer\", (el) => {\n    animate(el, { scale: 0.95 });\n    return () => animate(el, { scale: 1 });\n  });\n\n  // Count up balance\n  animate(0, 125500, {\n    duration: 2,\n    ease: \"circOut\",\n    onUpdate: (latest) => {\n      document.getElementById(\"main-balance\").textContent = Math.round(latest).toLocaleString();\n    }\n  });\n</script>\n",
