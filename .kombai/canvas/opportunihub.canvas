\"aspect-square border-2 border-dashed border-[#0A3D62]/20 flex items-center justify-center text-[#0A3D62]/20 text-4xl\" data-kid=\"1-3-1-2-4-2-2-6\">\n<i class=\"ti ti-lock\" data-kid=\"1-3-1-2-4-2-2-6-1\"></i>\n</div>\n</div>\n<div class=\"mt-10 p-3 neo-border-sm bg-[#0A3D62]/5 text-center\" data-kid=\"1-3-1-2-4-2-3\">\n<p class=\"text-sm font-black uppercase tracking-[0.2em] opacity-60\" data-kid=\"1-3-1-2-4-2-3-1\">Prochain badge à 5000 XP</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</main>\n\n<footer class=\"mt-32 bg-white neo-border border-b-0 border-x-0 pt-20 pb-10 px-6\" data-kid=\"1-4\">\n<div class=\"max-w-7xl mx-auto\" data-kid=\"1-4-1\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-16 pb-20\" data-kid=\"1-4-1-1\">\n<div class=\"md:col-span-5 space-y-8\" data-kid=\"1-4-1-1-1\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-4-1-1-1-1\">\n<div class=\"w-14 h-14 bg-[#0A3D62] neo-shadow flex items-center justify-center text-[#F6A623] font-anton text-3xl\" data-kid=\"1-4-1-1-1-1-1\">O</div>\n<span class=\"font-anton text-5xl uppercase tracking-tighter text-[#0A3D62]\" data-kid=\"1-4-1-1-1-1-2\">OpportuniHub</span>\n</div>\n<p class=\"font-medium text-xl leading-relaxed text-[#0A3D62]/70 max-w-md\" data-kid=\"1-4-1-1-1-2\">\n                        La première plateforme d'achat groupé d'Afrique de l'Ouest. Transformons notre pouvoir d'achat collectif en économies réelles et durables.\n                    </p>\n<div class=\"flex gap-4\" data-kid=\"1-4-1-1-1-3\">\n<a class=\"w-12 h-12 neo-border flex items-center justify-center text-2xl hover:bg-[#0A3D62] hover:text-white transition-all\" data-kid=\"1-4-1-1-1-3-1\" href=\"#\"><i class=\"ti ti-brand-facebook\" data-kid=\"1-4-1-1-1-3-1-1\"></i></a>\n<a class=\"w-12 h-12 neo-border flex items-center justify-center text-2xl hover:bg-[#0A3D62] hover:text-white transition-all\" data-kid=\"1-4-1-1-1-3-2\" href=\"#\"><i class=\"ti ti-brand-instagram\" data-kid=\"1-4-1-1-1-3-2-1\"></i></a>\n<a class=\"w-12 h-12 neo-border flex items-center justify-center text-2xl hover:bg-[#0A3D62] hover:text-white transition-all\" data-kid=\"1-4-1-1-1-3-3\" href=\"#\"><i class=\"ti ti-brand-x\" data-kid=\"1-4-1-1-1-3-3-1\"></i></a>\n</div>\n</div>\n<div class=\"md:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-0 divide-x-[3px] divide-[#0A3D62] border-l-[3px] border-[#0A3D62]\" data-kid=\"1-4-1-1-2\">\n<div class=\"space-y-6 p-8\" data-kid=\"1-4-1-1-2-1\">\n<h4 class=\"font-anton text-2xl uppercase tracking-widest text-[#F6A623]\" data-kid=\"1-4-1-1-2-1-1\">Navigation</h4>\n<ul class=\"space-y-4 font-bold uppercase text-sm tracking-wide\" data-kid=\"1-4-1-1-2-1-2\">\n<li data-kid=\"1-4-1-1-2-1-2-1\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-1-2-1-1\" href=\"#\">Catalogue</a></li>\n<li data-kid=\"1-4-1-1-2-1-2-2\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-1-2-2-1\" href=\"#\">Sondages</a></li>\n<li data-kid=\"1-4-1-1-2-1-2-3\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-1-2-3-1\" href=\"#\">Mon Wallet</a></li>\n<li data-kid=\"1-4-1-1-2-1-2-4\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-1-2-4-1\" href=\"#\">Aide &amp; Support</a></li>\n</ul>\n</div>\n<div class=\"space-y-6 p-8\" data-kid=\"1-4-1-1-2-2\">\n<h4 class=\"font-anton text-2xl uppercase tracking-widest text-[#F6A623]\" data-kid=\"1-4-1-1-2-2-1\">Légal</h4>\n<ul class=\"space-y-4 font-bold uppercase text-sm tracking-wide\" data-kid=\"1-4-1-1-2-2-2\">\n<li data-kid=\"1-4-1-1-2-2-2-1\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-2-2-1-1\" href=\"#\">CGU</a></li>\n<li data-kid=\"1-4-1-1-2-2-2-2\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-2-2-2-1\" href=\"#\">Confidentialité</a></li>\n<li data-kid=\"1-4-1-1-2-2-2-3\"><a class=\"hover:text-[#F6A623] transition-colors\" data-kid=\"1-4-1-1-2-2-2-3-1\" href=\"#\">Mentions Légales</a></li>\n</ul>\n</div>\n<div class=\"col-span-2 md:col-span-1 space-y-6 p-8\" data-kid=\"1-4-1-1-2-3\">\n<h4 class=\"font-anton text-2xl uppercase tracking-widest text-[#F6A623]\" data-kid=\"1-4-1-1-2-3-1\">Lieu</h4>\n<p class=\"font-bold text-sm uppercase tracking-widest leading-loose\" data-kid=\"1-4-1-1-2-3-2\">\n                            Quartier Administratif<br data-kid=\"1-4-1-1-2-3-2-1\">Lomé, Togo\n                        </p>\n</div>\n</div>\n</div>\n<div class=\"pt-10 neo-border border-b-0 border-x-0 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"1-4-1-2\">\n<p class=\"font-black text-xs uppercase tracking-[0.3em] opacity-40\" data-kid=\"1-4-1-2-1\">© 2024 OpportuniHub Togo. Tous droits réservés.</p>\n<p class=\"font-black text-xs uppercase tracking-[0.3em] flex items-center gap-2\" data-kid=\"1-4-1-2-2\">\n                    Fait avec <i class=\"ti ti-heart-filled text-rose-500\" data-kid=\"1-4-1-2-2-1\" data-name=\"heart icon\"></i> à Lomé\n                </p>\n</div>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"4\"></script>\n<script type=\"module\" data-kid=\"5\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    document.addEventListener('DOMContentLoaded', () => {\n        // Entrance Animations\n        gsap.from(\".reveal-anim\", {\n            y: 40,\n            autoAlpha: 0,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: \"expo.out\",\n            delay: 0.2\n        });\n\n        gsap.from(\"#progress-circle\", {\n            strokeDashoffset: 283,\n            duration: 2,\n            ease: \"power3.inOut\",\n            delay: 1\n        });\n\n        // Anime.js Marquee refactor\n        animate(\".marquee-track\", { \n            x: [\"0%\", \"-50%\"] \n        }, { \n            duration: 30000, \n            loop: true, \n            easing: 'linear' \n        });\n\n        // Spring Bounce Hover Effects with Anime.js\n        const targets = document.querySelectorAll('.bounce-target');\n        \n        targets.forEach(target => {\n            target.addEventListener('mouseenter', () => {\n                animate(target, {\n                    translateY: -8,\n                    scale: 1.02,\n                }, {\n                    duration: 400,\n                    easing: 'spring(1, 80, 10, 0)'\n                });\n            });\n\n            target.addEventListener('mouseleave', () => {\n                animate(target, {\n                    translateY: 0,\n                    scale: 1,\n                }, {\n                    duration: 400,\n                    easing: 'spring(1, 80, 10, 0)'\n                });\n            });\n        });\n    });\n</script>\n",
