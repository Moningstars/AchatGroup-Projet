      "html": "\n<div class=\"bg-[#F5F7FA] text-[#0A3D62] font-['Be_Vietnam_Pro'] min-h-screen selection:bg-[#F6A623]/30 overflow-x-hidden\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .variant-container {\n            width: 375px;\n            height: 812px;\n            position: relative;\n            flex-shrink: 0;\n            background: #F5F7FA;\n            overflow-y: auto;\n            border: 10px solid #1a1a1a;\n            border-radius: 3.5rem;\n            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.15);\n            scrollbar-width: none;\n            overflow-x: clip;\n        }\n        .variant-container::-webkit-scrollbar { display: none; }\n\n        .glass-avatar {\n            background: rgba(255, 255, 255, 0.2);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.3);\n        }\n\n        .btn-press:active {\n            transform: scale(0.96);\n        }\n        \n        .nav-shadow {\n            box-shadow: 0 -4px 20px rgba(0,0,0,0.06);\n        }\n\n        .pattern-dots {\n            background-image: radial-gradient(#0A3D62 0.5px, transparent 0.5px);\n            background-size: 10px 10px;\n        }\n    </style>\n\n    <div class=\"flex flex-wrap justify-center gap-16 p-12\" data-kid=\"2\">\n        \n        \n        <div class=\"variant-container\" data-kid=\"3\">\n            <div class=\"pb-56\" data-kid=\"4\">\n                \n                <div class=\"p-6 pt-12 flex flex-col items-center\" data-kid=\"5\">\n                    <div class=\"relative\" data-kid=\"6\">\n                        <div class=\"w-24 h-24 rounded-full bg-[#0A3D62] flex items-center justify-center text-white text-4xl font-extrabold mb-5 shadow-lg shadow-[#0A3D62]/10 ring-4 ring-white\" data-kid=\"7\">\n                            JD\n                        </div>\n                        <div class=\"absolute bottom-6 right-0 bg-[#27AE60] text-white w-7 h-7 rounded-full flex items-center justify-center border-4 border-white shadow-sm\" data-kid=\"8\">\n                            <i class=\"ti ti-check text-[10px] font-bold\" data-kid=\"9\"></i>\n                        </div>\n                    </div>\n                    <h2 class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold tracking-tight text-[#0A3D62]\" data-kid=\"10\">Jean Dupont</h2>\n                    <div class=\"flex items-center gap-2 text-xs text-gray-400 font-bold uppercase tracking-wider mt-1.5\" data-kid=\"11\">\n                        <i class=\"ti ti-phone text-[#F6A623]\" data-kid=\"12\"></i>\n                        <span data-kid=\"13\">+228 90 00 00 00</span>\n                    </div>\n\n                    \n                    <div class=\"w-full max-w-[180px] mt-6 bg-gray-200 h-1.5 rounded-full overflow-hidden\" data-kid=\"14\">\n                        <div class=\"bg-[#27AE60] w-3/4 h-full rounded-full\" data-kid=\"15\"></div>\n                    </div>\n                    <p class=\"text-[11px] text-gray-400 font-bold uppercase mt-2 tracking-wide\" data-kid=\"16\">Profil complété à 75%</p>\n                </div>\n\n                \n                <div class=\"px-6 mb-8\" data-kid=\"17\">\n                    <div class=\"bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center justify-between group cursor-pointer active:scale-[0.98]\" data-kid=\"18\">\n                        <div data-kid=\"19\">\n                            <p class=\"text-xs text-gray-400 font-black uppercase tracking-widest mb-1.5\" data-kid=\"20\">Solde Portefeuille</p>\n                            <h3 class=\"text-3xl font-['Plus_Jakarta_Sans'] font-extrabold text-[#0A3D62] flex items-baseline gap-1\" data-kid=\"21\">\n                                12,480 \n                                <span class=\"text-xs font-bold text-[#F6A623]\" data-kid=\"22\">FCFA</span>\n                            </h3>\n                        </div>\n                        <div class=\"w-14 h-14 bg-[#F6A623]/10 text-[#F6A623] rounded-2xl flex items-center justify-center\" data-kid=\"23\">\n                            <i class=\"ti ti-wallet text-2xl\" data-kid=\"24\"></i>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"px-6 space-y-6\" data-kid=\"25\">\n                    <h4 class=\"text-xs font-black text-gray-400 uppercase tracking-widest px-2 opacity-60\" data-kid=\"26\">Gestion du compte</h4>\n                    <div class=\"bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm\" data-kid=\"27\">\n                        <button class=\"w-full flex items-center gap-4 px-6 py-5 hover:bg-gray-50 border-b border-gray-50 btn-press text-[#0A3D62]\" data-kid=\"28\">\n                            <div class=\"w-10 h-10 bg-[#0A3D62]/5 text-[#0A3D62] rounded-xl flex items-center justify-center\" data-kid=\"29\">\n                                <i class=\"ti ti-credit-card text-xl\" data-kid=\"30\"></i>\n                            </div>\n                            <span class=\"flex-1 text-left font-bold\" data-kid=\"31\">Mon Portefeuille</span>\n                            <i class=\"ti ti-chevron-right text-gray-300\" data-kid=\"32\"></i>\n                        </button>\n                        <button class=\"w-full flex items-center gap-4 px-6 py-5 hover:bg-gray-50 border-b border-gray-50 btn-press text-[#0A3D62]\" data-kid=\"33\">\n                            <div class=\"w-10 h-10 bg-[#27AE60]/5 text-[#27AE60] rounded-xl flex items-center justify-center\" data-kid=\"34\">\n                                <i class=\"ti ti-history text-xl\" data-kid=\"35\"></i>\n                            </div>\n                            <span class=\"flex-1 text-left font-bold\" data-kid=\"36\">Historique d'achat</span>\n                            <i class=\"ti ti-chevron-right text-gray-300\" data-kid=\"37\"></i>\n                        </button>\n                        <button class=\"w-full flex items-center gap-4 px-6 py-5 hover:bg-red-50/50 text-red-500 btn-press\" data-kid=\"38\">\n                            <div class=\"w-10 h-10 bg-red-50 text-red-500 rounded-xl flex items-center justify-center\" data-kid=\"39\">\n                                <i class=\"ti ti-logout text-xl\" data-kid=\"40\"></i>\n                            </div>\n                            <span class=\"flex-1 text-left font-bold\" data-kid=\"41\">Déconnexion</span>\n                            <i class=\"ti ti-chevron-right opacity-30\" data-kid=\"42\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            \n            <nav class=\"absolute bottom-0 left-0 w-full bg-white border-t border-gray-100 px-6 pt-4 pb-8 flex items-center justify-between rounded-t-3xl nav-shadow z-20\" data-kid=\"43\">\n                <button class=\"flex flex-col items-center gap-1 opacity-40\" data-kid=\"44\">\n                    <i class=\"ti ti-smart-home text-2xl text-[#0A3D62]\" data-kid=\"45\"></i>\n                    <span class=\"text-[10px] font-black uppercase tracking-tighter\" data-kid=\"46\">Accueil</span>\n                </button>\n                <button class=\"flex flex-col items-center gap-1 opacity-40\" data-kid=\"47\">\n                    <i class=\"ti ti-checklist text-2xl text-[#0A3D62]\" data-kid=\"48\"></i>\n                    <span class=\"text-[10px] font-black uppercase tracking-tighter\" data-kid=\"49\">Sondages</span>\n                </button>\n                <div class=\"relative -top-8\" data-kid=\"50\">\n                    <button class=\"w-14 h-14 bg-[#0A3D62] rounded-2xl flex items-center justify-center text-white shadow-xl shadow-[#0A3D62]/30 border-4 border-white\" data-kid=\"51\">\n                        <i class=\"ti ti-wallet text-2xl\" data-kid=\"52\"></i>\n                    </button>\n                </div>\n                <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"53\">\n                    <div class=\"relative\" data-kid=\"54\">\n                        <i class=\"ti ti-user text-2xl text-[#0A3D62]\" data-kid=\"55\"></i>\n                        <div class=\"absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"56\"></div>\n                    </div>\n                    <span class=\"text-[10px] font-black uppercase tracking-tighter text-[#0A3D62]\" data-kid=\"57\">Profil</span>\n                </button>\n                <button class=\"flex flex-col items-center gap-1 opacity-40\" data-kid=\"58\">\n                    <i class=\"ti ti-settings text-2xl text-[#0A3D62]\" data-kid=\"59\"></i>\n                    <span class=\"text-[10px] font-black uppercase tracking-tighter\" data-kid=\"60\">Réglages</span>\n                </button>\n            </nav>\n        </div>\n\n        \n        <div class=\"variant-container\" data-kid=\"61\">\n            <div class=\"pb-56\" data-kid=\"62\">\n                \n                <div class=\"bg-[#0A3D62] p-8 pt-20 rounded-b-[2.5rem] relative overflow-hidden mb-8 shadow-xl shadow-[#0A3D62]/20\" data-kid=\"63\">\n                    <div class=\"relative z-10 flex items-center gap-6\" data-kid=\"64\">\n                        <div class=\"w-20 h-20 rounded-3xl glass-avatar flex items-center justify-center text-white text-3xl font-black\" data-kid=\"65\">\n                            JD\n                        </div>\n                        <div class=\"text-white\" data-kid=\"66\">\n                            <h2 class=\"text-2xl font-['Plus_Jakarta_Sans'] font-extrabold tracking-tight\" data-kid=\"67\">Jean Dupont</h2>\n                            <div class=\"flex items-center gap-2 mt-2 bg-white/10 w-fit px-3 py-1 rounded-full border border-white/10 backdrop-blur-sm\" data-kid=\"68\">\n                                <i class=\"ti ti-phone text-[11px] text-[#F6A623]\" data-kid=\"69\"></i>\n                                <p class=\"text-xs font-bold tracking-wide text-white/80\" data-kid=\"70\">+228 90 00 00 00</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute -right-16 -top-16 opacity-10 rotate-12\" data-kid=\"71\">\n                         <i class=\"ti ti-building-community text-[200px] text-white\" data-kid=\"72\"></i>\n                    </div>\n                    <div class=\"absolute inset-0 pattern-dots opacity-5\" data-kid=\"73\"></div>\n                </div>\n\n                \n                <div class=\"px-6 mb-10\" data-kid=\"74\">\n                    <div class=\"bg-gradient-to-br from-[#F6A623] to-[#FF9F1C] p-7 rounded-3xl text-[#0A3D62] shadow-xl shadow-[#F6A623]/20 relative overflow-hidden group cursor-pointer active:scale-[0.98]\" data-kid=\"75\">\n                        <div class=\"relative z-10 flex flex-col gap-6\" data-kid=\"76\">\n                            <div class=\"flex justify-between items-start\" data-kid=\"77\">\n                                <div class=\"w-12 h-12 bg-white/30 rounded-2xl flex items-center justify-center border border-white/40 backdrop-blur-md shadow-sm\" data-kid=\"78\">\n                                    <i class=\"ti ti-wallet text-2xl font-bold\" data-kid=\"79\"></i>\n                                </div>\n                                <div class=\"bg-[#0A3D62] text-white text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest shadow-lg\" data-kid=\"80\">Actif</div>\n                            </div>\n                            <div data-kid=\"81\">\n                                <p class=\"text-xs font-black uppercase tracking-widest text-[#0A3D62]/70 mb-2\" data-kid=\"82\">Solde Communautaire</p>\n                                <h3 class=\"text-4xl font-['Plus_Jakarta_Sans'] font-black flex items-baseline gap-2\" data-kid=\"83\">\n                                    12,480 \n                                    <span class=\"text-xs font-extrabold bg-[#0A3D62]/10 px-2 py-0.5 rounded-lg\" data-kid=\"84\">FCFA</span>\n                                </h3>\n                            </div>\n                        </div>\n                        <i class=\"ti ti-circles absolute -right-12 -bottom-12 text-white/20 text-[180px]\" data-kid=\"85\"></i>\n                    </div>\n                </div>\n\n                \n                <div class=\"px-6 space-y-4\" data-kid=\"86\">\n                    <button class=\"w-full flex items-center gap-5 bg-white p-5 rounded-3xl shadow-sm btn-press group text-[#0A3D62]\" data-kid=\"87\">\n                        <div class=\"w-14 h-14 bg-[#F5F7FA] text-[#0A3D62] rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"88\">\n                            <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"89\"></i>\n                        </div>\n                        <div class=\"flex-1 text-left\" data-kid=\"90\">\n                            <p class=\"font-extrabold text-lg leading-none mb-1\" data-kid=\"91\">Portefeuille</p>\n                            <p class=\"text-xs text-gray-400 font-semibold\" data-kid=\"92\">Économies groupées</p>\n                        </div>\n                        <div class=\"w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-300\" data-kid=\"93\">\n                            <i class=\"ti ti-arrow-right text-xs\" data-kid=\"94\"></i>\n                        </div>\n                    </button>\n                    <button class=\"w-full flex items-center gap-5 bg-white p-5 rounded-3xl shadow-sm btn-press group text-[#0A3D62]\" data-kid=\"95\">\n                        <div class=\"w-14 h-14 bg-[#F5F7FA] text-[#0A3D62] rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"96\">\n                            <i class=\"ti ti-history text-2xl\" data-kid=\"97\"></i>\n                        </div>\n                        <div class=\"flex-1 text-left\" data-kid=\"98\">\n                            <p class=\"font-extrabold text-lg leading-none mb-1\" data-kid=\"99\">Historique</p>\n                            <p class=\"text-xs text-gray-400 font-semibold\" data-kid=\"100\">Flux transactions</p>\n                        </div>\n                        <div class=\"w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-300\" data-kid=\"101\">\n                            <i class=\"ti ti-arrow-right text-xs\" data-kid=\"102\"></i>\n                        </div>\n                    </button>\n                    <button class=\"w-full flex items-center gap-5 bg-red-50 text-red-600 p-5 rounded-3xl border border-red-100 btn-press\" data-kid=\"103\">\n                        <div class=\"w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"104\">\n                            <i class=\"ti ti-power text-2xl\" data-kid=\"105\"></i>\n                        </div>\n                        <div class=\"flex-1 text-left\" data-kid=\"106\">\n                            <p class=\"font-black uppercase tracking-widest text-sm\" data-kid=\"107\">Déconnexion</p>\n                        </div>\n                    </button>\n                </div>\n            </div>\n\n            \n            <nav class=\"absolute bottom-6 left-6 right-6 bg-[#0A3D62] px-6 py-4 flex items-center justify-between rounded-[2rem] shadow-2xl text-white/40 z-20 border border-white/5\" data-kid=\"108\">\n                <button class=\"hover:text-white transition-colors\" data-kid=\"109\"><i class=\"ti ti-smart-home text-2xl\" data-kid=\"110\"></i></button>\n                <button class=\"hover:text-white transition-colors\" data-kid=\"111\"><i class=\"ti ti-checklist text-2xl\" data-kid=\"112\"></i></button>\n                <button class=\"w-12 h-12 bg-[#F6A623] text-[#0A3D62] rounded-2xl flex items-center justify-center shadow-lg active:scale-90 transition-transform border-4 border-[#0A3D62]\" data-kid=\"113\">\n                    <i class=\"ti ti-wallet text-2xl\" data-kid=\"114\"></i>\n                </button>\n                <button class=\"text-white relative\" data-kid=\"115\">\n                    <i class=\"ti ti-user text-2xl\" data-kid=\"116\"></i>\n                    <div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"117\"></div>\n                </button>\n                <button class=\"hover:text-white transition-colors\" data-kid=\"118\"><i class=\"ti ti-settings text-2xl\" data-kid=\"119\"></i></button>\n            </nav>\n        </div>\n\n        \n        <div class=\"variant-container bg-white\" data-kid=\"120\">\n            <div class=\"pb-56\" data-kid=\"121\">\n                \n                <div class=\"p-8 pt-20 flex items-center gap-6\" data-kid=\"122\">\n                    <div class=\"relative\" data-kid=\"123\">\n                        <div class=\"w-20 h-20 rounded-full bg-gradient-to-tr from-[#0A3D62] to-[#F6A623] p-1 shadow-lg shadow-[#0A3D62]/10\" data-kid=\"124\">\n                            <div class=\"w-full h-full rounded-full bg-white flex items-center justify-center text-[#0A3D62] text-2xl font-black border-2 border-white\" data-kid=\"125\">\n                                JD\n                            </div>\n                        </div>\n                        <div class=\"absolute -bottom-1 -right-1 bg-white p-1 rounded-full shadow-sm\" data-kid=\"126\">\n                            <div class=\"w-4 h-4 bg-[#27AE60] rounded-full\" data-kid=\"127\"></div>\n                        </div>\n                    </div>\n                    <div data-kid=\"128\">\n                        <h2 class=\"text-3xl font-['Plus_Jakarta_Sans'] font-black text-[#0A3D62] leading-none mb-2\" data-kid=\"129\">Jean <span class=\"text-[#F6A623]\" data-kid=\"130\">Dupont</span></h2>\n                        <div class=\"flex items-center gap-2 bg-[#F5F7FA] px-3 py-1.5 rounded-xl w-fit\" data-kid=\"131\">\n                            <i class=\"ti ti-device-mobile text-[11px] text-[#0A3D62]\" data-kid=\"132\"></i>\n                            <span class=\"text-xs font-bold text-[#0A3D62] opacity-60\" data-kid=\"133\">+228 90 00 00 00</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"px-8 mb-12\" data-kid=\"134\">\n                    <div class=\"bg-[#0A3D62] p-8 rounded-3xl text-white flex flex-col gap-8 shadow-xl shadow-[#0A3D62]/20 relative overflow-hidden group\" data-kid=\"135\">\n                        <div class=\"relative z-10 flex justify-between items-center\" data-kid=\"136\">\n                            <div class=\"flex flex-col\" data-kid=\"137\">\n                                <span class=\"text-xs font-black uppercase tracking-[0.3em] text-white/40 mb-1\" data-kid=\"138\">Disponible</span>\n                                <h3 class=\"text-4xl font-['Plus_Jakarta_Sans'] font-black tracking-tight flex items-baseline gap-1\" data-kid=\"139\">\n                                    12,480 \n                                    <span class=\"text-sm font-medium text-white/30\" data-kid=\"140\">FCFA</span>\n                                </h3>\n                            </div>\n                            <div class=\"w-16 h-16 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-center backdrop-blur-md\" data-kid=\"141\">\n                                <i class=\"ti ti-building-bank text-3xl text-white/20\" data-kid=\"142\"></i>\n                            </div>\n                        </div>\n                        <div class=\"relative z-10 flex gap-4\" data-kid=\"143\">\n                             <button class=\"flex-1 bg-white text-[#0A3D62] py-4 rounded-xl text-xs font-black uppercase tracking-widest shadow-lg btn-press\" data-kid=\"144\">Portefeuille</button>\n                             <button class=\"w-14 bg-[#F6A623] text-[#0A3D62] rounded-xl flex items-center justify-center shadow-lg active:scale-95 transition-transform\" data-kid=\"145\">\n                                <i class=\"ti ti-arrow-right text-xl\" data-kid=\"146\"></i>\n                             </button>\n                        </div>\n                        <div class=\"absolute -right-10 -bottom-10 w-40 h-40 bg-[#F6A623]/10 rounded-full blur-3xl\" data-kid=\"147\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"px-8 space-y-4 text-[#0A3D62]\" data-kid=\"148\">\n                    <button class=\"w-full flex items-center justify-between p-6 bg-[#F5F7FA] rounded-3xl group btn-press\" data-kid=\"149\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"150\">\n                            <div class=\"w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm\" data-kid=\"151\">\n                                <i class=\"ti ti-history text-2xl text-[#0A3D62]\" data-kid=\"152\"></i>\n                            </div>\n                            <span class=\"font-extrabold text-lg\" data-kid=\"153\">Historique</span>\n                        </div>\n                        <i class=\"ti ti-chevron-right text-gray-300\" data-kid=\"154\"></i>\n                    </button>\n                    <button class=\"w-full flex items-center justify-between p-6 bg-red-50 rounded-3xl group btn-press text-red-500\" data-kid=\"155\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"156\">\n                            <div class=\"w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm\" data-kid=\"157\">\n                                <i class=\"ti ti-logout text-2xl text-red-500\" data-kid=\"158\"></i>\n                            </div>\n                            <span class=\"font-extrabold text-lg\" data-kid=\"159\">Déconnexion</span>\n                        </div>\n                        <i class=\"ti ti-chevron-right text-red-200\" data-kid=\"160\"></i>\n                    </button>\n                </div>\n            </div>\n\n            \n            <nav class=\"absolute bottom-8 left-8 right-8 bg-white/90 backdrop-blur-2xl border border-gray-100 px-6 py-3 flex items-center justify-between rounded-full shadow-xl z-20\" data-kid=\"161\">\n                 <button class=\"text-gray-300 hover:text-[#0A3D62] transition-colors\" data-kid=\"162\"><i class=\"ti ti-smart-home text-2xl\" data-kid=\"163\"></i></button>\n                 <button class=\"text-gray-300 hover:text-[#0A3D62] transition-colors\" data-kid=\"164\"><i class=\"ti ti-checklist text-2xl\" data-kid=\"165\"></i></button>\n                 <button class=\"w-11 h-11 bg-[#0A3D62] text-white rounded-full flex items-center justify-center shadow-lg active:scale-90 transition-transform\" data-kid=\"166\">\n                    <i class=\"ti ti-wallet text-xl\" data-kid=\"167\"></i>\n                 </button>\n                 <button class=\"text-[#0A3D62] relative\" data-kid=\"168\">\n                    <i class=\"ti ti-user text-2xl\" data-kid=\"169\"></i>\n                    <div class=\"absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#F6A623] rounded-full\" data-kid=\"170\"></div>\n                 </button>\n                 <button class=\"text-gray-300 hover:text-[#0A3D62] transition-colors\" data-kid=\"171\"><i class=\"ti ti-settings text-2xl\" data-kid=\"172\"></i></button>\n            </nav>\n        </div>\n\n    </div>\n\n    \n    <div class=\"fixed inset-0 pointer-events-none -z-10 opacity-30\" data-kid=\"173\">\n        <div class=\"absolute top-[10%] left-[5%] w-[40rem] h-[40rem] bg-[#0A3D62]/5 rounded-full blur-[100px]\" data-kid=\"174\"></div>\n        <div class=\"absolute bottom-[10%] right-[5%] w-[30rem] h-[30rem] bg-[#F6A623]/5 rounded-full blur-[100px]\" data-kid=\"175\"></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"176\"></script>\n    <script data-kid=\"177\">\n        // Enhanced entrance animation for the devices\n        gsap.from(\".variant-container\", {\n            y: 100,\n            opacity: 0,\n            scale: 0.95,\n            duration: 1.4,\n            stagger: 0.3,\n            ease: \"expo.out\"\n        });\n\n        // Animation for inner elements - targeting non-conflicting elements\n        document.querySelectorAll('.variant-container').forEach((container, i) => {\n            const elements = container.querySelectorAll('h2, h4, .w-24, .w-20, nav, .bg-gradient-to-br');\n            gsap.from(elements, {\n                y: 30,\n                opacity: 0,\n                duration: 1,\n                stagger: 0.12,\n                ease: \"power3.out\",\n                delay: 0.6 + (i * 0.2)\n            });\n        });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-07-11T07:45:29.045433+00:00",
