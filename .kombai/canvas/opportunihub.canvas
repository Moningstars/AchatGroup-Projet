      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');\n\n  :root {\n    --primary: #0A3D62;\n    --accent: #F6A623;\n    --success: #27AE60;\n    --urgency: #E74C3C;\n    --in-progress: #3498DB;\n    --bg: #F5F7FA;\n  }\n\n  body {\n    font-family: 'Be+Vietnam+Pro', sans-serif;\n    background-color: var(--bg);\n    color: var(--primary);\n    margin: 0;\n    padding: 0;\n  }\n\n  .font-heading {\n    font-family: 'Plus+Jakarta+Sans', sans-serif;\n  }\n\n  /* Custom Scrollbar for filter */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n</style>\n\n<div class=\"flex flex-col min-h-screen max-w-[375px] mx-auto bg-[#F5F7FA] relative overflow-x-clip\" data-kid=\"1\">\n  \n  \n  <header class=\"bg-white border-b-2 border-[#E2E8F0] px-4 py-4 sticky top-0 z-50 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <button id=\"back-btn\" class=\"w-10 h-10 rounded-full border-2 border-[#E2E8F0] flex items-center justify-center text-[#0A3D62] cursor-pointer\" data-kid=\"4\">\n        <i class=\"ti ti-chevron-left text-xl\" data-kid=\"5\"></i>\n      </button>\n      <h1 class=\"text-xl font-heading font-extrabold text-[#0A3D62] tracking-tight\" data-kid=\"6\">Mes Achats</h1>\n    </div>\n    <button class=\"w-10 h-10 rounded-full border-2 border-[#E2E8F0] flex items-center justify-center text-[#0A3D62] cursor-pointer\" data-kid=\"7\">\n      <i class=\"ti ti-adjustments-horizontal text-xl\" data-kid=\"8\"></i>\n    </button>\n  </header>\n\n  \n  <div class=\"bg-white border-b-2 border-[#E2E8F0] overflow-x-auto hide-scrollbar\" data-kid=\"9\">\n    <div class=\"flex items-center gap-2 p-4 min-w-max\" data-kid=\"10\">\n      <button class=\"px-5 py-2.5 rounded-full bg-[#0A3D62] text-white text-xs font-bold border-2 border-[#0A3D62]\" data-kid=\"11\">Tous</button>\n      <button class=\"px-5 py-2.5 rounded-full bg-white text-[#0A3D62]/60 text-xs font-bold border-2 border-[#E2E8F0]\" data-kid=\"12\">En cours</button>\n      <button class=\"px-5 py-2.5 rounded-full bg-white text-[#0A3D62]/60 text-xs font-bold border-2 border-[#E2E8F0]\" data-kid=\"13\">Validés</button>\n      <button class=\"px-5 py-2.5 rounded-full bg-white text-[#0A3D62]/60 text-xs font-bold border-2 border-[#E2E8F0]\" data-kid=\"14\">Remboursés</button>\n      <button class=\"px-5 py-2.5 rounded-full bg-white text-[#0A3D62]/60 text-xs font-bold border-2 border-[#E2E8F0]\" data-kid=\"15\">Annulés</button>\n    </div>\n  </div>\n\n  \n  <main class=\"flex-1 p-4 pb-24\" data-kid=\"16\">\n    <div id=\"backlog-list\" class=\"space-y-4\" data-kid=\"17\">\n      \n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#3498DB] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"18\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0\" data-kid=\"19\">\n          <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=200&q=80&fit=crop\" alt=\"Iwaria Inc. on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"20\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"21\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"22\">Pagne Kita Premium (Tier 2)</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"23\">Aujourd'hui • 14:30</p>\n          <p class=\"font-heading font-extrabold text-[#0A3D62] text-base\" data-kid=\"24\">25,000 FCFA</p>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"25\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#3498DB]/10 text-[#3498DB] uppercase tracking-tighter\" data-kid=\"26\">EN_COURS</span>\n        </div>\n      </div>\n\n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#27AE60] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"27\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0\" data-kid=\"28\">\n          <img src=\"https://images.unsplash.com/photo-1692689383138-c2df3476072c?auto=format&w=200&q=80&fit=crop\" alt=\"Vije Vijendranath on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"29\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"30\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"31\">Sac à dos Bogolan</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"32\">12 Oct 2023 • 09:15</p>\n          <p class=\"font-heading font-extrabold text-[#0A3D62] text-base\" data-kid=\"33\">15,000 FCFA</p>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"34\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#27AE60]/10 text-[#27AE60] uppercase tracking-tighter\" data-kid=\"35\">VALIDE</span>\n        </div>\n      </div>\n\n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#F6A623] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"36\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0\" data-kid=\"37\">\n          <img src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=200&q=80&fit=crop\" alt=\"WyteShot on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"38\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"39\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"40\">Tissu Batik Indigo</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"41\">08 Oct 2023 • 17:45</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"42\">\n            <p class=\"font-heading font-extrabold text-[#0A3D62] text-base\" data-kid=\"43\">12,500 FCFA</p>\n            <span class=\"text-[10px] text-[#F6A623] font-bold\" data-kid=\"44\">+ Frais remboursés</span>\n          </div>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"45\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#F6A623]/10 text-[#F6A623] uppercase tracking-tighter\" data-kid=\"46\">REMBOURSE</span>\n        </div>\n      </div>\n\n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#27AE60] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"47\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0\" data-kid=\"48\">\n          <img src=\"https://images.unsplash.com/photo-1760727467662-5f0943d196a8?auto=format&w=200&q=80&fit=crop\" alt=\"mathieu gauzy on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"49\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"50\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"51\">Paniers Tressés (Lot de 3)</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"52\">05 Oct 2023 • 11:20</p>\n          <p class=\"font-heading font-extrabold text-[#0A3D62] text-base\" data-kid=\"53\">8,500 FCFA</p>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"54\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#27AE60]/10 text-[#27AE60] uppercase tracking-tighter\" data-kid=\"55\">VALIDE</span>\n        </div>\n      </div>\n\n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#E74C3C] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"56\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0 grayscale\" data-kid=\"57\">\n          <img src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=200&q=80&fit=crop\" alt=\"WyteShot on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n        </div>\n        <div class=\"flex-1 min-w-0 opacity-60\" data-kid=\"59\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"60\">Lot de Tissus Wax</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"61\">01 Oct 2023 • 11:00</p>\n          <p class=\"font-heading font-extrabold text-[#0A3D62] text-base line-through\" data-kid=\"62\">45,000 FCFA</p>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"63\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#E74C3C]/10 text-[#E74C3C] uppercase tracking-tighter\" data-kid=\"64\">ANNULE</span>\n        </div>\n      </div>\n\n      \n      <div class=\"purchase-card bg-white rounded-xl border-2 border-[#E2E8F0] border-l-4 border-l-[#27AE60] p-3 flex items-center gap-3 relative shadow-sm cursor-pointer\" data-kid=\"65\">\n        <div class=\"w-16 h-16 rounded-lg overflow-hidden shrink-0\" data-kid=\"66\">\n          <img src=\"https://images.unsplash.com/photo-1760726744405-b955b568ba3e?auto=format&w=200&q=80&fit=crop\" alt=\"mathieu gauzy on Unsplash\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"67\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"68\">\n          <h3 class=\"font-bold text-[#0A3D62] truncate text-sm\" data-kid=\"69\">Collier de Perles Artisanal</h3>\n          <p class=\"text-[11px] text-[#0A3D62]/50 font-medium mb-1\" data-kid=\"70\">28 Sep 2023 • 16:40</p>\n          <p class=\"font-heading font-extrabold text-[#0A3D62] text-base\" data-kid=\"71\">5,000 FCFA</p>\n        </div>\n        <div class=\"absolute top-3 right-3\" data-kid=\"72\">\n          <span class=\"px-2 py-1 rounded-md text-[10px] font-bold bg-[#27AE60]/10 text-[#27AE60] uppercase tracking-tighter\" data-kid=\"73\">VALIDE</span>\n        </div>\n      </div>\n\n    </div>\n  </main>\n\n  \n  <nav class=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[375px] bg-white border-t-2 border-[#E2E8F0] px-6 py-3 flex items-center justify-between z-50\" data-kid=\"74\">\n    <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"75\">\n      <i class=\"ti ti-home text-2xl text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"76\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"77\">Accueil</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"78\">\n      <i class=\"ti ti-forms text-2xl text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"79\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"80\">Sondages</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 relative\" data-kid=\"81\">\n      <div class=\"text-[#0A3D62] flex flex-col items-center gap-1\" data-kid=\"82\">\n        <i class=\"ti ti-history text-2xl\" data-kid=\"83\"></i>\n        <span class=\"text-[10px] font-bold\" data-kid=\"84\">Achats</span>\n      </div>\n      <div class=\"absolute -top-1 right-2 w-1.5 h-1.5 bg-[#F6A623] rounded-full\" data-kid=\"85\"></div>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"86\">\n      <i class=\"ti ti-wallet text-2xl text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"87\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"88\">Portefeuille</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 group\" data-kid=\"89\">\n      <i class=\"ti ti-user text-2xl text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"90\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 group-active:text-[#0A3D62]\" data-kid=\"91\">Profil</span>\n    </button>\n  </nav>\n\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"92\"></script>\n<script type=\"module\" data-kid=\"93\">\n  import { animate, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Press feedback on cards\n  press(\".purchase-card\", el => {\n    animate(el, { scale: 0.98 }, { duration: 0.1 });\n    return () => animate(el, { scale: 1 }, { duration: 0.1 });\n  });\n\n  press(\"button\", el => {\n    animate(el, { scale: 0.92 }, { duration: 0.1 });\n    return () => animate(el, { scale: 1 }, { duration: 0.1 });\n  });\n\n  // Stagger entry animation\n  gsap.from(\".purchase-card\", {\n    opacity: 0,\n    y: 20,\n    stagger: 0.08,\n    duration: 0.6,\n    ease: \"power2.out\",\n    delay: 0.2\n  });\n\n  gsap.from(\"header\", {\n    opacity: 0,\n    y: -20,\n    duration: 0.5,\n    ease: \"power2.out\"\n  });\n\n</script>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"94\">\n",
