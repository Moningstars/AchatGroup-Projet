      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --primary: #0A3D62;\n    --accent: #F6A623;\n    --success: #27AE60;\n    --bg: #F5F7FA;\n    --white: #FFFFFF;\n    --border: #E2E8F0;\n  }\n\n  body {\n    background-color: var(--bg);\n    color: var(--primary);\n    font-family: 'Be Vietnam Pro', sans-serif;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 8px; }\n  ::-webkit-scrollbar-track { background: var(--bg); }\n  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n\n  .medium-border {\n    border: 2px solid var(--border);\n    border-radius: 1rem;\n  }\n\n  .header-scrolled {\n    box-shadow: 0 4px 20px rgba(10, 61, 98, 0.08);\n  }\n\n  /* Progress Ladder active line glow */\n  .active-tier::before {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    background: var(--success);\n    opacity: 0.05;\n    border-radius: 1.5rem;\n    z-index: -1;\n  }\n</style>\n\n<div class=\"min-h-screen flex flex-col\" data-kid=\"1\">\n  \n  <header id=\"main-header\" class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[var(--border)] transition-all duration-300\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-10\" data-kid=\"4\">\n        <a href=\"/\" class=\"flex items-center gap-2 group\" data-kid=\"5\">\n          <div class=\"w-10 h-10 bg-[var(--primary)] rounded-xl flex items-center justify-center rotate-3 group-hover:rotate-0 transition-transform\" data-kid=\"6\">\n            <i class=\"ti ti-building-community text-[var(--accent)] text-xl\" data-kid=\"7\"></i>\n          </div>\n          <span class=\"font-plus text-2xl font-black tracking-tight text-[var(--primary)]\" data-kid=\"8\">\n            Opportuni<span class=\"text-[var(--accent)]\" data-kid=\"9\">Hub</span>\n          </span>\n        </a>\n        <nav class=\"hidden md:flex items-center gap-8\" data-kid=\"10\">\n          <a href=\"#\" class=\"text-sm font-bold text-[var(--primary)]/70 hover:text-[var(--primary)] transition-colors\" data-kid=\"11\">Catalog</a>\n          <a href=\"#\" class=\"text-sm font-bold text-[var(--primary)]/70 hover:text-[var(--primary)] transition-colors\" data-kid=\"12\">Surveys</a>\n          <a href=\"#\" class=\"text-sm font-bold text-[var(--primary)]/70 hover:text-[var(--primary)] transition-colors\" data-kid=\"13\">History</a>\n        </nav>\n      </div>\n\n      <div class=\"flex items-center gap-6\" data-kid=\"14\">\n        <div class=\"hidden sm:flex items-center bg-[var(--primary)] text-white pl-4 pr-1 py-1 rounded-full border-2 border-[var(--primary)] shadow-sm\" data-kid=\"15\">\n          <div class=\"flex flex-col pr-4\" data-kid=\"16\">\n            <span class=\"text-[10px] opacity-60 font-bold uppercase tracking-wider\" data-kid=\"17\">Balance</span>\n            <span class=\"font-plus font-bold text-sm\" data-kid=\"18\">45,000 FCFA</span>\n          </div>\n          <button class=\"bg-[var(--accent)] text-[var(--primary)] w-9 h-9 rounded-full flex items-center justify-center hover:scale-105 transition-transform\" data-kid=\"19\">\n            <i class=\"ti ti-plus font-bold\" data-kid=\"20\"></i>\n          </button>\n        </div>\n        <div class=\"flex items-center gap-3 pl-2 border-l border-[var(--border)]\" data-kid=\"21\">\n          <div class=\"w-10 h-10 rounded-full bg-slate-200 border-2 border-white shadow-sm overflow-hidden cursor-pointer\" data-kid=\"22\">\n            <img src=\"https://i.pravatar.cc/100?u=aisha\" alt=\"Profile\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"flex-grow pt-8 pb-32\" data-kid=\"24\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\" data-kid=\"25\">\n      \n      <div class=\"grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-12 xl:gap-20 items-start\" data-kid=\"26\">\n        \n        \n        <section class=\"space-y-6\" id=\"gallery-container\" data-kid=\"27\">\n          <div class=\"group relative aspect-[4/3] rounded-3xl overflow-hidden bg-white border-2 border-[var(--border)] shadow-xl transition-all duration-500 hover:shadow-2xl\" data-kid=\"28\">\n            \n            <img id=\"main-image\" src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxhdXRoZW50aWMlMjBhZnJpY2FuJTIwbWFya2V0JTIwcHJvZHVjdHxlbnwwfHx8fDE3ODM3MjU3MTR8MA&ixlib=rb-4.1.0&q=85&auto=format&w=1200\" alt=\"Artisanal Textiles Showcase\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"29\">\n            \n            <div class=\"absolute top-6 right-6 bg-white/95 backdrop-blur-md px-5 py-3 rounded-2xl border border-white shadow-lg flex flex-col items-center\" data-kid=\"30\">\n              <span class=\"text-[10px] font-bold text-[var(--primary)]/50 uppercase tracking-widest mb-1\" data-kid=\"31\">Clôture dans</span>\n              <div class=\"flex items-center gap-3 text-[var(--primary)] font-plus font-black text-xl\" data-kid=\"32\">\n                <span data-kid=\"33\">02<span class=\"text-xs ml-1 opacity-50\" data-kid=\"34\">J</span></span>\n                <span class=\"text-[var(--accent)]\" data-kid=\"35\">:</span>\n                <span data-kid=\"36\">14<span class=\"text-xs ml-1 opacity-50\" data-kid=\"37\">H</span></span>\n                <span class=\"text-[var(--accent)]\" data-kid=\"38\">:</span>\n                <span data-kid=\"39\">35<span class=\"text-xs ml-1 opacity-50\" data-kid=\"40\">M</span></span>\n              </div>\n            </div>\n            \n            <div class=\"absolute bottom-6 left-6 bg-[var(--success)] text-white px-4 py-2 rounded-xl font-plus font-bold shadow-lg flex items-center gap-2\" data-kid=\"41\">\n              <i class=\"ti ti-discount-2\" data-kid=\"42\"></i>\n              <span data-kid=\"43\">-35% RÉDUCTION</span>\n            </div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-4 gap-4\" id=\"thumb-grid\" data-kid=\"44\">\n            <button class=\"thumb-btn active ring-4 ring-[var(--primary)]/20 ring-offset-2 border-2 border-[var(--primary)] rounded-2xl overflow-hidden aspect-square transition-all\" data-src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=1200&q=80\" data-kid=\"45\">\n              <img src=\"https://images.unsplash.com/photo-1655682614757-a9a33fa45c93?auto=format&w=200&q=80\" alt=\"Thumb 1\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"46\">\n            </button>\n            <button class=\"thumb-btn border-2 border-[var(--border)] rounded-2xl overflow-hidden aspect-square transition-all hover:border-[var(--accent)]\" data-src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=1200&q=80\" data-kid=\"47\">\n              <img src=\"https://images.unsplash.com/photo-1768212566108-4ce4f329e4d2?auto=format&w=200&q=80\" alt=\"Thumb 2\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"48\">\n            </button>\n            <button class=\"thumb-btn border-2 border-[var(--border)] rounded-2xl overflow-hidden aspect-square transition-all hover:border-[var(--accent)]\" data-src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=1200&q=80\" data-kid=\"49\">\n              <img src=\"https://images.unsplash.com/photo-1768212565426-58b089b6386d?auto=format&w=200&q=80\" alt=\"Thumb 3\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"50\">\n            </button>\n            <button class=\"thumb-btn border-2 border-[var(--border)] rounded-2xl overflow-hidden aspect-square transition-all hover:border-[var(--accent)]\" data-src=\"https://images.unsplash.com/photo-1692689383138-c2df3476072c?auto=format&w=1200&q=80\" data-kid=\"51\">\n              <img src=\"https://images.unsplash.com/photo-1692689383138-c2df3476072c?auto=format&w=200&q=80\" alt=\"Thumb 4\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"52\">\n            </button>\n          </div>\n        </section>\n\n        \n        <section class=\"space-y-10\" id=\"info-panel\" data-kid=\"53\">\n          <div data-kid=\"54\">\n            <div class=\"flex items-center gap-3 mb-4\" data-kid=\"55\">\n              <span class=\"bg-[var(--primary)] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-lg\" data-kid=\"56\">Exclusivité OpportuniHub</span>\n              <span class=\"flex items-center gap-1 text-[var(--success)] font-bold text-sm\" data-kid=\"57\">\n                <i class=\"ti ti-shield-check\" data-kid=\"58\"></i> Vérifié par nos agents\n              </span>\n            </div>\n            <h1 class=\"text-4xl xl:text-5xl font-plus font-extrabold text-[var(--primary)] leading-tight mb-6\" data-kid=\"59\">\n              Collection Textile Wax Premium : <br data-kid=\"60\">Lot 24 Pièces Artisanales\n            </h1>\n            <p class=\"text-lg text-[var(--primary)]/70 leading-relaxed font-medium\" data-kid=\"61\">\n              Une sélection exclusive de motifs traditionnels en coton haute densité. Ce lot est directement sourcé auprès des coopératives de Lomé pour garantir le meilleur prix communautaire.\n            </p>\n          </div>\n\n          \n          <div class=\"bg-white p-8 rounded-[2rem] border-2 border-[var(--border)] shadow-sm relative overflow-hidden group\" data-kid=\"62\">\n            <div class=\"absolute top-0 right-0 w-32 h-32 bg-[var(--accent)]/5 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-110\" data-kid=\"63\"></div>\n            <div class=\"flex flex-col gap-1 relative z-10\" data-kid=\"64\">\n              <span class=\"text-sm font-bold text-[var(--primary)]/40 uppercase tracking-widest\" data-kid=\"65\">Prix Actuel Débloqué</span>\n              <div class=\"flex items-baseline gap-4\" data-kid=\"66\">\n                <span class=\"text-6xl font-plus font-black text-[var(--accent)] tracking-tighter\" data-kid=\"67\">275,000</span>\n                <span class=\"text-2xl font-plus font-extrabold text-[var(--accent)]/80\" data-kid=\"68\">FCFA</span>\n                <span class=\"text-xl text-[var(--primary)]/30 line-through decoration-[var(--accent)]/40 decoration-2 font-medium\" data-kid=\"69\">425k FCFA</span>\n              </div>\n            </div>\n            \n            \n            <div class=\"mt-8 flex items-center gap-4 pt-6 border-t border-[var(--border)]\" data-kid=\"70\">\n              <div class=\"flex -space-x-3 hover:space-x-1 transition-all\" data-kid=\"71\">\n                <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=1\" decoding=\"async\" loading=\"lazy\" data-kid=\"72\">\n                <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=2\" decoding=\"async\" loading=\"lazy\" data-kid=\"73\">\n                <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=3\" decoding=\"async\" loading=\"lazy\" data-kid=\"74\">\n                <img class=\"w-10 h-10 rounded-full border-2 border-white object-cover\" src=\"https://i.pravatar.cc/100?u=4\" decoding=\"async\" loading=\"lazy\" data-kid=\"75\">\n                <div class=\"w-10 h-10 rounded-full border-2 border-white bg-[var(--bg)] flex items-center justify-center text-[10px] font-bold text-[var(--primary)]\" data-kid=\"76\">+3</div>\n              </div>\n              <p class=\"text-sm font-bold text-[var(--primary)]\" data-kid=\"77\">\n                7 personnes participent déjà <br data-kid=\"78\">\n                <span class=\"text-[var(--success)] font-medium\" data-kid=\"79\">Rejoignez-les pour réduire le prix !</span>\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"space-y-6\" id=\"ladder-section\" data-kid=\"80\">\n            <h3 class=\"font-plus font-bold text-[var(--primary)] flex items-center gap-2 text-lg\" data-kid=\"81\">\n              <i class=\"ti ti-stairs text-[var(--accent)] text-xl\" data-kid=\"82\"></i>\n              Paliers de Réduction Groupée\n            </h3>\n            \n            <div class=\"relative pl-10 space-y-12\" data-kid=\"83\">\n              \n              <div class=\"absolute left-[14px] top-4 bottom-4 w-[6px] bg-[var(--border)] rounded-full overflow-hidden\" data-kid=\"84\">\n                <div id=\"progress-bar\" class=\"w-full bg-[var(--success)] rounded-full origin-top h-0\" data-kid=\"85\"></div>\n              </div>\n\n              \n              <div class=\"tier-item relative flex items-center justify-between group opacity-50 transition-opacity hover:opacity-100\" data-kid=\"86\">\n                <div class=\"absolute -left-[32px] w-6 h-6 rounded-full border-4 border-[var(--success)] bg-white flex items-center justify-center z-10 transition-transform hover:scale-125\" data-kid=\"87\">\n                   <div class=\"w-2 h-2 bg-[var(--success)] rounded-full\" data-kid=\"88\"></div>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"89\">\n                  <span class=\"text-[10px] font-black text-[var(--success)] uppercase tracking-tighter\" data-kid=\"90\">Atteint</span>\n                  <span class=\"text-xl font-plus font-extrabold\" data-kid=\"91\">10 participants</span>\n                </div>\n                <div class=\"text-right\" data-kid=\"92\">\n                  <span class=\"text-2xl font-plus font-black text-[var(--primary)]/30 italic\" data-kid=\"93\">355,000 FCFA</span>\n                </div>\n              </div>\n\n              \n              <div class=\"tier-item relative flex items-center justify-between p-5 bg-white rounded-3xl border-2 border-[var(--success)] shadow-[0_12px_40px_-12px_rgba(39,174,96,0.3)] transform scale-105 active-tier\" data-kid=\"94\">\n                <div class=\"absolute -left-[32px] w-6 h-6 rounded-full bg-[var(--success)] flex items-center justify-center z-10 shadow-[0_0_20px_rgba(39,174,96,0.5)]\" data-kid=\"95\">\n                   <i class=\"ti ti-check text-white text-[10px] font-black\" data-kid=\"96\"></i>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"97\">\n                  <span class=\"text-[10px] font-black text-[var(--success)] uppercase tracking-tighter flex items-center gap-1\" data-kid=\"98\">\n                    <span class=\"w-1.5 h-1.5 bg-[var(--success)] rounded-full animate-pulse\" data-kid=\"99\"></span> Prix Actuel\n                  </span>\n                  <span class=\"text-xl font-plus font-extrabold text-[var(--primary)]\" data-kid=\"100\">30 participants</span>\n                </div>\n                <div class=\"text-right\" data-kid=\"101\">\n                  <span class=\"text-3xl font-plus font-black text-[var(--primary)]\" data-kid=\"102\">275,000 <span class=\"text-sm font-bold opacity-50\" data-kid=\"103\">FCFA</span></span>\n                </div>\n              </div>\n\n              \n              <div class=\"tier-item relative flex items-center justify-between group transition-all\" data-kid=\"104\">\n                <div class=\"absolute -left-[32px] w-6 h-6 rounded-full border-4 border-[var(--border)] bg-white z-10\" data-kid=\"105\"></div>\n                <div class=\"flex flex-col\" data-kid=\"106\">\n                  <span class=\"text-[10px] font-black text-[var(--primary)]/40 uppercase tracking-tighter\" data-kid=\"107\">Objectif Suivant</span>\n                  <span class=\"text-xl font-plus font-extrabold text-[var(--primary)]/60\" data-kid=\"108\">50 participants</span>\n                </div>\n                <div class=\"text-right\" data-kid=\"109\">\n                  <div class=\"flex flex-col items-end\" data-kid=\"110\">\n                    <span class=\"text-2xl font-plus font-black text-[var(--primary)]/40\" data-kid=\"111\">250,000 FCFA</span>\n                    <span class=\"text-[10px] font-bold text-[var(--success)]\" data-kid=\"112\">-15k FCFA de plus</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"hidden md:block\" data-kid=\"113\">\n            <button id=\"cta-desktop\" class=\"w-full bg-[var(--accent)] hover:bg-[#e89a1c] text-white py-6 rounded-[1.5rem] font-plus font-black text-2xl shadow-[0_12px_48px_-8px_rgba(246,166,35,0.4)] transition-all transform hover:-translate-y-1 active:scale-95 flex items-center justify-center gap-4 group\" data-kid=\"114\">\n              REJOINDRE LE GROUPE\n              <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-1 transition-transform\" data-kid=\"115\"></i>\n            </button>\n            <div class=\"mt-6 flex items-center justify-center gap-8 text-[11px] font-bold text-[var(--primary)]/40 uppercase tracking-widest\" data-kid=\"116\">\n              <span class=\"flex items-center gap-2\" data-kid=\"117\"><i class=\"ti ti-shield-lock text-lg\" data-kid=\"118\"></i> Paiement Sécurisé</span>\n              <span class=\"flex items-center gap-2\" data-kid=\"119\"><i class=\"ti ti-refresh text-lg\" data-kid=\"120\"></i> Remboursement Garanti</span>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </main>\n\n  \n  <div class=\"md:hidden fixed bottom-0 left-0 right-0 z-[60] p-4 bg-white/90 backdrop-blur-xl border-t border-[var(--border)]\" data-kid=\"121\">\n    <div class=\"flex items-center gap-4\" data-kid=\"122\">\n      <div class=\"flex-grow\" data-kid=\"123\">\n        <span class=\"text-[10px] font-bold opacity-50 uppercase block\" data-kid=\"124\">Prix Actuel</span>\n        <span class=\"text-xl font-plus font-black text-[var(--accent)]\" data-kid=\"125\">275,000 FCFA</span>\n      </div>\n      <button id=\"cta-mobile\" class=\"bg-[var(--accent)] text-white px-8 py-4 rounded-2xl font-plus font-black text-sm shadow-xl flex items-center gap-2 active:scale-95 transition-transform\" data-kid=\"126\">\n        REJOINDRE\n        <i class=\"ti ti-arrow-right\" data-kid=\"127\"></i>\n      </button>\n    </div>\n  </div>\n\n  <footer class=\"bg-[var(--primary)] text-white/40 py-12\" data-kid=\"128\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\" data-kid=\"129\">\n      <div class=\"flex items-center justify-center gap-2 mb-6\" data-kid=\"130\">\n        <div class=\"w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center\" data-kid=\"131\">\n          <i class=\"ti ti-building-community text-[var(--accent)] text-lg\" data-kid=\"132\"></i>\n        </div>\n        <span class=\"font-plus text-lg font-black tracking-tight text-white\" data-kid=\"133\">\n          Opportuni<span class=\"text-[var(--accent)]\" data-kid=\"134\">Hub</span>\n        </span>\n      </div>\n      <p class=\"text-sm font-medium max-w-md mx-auto mb-8\" data-kid=\"135\">\n        La plateforme de groupage numéro 1 en Afrique de l'Ouest. Ensemble, augmentons notre pouvoir d'achat.\n      </p>\n      <div class=\"text-[10px] font-bold uppercase tracking-[0.2em]\" data-kid=\"136\">\n        &copy; 2024 OpportuniHub S.A.R.L. Tous droits réservés.\n      </div>\n    </div>\n  </footer>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"137\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"138\"></script>\n<script type=\"module\" data-kid=\"139\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n\n  // GSAP Plugin\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Lenis Smooth Scroll\n  const lenis = new Lenis({\n    autoRaf: true,\n    lerp: 0.1\n  });\n\n  // Header Scroll Effect\n  window.addEventListener('scroll', () => {\n    const header = document.getElementById('main-header');\n    if (window.scrollY > 20) {\n      header.classList.add('header-scrolled');\n    } else {\n      header.classList.remove('header-scrolled');\n    }\n  });\n\n  // Gallery Thumbnail Switcher\n  const mainImage = document.getElementById('main-image');\n  const thumbBtns = document.querySelectorAll('.thumb-btn');\n\n  thumbBtns.forEach(btn => {\n    btn.addEventListener('click', () => {\n      thumbBtns.forEach(b => b.classList.remove('active', 'ring-4', 'ring-[var(--primary)]/20', 'ring-offset-2', 'border-[var(--primary)]'));\n      thumbBtns.forEach(b => b.classList.add('border-[var(--border)]'));\n      \n      btn.classList.add('active', 'ring-4', 'ring-[var(--primary)]/20', 'ring-offset-2', 'border-[var(--primary)]');\n      btn.classList.remove('border-[var(--border)]');\n\n      gsap.to(mainImage, {\n        opacity: 0,\n        scale: 0.95,\n        duration: 0.2,\n        onComplete: () => {\n          mainImage.src = btn.dataset.src;\n          gsap.to(mainImage, { opacity: 1, scale: 1, duration: 0.4, ease: \"power2.out\" });\n        }\n      });\n    });\n  });\n\n  // Animations on Load\n  window.addEventListener('DOMContentLoaded', () => {\n    gsap.from(\"#info-panel > *\", {\n      opacity: 0,\n      y: 30,\n      stagger: 0.1,\n      duration: 0.8,\n      ease: \"power3.out\"\n    });\n\n    gsap.from(\"#gallery-container\", {\n      opacity: 0,\n      x: -50,\n      duration: 1,\n      ease: \"power4.out\"\n    });\n\n    gsap.from(\".tier-item\", {\n      opacity: 0,\n      x: 20,\n      stagger: 0.15,\n      duration: 1,\n      ease: \"back.out(1.7)\",\n      scrollTrigger: {\n        trigger: \"#ladder-section\",\n        start: \"top 80%\"\n      }\n    });\n\n    gsap.to(\"#progress-bar\", {\n      height: \"60%\",\n      duration: 1.5,\n      delay: 1,\n      ease: \"power2.inOut\",\n      scrollTrigger: {\n        trigger: \"#ladder-section\",\n        start: \"top 80%\"\n      }\n    });\n\n    const ctaButtons = document.querySelectorAll('#cta-desktop, #cta-mobile');\n    ctaButtons.forEach(btn => {\n      btn.addEventListener('mouseenter', () => gsap.to(btn, { scale: 1.02, duration: 0.3 }));\n      btn.addEventListener('mouseleave', () => gsap.to(btn, { scale: 1, duration: 0.3 }));\n    });\n  });\n</script>\n",
