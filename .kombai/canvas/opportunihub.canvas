      "html": "\n<div class=\"min-h-screen bg-[#FEFEFA] text-[#0A3D62] font-['Space_Grotesk'] antialiased selection:bg-[#F6A623] selection:text-[#0A3D62]\" data-kid=\"1\">\n<style data-kid=\"0\">\n        @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-anton { font-family: 'Anton', sans-serif; }\n        .font-space { font-family: 'Space Grotesk', sans-serif; }\n\n        .neo-border { border: 3px solid #0A3D62; }\n        .neo-border-sm { border: 2px solid #0A3D62; }\n        .neo-shadow { box-shadow: 6px 6px 0px 0px #0A3D62; }\n        .neo-shadow-sm { box-shadow: 4px 4px 0px 0px #0A3D62; }\n        .neo-shadow-mango { box-shadow: 6px 6px 0px 0px #F6A623; }\n        \n        .ticket-notch { position: relative; }\n        .ticket-notch::before, .ticket-notch::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            width: 36px;\n            height: 36px;\n            background: #FEFEFA;\n            border: 3px solid #0A3D62;\n            border-radius: 50%;\n            z-index: 20;\n        }\n        .ticket-notch::before { left: -18px; transform: translateY(-50%); }\n        .ticket-notch::after { right: -18px; transform: translateY(-50%); }\n\n        .pattern-overlay {\n            background-image: url(\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/viscious-speed/abstract-088.svg\");\n            background-size: 150px;\n            opacity: 0.03;\n            pointer-events: none;\n        }\n\n        .marquee-track {\n            display: flex;\n            white-space: nowrap;\n        }\n\n    </style>\n<div class=\"pattern-overlay fixed inset-0 z-0\" data-kid=\"1-1\"></div>\n\n<nav class=\"sticky top-0 z-50 bg-white neo-border border-t-0 border-x-0 px-6 py-4 flex items-center justify-between\" data-kid