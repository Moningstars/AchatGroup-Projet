      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --bg-main: #0F172A;\n        --bg-card: #1E293B;\n        --accent: #F59E0B;\n        --text-primary: #F8FAFC;\n        --text-secondary: #94A3B8;\n        --neon-gold: rgba(245, 158, 11, 0.4);\n    }\n\n    body {\n        background-color: var(--bg-main);\n        color: var(--text-primary);\n        font-family: 'IBM Plex Sans', sans-serif;\n    }\n\n    .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-plex { font-family: 'IBM Plex Sans', sans-serif; }\n\n    .glass-card {\n        background: rgba(30, 41, 59, 0.7);\n        backdrop-filter: blur(20px);\n        border: 1px solid rgba(255, 255, 255, 0.05);\n        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\n    }\n\n    .neon-border-gold {\n        border: 1.5px solid rgba(245, 158, 11, 0.3);\n        box-shadow: 0 0 15px rgba(245, 158, 11, 0.1), 0 0 40px rgba(245, 158, 11, 0.05);\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 4px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: var(--accent);\n        border-radius: 10px;\n    }\n\n    /* Animation classes */\n    .gsap-reveal { opacity: 1; } /* We will animate using GSAP .from, so we don't pre-hide */\n</style>\n<div class=\"min-h-screen bg-[var(--bg-main)] antialiased font-plex selection:bg-[var(--accent)] selection:text-[var(--bg-main)]\" data-kid=\"1\" data-name=\"page layout container\">\n\n<nav class=\"sticky top-0 z-50 bg-[var(--bg-main)]/90 backdrop-blur-xl border-b border-white/5 px-6 py-4 lg:px-12\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n<div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n<div class=\"flex items-center gap-14\" data-kid=\"1-1-1-1\" data-name=\"logo and nav link container\">\n<a class=\"flex items-center gap-3 group\" data-kid=\"1-1-1-1-1\" data-name=\"logo anchor link\" href=\"#\">\n<div class=\"w-10 h-10 bg-[var(--accent)] rounded-xl flex items-center justify-center text-[var(--bg-main)] font-black text-xl shadow-[0_0_20px_var(--neon-gold)] transition-transform group-hover:rotate-6 group-hover:scale-110\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo letter icon\">O</div>\n<span class=\"font-plus font-extrabold text-white text-2xl tracking-tighter hidden sm:block\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">OpportuniHub</span>\n</a>\n<div class=\"hidden lg:flex items-center gap-10\" data-kid=\"1-1-1-1-2\" data-name=\"navigation links list container\">\n<a class=\"font-plus font-bold text-slate-500 hover:text-white transition-colors text-sm\" data-kid=\"1-1-1-1-2-1\" data-name=\"catalogue navigation link\" href=\"#\">Catalogue</a>\n<a class=\"font-plus font-bold text-slate-500 hover:text-white transition-colors text-sm\" data-kid=\"1-1-1-1-2-2\" data-name=\"sondages navigation link\" href=\"#\">Sondages</a>\n<a class=\"font-plus font-bold text-white relative py-2 text-sm after:content-[''] after:absolute after:-bottom-[21px] after:left-0 after:w-full after:h-[2px] after:bg-[var(--accent)] after:shadow-[0_0_10px_var(--accent)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"active profile navigation link\" href=\"#\">Profil</a>\n<a class=\"font-plus font-bold text-slate-500 hover:text-white transition-colors text-sm\" data-kid=\"1-1-1-1-2-4\" data-name=\"aide navigation link\" href=\"#\">Aide</a>\n</div>\n</div>\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"account controls container\">\n<div class=\"hidden md:flex bg-white/5 p-1 rounded-full border border-white/10 glass-pill\" data-kid=\"1-1-1-2-1\" data-name=\"design mode toggle container\">\n<button class=\"px-5 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-full text-slate-500 cursor-pointer\" data-kid=\"1-1-1-2-1-1\" data-name=\"modern mode button\">Modern</button>\n<button class=\"px-5 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-full text-slate-500 cursor-pointer\" data-kid=\"1-1-1-2-1-2\" data-name=\"glass mode button\">Glass</button>\n<button class=\"px-5 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-full bg-[var(--bg-card)] text-white shadow-lg cursor-pointer\" data-kid=\"1-1-1-2-1-3\" data-name=\"premium mode button\">Premium</button>\n</div>\n<div class=\"bg-white/5 px-5 py-2 rounded-2xl border border-white/10 flex items-center gap-3 shadow-sm\" data-kid=\"1-1-1-2-2\" data-name=\"wallet balance status bar\">\n<i class=\"ti ti-wallet text-[var(--accent)] text-xl\" data-kid=\"1-1-1-2-2-1\" data-name=\"wallet icon\"></i>\n<div class=\"flex flex-col leading-none\" data-kid=\"1-1-1-2-2-2\" data-name=\"balance text group\">\n<span class=\"text-[9px] text-slate-500 font-black uppercase tracking-[0.15em]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"balance label\">Solde</span>\n<span class=\"font-plex font-bold text-[13px] text-[var(--accent)]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"balance amount\">125.750 <span class=\"text-[10px] text-slate-400\" data-kid=\"1-1-1-2-2-2-2-1\" data-name=\"currency label\">FCFA</span></span>\n</div>\n</div>\n</div>\n</div>\n</nav>\n<main class=\"max-w-7xl mx-auto px-6 py-12 lg:px-12\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"grid grid-cols-1 lg:grid-cols-10 gap-12\" data-kid=\"1-2-1\" data-name=\"grid content layout\">\n\n<div class=\"lg:col-span-3 gsap-reveal\" data-kid=\"1-2-1-1\" data-name=\"sidebar container\">\n<div class=\"glass-card rounded-[2rem] p-10 border border-white/5 sticky top-32 overflow-hidden\" data-kid=\"1-2-1-1-1\" data-name=\"sidebar profile card\" id=\"sidebar-card\">\n\n<img class=\"absolute -bottom-12 -right-12 w-48 h-48 opacity-5 pointer-events-none\" data-kid=\"1-2-1-1-1-1\" data-name=\"background watermark abstract icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/viscious-speed/abstract-012.svg\" style=\"filter: invert(1);\">\n<div class=\"flex flex-col items-center text-center mb-12 relative\" data-kid=\"1-2-1-1-1-2\" data-name=\"profile info group\">\n<div class=\"relative mb-8\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"avatar container\">\n<div class=\"w-36 h-36 rounded-full ring-1 ring-[var(--accent)]/30 ring-offset-4 ring-offset-[var(--bg-card)] p-1 overflow-hidden hover:scale-105 transition-transform duration-500\" data-kid=\"1-2-1-1-1-2-1-1\" data-name=\"avatar image container\">\n<img alt=\"Avatar\" class=\"w-full h-full object-cover rounded-full grayscale group-hover:grayscale-0 transition-all duration-700\" data-kid=\"1-2-1-1-1-2-1-1-1\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/300?u=opportuni\">\n</div>\n<div class=\"absolute bottom-1.5 right-2.5 w-9 h-9 bg-emerald-500 border-4 border-[var(--bg-card)] rounded-full flex items-center justify-center text-white shadow-xl\" data-kid=\"1-2-1-1-1-2-1-2\" data-name=\"verification status badge\">\n<i class=\"ti ti-check text-lg font-bold\" data-kid=\"1-2-1-1-1-2-1-2-1\" data-name=\"checkmark icon\"></i>\n</div>\n</div>\n<h2 class=\"text-2xl font-plus font-black text-white tracking-tight\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"user full name text\">Jean Dupont</h2>\n<div class=\"flex items-center gap-2 mt-2 text-slate-500 font-plex font-semibold text-[13px] tracking-wide\" data-kid=\"1-2-1-1-1-2-3\" data-name=\"user phone info group\">\n<i class=\"ti ti-phone text-[var(--accent)]/60\" data-kid=\"1-2-1-1-1-2-3-1\" data-name=\"phone icon\"></i>\n<span class=\"opacity-80\" data-kid=\"1-2-1-1-1-2-3-2\" data-name=\"phone number text\">+228 90 12 34 56</span>\n</div>\n</div>\n<nav class=\"space-y-3 relative\" data-kid=\"1-2-1-1-1-3\" data-name=\"sidebar navigation menu\">\n<a class=\"flex items-center gap-5 px-6 py-4 rounded-2xl bg-[var(--accent)] text-[var(--bg-main)] shadow-[0_15px_30px_rgba(245,158,11,0.2)] font-plus font-black transition-transform hover:-translate-y-0.5\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"profile navigation link\" href=\"#\">\n<i class=\"ti ti-user-circle text-2xl\" data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"profile icon\"></i>\n<span class=\"text-sm\" data-kid=\"1-2-1-1-1-3-1-2\" data-name=\"profile label\">Profil</span>\n</a>\n<a class=\"flex items-center gap-5 px-6 py-4 rounded-2xl text-slate-400 hover:bg-white/5 hover:text-white transition-all font-plus font-bold group\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"wallet navigation link\" href=\"#\">\n<i class=\"ti ti-wallet text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"wallet icon\"></i>\n<span class=\"text-sm\" data-kid=\"1-2-1-1-1-3-2-2\" data-name=\"wallet label\">Portefeuille</span>\n</a>\n<a class=\"flex items-center gap-5 px-6 py-4 rounded-2xl text-slate-400 hover:bg-white/5 hover:text-white transition-all font-plus font-bold group\" data-kid=\"1-2-1-1-1-3-3\" data-name=\"history navigation link\" href=\"#\">\n<i class=\"ti ti-history text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-3-3-1\" data-name=\"history icon\"></i>\n<span class=\"text-sm\" data-kid=\"1-2-1-1-1-3-3-2\" data-name=\"history label\">Historique</span>\n</a>\n<a class=\"flex items-center gap-5 px-6 py-4 rounded-2xl text-slate-400 hover:bg-white/5 hover:text-white transition-all font-plus font-bold group\" data-kid=\"1-2-1-1-1-3-4\" data-name=\"settings navigation link\" href=\"#\">\n<i class=\"ti ti-settings text-2xl group-hover:text-[var(--accent)]\" data-kid=\"1-2-1-1-1-3-4-1\" data-name=\"settings icon\"></i>\n<span class=\"text-sm\" data-kid=\"1-2-1-1-1-3-4-2\" data-name=\"settings label\">Paramètres</span>\n</a>\n<div class=\"pt-8 mt-8 border-t border-white/5\" data-kid=\"1-2-1-1-1-3-5\" data-name=\"menu divider\"></div>\n<a class=\"flex items-center gap-5 px-6 py-4 rounded-2xl text-rose-500/70 hover:bg-rose-500/5 hover:text-rose-500 transition-all font-plus font-bold\" data-kid=\"1-2-1-1-1-3-6\" data-name=\"logout navigation link\" href=\"#\">\n<i class=\"ti ti-logout text-2xl\" data-kid=\"1-2-1-1-1-3-6-1\" data-name=\"logout icon\"></i>\n<span class=\"text-sm\" data-kid=\"1-2-1-1-1-3-6-2\" data-name=\"logout label\">Déconnexion</span>\n</a>\n</nav>\n</div>\n</div>\n\n<div class=\"lg:col-span-7 space-y-12\" data-kid=\"1-2-1-2\" data-name=\"main dashboard panel\">\n\n<div class=\"gsap-reveal\" data-kid=\"1-2-1-2-1\" data-name=\"welcome header section\">\n<h1 class=\"text-5xl font-plus font-black text-white tracking-tight mb-3\" data-kid=\"1-2-1-2-1-1\" data-name=\"main page headline\">Tableau de Bord</h1>\n<div class=\"w-16 h-1 bg-[var(--accent)] mb-4 rounded-full\" data-kid=\"1-2-1-2-1-2\" data-name=\"accent divider line\"></div>\n<p class=\"text-slate-400 text-lg font-plex font-medium\" data-kid=\"1-2-1-2-1-3\" data-name=\"welcome message text\">Bon retour, Jean. Voici un aperçu de votre compte aujourd'hui.</p>\n</div>\n\n<div class=\"glass-card rounded-[2rem] p-10 border border-white/5 flex flex-col md:flex-row items-center gap-10 gsap-reveal glow-on-hover\" data-kid=\"1-2-1-2-2\" data-name=\"profile completion widget\">\n<div class=\"relative w-32 h-32 flex-shrink-0\" data-kid=\"1-2-1-2-2-1\" data-name=\"progress ring container\">\n<svg class=\"w-full h-full -rotate-90\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"progress ring svg\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"45\" stroke=\"rgba(255,255,255,0.02)\" stroke-width=\"6\" data-kid=\"2\"></circle>\n<circle class=\"drop-shadow-[0_0_6px_var(--neon-gold)]\" cx=\"50\" cy=\"50\" fill=\"none\" id=\"progress-circle\" r=\"45\" stroke=\"var(--accent)\" stroke-dasharray=\"282.7\" stroke-dashoffset=\"70.6\" stroke-linecap=\"round\" stroke-width=\"6\" data-kid=\"3\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"progress percentage container\">\n<span class=\"text-2xl font-plex font-bold text-white tracking-tight\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"progress percentage text\">75%</span>\n</div>\n</div>\n<div class=\"flex-1 text-center md:text-left\" data-kid=\"1-2-1-2-2-2\" data-name=\"widget text description\">\n<h3 class=\"text-2xl font-plus font-black text-white mb-2 tracking-tight\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"widget title\">Optimisez votre visibilité</h3>\n<p class=\"text-slate-400 text-[15px] font-plex mb-6 leading-relaxed max-w-xl\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"widget body text\">Un profil complété vous donne accès à des offres exclusives et augmente votre confiance auprès de la communauté.</p>\n<div class=\"flex flex-wrap justify-center md:justify-start gap-4\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"completion status badges group\">\n<span class=\"px-3 py-1.5 bg-emerald-500/10 text-emerald-500 text-[9px] font-plus font-bold uppercase tracking-wide rounded-full border border-emerald-500/20 flex items-center gap-1.5\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"email verified badge\">\n<i class=\"ti ti-check\" data-kid=\"1-2-1-2-2-2-3-1-1\" data-name=\"checkmark icon\"></i> Email vérifié\n                            </span>\n<span class=\"px-3 py-1.5 bg-white/5 text-slate-500 text-[9px] font-plus font-bold uppercase tracking-wide rounded-full border border-white/10\" data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"photo badge\">\n                                Photo de profil\n                            </span>\n<span class=\"px-3 py-1.5 bg-white/5 text-slate-500 text-[9px] font-plus font-bold uppercase tracking-wide rounded-full border border-white/10\" data-kid=\"1-2-1-2-2-2-3-3\" data-name=\"bank info badge\">\n                                Infos Bancaires\n                            </span>\n</div>\n</div>\n<button class=\"bg-[var(--accent)] text-[var(--bg-main)] px-10 py-4 rounded-xl text-[12px] font-plus font-black uppercase tracking-widest hover:scale-105 transition-transform shadow-[0_15px_30px_rgba(245,158,11,0.25)] cursor-pointer\" data-kid=\"1-2-1-2-2-3\" data-name=\"complete profile button\">Compléter</button>\n</div>\n\n<div class=\"relative rounded-[2.5rem] p-9 text-white overflow-hidden gsap-reveal border-[1px] border-[var(--accent)]/10 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)] group\" data-kid=\"1-2-1-2-3\" data-name=\"wallet summary card\">\n<img alt=\"Dark abstract glass\" class=\"absolute inset-0 w-full h-full object-cover opacity-45 mix-blend-overlay group-hover:scale-105 transition-transform duration-[3000ms]\" data-kid=\"1-2-1-2-3-1\" data-name=\"abstract background texture image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1683799286400-69220fa89f48?crop=entropy&amp;cs=srgb&amp;fm=jpg&amp;ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxhYnN0cmFjdCUyMGRhcmslMjBnbGFzcyUyMHRleHR1cmUlMjB3aXRoJTIwYW1iZXIlMjBsaWdodHxlbnwwfHx8fDE3ODM5NTQ3OTB8MA&amp;ixlib=rb-4.1.0&amp;q=85&amp;auto=format&amp;w=1400\">\n<div class=\"absolute inset-0 bg-gradient-to-br from-[#1E293B] via-[#0F172A]/95 to-transparent\" data-kid=\"1-2-1-2-3-2\" data-name=\"card background gradient\"></div>\n<div class=\"relative z-10\" data-kid=\"1-2-1-2-3-3\" data-name=\"card content container\">\n<div class=\"flex justify-between items-start mb-12\" data-kid=\"1-2-1-2-3-3-1\" data-name=\"card top header group\">\n<div class=\"inline-flex items-center gap-3 bg-white/5 backdrop-blur-md px-4 py-2 rounded-full border border-white/10\" data-kid=\"1-2-1-2-3-3-1-1\" data-name=\"status pill container\">\n<div class=\"w-2.5 h-2.5 rounded-full bg-[var(--accent)] shadow-[0_0_12px_var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-3-1-1-1\" data-name=\"live pulse indicator\" data-reason=\"pulsing animation re-scales the element\" id=\"live-indicator\"></div>\n<span class=\"